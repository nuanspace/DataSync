RELEASE_VERSION=s7-20260722.1
DEPLOYMENT_MODE=external-cube
CYYY_IMAGE=datasync-cyyy:s7-20260722.1
LHYY_IMAGE=datasync-lhyy-v2:s7-20260722.1
DATASYNC_DB_IMAGE=postgres:17.6
# 仅 fresh-cube 模式需要
CUBE_DB_IMAGE=followup-cube-postgres:17.6-pgvector-s7

DATA_ROOT=/data/s7-followup
# 必须填写 NTCare 实际使用的 uploads 宿主机绝对路径或同一共享存储挂载点
NTCARE_UPLOADS_PATH=/__REPLACE_WITH_NTCARE_UPLOADS_ABSOLUTE_PATH__
MANAGEMENT_BIND_ADDRESS=127.0.0.1
DATABASE_BIND_ADDRESS=127.0.0.1
CYYY_HOST_PORT=18080
LHYY_HOST_PORT=18081
DATASYNC_DB_HOST_PORT=15432
# 仅 fresh-cube 模式需要
CUBE_DB_HOST_PORT=15433

DATASYNC_DB_NAME=datasync
DATASYNC_DB_USER=postgres
# 仅 fresh-cube 模式需要
CUBE_DB_NAME=cube
CUBE_DB_USER=postgres
CYYY_CONTAINER_UID=1654
