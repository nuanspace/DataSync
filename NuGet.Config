<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Bio.Private" value="https://nuget.bio-ocean.com/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Bio.Private">
      <package pattern="Bio.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
