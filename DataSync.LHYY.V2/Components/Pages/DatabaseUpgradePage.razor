@page "/database-upgrade"
@inherits BasePage

<PageTitle>数据库升级 - LHYY V2</PageTitle>

<div class="database-upgrade-page">
    <header class="database-upgrade-header">
        <div class="database-upgrade-title-block">
            <MudText Typo="Typo.h4" Class="database-upgrade-title">数据库升级</MudText>
            <MudText Typo="Typo.body2" Class="database-upgrade-subtitle">选择目标库，检查内置脚本，确认后先备份再升级。</MudText>
        </div>
        <div class="database-upgrade-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadConnections" Disabled="@IsFormLocked">
                刷新
            </MudButton>
        </div>
    </header>

    @if (IsSelectedUpgradeBlocked)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            external-cube 模式下，现有 CubeDb 仅允许业务导入和只读兼容性检查；本页面不会对其执行比对同步、内置脚本或 SQL 文件。
        </MudAlert>
    }

    <section class="database-upgrade-panel">
        <div class="database-upgrade-form">
            <MudSelect T="string" @bind-Value="_upgradeMode" Label="升级方式"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked">
                <MudSelectItem Value="@CompareMode">数据库比对</MudSelectItem>
                <MudSelectItem Value="@ProjectScriptsMode">内置脚本</MudSelectItem>
                <MudSelectItem Value="@SqlFileMode">数据库文件</MudSelectItem>
            </MudSelect>

            <MudSelect T="string" @bind-Value="_selectedConnectionName" Label="低版本目标数据库"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked">
                @foreach (var connection in _connections)
                {
                    <MudSelectItem Value="@connection.Name">@connection.DisplayName</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_pgDumpPath" Label="PostgreSQL 工具路径（可选）"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked"
                          Placeholder="可填 bin 目录、pg_dump.exe 或 psql.exe 路径" />
        </div>

        @if (IsCompareMode)
        {
            <div class="database-upgrade-compare-panel">
                <div class="database-upgrade-compare-grid">
                    <MudSelect T="string" @bind-Value="_compareSourceMode" Label="高版本来源"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked">
                        <MudSelectItem Value="@CompareSourceConnectionMode">数据库连接</MudSelectItem>
                        <MudSelectItem Value="@CompareSourceSqlFileMode">SQL 文件</MudSelectItem>
                    </MudSelect>

                    @if (IsCompareSourceConnectionMode)
                    {
                        <MudSelect T="string" @bind-Value="_sourceConnectionName" Label="高版本标准数据库"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked">
                            @foreach (var connection in _connections)
                            {
                                <MudSelectItem Value="@connection.Name">@connection.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_sourceSqlFilePath" Label="高版本 SQL 文件路径"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked"
                                      Placeholder="可填服务器路径，也可上传完整 .sql" />
                    }

                    <MudTextField @bind-Value="_schemasText" Label="Schema"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked"
                                  Placeholder="多个用英文逗号分隔，默认 lhyy" />
                </div>

                @if (IsCompareSourceSqlFileMode)
                {
                    <div class="database-upgrade-file-row">
                        <label class="database-upgrade-upload">
                            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
                            <span>上传高版本 SQL</span>
                            <InputFile OnChange="OnSourceSqlFileChanged" accept=".sql" disabled="@IsFormLocked" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(_uploadedSourceSqlFileName))
                        {
                            <MudText Typo="Typo.body2" Class="database-upgrade-file-name">已选择：@_uploadedSourceSqlFileName</MudText>
                        }
                    </div>
                }

                <MudCheckBox T="bool" @bind-Value="_includeDrop" Color="Color.Error" Disabled="@IsFormLocked"
                             Label="允许生成删除多余表、字段、索引、约束、视图、函数、触发器的 SQL" />
            </div>
        }

        <div class="database-upgrade-backup">
            <MudCheckBox T="bool" @bind-Value="_skipBackup" Color="Color.Warning" Disabled="@IsFormLocked"
                         Label="我已手工备份，跳过自动备份" />
        </div>

        @if (IsSqlFileMode)
        {
            <div class="database-upgrade-file-panel">
                <div class="database-upgrade-file-row">
                    <MudTextField @bind-Value="_sqlFilePath" Label="服务器 SQL 文件路径"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked"
                                  Placeholder="例如 D:\Upgrade\upgrade.sql；也可使用下方上传" />
                    <label class="database-upgrade-upload">
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" />
                        <span>上传 SQL 文件</span>
                        <InputFile OnChange="OnSqlFileChanged" accept=".sql" disabled="@IsFormLocked" />
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(_uploadedSqlFileName))
                {
                    <MudText Typo="Typo.body2" Class="database-upgrade-file-name">已选择：@_uploadedSqlFileName</MudText>
                }
            </div>
        }

        <div class="database-upgrade-button-row">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FactCheck"
                       OnClick="CheckUpgrade" Disabled="@(!CanOperate)">
                检查升级
            </MudButton>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="_messageSeverity" Variant="Variant.Outlined" Dense="true">@_message</MudAlert>
        }

        @if (_checkResult != null && IsProjectScriptsMode)
        {
            <div class="database-upgrade-summary">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">脚本总数：@_checkResult.TotalScriptCount</MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">功能脚本：@_checkResult.LegacyScripts.Count</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">优化脚本未执行：@CountManagedScripts(DatabaseUpgradeScriptStatus.Pending)</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">优化脚本未知：@CountManagedScripts(DatabaseUpgradeScriptStatus.Unknown)</MudChip>
            </div>

            @if (!_checkResult.IsStateWritable && !string.IsNullOrWhiteSpace(_checkResult.StateErrorMessage))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    @_checkResult.StateErrorMessage。优化脚本执行和状态标记已禁用；功能脚本处理不依赖该状态文件。
                </MudAlert>
            }

            <MudTabs @bind-ActivePanelIndex="_projectScriptTabIndex"
                     Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="false"
                     Class="database-upgrade-tabs">
                <MudTabPanel Text="功能脚本处理" Icon="@Icons.Material.Filled.History">
                    <MudText Typo="Typo.body2" Class="database-upgrade-subtitle">
                        功能脚本保留原有方式：确认后会先备份目标库，再按顺序执行下方所有功能脚本。
                    </MudText>
                    @if (_checkResult.LegacyScripts.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="database-upgrade-empty">没有功能脚本。</MudText>
                    }
                    else
                    {
                        <MudTable Items="_checkResult.LegacyScripts" Dense="true" Hover="true" Elevation="0" Class="database-upgrade-table">
                            <HeaderContent>
                                <MudTh>脚本名称</MudTh>
                                <MudTh>简介</MudTh>
                                <MudTh>创建时间</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="脚本名称">
                                    <div class="database-upgrade-script-name">@context.ScriptName</div>
                                    <div class="database-upgrade-script-path">@context.ScriptKey</div>
                                </MudTd>
                                <MudTd DataLabel="简介">@context.Description</MudTd>
                                <MudTd DataLabel="创建时间">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>
                <MudTabPanel Text="优化脚本处理" Icon="@Icons.Material.Filled.NewReleases">
                    @if (_checkResult.ManagedScripts.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="database-upgrade-empty">没有优化脚本。</MudText>
                    }
                    else
                    {
                        <MudTable Items="_checkResult.ManagedScripts" Dense="true" Hover="true" Elevation="0" Class="database-upgrade-table">
                            <HeaderContent>
                                <MudTh>脚本名称</MudTh>
                                <MudTh>简介</MudTh>
                                <MudTh>创建时间</MudTh>
                                <MudTh>状态</MudTh>
                                <MudTh>操作</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="脚本名称">
                                    <div class="database-upgrade-script-name">@context.ScriptName</div>
                                    <div class="database-upgrade-script-path">@context.ScriptKey</div>
                                </MudTd>
                                <MudTd DataLabel="简介">@context.Description</MudTd>
                                <MudTd DataLabel="创建时间">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="状态">
                                    <MudChip T="string" Size="Size.Small" Color="@GetScriptStatusColor(context.Status)" Variant="Variant.Outlined">
                                        @context.StatusText
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="操作">
                                    <div class="database-upgrade-row-actions">
                                        @if (context.Status == DatabaseUpgradeScriptStatus.Pending)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                                       Disabled="@(_busy || !_checkResult.IsStateWritable || IsTaskRunning || !IsConfirmTextValid)"
                                                       OnClick="@(() => StartManagedScriptTask(context))">
                                                执行
                                            </MudButton>
                                        }
                                        else if (context.Status == DatabaseUpgradeScriptStatus.Unknown)
                                        {
                                            @if (context.CanMarkStatus)
                                            {
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Success"
                                                           Size="Size.Small"
                                                           Disabled="@(_busy || !_checkResult.IsStateWritable || IsTaskRunning || !IsConfirmTextValid)"
                                                           OnClick="@(() => MarkScriptStatus(context, DatabaseUpgradeScriptStatus.Executed))">
                                                    标记已执行
                                                </MudButton>
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           Disabled="@(_busy || !_checkResult.IsStateWritable || IsTaskRunning || !IsConfirmTextValid)"
                                                           OnClick="@(() => MarkScriptStatus(context, DatabaseUpgradeScriptStatus.Pending))">
                                                    标记未执行
                                                </MudButton>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    状态由目标库检测决定，不能手工标记。
                                                </MudText>
                                            }
                                        }
                                    </div>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>
            </MudTabs>

            @if (_currentTask != null)
            {
                <MudAlert Severity="@GetTaskSeverity(_currentTask.Status)" Variant="Variant.Outlined" Dense="true">
                    @if (IsTaskRunning)
                    {
                        <span class="database-upgrade-running-state">脚本正在执行中</span>
                        <span>；当前步骤：@_currentTask.CurrentStep；@_currentTask.StatusText</span>
                    }
                    else
                    {
                        <span>后台任务：@_currentTask.StatusText；当前步骤：@_currentTask.CurrentStep</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_currentTask.ErrorMessage))
                    {
                        <span>；错误：@_currentTask.ErrorMessage</span>
                    }
                </MudAlert>
                @if (_currentTask.Progress != null)
                {
                    <div class="database-upgrade-progress">
                        <div class="database-upgrade-progress-header">
                            <span>迁移历史终态消息</span>
                            <span>@_currentTask.Progress.Percent.ToString("0.##")%</span>
                        </div>
                        <MudProgressLinear Color="Color.Info"
                                           Value="@_currentTask.Progress.Percent"
                                           Rounded="true"
                                           Size="Size.Medium" />
                        <div class="database-upgrade-progress-detail">
                            <span>消息：@_currentTask.Progress.MigratedMessages.ToString("N0") / @_currentTask.Progress.TotalMessages.ToString("N0")</span>
                            <span>处理日志：@_currentTask.Progress.MigratedLogs.ToString("N0")</span>
                            <span>批次：@_currentTask.Progress.BatchIndex.ToString("N0")</span>
                            <span>阈值：@_currentTask.Progress.Threshold.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        </div>
                    </div>
                }
                @if (_currentTask.Logs.Count > 0)
                {
                    <div class="database-upgrade-task-log">
                        <div class="database-upgrade-task-log-title">执行日志</div>
                        <div class="database-upgrade-task-log-list">
                            @foreach (var log in _currentTask.Logs)
                            {
                                <div class="database-upgrade-task-log-row @GetTaskLogLevelClass(log.Level)">
                                    <span class="database-upgrade-task-log-time">@log.Timestamp.ToString("HH:mm:ss")</span>
                                    <span class="database-upgrade-task-log-step">@log.Step</span>
                                    <span class="database-upgrade-task-log-message">@log.Message</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }

        @if (_compareResult != null && IsCompareMode)
        {
            <div class="database-upgrade-summary">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Schema：@string.Join(", ", _compareResult.Schemas)</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">差异：@_compareResult.Differences.Count</MudChip>
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">删除类：@_compareResult.Differences.Count(x => x.IsDangerous)</MudChip>
            </div>

            <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false" Class="database-upgrade-tabs">
                <MudTabPanel Text="结构差异" Icon="@Icons.Material.Filled.CompareArrows">
                    @if (_compareResult.Differences.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="database-upgrade-empty">没有发现结构差异。</MudText>
                    }
                    else
                    {
                        <MudTable Items="_compareResult.Differences" Dense="true" Hover="true" Elevation="0" Class="database-upgrade-table">
                            <HeaderContent>
                                <MudTh>类型</MudTh>
                                <MudTh>对象</MudTh>
                                <MudTh>变化</MudTh>
                                <MudTh>说明</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Category</MudTd>
                                <MudTd>@context.ObjectName</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="@(context.IsDangerous ? Color.Error : Color.Primary)" Variant="Variant.Outlined">
                                        @context.ChangeType
                                    </MudChip>
                                </MudTd>
                                <MudTd>@context.Note</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>
                <MudTabPanel Text="数据同步" Icon="@Icons.Material.Filled.SyncAlt">
                    <MudText Typo="Typo.body2" Class="database-upgrade-subtitle">选择需要从高版本同步到低版本的数据表。</MudText>
                    <MudTable Items="_tableSyncSelections" Dense="true" Hover="true" Elevation="0" Class="database-upgrade-table">
                        <HeaderContent>
                            <MudTh>同步</MudTh>
                            <MudTh>表</MudTh>
                            <MudTh>方式</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudCheckBox T="bool" @bind-Value="context.Selected" Color="Color.Primary" />
                            </MudTd>
                            <MudTd>@context.FullName</MudTd>
                            <MudTd>
                                <MudSelect T="string" @bind-Value="context.Mode" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@DatabaseCompareService.DataSyncModeUpsert">更新插入</MudSelectItem>
                                    <MudSelectItem Value="@DatabaseCompareService.DataSyncModeClearImport">清空导入</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudTabPanel>
            </MudTabs>
        }

        <div class="database-upgrade-confirm">
            <MudText Typo="Typo.subtitle2" Class="database-upgrade-confirm-title">执行确认</MudText>
            <MudText Typo="Typo.body2" Class="database-upgrade-subtitle">确认目标库和待执行内容无误后，输入“确认”启用执行按钮。</MudText>
            <MudTextField @bind-Value="_confirmText" Label="确认文本"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@IsFormLocked" />
            @if (ShowBulkExecuteButton)
            {
                <div class="database-upgrade-button-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="ExecuteUpgrade" Disabled="@(!CanExecute)">
                        @ExecuteButtonText
                    </MudButton>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_executeMessage))
            {
                <MudAlert Severity="_executeMessageSeverity" Variant="Variant.Outlined" Dense="true">@_executeMessage</MudAlert>
            }
        </div>

        @if (_executeResult != null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                升级完成，备份文件：@_executeResult.BackupFile
            </MudAlert>
            <MudList T="string" Dense="true" Class="database-upgrade-script-list">
                @foreach (var script in _executeResult.ExecutedScripts)
                {
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle">@script</MudListItem>
                }
            </MudList>
        }

        @if (_compareExecuteResult != null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                比对升级完成，备份文件：@_compareExecuteResult.BackupFile
            </MudAlert>
            <MudList T="string" Dense="true" Class="database-upgrade-script-list">
                @foreach (var item in _compareExecuteResult.SummaryItems)
                {
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle">@item</MudListItem>
                }
            </MudList>
        }
    </section>
</div>

@code {
    private List<DatabaseConnectionOption> _connections = [];
    private const string ProjectScriptsMode = "ProjectScripts";
    private const string SqlFileMode = "SqlFile";
    private const string CompareMode = "Compare";
    private const string CompareSourceConnectionMode = DatabaseCompareService.SourceConnection;
    private const string CompareSourceSqlFileMode = DatabaseCompareService.SourceSqlFile;
    private string _upgradeMode = CompareMode;
    private string _compareSourceMode = CompareSourceConnectionMode;
    private string? _selectedConnectionName;
    private string? _sourceConnectionName;
    private string? _pgDumpPath;
    private string? _sqlFilePath;
    private string? _sourceSqlFilePath;
    private string? _uploadedSqlFileName;
    private string? _uploadedSourceSqlFileName;
    private string? _checkedConnectionName;
    private string? _checkedSqlFilePath;
    private string? _checkedCompareKey;
    private string _schemasText = "lhyy";
    private string? _confirmText;
    private string? _message;
    private string? _executeMessage;
    private Severity _messageSeverity = Severity.Info;
    private Severity _executeMessageSeverity = Severity.Info;
    private bool _busy;
    private bool _sqlFileChecked;
    private bool _skipBackup;
    private bool _includeDrop;
    private int _projectScriptTabIndex;
    private Guid? _currentTaskId;
    private DatabaseUpgradeTaskSnapshot? _currentTask;
    private DatabaseUpgradeCheckResult? _checkResult;
    private DatabaseUpgradeExecuteResult? _executeResult;
    private DatabaseCompareResult? _compareResult;
    private DatabaseCompareExecuteResult? _compareExecuteResult;
    private List<TableSyncSelection> _tableSyncSelections = [];

    private bool CanOperate => !_busy && !IsTaskRunning && !string.IsNullOrWhiteSpace(_selectedConnectionName);
    private bool IsFormLocked => _busy || IsTaskRunning;
    private bool IsProjectScriptsMode => string.Equals(_upgradeMode, ProjectScriptsMode, StringComparison.Ordinal);
    private bool IsSqlFileMode => string.Equals(_upgradeMode, SqlFileMode, StringComparison.Ordinal);
    private bool IsCompareMode => string.Equals(_upgradeMode, CompareMode, StringComparison.Ordinal);
    private bool IsCompareSourceConnectionMode => string.Equals(_compareSourceMode, CompareSourceConnectionMode, StringComparison.Ordinal);
    private bool IsCompareSourceSqlFileMode => string.Equals(_compareSourceMode, CompareSourceSqlFileMode, StringComparison.Ordinal);
    private bool IsConfirmTextValid => string.Equals(_confirmText, "确认", StringComparison.Ordinal);
    private bool IsTaskRunning => _currentTask is { IsTerminal: false };
    private bool IsSelectedUpgradeBlocked =>
        inj_databaseUpgradeService.IsUpgradeExecutionBlocked(_selectedConnectionName);
    private bool ShowBulkExecuteButton => !IsProjectScriptsMode || _projectScriptTabIndex == 0;
    private string ExecuteButtonText => IsSqlFileMode
        ? (_skipBackup ? "执行文件" : "备份并执行文件")
        : IsProjectScriptsMode
        ? (_skipBackup ? "执行功能脚本" : "备份并执行功能脚本")
        : (_skipBackup ? "执行升级" : "备份并升级");
    private bool CanExecute =>
        CanOperate
        && !IsSelectedUpgradeBlocked
        && IsConfirmTextValid
        && string.Equals(_checkedConnectionName, _selectedConnectionName, StringComparison.OrdinalIgnoreCase)
        && (IsCompareMode
            ? _compareResult != null
                && _compareResult.Differences.Count > 0
                && string.Equals(_checkedCompareKey, BuildCompareKey(), StringComparison.Ordinal)
            : IsProjectScriptsMode
            ? _projectScriptTabIndex == 0
                && _checkResult?.LegacyScripts.Count > 0
            : _sqlFileChecked
                && !string.IsNullOrWhiteSpace(_sqlFilePath)
                && string.Equals(_checkedSqlFilePath, _sqlFilePath, StringComparison.OrdinalIgnoreCase));

    protected override bool RequiresIntegrationProject => false;

    protected override Task OnPageInitializedAsync()
    {
        LoadConnections();
        return Task.CompletedTask;
    }

    private void LoadConnections()
    {
        _connections = inj_databaseUpgradeService.GetConnectionOptions();
        _selectedConnectionName ??= _connections.FirstOrDefault()?.Name;
        _sourceConnectionName ??= _connections.FirstOrDefault(item => !string.Equals(item.Name, _selectedConnectionName, StringComparison.OrdinalIgnoreCase))?.Name
            ?? _connections.FirstOrDefault()?.Name;
        _message = _connections.Count == 0 ? "未找到连接字符串，请检查 appsettings.json。" : null;
        _messageSeverity = Severity.Info;
    }

    private async Task CheckUpgrade()
    {
        if (string.IsNullOrWhiteSpace(_selectedConnectionName))
            return;
        if (IsTaskRunning)
        {
            _message = "后台升级任务正在执行，请等待完成后再检查升级。";
            _messageSeverity = Severity.Warning;
            return;
        }

        _busy = true;
        _message = "正在检查数据库升级脚本...";
        _messageSeverity = Severity.Info;
        _executeMessage = null;
        _executeResult = null;
        _compareExecuteResult = null;
        _currentTask = null;
        _currentTaskId = null;

        try
        {
            if (IsSqlFileMode)
            {
                await inj_databaseUpgradeService.CheckSqlFileAsync(_selectedConnectionName, _sqlFilePath ?? "", CancellationToken);
                _checkResult = null;
                _sqlFileChecked = true;
                _checkedConnectionName = _selectedConnectionName;
                _checkedSqlFilePath = _sqlFilePath;
                _message = $"检查完成，SQL 文件可执行：{_sqlFilePath}";
                _messageSeverity = Severity.Success;
            }
            else if (IsCompareMode)
            {
                var request = BuildCompareRequest();
                _compareResult = await inj_databaseCompareService.CheckAsync(request, CancellationToken);
                _tableSyncSelections = _compareResult.Tables
                    .Select(table => new TableSyncSelection
                    {
                        Schema = table.Schema,
                        Table = table.Table,
                        FullName = table.FullName,
                        Mode = DatabaseCompareService.DataSyncModeUpsert
                    })
                    .ToList();
                _checkResult = null;
                _sqlFileChecked = false;
                _checkedConnectionName = _selectedConnectionName;
                _checkedCompareKey = BuildCompareKey();
                _message = _compareResult.Differences.Count == 0
                    ? "比对完成，没有发现结构差异。"
                    : $"比对完成，共 {_compareResult.Differences.Count} 个结构差异。";
                _messageSeverity = _compareResult.Differences.Any(item => item.IsDangerous) ? Severity.Warning : Severity.Success;
            }
            else
            {
                _checkResult = await inj_databaseUpgradeService.CheckAsync(_selectedConnectionName, CancellationToken);
                _sqlFileChecked = false;
                _checkedConnectionName = _selectedConnectionName;
                _checkedSqlFilePath = null;
                _message = $"检查完成，功能脚本 {_checkResult.LegacyScripts.Count} 个，优化脚本 {_checkResult.ManagedScripts.Count} 个。";
                _messageSeverity = Severity.Success;
            }
        }
        catch (Exception ex)
        {
            _checkResult = null;
            _compareResult = null;
            _sqlFileChecked = false;
            _checkedConnectionName = null;
            _checkedSqlFilePath = null;
            _checkedCompareKey = null;
            _message = $"检查失败：{ex.Message}";
            _messageSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExecuteUpgrade()
    {
        if (!CanExecute || string.IsNullOrWhiteSpace(_selectedConnectionName))
            return;

        var confirmed = await inj_dialogService.ShowMessageBox(
            "确认升级数据库",
            _skipBackup ? "将跳过自动备份，直接执行待升级内容。确认继续？" : "将先备份目标数据库，再执行待升级内容。确认继续？",
            yesText: "确认升级",
            cancelText: "取消");
        if (confirmed != true)
            return;

        _busy = true;
        _executeMessage = _skipBackup ? "正在升级数据库..." : "正在备份并升级数据库...";
        _executeMessageSeverity = Severity.Info;
        _executeResult = null;
        _compareExecuteResult = null;

        try
        {
            if (IsCompareMode)
            {
                var syncTables = _tableSyncSelections
                    .Where(table => table.Selected)
                    .Select(table => new DatabaseTableDataSyncRequest(table.Schema, table.Table, table.Mode))
                    .ToList();
                var request = BuildCompareRequest();
                _compareExecuteResult = await inj_databaseUpgradeService.RunExclusiveUpgradeOperationAsync(
                    request.TargetConnectionName,
                    () => inj_databaseCompareService.ExecuteAsync(request, syncTables, _skipBackup, CancellationToken),
                    CancellationToken);
                _executeResult = null;
            }
            else
            {
                _executeResult = IsSqlFileMode
                    ? await inj_databaseUpgradeService.ExecuteSqlFileAsync(_selectedConnectionName, _sqlFilePath ?? "", _pgDumpPath, _skipBackup, CancellationToken)
                    : await inj_databaseUpgradeService.ExecuteLegacyScriptsAsync(_selectedConnectionName, _pgDumpPath, _skipBackup, CancellationToken);
                _compareExecuteResult = null;
            }
            _confirmText = null;
            _executeMessage = "数据库升级完成。";
            _executeMessageSeverity = Severity.Success;
            if (IsProjectScriptsMode)
            {
                _checkResult = await inj_databaseUpgradeService.CheckAsync(_selectedConnectionName, CancellationToken);
            }
        }
        catch (Exception ex)
        {
            _executeMessage = $"升级失败：{ex.Message}";
            _executeMessageSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnSqlFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _busy = true;
        _message = "正在上传 SQL 文件...";
        _messageSeverity = Severity.Info;
        _executeMessage = null;
        _sqlFileChecked = false;
        _checkedSqlFilePath = null;
        _executeResult = null;
        _compareExecuteResult = null;

        try
        {
            await using var stream = file.OpenReadStream(DatabaseUpgradeService.MaxSqlFileUploadBytes, CancellationToken);
            _sqlFilePath = await inj_databaseUpgradeService.SaveSqlFileAsync(file.Name, stream, CancellationToken);
            _uploadedSqlFileName = $"{file.Name}（{FormatBytes(file.Size)}）";
            _message = "SQL 文件已上传，请先检查升级。";
            _messageSeverity = Severity.Success;
        }
        catch (Exception ex)
        {
            _message = $"上传失败：{ex.Message}";
            _messageSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }

