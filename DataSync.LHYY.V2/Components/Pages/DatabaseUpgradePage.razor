    private DatabaseCompareRequest BuildCompareRequest() =>
        new(
            _selectedConnectionName ?? "",
            _compareSourceMode,
            _sourceConnectionName,
            _sourceSqlFilePath,
            _schemasText,
            _pgDumpPath,
            _includeDrop);

    private string BuildCompareKey() =>
        string.Join("|",
            _selectedConnectionName,
            _compareSourceMode,
            _sourceConnectionName,
            _sourceSqlFilePath,
            _schemasText,
            _pgDumpPath,
            _includeDrop);

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024d / 1024d:0.##} MB";

        if (bytes >= 1024)
            return $"{bytes / 1024d:0.##} KB";

        return $"{bytes} B";
    }

    private int CountManagedScripts(DatabaseUpgradeScriptStatus status) =>
        _checkResult?.ManagedScripts.Count(script => script.Status == status) ?? 0;

    private static Color GetScriptStatusColor(DatabaseUpgradeScriptStatus status) =>
        status switch
        {
            DatabaseUpgradeScriptStatus.Executed => Color.Success,
            DatabaseUpgradeScriptStatus.Pending => Color.Warning,
            _ => Color.Default
        };

    private static Severity GetTaskSeverity(DatabaseUpgradeTaskStatus status) =>
        status switch
        {
            DatabaseUpgradeTaskStatus.Succeeded => Severity.Success,
            DatabaseUpgradeTaskStatus.Failed => Severity.Error,
            _ => Severity.Info
        };

    private static string GetTaskLogLevelClass(string level) =>
        level switch
        {
            "Success" => "is-success",
            "Error" => "is-error",
            _ => "is-info"
        };

    private async Task StartManagedScriptTask(DatabaseUpgradeScriptItem script)
    {
        if (_busy
            || IsTaskRunning
            || !IsConfirmTextValid
            || string.IsNullOrWhiteSpace(_selectedConnectionName)
            || script.Status != DatabaseUpgradeScriptStatus.Pending)
            return;

        var confirmed = await inj_dialogService.ShowMessageBox(
            "确认执行脚本",
            _skipBackup
                ? $"将跳过自动备份，直接执行脚本：{script.ScriptName}。确认继续？"
                : $"将先备份目标数据库，再执行脚本：{script.ScriptName}。确认继续？",
            yesText: "确认执行",
            cancelText: "取消");
        if (confirmed != true)
            return;

        _busy = true;
        _executeMessage = $"已提交后台任务：{script.ScriptName}";
        _executeMessageSeverity = Severity.Info;
        _executeResult = null;
        _compareExecuteResult = null;

        try
        {
            _currentTask = await inj_databaseUpgradeService.StartManagedScriptTaskAsync(
                _selectedConnectionName,
                script.ScriptKey,
                _pgDumpPath,
                _skipBackup,
                CancellationToken);
            _currentTaskId = _currentTask.TaskId;
            _confirmText = null;
            _ = PollCurrentTaskAsync(_currentTask.TaskId);
        }
        catch (Exception ex)
        {
            _executeMessage = $"提交后台任务失败：{ex.Message}";
            _executeMessageSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PollCurrentTaskAsync(Guid taskId)
    {
        try
        {
            while (!CancellationToken.IsCancellationRequested)
            {
                await Task.Delay(1500, CancellationToken);
                var snapshot = inj_databaseUpgradeService.GetTaskSnapshot(taskId);
                if (snapshot is null)
                    return;

                await InvokeAsync(async () =>
                {
                    _currentTask = snapshot;
                    if (snapshot.IsTerminal)
                    {
                        _executeMessage = snapshot.Status == DatabaseUpgradeTaskStatus.Succeeded
                            ? "后台升级任务完成。"
                            : $"后台升级任务失败：{snapshot.ErrorMessage}";
                        _executeMessageSeverity = snapshot.Status == DatabaseUpgradeTaskStatus.Succeeded
                            ? Severity.Success
                            : Severity.Error;

                        if (!string.IsNullOrWhiteSpace(snapshot.ConnectionName))
                        {
                            _selectedConnectionName = snapshot.ConnectionName;
                            _checkedConnectionName = snapshot.ConnectionName;
                            _checkResult = await inj_databaseUpgradeService.CheckAsync(snapshot.ConnectionName, CancellationToken);
                        }
                    }

                    StateHasChanged();
                });

                if (snapshot.IsTerminal)
                    return;
            }
        }
        catch (OperationCanceledException) when (CancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _executeMessage = $"后台任务轮询失败：{ex.Message}";
                _executeMessageSeverity = Severity.Error;
                StateHasChanged();
            });
        }
    }

    private async Task MarkScriptStatus(DatabaseUpgradeScriptItem script, DatabaseUpgradeScriptStatus status)
    {
        if (_busy || IsTaskRunning || string.IsNullOrWhiteSpace(_selectedConnectionName) || !IsConfirmTextValid)
            return;

        var targetStatusText = status == DatabaseUpgradeScriptStatus.Executed ? "已执行" : "未执行";
        var confirmed = await inj_dialogService.ShowMessageBox(
            "确认标记脚本状态",
            $"只修改本地升级状态，不执行 SQL。确定将「{script.ScriptName}」标记为「{targetStatusText}」？",
            yesText: "确认标记",
            cancelText: "取消");
        if (confirmed != true)
            return;

        _busy = true;
        _executeMessage = $"正在标记脚本状态：{script.ScriptName}";
        _executeMessageSeverity = Severity.Info;

        try
        {
            await inj_databaseUpgradeService.MarkScriptStatusAsync(_selectedConnectionName, script.ScriptKey, status, CancellationToken);
            _confirmText = null;
            _executeMessage = "脚本状态已更新。";
            _executeMessageSeverity = Severity.Success;
            _checkResult = await inj_databaseUpgradeService.CheckAsync(_selectedConnectionName, CancellationToken);
        }
        catch (Exception ex)
        {
            _executeMessage = $"标记失败：{ex.Message}";
            _executeMessageSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class TableSyncSelection
    {
        public string Schema { get; set; } = "";
        public string Table { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Mode { get; set; } = DatabaseCompareService.DataSyncModeUpsert;
        public bool Selected { get; set; }
    }
}
