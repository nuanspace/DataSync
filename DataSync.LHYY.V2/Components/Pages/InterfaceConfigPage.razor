            MissingEventIdentityPolicy = item.MissingEventIdentityPolicy,
            SoapEnabled = item.SoapEnabled,
            SoapServiceCode = string.IsNullOrWhiteSpace(item.SoapServiceCode) ? "bioo" : item.SoapServiceCode,
