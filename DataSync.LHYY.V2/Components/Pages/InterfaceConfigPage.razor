@page "/config/interfaces"
@inherits BasePage
@using Newtonsoft.Json.Linq

<PageTitle>接口配置 - LHYY V2</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">接口配置</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="AddNew" Class="mb-4">新增接口</MudButton>
<MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.FolderOpen"
           OnClick="@(() => _projectDocumentsVisible = true)" Class="mb-4 ml-2">项目文档</MudButton>
@if (_llmAvailable)
{
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AutoAwesome"
               OnClick="@(() => _aiDialogVisible = true)" Class="mb-4 ml-2 llm-action-button">AI 新建</MudButton>
}

<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false" PanelClass="pt-3">
    <MudTabPanel Text="@EnabledTabText" Icon="@Icons.Material.Filled.CheckCircle">
        @InterfaceTable(_enabledItems, "暂无启用接口")
    </MudTabPanel>
    <MudTabPanel Text="@DisabledTabText" Icon="@Icons.Material.Filled.Cancel">
        @InterfaceTable(_disabledItems, "暂无未启用接口")
    </MudTabPanel>
</MudTabs>

@* AI 新建对话框 *@
<MudDialog @bind-Visible="_aiDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">AI 分析接口配置</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_aiSampleJson" Label="JSON 示例（必填）" Lines="12" Required="true"
                      Variant="Variant.Outlined" Placeholder="粘贴该接口的示例 JSON 数据..."
                      Disabled="_aiAnalyzing" />
        <MudTextField @bind-Value="_aiDocDescription" Label="接口文档描述（选填）" Lines="4" Class="mt-3"
                      Variant="Variant.Outlined" Placeholder="如：入院登记接口，用于接收 HIS 系统的入院通知..."
                      Disabled="_aiAnalyzing" />
        @if (_aiAnalyzing)
        {
            <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mt-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">正在分析 JSON 结构，请稍候...</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _aiDialogVisible = false)" Disabled="_aiAnalyzing">取消</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="RunAiAnalysis"
                   Disabled="_aiAnalyzing" StartIcon="@Icons.Material.Filled.AutoAwesome" Class="llm-action-button">开始分析</MudButton>
    </DialogActions>
</MudDialog>

<ProjectDocumentDialog Visible="_projectDocumentsVisible"
                       VisibleChanged="OnProjectDocumentsVisibleChanged"
                       IntegrationProjectCode="@CurrentIntegrationProjectCode"
                       IntegrationProjectName="@CurrentIntegrationProjectName"
                       AllowManage="false" />

@if (_dialogVisible)
{
    <div class="interface-config-modal-overlay">
        <div class="interface-config-modal" @onclick:stopPropagation="true">
            <div class="interface-config-modal-header">
                <MudText Typo="Typo.h6">@(_isNew ? "新增接口" : "编辑接口")</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               OnClick="@(() => _dialogVisible = false)"
                               Disabled="_saving"
                               Class="interface-config-modal-close" />
            </div>
            <div class="@(_hasSampleJson ? "interface-config-modal-body interface-config-modal-body-split" : "interface-config-modal-body")">
                @if (_editItem != null)
                {
                    <div class="@(_hasSampleJson ? "interface-config-dialog-body" : null)">
                        @if (_hasSampleJson)
                        {
                            <div class="interface-config-columns">
                                <div class="interface-config-col interface-config-col-json">
                                    <div class="interface-config-panel">
                                        <div class="interface-config-panel-header">
                                        @if (_pathPickTarget != PathPickTarget.None)
                                        {
                                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@GetPathPickPrompt()</MudAlert>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.subtitle2" Class="mb-2">点击右侧路径输入框，再点击下方节点填入</MudText>
                                        }
                                        </div>
                                        <div class="interface-config-surface interface-config-json-tree-shell">
                                            <div class="interface-config-json-tree-scroll-body">
                                            <JsonTreeViewer JsonText="@_editItem.SampleJson"
                                                            MaxNodesToRender="0"
                                                            MaxArrayItemsToRender="0"
                                                            ShowSearch="true"
                                                            UseArrayBrackets="true"
                                                            PreferFirstArrayItemAsRoot="true"
                                                            SelectedPath="@_selectedJsonTreePath"
                                                            SelectionVersion="@_selectedJsonTreeVersion"
                                                            OnPathSelected="OnSidePanelPathPicked" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="interface-config-col interface-config-col-form">
                                    <div class="interface-config-surface interface-config-panel interface-config-form-panel">
                                        @EditFormContent
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @EditFormContent
                        }
                    </div>
                }
            </div>
            <div class="interface-config-modal-actions">
                <MudButton OnClick="@(() => _dialogVisible = false)" Disabled="_saving">取消</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">
                    @(_saving ? "保存中..." : "保存")
                </MudButton>
            </div>
        </div>
    </div>
}

<OcrFieldSelectorDialog Visible="_ocrFieldSelectorVisible"
                        VisibleChanged="value => _ocrFieldSelectorVisible = value"
                        PreviewResult="_ocrPreviewResult"
                        ExtractionRules="_editOcrExtractionRules"
                        ExtractionRulesChanged="OnOcrExtractionRulesChanged"
                        Loading="_ocrPreviewing"
                        HasMorePages="_ocrPreviewHasMorePages"
                        LoadError="@_ocrPreviewLoadError"
                        Testing="_ocrPreviewTesting"
                        FieldsTested="_ocrPreviewFieldsTested"
                        TestError="@_ocrPreviewTestError"
                        Saving="_saving"
                        OnLoadMore="LoadMoreOcrPreviewPagesAsync"
                        OnTestFields="TestOcrPreviewFieldsAsync"
                        OnSave="SaveFromOcrPreviewAsync" />

<OcrExtractionRulesDialog Visible="_ocrRulesDialogVisible"
                          VisibleChanged="value => _ocrRulesDialogVisible = value"
                          Rules="_editOcrExtractionRules"
                          AddInitialField="_ocrRulesDialogAddInitialField"
                          FocusedIndex="_ocrRulesDialogFocusedIndex"
                          OnApply="OnOcrProfileExtractionRulesChanged" />

<MudDialog @bind-Visible="_soapDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">配置 WebService</MudText>
    </TitleContent>
    <DialogContent>
        @if (_soapEditItem != null)
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_soapEditItem.TranCode" Label="接口代码" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@_soapEditItem.TranName" Label="接口名称" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_soapEditItem.SoapEnabled" Label="开放 SOAP 1.1 WebService" Color="Color.Primary" />
                </MudItem>
                @if (_soapEditItem.SoapEnabled)
                {
                    @if (!_soapEditItem.IsEnabled)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Dense="true">当前接口已停用，WebService 配置保存后不会对外生效。</MudAlert>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_soapEditItem.SoapServiceCode" Label="服务代码" Required="true"
                                      MaxLength="100" Placeholder="bioo" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_soapEditItem.SoapOperation" Label="操作名" MaxLength="100"
                                      Placeholder="默认使用接口代码" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_soapEditItem.SoapAction" Label="SOAPAction" MaxLength="500"
                                      Placeholder="留空时自动生成" />
                    </MudItem>
                    @if (!string.IsNullOrWhiteSpace(_soapEditItem.SoapServiceCode))
                    {
                        <MudItem xs="12">
                            <MudTextField Value="@GetSoapEndpoint(_soapEditItem)" Label="服务地址" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Value="@GetSoapWsdl(_soapEditItem)" Label="WSDL 地址" ReadOnly="true" />
                        </MudItem>
                    }
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _soapDialogVisible = false)" Disabled="_soapSaving">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveSoapConfigAsync" Disabled="_soapSaving">
            @(_soapSaving ? "保存中..." : "保存")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ConfigService ConfigSvc { get; set; } = default!;
    [Inject] private BioCoreIntegrationService BioCoreService { get; set; } = default!;
    [Inject] private LlmService LlmService { get; set; } = default!;
    [Inject] private MessageQueryService MessageQuerySvc { get; set; } = default!;
    [Inject] private SoapWebServiceService SoapWebServiceSvc { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "createFromMessageId")] public long? QueryCreateFromMessageId { get; set; }
    [SupplyParameterFromQuery(Name = "ocrSampleMessageId")] public long? QueryOcrSampleMessageId { get; set; }

    private List<EsbInterfaceConfig> _items = [];
    private List<EsbInterfaceConfig> _enabledItems = [];
    private List<EsbInterfaceConfig> _disabledItems = [];
    private EsbInterfaceConfig? _editItem;
    private EsbInterfaceConfig? _soapEditItem;
    private bool _loading = true;
    private bool _dialogVisible;
    private bool _soapDialogVisible;
    private bool _isNew;
    private bool _saving;
    private bool _soapSaving;
    private bool _statusChanging;
    private bool _projectDocumentsVisible;

    // 接口级过滤规则
    private List<EsbFilterRule> _editFilterRules = [];
    private List<EsbInterfaceMatchRule> _editMatchRules = [];
    private List<EsbIdempotentKeyPart> _editIdempotentKeyParts = [];
    private EsbOcrProfile _editOcrProfile = new();
    private List<OcrExtractionRule> _editOcrExtractionRules = [];
    private List<EsbMessageListItem> _ocrSampleMessages = [];
    private long? _selectedOcrSampleMessageId;
    private EsbMessage? _selectedOcrSampleMessage;
    private OcrDocumentResult? _ocrPreviewResult;
    private bool _ocrFieldSelectorVisible;
    private bool _ocrSamplesLoading;
    private bool _ocrPreviewing;
    private bool _ocrPreviewHasMorePages;
    private string? _ocrPreviewLoadError;
    private bool _ocrPreviewTesting;
    private bool _ocrPreviewFieldsTested;
    private string? _ocrPreviewTestError;
    private long _ocrPreviewElapsedMs;
    private string? _ocrPreviewTestRuleSignature;
    private long? _ocrPreviewTestSampleMessageId;
    private string? _ocrTemplateRuleSignature;
    private long? _ocrTemplateSampleMessageId;
    private bool _ocrRulesDialogVisible;
    private bool _ocrRulesDialogAddInitialField;
    private int? _ocrRulesDialogFocusedIndex;

    // 可用的自定义处理器类名
    private List<string> _availableHandlers = [];

    // 事件类型下拉数据
    private List<string> _eventTypes = [];

    // 全局默认 LicenseCode
    private string? _defaultLicenseCode;

    // AI 新建相关
    private bool _llmAvailable;
    private bool _aiDialogVisible;
    private string _aiSampleJson = "";
    private string _aiDocDescription = "";
    private bool _aiAnalyzing;
    private bool _openWizardAfterCreateFromMessageSave;

    // 路径选取目标枚举（与 MappingEditDialog 模式一致）
    private enum PathPickTarget { None, Mrn, EventTime, VisitNo, InpatientNo, CombinedVisitIdentity, SourceMessageId, MainRecordArray, OcrSource, FilterRule, MatchRule, IdempotentKeyPart }
    private enum EventIdentityModeOption
    {
        RequireEventTime,
        LookupThenFail,
        LookupThenDegradeToPatientOnly,
        LookupThenPending
    }

    private PathPickTarget _pathPickTarget = PathPickTarget.None;
    private int _pickFilterRuleIndex = -1;
    private int _pickMatchRuleIndex = -1;
    private int _pickIdempotentKeyPartIndex = -1;
    private EventCallback<int> _filterRulePathPickCallback;
    private EventCallback<int> _matchRulePathPickCallback;
    private EventCallback<int> _idempotentKeyPartPathPickCallback;
    private string? _selectedJsonTreePath;
    private int _selectedJsonTreeVersion;
    private bool _advancedExpanded;
    private bool _ocrExpanded;
    private bool _dedupeExpanded;
    private bool _webServiceExpanded;
    private bool _recognitionExpanded;
    private bool _filterExpanded;

    // 当前编辑项是否有 SampleJson
    private bool _hasSampleJson => !string.IsNullOrWhiteSpace(_editItem?.SampleJson);
    private bool _supportsEventIdentity => _editItem != null
        && (RequiresEventStartTimePath(_editItem.HandlerType) || _isOcrHandler);
    private bool _showVisitIdentityFields => _supportsEventIdentity;
    private bool _isMrnPathRequired => _editItem?.HandlerType != HandlerType.GenericQuestionWriteBack &&
                                       (_editItem?.HandlerType != HandlerType.Generic ||
                                        string.IsNullOrWhiteSpace(_editItem.CombinedVisitIdentitySourcePath));
    private bool _isOcrHandler => OcrProfileService.IsOcrHandler(_editItem);
    private string EnabledTabText => $"启用接口 ({_enabledItems.Count})";
    private string DisabledTabText => $"未启用接口 ({_disabledItems.Count})";

    private ReceiveMode SelectedReceiveMode
    {
        get => _editItem?.ReceiveMode ?? ReceiveMode.PersistAndAsync;
        set
        {
            if (_editItem == null)
                return;

            _editItem.ReceiveMode = value;
            if (value == ReceiveMode.Direct && SelectedEventIdentityMode == EventIdentityModeOption.LookupThenPending)
                SelectedEventIdentityMode = EventIdentityModeOption.LookupThenFail;
        }
    }

    private EventIdentityModeOption SelectedEventIdentityMode
    {
        get
        {
            if (_editItem == null)
                return EventIdentityModeOption.RequireEventTime;

            if (!_editItem.AllowMissingEventTime)
                return EventIdentityModeOption.RequireEventTime;

            if (_editItem.HandlerType == HandlerType.GenericQuestionWriteBack &&
                _editItem.MissingEventIdentityPolicy == MissingEventIdentityPolicy.DegradeToPatientOnly)
            {
                return EventIdentityModeOption.LookupThenFail;
            }

            return _editItem.MissingEventIdentityPolicy switch
            {
                MissingEventIdentityPolicy.DegradeToPatientOnly => EventIdentityModeOption.LookupThenDegradeToPatientOnly,
                MissingEventIdentityPolicy.Pending => EventIdentityModeOption.LookupThenPending,
                _ => EventIdentityModeOption.LookupThenFail
            };
        }
        set
        {
            if (_editItem == null)
                return;

            switch (value)
            {
                case EventIdentityModeOption.RequireEventTime:
                    _editItem.AllowMissingEventTime = false;
                    _editItem.MissingEventIdentityPolicy = MissingEventIdentityPolicy.Fail;
                    break;
                case EventIdentityModeOption.LookupThenFail:
                    _editItem.AllowMissingEventTime = true;
                    _editItem.MissingEventIdentityPolicy = MissingEventIdentityPolicy.Fail;
                    break;
                case EventIdentityModeOption.LookupThenDegradeToPatientOnly:
                    _editItem.AllowMissingEventTime = true;
                    _editItem.MissingEventIdentityPolicy = MissingEventIdentityPolicy.DegradeToPatientOnly;
                    break;
                case EventIdentityModeOption.LookupThenPending:
                    _editItem.AllowMissingEventTime = true;
                    _editItem.MissingEventIdentityPolicy = MissingEventIdentityPolicy.Pending;
                    break;
            }
        }
    }

    private Task OnProjectDocumentsVisibleChanged(bool visible)
    {
        _projectDocumentsVisible = visible;
        return Task.CompletedTask;
    }

    private void PrepareDialogLayout(bool hasExistingAdvancedConfig = false)
    {
        _advancedExpanded = false;
        _ocrExpanded = _isOcrHandler && (hasExistingAdvancedConfig || _editOcrExtractionRules.Count > 0);
        _dedupeExpanded = false;
        _webServiceExpanded = _editItem?.SoapEnabled == true;
        _recognitionExpanded = hasExistingAdvancedConfig && _editMatchRules.Count > 0;
        _filterExpanded = hasExistingAdvancedConfig && _editFilterRules.Count > 0;
    }

    private void ActivatePathPickTarget(PathPickTarget target, int targetIndex = -1)
    {
        SetPathPickTarget(target, targetIndex);
    }

    private string GetPathPickPrompt()
        => _pathPickTarget switch
        {
            PathPickTarget.Mrn => "当前正在为病案号路径选取节点。",
            PathPickTarget.EventTime => "当前正在为事件开始时间路径选取节点。",
            PathPickTarget.VisitNo => "当前正在为住院次数路径选取节点。",
            PathPickTarget.InpatientNo => "当前正在为就诊号/住院号路径选取节点。",
            PathPickTarget.CombinedVisitIdentity => "当前正在为病案号+住院次数组合标识路径选取节点。",
            PathPickTarget.SourceMessageId => "当前正在为上游消息号路径选取节点。",
            PathPickTarget.MainRecordArray => "当前正在为主记录数组路径选取节点，请尽量点击数组节点。",
            PathPickTarget.OcrSource => "当前正在为 OCR 的 PDF 来源路径选取节点。",
            PathPickTarget.FilterRule => $"当前正在为过滤规则 #{_pickFilterRuleIndex + 1} 选取源路径。",
            PathPickTarget.MatchRule => $"当前正在为识别规则 #{_pickMatchRuleIndex + 1} 选取源路径。",
            PathPickTarget.IdempotentKeyPart => $"当前正在为幂等键片段 #{_pickIdempotentKeyPartIndex + 1} 选取源路径。",
            _ => "当前未选择路径目标。"
        };

    private RenderFragment InterfaceTable(List<EsbInterfaceConfig> items, string emptyText) => __builder =>
    {
        <MudTable Items="@items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="_loading">
            <HeaderContent>
                <MudTh>排序</MudTh>
                <MudTh>事件代码</MudTh>
                <MudTh>事件名称</MudTh>
                <MudTh>启用</MudTh>
                <MudTh>处理器</MudTh>
                <MudTh>事件类型</MudTh>
                <MudTh>WebService</MudTh>
                <MudTh>服务/操作</MudTh>
                <MudTh>SOAPAction</MudTh>
                <MudTh>服务地址</MudTh>
                <MudTh>说明</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.SortOrder</MudTd>
                <MudTd><MudText Typo="Typo.body2"><b>@context.TranCode</b></MudText></MudTd>
                <MudTd>@context.TranName</MudTd>
                <MudTd>
                    <MudTooltip Text="@(context.IsEnabled ? "停用接口" : "启用接口")">
                        <MudIconButton Icon="@(context.IsEnabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                       Size="Size.Small"
                                       Color="@(context.IsEnabled ? Color.Success : Color.Default)"
                                       Disabled="@_statusChanging"
                                       OnClick="@(() => ToggleEnabled(context))" />
                    </MudTooltip>
                </MudTd>
                <MudTd>@GetHandlerTypeDisplayName(context.HandlerType)</MudTd>
                <MudTd>@context.EventTypeName</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.SoapEnabled ? Color.Info : Color.Default)">
                        @(context.SoapEnabled ? "已开放" : "未开放")
                    </MudChip>
                </MudTd>
                <MudTd>
                    @if (context.SoapEnabled)
                    {
                        <MudText Typo="Typo.body2">@context.SoapServiceCode</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.SoapOperation</MudText>
                    }
                </MudTd>
                <MudTd Style="max-width:240px;overflow:hidden;text-overflow:ellipsis;">@context.SoapAction</MudTd>
                <MudTd Style="max-width:260px;overflow:hidden;text-overflow:ellipsis;">
                    @(context.SoapEnabled ? GetSoapEndpoint(context) : "")
                </MudTd>
                <MudTd Style="max-width:200px;overflow:hidden;text-overflow:ellipsis;">@context.Description</MudTd>
                <MudTd Class="interface-config-row-actions">
                    <MudTooltip Text="映射引导">
                        <MudIconButton Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Small" Color="Color.Secondary"
                                       OnClick="@(() => inj_navigationManager.NavigateTo($"/config/wizard?tranCode={context.TranCode}"))" />
                    </MudTooltip>
                    <MudTooltip Text="WebService配置">
                        <MudIconButton Icon="@Icons.Material.Filled.SettingsInputComponent" Size="Size.Small" Color="Color.Info"
                                       OnClick="@(() => OpenSoapConfig(context))" />
                    </MudTooltip>
                    @if (context.SoapEnabled && !string.IsNullOrWhiteSpace(context.SoapServiceCode))
                    {
                        <MudTooltip Text="打开 WSDL">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Info"
                                           Href="@GetSoapWsdl(context)" Target="_blank" />
                        </MudTooltip>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => Delete(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@emptyText</MudText>
            </NoRecordsContent>
        </MudTable>
    };

    /// <summary>表单内容（SidePanel 和普通两种布局复用）</summary>
    private RenderFragment EditFormContent => __builder =>
    {
        <MudGrid Class="interface-config-form">
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="mb-1">核心配置</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="interface-config-caption">
                    先填写能让接口接收、识别患者并定位事件的最少字段；其余配置按需展开。
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editItem!.TranCode" Label="事件代码" Required="true"
                              Disabled="!_isNew" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_editItem!.TranName" Label="事件名称" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="HandlerType" @bind-Value="SelectedHandlerType" Label="处理器类型"
                           HelperText="大多数接口使用 Generic；只有真正特殊逻辑才切到 Custom。">
                    <MudSelectItem Value="HandlerType.Generic">Generic</MudSelectItem>
                    <MudSelectItem Value="HandlerType.GenericQuestionWriteBack">GenericQuestionWriteBack</MudSelectItem>
                    <MudSelectItem Value="HandlerType.Custom">Custom</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="ReceiveMode" @bind-Value="SelectedReceiveMode" Label="接收方式"
                           Disabled="_isOcrHandler" HelperText="@GetReceiveModeHelperText()">
                    <MudSelectItem Value="ReceiveMode.PersistAndAsync">入队异步处理</MudSelectItem>
                    <MudSelectItem Value="ReceiveMode.Direct">直接处理</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_editItem!.HandlerType == HandlerType.Custom)
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="SelectedHandlerName" Label="处理器类名" Clearable="true"
                               HelperText="选择已实现 IMessageHandler 的处理器类">
                        @foreach (var name in _availableHandlers)
                        {
                            <MudSelectItem Value="@name">@name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_editItem!.EventTypeName" Label="事件类型" Clearable="true"
                           Disabled="@(string.IsNullOrEmpty(_defaultLicenseCode))">
                    @foreach (var et in _eventTypes)
                    {
                        <MudSelectItem Value="@et">@et</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                @if (_hasSampleJson)
                {
