    private async Task SyncFilterRulesAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var oldRules = await db.EsbFilterRules
            .Where(r => r.TranCode == tranCode && r.MappingId == null && r.IntegrationProjectCode == integrationProjectCode)
            .ToListAsync();
        db.EsbFilterRules.RemoveRange(oldRules);

        foreach (var (rule, index) in _editFilterRules.Select((r, i) => (r, i)))
        {
            db.EsbFilterRules.Add(new EsbFilterRule
            {
                TranCode = tranCode,
                SourcePath = rule.SourcePath,
                RuleGroup = Math.Max(1, rule.RuleGroup),
                Operator = rule.Operator,
                CompareValue = rule.CompareValue,
                MappingId = null,
                FilterScope = rule.FilterScope,
                IsEnabled = rule.IsEnabled,
                SortOrder = index,
                Description = rule.Description,
                IntegrationProjectCode = integrationProjectCode,
            });
        }

        await db.SaveChangesAsync();
    }

    private async Task SyncMatchRulesAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var oldRules = await db.EsbInterfaceMatchRules
            .Where(r => r.TranCode == tranCode && r.IntegrationProjectCode == integrationProjectCode)
            .ToListAsync();
        db.EsbInterfaceMatchRules.RemoveRange(oldRules);

        foreach (var (rule, index) in _editMatchRules.Select((r, i) => (r, i)))
        {
            db.EsbInterfaceMatchRules.Add(new EsbInterfaceMatchRule
            {
                TranCode = tranCode,
                MatchGroup = rule.MatchGroup <= 0 ? 1 : rule.MatchGroup,
                SourcePath = rule.SourcePath,
                Operator = string.IsNullOrWhiteSpace(rule.Operator) ? "eq" : rule.Operator,
                CompareValue = rule.CompareValue ?? "",
                IsEnabled = rule.IsEnabled,
                SortOrder = index,
                Description = rule.Description,
                IntegrationProjectCode = integrationProjectCode,
            });
        }

        await db.SaveChangesAsync();
    }

    private async Task SyncIdempotentKeyPartsAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var oldParts = await db.EsbIdempotentKeyParts
            .Where(p => p.TranCode == tranCode && p.IntegrationProjectCode == integrationProjectCode)
            .ToListAsync();
        db.EsbIdempotentKeyParts.RemoveRange(oldParts);

        foreach (var (part, index) in _editIdempotentKeyParts.Select((p, i) => (p, i)))
        {
            db.EsbIdempotentKeyParts.Add(new EsbIdempotentKeyPart
            {
                TranCode = tranCode,
                SourcePath = part.SourcePath,
                LiteralValue = part.LiteralValue,
                DefaultValue = part.DefaultValue,
                SortOrder = index,
                IsEnabled = part.IsEnabled,
                Description = part.Description,
                IntegrationProjectCode = integrationProjectCode,
            });
        }

        await db.SaveChangesAsync();
    }

    private async Task SyncOcrProfileAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var profile = _editOcrProfile.Id > 0
            ? await db.EsbOcrProfiles.FindAsync(_editOcrProfile.Id)
            : await db.EsbOcrProfiles
                .Where(item => item.TranCode == tranCode && item.IntegrationProjectCode == integrationProjectCode)
                .OrderBy(item => item.Id)
                .FirstOrDefaultAsync();

        if (profile == null)
        {
            profile = new EsbOcrProfile
            {
                CreatedAt = DateTime.Now
            };
            db.EsbOcrProfiles.Add(profile);
        }

        profile.TranCode = tranCode;
        profile.IntegrationProjectCode = integrationProjectCode;
        profile.ProfileName = _editOcrProfile.ProfileName;
        profile.IsEnabled = _editOcrProfile.IsEnabled;
        profile.SourceKind = _editOcrProfile.SourceKind;
        profile.SourcePath = _editOcrProfile.SourcePath;
        profile.Language = _editOcrProfile.Language;
        profile.Dpi = _editOcrProfile.Dpi;
        profile.PageSegMode = _editOcrProfile.PageSegMode;
        profile.MaxPages = _editOcrProfile.MaxPages;
        profile.MaxInputBytes = _editOcrProfile.MaxInputBytes;
        profile.TimeoutSeconds = _editOcrProfile.TimeoutSeconds;
        profile.KeepWorkFiles = _editOcrProfile.KeepWorkFiles;
        profile.AllowedFileRoots = _editOcrProfile.AllowedFileRoots;
        profile.OutputJsonPath = _editOcrProfile.OutputJsonPath;
        profile.ExtractionRules = _editOcrProfile.ExtractionRules;
        profile.SampleMessageId = _editOcrProfile.SampleMessageId;
        profile.Description = _editOcrProfile.Description;
        profile.UpdatedAt = DateTime.Now;

        await db.SaveChangesAsync();
        _editOcrProfile.Id = profile.Id;
    }

    private async Task Delete(EsbInterfaceConfig item)
    {
        var confirmed = await inj_dialogService.ShowMessageBox("确认删除",
            $"确定要删除接口 {item.TranCode} - {item.TranName} 吗？", yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var entity = await db.EsbInterfaceConfigs.FindAsync(item.Id);
            if (entity != null)
            {
                var oldFilterRules = await db.EsbFilterRules
                    .Where(r => r.TranCode == item.TranCode && r.MappingId == null && r.IntegrationProjectCode == item.IntegrationProjectCode)
                    .ToListAsync();
                var oldMatchRules = await db.EsbInterfaceMatchRules
                    .Where(r => r.TranCode == item.TranCode && r.IntegrationProjectCode == item.IntegrationProjectCode)
                    .ToListAsync();
                var oldIdempotentParts = await db.EsbIdempotentKeyParts
                    .Where(p => p.TranCode == item.TranCode && p.IntegrationProjectCode == item.IntegrationProjectCode)
                    .ToListAsync();

                db.EsbFilterRules.RemoveRange(oldFilterRules);
                db.EsbInterfaceMatchRules.RemoveRange(oldMatchRules);
                db.EsbIdempotentKeyParts.RemoveRange(oldIdempotentParts);
                db.EsbInterfaceConfigs.Remove(entity);
                await db.SaveChangesAsync();
                ConfigSvc.ClearCache();
                inj_snackbar.Add("删除成功", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleEnabled(EsbInterfaceConfig item)
    {
        if (_statusChanging)
            return;

        _statusChanging = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var entity = await db.EsbInterfaceConfigs.FindAsync(item.Id);
            if (entity == null)
            {
                inj_snackbar.Add("接口配置不存在", Severity.Warning);
                return;
            }

            var nextEnabled = !entity.IsEnabled;
            if (nextEnabled)
            {
                var errors = ConfigSvc.ValidateInterfaceConfig(entity);
                if (OcrProfileService.IsOcrHandler(entity))
                    errors.AddRange(await ValidateStoredOcrProfileAsync(db, entity));

                if (errors.Count > 0)
                {
                    foreach (var err in errors)
                        inj_snackbar.Add(err, Severity.Error);
                    return;
                }
            }

            entity.IsEnabled = nextEnabled;
            await db.SaveChangesAsync();
            ConfigSvc.ClearCache();
            inj_snackbar.Add(nextEnabled ? "接口已启用" : "接口已停用", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"状态切换失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _statusChanging = false;
        }
    }

    private static async Task<List<string>> ValidateStoredOcrProfileAsync(
        DataSyncDbContext db,
        EsbInterfaceConfig config)
    {
        var profiles = await db.EsbOcrProfiles
            .AsNoTracking()
            .Where(profile => profile.IsEnabled
                && profile.TranCode == config.TranCode
                && (profile.IntegrationProjectCode == config.IntegrationProjectCode
                    || profile.IntegrationProjectCode == null))
            .OrderBy(profile => profile.Id)
            .ToListAsync();
        var profile = profiles.FirstOrDefault(item => string.Equals(
                item.IntegrationProjectCode,
                config.IntegrationProjectCode,
                StringComparison.OrdinalIgnoreCase))
            ?? profiles.FirstOrDefault(item => string.IsNullOrWhiteSpace(item.IntegrationProjectCode));
        if (profile == null)
            return ["未找到启用的 OCR 配置"];

        try
        {
            var rules = OcrProfileService.DeserializeExtractionRules(profile.ExtractionRules);
            return OcrProfileService.ValidateProfile(profile, rules).ToList();
        }
        catch (System.Text.Json.JsonException ex)
        {
            return [$"OCR 字段提取规则解析失败：{ex.Message}"];
        }
    }
