    protected override async Task OnPageInitializedAsync()
    {
        _availableHandlers = ConfigService.GetAvailableHandlerNames();
        _llmAvailable = await LlmService.IsAvailableAsync();

        // 获取当前项目默认 LicenseCode
        _defaultLicenseCode = await ConfigSvc.GetDefaultLicenseCodeAsync(CurrentIntegrationProjectCode);

        // 初始化事件类型下拉
        await LoadEventTypesAsync();

        // 初始化过滤规则路径选取回调
        _filterRulePathPickCallback = EventCallback.Factory.Create<int>(this, idx => ActivatePathPickTarget(PathPickTarget.FilterRule, idx));
        _matchRulePathPickCallback = EventCallback.Factory.Create<int>(this, idx => ActivatePathPickTarget(PathPickTarget.MatchRule, idx));
        _idempotentKeyPartPathPickCallback = EventCallback.Factory.Create<int>(this, idx => ActivatePathPickTarget(PathPickTarget.IdempotentKeyPart, idx));

        await LoadDataAsync();
        if (QueryOcrSampleMessageId.HasValue)
            await OpenOcrSampleFromQueryAsync();
        else
            await OpenCreateFromMessageAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var scopedItems = await ApplyCurrentProjectScope(db.EsbInterfaceConfigs)
                .OrderByDescending(c => c.IntegrationProjectCode == CurrentIntegrationProjectCode)
                .ThenBy(c => c.SortOrder)
                .ThenBy(c => c.TranCode)
                .ToListAsync();

            _items = SelectEffectiveProjectItems(scopedItems, item => item.TranCode, item => item.IntegrationProjectCode)
                .OrderBy(c => c.SortOrder)
                .ThenBy(c => c.TranCode)
                .ToList();
            _enabledItems = _items.Where(c => c.IsEnabled).ToList();
            _disabledItems = _items.Where(c => !c.IsEnabled).ToList();
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateFromMessageAsync()
    {
        if (!QueryCreateFromMessageId.HasValue)
            return;

        var message = await MessageQuerySvc.GetMessageByIdAsync(QueryCreateFromMessageId.Value);
        if (message == null)
        {
            inj_snackbar.Add("消息不存在，无法创建接口配置", Severity.Warning);
            return;
        }

        if (!MessageJsonHelper.TryParseToken(message.RawJson, out var sampleToken, out var error))
        {
            inj_snackbar.Add(error ?? "消息 RawJson 无效，无法创建接口配置", Severity.Warning);
            return;
        }

        var existing = _items.FirstOrDefault(item =>
            string.Equals(item.TranCode, message.TranCode, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
        {
            inj_snackbar.Add("接口配置已存在，可直接进入工作台配置", Severity.Info);
            inj_navigationManager.NavigateTo($"/config/wizard?messageId={QueryCreateFromMessageId.Value}");
            return;
        }

        _editItem = new EsbInterfaceConfig
        {
            IsEnabled = true,
            ReceiveMode = ReceiveMode.PersistAndAsync,
            TranCode = Truncate(message.TranCode, 20),
            TranName = Truncate(message.TranName, 100),
            SampleJson = sampleToken.ToString(Newtonsoft.Json.Formatting.Indented),
            IntegrationProjectCode = CurrentIntegrationProjectCode,
            SortOrder = GetNextSortOrder(),
        };
        _editFilterRules = [];
        _editMatchRules = [];
        _editIdempotentKeyParts = [];
        ResetOcrProfile(_editItem.TranCode, _editItem.IntegrationProjectCode);
        ResetPathPickState();
        PrepareDialogLayout();
        _isNew = true;
        _dialogVisible = true;
        _openWizardAfterCreateFromMessageSave = true;
        await LoadEventTypesAsync();
        inj_snackbar.Add("已根据当前消息创建接口配置草稿，保存后才会写入数据库", Severity.Info);
    }

