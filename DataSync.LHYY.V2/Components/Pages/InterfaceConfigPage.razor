    private async Task LoadOcrProfileAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var profiles = await db.EsbOcrProfiles
            .AsNoTracking()
            .Where(profile => profile.TranCode == tranCode
                && (profile.IntegrationProjectCode == integrationProjectCode || profile.IntegrationProjectCode == null))
            .OrderBy(profile => profile.Id)
            .ToListAsync();

        var profile = profiles.FirstOrDefault(item =>
                string.Equals(item.IntegrationProjectCode, integrationProjectCode, StringComparison.OrdinalIgnoreCase))
            ?? profiles.FirstOrDefault(item => string.IsNullOrWhiteSpace(item.IntegrationProjectCode));

        if (profile == null)
        {
            ResetOcrProfile(tranCode, integrationProjectCode);
            return;
        }

        var isProjectProfile = string.Equals(
            profile.IntegrationProjectCode,
            integrationProjectCode,
            StringComparison.OrdinalIgnoreCase);
        _editOcrProfile = CopyOcrProfile(profile, isProjectProfile ? profile.Id : 0, integrationProjectCode);
        _selectedOcrSampleMessageId = _editOcrProfile.SampleMessageId;

        try
        {
            _editOcrExtractionRules = OcrProfileService.DeserializeExtractionRules(profile.ExtractionRules);
        }
        catch (System.Text.Json.JsonException ex)
        {
            _editOcrExtractionRules = [];
            inj_snackbar.Add($"OCR 字段提取规则解析失败: {ex.Message}", Severity.Error);
        }

        _ocrTemplateRuleSignature = BuildOcrRuleValueSignature(_editOcrExtractionRules);
        _ocrTemplateSampleMessageId = _editOcrProfile.SampleMessageId;
    }

