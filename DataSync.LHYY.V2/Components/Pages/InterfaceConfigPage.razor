    private void PrepareOcrExtractionRules()
    {
        foreach (var rule in _editOcrExtractionRules)
        {
            rule.FieldCode = rule.FieldCode.Trim();
            rule.SourceFieldName = string.IsNullOrWhiteSpace(rule.SourceFieldName)
                ? null
                : rule.SourceFieldName.Trim();
            rule.SectionHeading = string.IsNullOrWhiteSpace(rule.SectionHeading)
                ? null
                : rule.SectionHeading.Trim();
            rule.Instruction = string.IsNullOrWhiteSpace(rule.Instruction) ? null : rule.Instruction.Trim();
        }
    }

    private void OnOcrExtractionRulesChanged(List<OcrExtractionRule> rules)
    {
        _editOcrExtractionRules = rules;
        PrepareOcrExtractionRules();
        var currentSignature = BuildOcrRuleValueSignature(_editOcrExtractionRules);
        if (_ocrPreviewFieldsTested
            && !string.Equals(_ocrPreviewTestRuleSignature, currentSignature, StringComparison.Ordinal))
        {
            _ocrPreviewFieldsTested = false;
            _ocrPreviewTestRuleSignature = null;
            _ocrPreviewTestSampleMessageId = null;
            _ocrPreviewResult?.ExtractedFields.Clear();
        }

        _ocrPreviewTestError = null;
        if (OcrExtractionRuleHelper.Validate(_editOcrExtractionRules).Count == 0)
            RebuildOcrSampleJson();
    }

    private void OnOcrProfileExtractionRulesChanged(List<OcrExtractionRule> rules)
    {
        _editOcrExtractionRules = rules;
        PrepareOcrExtractionRules();

        var currentSignature = BuildOcrRuleValueSignature(_editOcrExtractionRules);
        if (_ocrPreviewFieldsTested
            && !string.Equals(_ocrPreviewTestRuleSignature, currentSignature, StringComparison.Ordinal))
        {
            _ocrPreviewFieldsTested = false;
            _ocrPreviewTestRuleSignature = null;
            _ocrPreviewTestSampleMessageId = null;
            _ocrPreviewResult?.ExtractedFields.Clear();
        }

        _ocrPreviewTestError = null;
        if (OcrExtractionRuleHelper.Validate(_editOcrExtractionRules).Count == 0)
            RebuildOcrSampleJson();
    }

