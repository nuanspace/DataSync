    private static string? NormalizeJsonTreeSelectionPath(string? path)
    {
        var normalized = path?.Trim();
        if (string.IsNullOrWhiteSpace(normalized))
            return null;

        normalized = SubCardPathHelper.IsAbsoluteJsonPath(normalized)
            ? normalized[2..]
            : normalized;

        return SubCardPathHelper.NormalizeArrayPath(normalized);
    }

    private void SetJsonTreeSelection(string? path)
    {
        _selectedJsonTreePath = NormalizeJsonTreeSelectionPath(path);
        _selectedJsonTreeVersion++;
    }

    private JToken? GetSampleJsonRoot()
    {
        if (string.IsNullOrWhiteSpace(_editItem?.SampleJson))
            return null;

        try
        {
            return JToken.Parse(_editItem.SampleJson);
        }
        catch
        {
            return null;
        }
    }

    private string GetMainRecordArrayPath() =>
        SubCardPathHelper.NormalizeArrayContainerPath(_editItem?.MainRecordArrayPath);

    private JToken? GetConfiguredMainRecordContext()
    {
        var root = GetSampleJsonRoot();
        var mainRecordArrayPath = GetMainRecordArrayPath();
        if (root == null || string.IsNullOrWhiteSpace(mainRecordArrayPath))
            return null;

        return SubCardPathHelper.ResolveFirstSubCardContext(root, mainRecordArrayPath);
    }

    private string BuildScopedPath(string arrayPath, string sourcePath)
    {
        if (SubCardPathHelper.PathsEqual(arrayPath, "$"))
            return sourcePath;

        var root = GetSampleJsonRoot();
        if (root != null && SubCardPathHelper.ResolveSubCardContainer(root, arrayPath) is JObject)
            return $"{arrayPath}.{sourcePath}";

        return $"{arrayPath}[].{sourcePath}";
    }

    private bool TryBuildMainRecordScopedPath(string? sourcePath, out string scopedPath)
    {
        scopedPath = "";
        var normalizedSource = sourcePath?.Trim() ?? "";
        var mainRecordArrayPath = GetMainRecordArrayPath();
        var mainRecordContext = GetConfiguredMainRecordContext();
        if (string.IsNullOrWhiteSpace(normalizedSource)
            || string.IsNullOrWhiteSpace(mainRecordArrayPath)
            || mainRecordContext == null
            || SubCardPathHelper.IsAbsoluteJsonPath(normalizedSource)
            || SubCardPathHelper.IsRootScopedPath(normalizedSource, mainRecordArrayPath))
        {
            return false;
        }

        if (MessageJsonHelper.IsMainRecordScopedPath(normalizedSource))
        {
            var relativePath = MessageJsonHelper.TrimMainRecordScopePrefix(normalizedSource);
            if (string.IsNullOrWhiteSpace(relativePath))
                return false;

            scopedPath = MessageJsonHelper.EnsureMainRecordScopedPath(relativePath);
            return true;
        }

        if (SubCardPathHelper.ResolveFirstToken(mainRecordContext, normalizedSource) == null)
            return false;

        scopedPath = MessageJsonHelper.EnsureMainRecordScopedPath(normalizedSource);
        return true;
    }

    private bool TryNormalizeMainRecordSourcePath(string? sourcePath, out string normalizedPath)
        => MessageJsonHelper.TryNormalizeMainRecordSourcePath(sourcePath, GetMainRecordArrayPath(), out normalizedPath);

    private bool TryExpandMainRecordScopedPath(string? sourcePath, out string scopedPath)
    {
        scopedPath = "";
        var normalizedSource = sourcePath?.Trim() ?? "";
        var mainRecordArrayPath = GetMainRecordArrayPath();
        var mainRecordContext = GetConfiguredMainRecordContext();
        if (string.IsNullOrWhiteSpace(normalizedSource)
            || string.IsNullOrWhiteSpace(mainRecordArrayPath)
            || mainRecordContext == null
            || SubCardPathHelper.IsAbsoluteJsonPath(normalizedSource)
            || SubCardPathHelper.IsRootScopedPath(normalizedSource, mainRecordArrayPath))
        {
            return false;
        }

        var relativePath = MessageJsonHelper.IsMainRecordScopedPath(normalizedSource)
            ? MessageJsonHelper.TrimMainRecordScopePrefix(normalizedSource)
            : normalizedSource;
        if (string.IsNullOrWhiteSpace(relativePath)
            || SubCardPathHelper.ResolveFirstToken(mainRecordContext, relativePath) == null)
        {
            return false;
        }

        scopedPath = BuildScopedPath(mainRecordArrayPath, relativePath);
        return true;
    }

    private string NormalizePickedPath(string? path)
        => TryNormalizeMainRecordSourcePath(path, out var normalizedPath)
            ? normalizedPath
            : path?.Trim() ?? "";

    private string? BuildArrayPathTreeSelectionPath(string? arrayPath)
    {
        var normalizedPath = SubCardPathHelper.NormalizeArrayContainerPath(arrayPath);
        if (string.IsNullOrWhiteSpace(normalizedPath))
            return null;

        var root = GetSampleJsonRoot();
        if (root != null && SubCardPathHelper.ResolveSubCardContainer(root, normalizedPath) is JArray)
            return NormalizeJsonTreeSelectionPath($"{normalizedPath}[]");

        return NormalizeJsonTreeSelectionPath(normalizedPath);
    }

    private string? BuildJsonTreeSelectionPath(string? sourcePath)
    {
        if (string.IsNullOrWhiteSpace(sourcePath))
            return null;

        var normalizedSource = sourcePath.Trim();
        return TryExpandMainRecordScopedPath(normalizedSource, out var scopedPath)
            ? NormalizeJsonTreeSelectionPath(scopedPath)
            : NormalizeJsonTreeSelectionPath(normalizedSource);
    }

    private string? GetPathSelection(PathPickTarget target, int targetIndex = -1)
    {
        if (_editItem == null)
            return null;

        return target switch
        {
            PathPickTarget.Mrn => _editItem.MrnSourcePath,
            PathPickTarget.EventTime => _editItem.EventStartTimeSourcePath,
            PathPickTarget.VisitNo => _editItem.VisitNoSourcePath,
            PathPickTarget.InpatientNo => _editItem.InpatientNoSourcePath,
            PathPickTarget.SourceMessageId => _editItem.SourceMessageIdPath,
            PathPickTarget.MainRecordArray => _editItem.MainRecordArrayPath,
            PathPickTarget.FilterRule when targetIndex >= 0 && targetIndex < _editFilterRules.Count => _editFilterRules[targetIndex].SourcePath,
            PathPickTarget.MatchRule when targetIndex >= 0 && targetIndex < _editMatchRules.Count => _editMatchRules[targetIndex].SourcePath,
            PathPickTarget.IdempotentKeyPart when targetIndex >= 0 && targetIndex < _editIdempotentKeyParts.Count => _editIdempotentKeyParts[targetIndex].SourcePath,
            _ => null
        };
    }

    private void SetPathPickTarget(PathPickTarget target, int targetIndex = -1)
    {
        ResetPathPickState();
        if (target == PathPickTarget.None)
            return;

        _pathPickTarget = target;

        switch (target)
        {
            case PathPickTarget.FilterRule:
                _pickFilterRuleIndex = targetIndex;
                break;
            case PathPickTarget.MatchRule:
                _pickMatchRuleIndex = targetIndex;
                break;
            case PathPickTarget.IdempotentKeyPart:
                _pickIdempotentKeyPartIndex = targetIndex;
                break;
        }

        SetJsonTreeSelection(target == PathPickTarget.MainRecordArray
            ? BuildArrayPathTreeSelectionPath(GetPathSelection(target, targetIndex))
            : BuildJsonTreeSelectionPath(GetPathSelection(target, targetIndex)));
    }

    private void ResetPathPickState()
    {
        _pathPickTarget = PathPickTarget.None;
        _pickFilterRuleIndex = -1;
        _pickMatchRuleIndex = -1;
        _pickIdempotentKeyPartIndex = -1;
        SetJsonTreeSelection(null);
    }

    private void OnSidePanelPathPicked(string path)
    {
        if (_editItem == null) return;

        var normalizedPath = NormalizePickedPath(path);

        switch (_pathPickTarget)
        {
            case PathPickTarget.Mrn:
                _editItem.MrnSourcePath = normalizedPath;
                break;
            case PathPickTarget.EventTime:
                _editItem.EventStartTimeSourcePath = normalizedPath;
                break;
            case PathPickTarget.VisitNo:
                _editItem.VisitNoSourcePath = normalizedPath;
                break;
            case PathPickTarget.InpatientNo:
                _editItem.InpatientNoSourcePath = normalizedPath;
                break;
            case PathPickTarget.SourceMessageId:
                _editItem.SourceMessageIdPath = normalizedPath;
                break;
            case PathPickTarget.MainRecordArray:
                _editItem.MainRecordArrayPath = SubCardPathHelper.NormalizeArrayContainerPath(path);
                break;
            case PathPickTarget.FilterRule:
                if (_pickFilterRuleIndex >= 0 && _pickFilterRuleIndex < _editFilterRules.Count)
                    _editFilterRules[_pickFilterRuleIndex].SourcePath = normalizedPath;
                break;
            case PathPickTarget.MatchRule:
                if (_pickMatchRuleIndex >= 0 && _pickMatchRuleIndex < _editMatchRules.Count)
                    _editMatchRules[_pickMatchRuleIndex].SourcePath = normalizedPath;
                break;
            case PathPickTarget.IdempotentKeyPart:
                if (_pickIdempotentKeyPartIndex >= 0 && _pickIdempotentKeyPartIndex < _editIdempotentKeyParts.Count)
                    _editIdempotentKeyParts[_pickIdempotentKeyPartIndex].SourcePath = normalizedPath;
                break;
        }

        var currentTargetIndex = _pathPickTarget switch
        {
            PathPickTarget.FilterRule => _pickFilterRuleIndex,
            PathPickTarget.MatchRule => _pickMatchRuleIndex,
            PathPickTarget.IdempotentKeyPart => _pickIdempotentKeyPartIndex,
            _ => -1
        };

        SetJsonTreeSelection(_pathPickTarget == PathPickTarget.MainRecordArray
            ? BuildArrayPathTreeSelectionPath(GetPathSelection(_pathPickTarget, currentTargetIndex))
            : BuildJsonTreeSelectionPath(GetPathSelection(_pathPickTarget, currentTargetIndex)));
    }

    private async Task Save()
    {
        if (_editItem == null || string.IsNullOrWhiteSpace(_editItem.TranCode))
        {
            inj_snackbar.Add("事件代码不能为空", Severity.Warning);
            return;
        }

        // 启用时校验关键路径
        if (_editItem.IsEnabled)
        {
            var errors = ConfigSvc.ValidateInterfaceConfig(_editItem);
            if (errors.Count > 0)
            {
                foreach (var err in errors)
                    inj_snackbar.Add(err, Severity.Error);
                return;
            }
        }

        try
        {
            if (_editItem.HandlerType != HandlerType.Custom)
                _editItem.HandlerName = null;

            if (_editItem.HandlerType == HandlerType.GenericQuestionWriteBack &&
                _editItem.MissingEventIdentityPolicy == MissingEventIdentityPolicy.DegradeToPatientOnly)
            {
                _editItem.MissingEventIdentityPolicy = MissingEventIdentityPolicy.Fail;
            }

            _editItem.MainRecordArrayPath = string.IsNullOrWhiteSpace(_editItem.MainRecordArrayPath)
                ? null
                : SubCardPathHelper.NormalizeArrayContainerPath(_editItem.MainRecordArrayPath);

            _editItem.MrnSourcePath = NormalizePickedPath(_editItem.MrnSourcePath);
            _editItem.EventStartTimeSourcePath = NormalizePickedPath(_editItem.EventStartTimeSourcePath);
            _editItem.VisitNoSourcePath = NormalizePickedPath(_editItem.VisitNoSourcePath);
            _editItem.InpatientNoSourcePath = NormalizePickedPath(_editItem.InpatientNoSourcePath);
            _editItem.SourceMessageIdPath = NormalizePickedPath(_editItem.SourceMessageIdPath);

            foreach (var rule in _editFilterRules)
                rule.SourcePath = NormalizePickedPath(rule.SourcePath);

            foreach (var rule in _editMatchRules)
                rule.SourcePath = NormalizePickedPath(rule.SourcePath);

            foreach (var part in _editIdempotentKeyParts)
                part.SourcePath = NormalizePickedPath(part.SourcePath);

            await using var db = await ContextFactory.CreateDbContextAsync();

            if (_isNew)
            {
                _editItem.IntegrationProjectCode ??= CurrentIntegrationProjectCode;
                db.EsbInterfaceConfigs.Add(_editItem);
            }
            else
            {
                var existing = await db.EsbInterfaceConfigs.FindAsync(_editItem.Id);
                if (existing != null)
                {
                    existing.TranCode = _editItem.TranCode;
                    existing.TranName = _editItem.TranName;
                    existing.IsEnabled = _editItem.IsEnabled;
                    existing.HandlerType = _editItem.HandlerType;
                    existing.HandlerName = _editItem.HandlerName;
                    existing.AllowMultipleMatch = _editItem.AllowMultipleMatch;
                    existing.ReceiveMode = _editItem.ReceiveMode;
                    existing.LicenseCode = _editItem.LicenseCode;
                    existing.EventTypeName = _editItem.EventTypeName;
                    existing.Description = _editItem.Description;
                    existing.SortOrder = _editItem.SortOrder;
                    existing.MrnSourcePath = _editItem.MrnSourcePath;
                    existing.EventStartTimeSourcePath = _editItem.EventStartTimeSourcePath;
                    existing.VisitNoSourcePath = _editItem.VisitNoSourcePath;
                    existing.InpatientNoSourcePath = _editItem.InpatientNoSourcePath;
                    existing.SourceMessageIdPath = _editItem.SourceMessageIdPath;
                    existing.MainRecordArrayPath = _editItem.MainRecordArrayPath;
                    existing.AllowMissingEventTime = _editItem.AllowMissingEventTime;
                    existing.ResponseMode = _editItem.ResponseMode;
                    existing.MissingEventIdentityPolicy = _editItem.MissingEventIdentityPolicy;
                    existing.SampleJson = _editItem.SampleJson;
                    existing.IntegrationProjectCode = _editItem.IntegrationProjectCode;
                }
            }

            await db.SaveChangesAsync();
            await SyncFilterRulesAsync(db, _editItem.TranCode, _editItem.IntegrationProjectCode);
            await SyncMatchRulesAsync(db, _editItem.TranCode, _editItem.IntegrationProjectCode);
            await SyncIdempotentKeyPartsAsync(db, _editItem.TranCode, _editItem.IntegrationProjectCode);

            var savedTranCode = _editItem.TranCode;
            var openWizardAfterSave = _openWizardAfterCreateFromMessageSave;
            ConfigSvc.ClearCache();
            _dialogVisible = false;
            _openWizardAfterCreateFromMessageSave = false;
            inj_snackbar.Add("保存成功", Severity.Success);
            await LoadDataAsync();

            if (openWizardAfterSave)
            {
                var confirmed = await inj_dialogService.ShowMessageBox(
                    "继续配置工作台",
                    "接口配置已创建，是否进入接口配置工作台继续配置？",
                    yesText: "进入工作台",
                    cancelText: "暂不进入");

                if (confirmed == true)
                {
                    inj_navigationManager.NavigateTo($"/config/wizard?tranCode={Uri.EscapeDataString(savedTranCode)}");
                }
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task RunAiAnalysis()
    {
        if (string.IsNullOrWhiteSpace(_aiSampleJson))
        {
            inj_snackbar.Add("请粘贴 JSON 示例", Severity.Warning);
            return;
        }

        // 校验 JSON 格式
        try
        {
            var token = Newtonsoft.Json.Linq.JToken.Parse(_aiSampleJson);
            if (token is not Newtonsoft.Json.Linq.JObject && token is not Newtonsoft.Json.Linq.JArray)
            {
                inj_snackbar.Add("JSON 格式无效: 根节点必须是对象或数组", Severity.Error);
                return;
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"JSON 格式无效: {ex.Message}", Severity.Error);
            return;
        }

        _aiAnalyzing = true;
        StateHasChanged();

        try
        {
            await LoadEventTypesAsync();
            var result = await LlmService.AnalyzeInterfaceConfigAsync(_aiSampleJson, _aiDocDescription, _eventTypes, CancellationToken.None);
            if (result == null)
            {
                inj_snackbar.Add("AI 未返回有效结果，请检查 JSON 或重试", Severity.Warning);
                return;
            }

            // 创建新接口配置，填入 LLM 结果（按 MaxLength 截断）
            _editItem = new EsbInterfaceConfig
            {
                IsEnabled = true,
                TranCode = Truncate(result.TranCode, 20),
                TranName = Truncate(result.TranName, 100),
                EventTypeName = Truncate(result.EventTypeName, 100),
                MainRecordArrayPath = Truncate(result.MainRecordArrayPath, 500),
                MrnSourcePath = Truncate(result.MrnSourcePath, 500),
                EventStartTimeSourcePath = Truncate(result.EventStartTimeSourcePath, 500),
                Description = Truncate(result.Description, 500),
                SampleJson = _aiSampleJson,
            };
            _editFilterRules = [];
            _editMatchRules = [];
            _editIdempotentKeyParts = [];
            ResetPathPickState();
            PrepareDialogLayout();
            _isNew = true;
            await LoadEventTypesAsync();

            // 关闭 AI 对话框，打开编辑对话框
            _aiDialogVisible = false;
            _dialogVisible = true;
            inj_snackbar.Add("AI 分析完成，请审核并修改配置", Severity.Success);
        }
        catch (HttpRequestException ex)
        {
            inj_snackbar.Add($"LLM 服务请求失败: {ex.Message}", Severity.Error);
        }
        catch (TimeoutException ex)
        {
            inj_snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (TaskCanceledException)
        {
            inj_snackbar.Add("LLM 请求超时，请稍后重试", Severity.Warning);
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"AI 分析出错: {ex.Message}", Severity.Error);
        }
        finally
        {
            _aiAnalyzing = false;
        }
    }

    private static string Truncate(string? value, int maxLength)
        => string.IsNullOrEmpty(value) ? "" : value.Length <= maxLength ? value : value[..maxLength];

    private async Task SyncFilterRulesAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var oldRules = await db.EsbFilterRules
            .Where(r => r.TranCode == tranCode && r.MappingId == null && r.IntegrationProjectCode == integrationProjectCode)
            .ToListAsync();
        db.EsbFilterRules.RemoveRange(oldRules);

        foreach (var (rule, index) in _editFilterRules.Select((r, i) => (r, i)))
        {
            db.EsbFilterRules.Add(new EsbFilterRule
            {
                TranCode = tranCode,
                SourcePath = rule.SourcePath,
                RuleGroup = Math.Max(1, rule.RuleGroup),
                Operator = rule.Operator,
                CompareValue = rule.CompareValue,
                MappingId = null,
                FilterScope = rule.FilterScope,
                IsEnabled = rule.IsEnabled,
                SortOrder = index,
                Description = rule.Description,
                IntegrationProjectCode = integrationProjectCode,
            });
        }

        await db.SaveChangesAsync();
    }

    private async Task SyncMatchRulesAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var oldRules = await db.EsbInterfaceMatchRules
            .Where(r => r.TranCode == tranCode && r.IntegrationProjectCode == integrationProjectCode)
            .ToListAsync();
        db.EsbInterfaceMatchRules.RemoveRange(oldRules);

        foreach (var (rule, index) in _editMatchRules.Select((r, i) => (r, i)))
        {
            db.EsbInterfaceMatchRules.Add(new EsbInterfaceMatchRule
            {
                TranCode = tranCode,
                MatchGroup = rule.MatchGroup <= 0 ? 1 : rule.MatchGroup,
                SourcePath = rule.SourcePath,
                Operator = string.IsNullOrWhiteSpace(rule.Operator) ? "eq" : rule.Operator,
                CompareValue = rule.CompareValue ?? "",
                IsEnabled = rule.IsEnabled,
                SortOrder = index,
                Description = rule.Description,
                IntegrationProjectCode = integrationProjectCode,
            });
        }

        await db.SaveChangesAsync();
    }

    private async Task SyncIdempotentKeyPartsAsync(DataSyncDbContext db, string tranCode, string? integrationProjectCode)
    {
        var oldParts = await db.EsbIdempotentKeyParts
            .Where(p => p.TranCode == tranCode && p.IntegrationProjectCode == integrationProjectCode)
            .ToListAsync();
        db.EsbIdempotentKeyParts.RemoveRange(oldParts);

        foreach (var (part, index) in _editIdempotentKeyParts.Select((p, i) => (p, i)))
        {
            db.EsbIdempotentKeyParts.Add(new EsbIdempotentKeyPart
            {
                TranCode = tranCode,
                SourcePath = part.SourcePath,
                LiteralValue = part.LiteralValue,
                DefaultValue = part.DefaultValue,
                SortOrder = index,
                IsEnabled = part.IsEnabled,
                Description = part.Description,
                IntegrationProjectCode = integrationProjectCode,
            });
        }

        await db.SaveChangesAsync();
    }

    private async Task Delete(EsbInterfaceConfig item)
    {
        var confirmed = await inj_dialogService.ShowMessageBox("确认删除",
            $"确定要删除接口 {item.TranCode} - {item.TranName} 吗？", yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var entity = await db.EsbInterfaceConfigs.FindAsync(item.Id);
            if (entity != null)
            {
                var oldFilterRules = await db.EsbFilterRules
                    .Where(r => r.TranCode == item.TranCode && r.MappingId == null && r.IntegrationProjectCode == item.IntegrationProjectCode)
                    .ToListAsync();
                var oldMatchRules = await db.EsbInterfaceMatchRules
                    .Where(r => r.TranCode == item.TranCode && r.IntegrationProjectCode == item.IntegrationProjectCode)
                    .ToListAsync();
                var oldIdempotentParts = await db.EsbIdempotentKeyParts
                    .Where(p => p.TranCode == item.TranCode && p.IntegrationProjectCode == item.IntegrationProjectCode)
                    .ToListAsync();

                db.EsbFilterRules.RemoveRange(oldFilterRules);
                db.EsbInterfaceMatchRules.RemoveRange(oldMatchRules);
                db.EsbIdempotentKeyParts.RemoveRange(oldIdempotentParts);
                db.EsbInterfaceConfigs.Remove(entity);
                await db.SaveChangesAsync();
                ConfigSvc.ClearCache();
                inj_snackbar.Add("删除成功", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }
}
