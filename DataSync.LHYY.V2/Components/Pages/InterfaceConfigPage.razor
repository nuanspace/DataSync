    private async Task OpenOcrSampleFromQueryAsync()
    {
        if (!QueryOcrSampleMessageId.HasValue)
            return;

        var message = await MessageQuerySvc.GetMessageByIdAsync(QueryOcrSampleMessageId.Value);
        if (message == null)
        {
            inj_snackbar.Add("消息不存在，无法用于 OCR 配置", Severity.Warning);
            return;
        }

        var existing = _items.FirstOrDefault(item =>
            string.Equals(item.TranCode, message.TranCode, StringComparison.OrdinalIgnoreCase));
        if (existing != null)
        {
            await Edit(existing);
            if (string.IsNullOrWhiteSpace(_editItem?.SampleJson))
                _editItem!.SampleJson = BuildSanitizedMessageTemplate(message.RawJson);
        }
        else
        {
            _editItem = new EsbInterfaceConfig
            {
                IsEnabled = false,
                ReceiveMode = ReceiveMode.PersistAndAsync,
                TranCode = Truncate(message.TranCode, 20),
                TranName = Truncate(message.TranName, 100),
                HandlerType = HandlerType.Custom,
                HandlerName = OcrProfileService.HandlerName,
                SampleJson = BuildSanitizedMessageTemplate(message.RawJson),
                IntegrationProjectCode = CurrentIntegrationProjectCode,
                SortOrder = GetNextSortOrder()
            };
            _editFilterRules = [];
            _editMatchRules = [];
            _editIdempotentKeyParts = [];
            ResetOcrProfile(_editItem.TranCode, _editItem.IntegrationProjectCode);
            ResetPathPickState();
            PrepareDialogLayout();
            _isNew = true;
            _dialogVisible = true;
            _openWizardAfterCreateFromMessageSave = false;
            await LoadEventTypesAsync();
        }

        SetOcrSampleMessage(message);
        await LoadOcrSampleMessagesAsync(false);
        _ocrExpanded = true;
        inj_snackbar.Add("已载入 OCR 样本消息，预览不会执行映射或写业务表", Severity.Info);
    }

    private async Task LoadOcrSampleMessagesAsync() => await LoadOcrSampleMessagesAsync(true);

    private async Task LoadOcrSampleMessagesAsync(bool showEmptyMessage)
    {
        if (_editItem == null || string.IsNullOrWhiteSpace(_editItem.TranCode))
        {
            inj_snackbar.Add("请先填写事件代码", Severity.Warning);
            return;
        }

        _ocrSamplesLoading = true;
        try
        {
            var preferredMessageId = _selectedOcrSampleMessageId ?? _editOcrProfile.SampleMessageId;
            var items = await MessageQuerySvc.GetOcrSampleMessagesAsync(
                _editItem.TranCode,
                preferredMessageId,
                _editMatchRules);
            _ocrSampleMessages = items;

            if (_selectedOcrSampleMessage != null
                && IsOcrSampleForCurrentInterface(_selectedOcrSampleMessage)
                && _ocrSampleMessages.All(item => item.Id != _selectedOcrSampleMessage.Id))
            {
                _ocrSampleMessages.Insert(0, ToMessageListItem(_selectedOcrSampleMessage));
            }

            var selectedMessageId = preferredMessageId.HasValue
                && _ocrSampleMessages.Any(item => item.Id == preferredMessageId.Value)
                    ? preferredMessageId
                    : _ocrSampleMessages.FirstOrDefault()?.Id;
            if (selectedMessageId.HasValue)
            {
                _selectedOcrSampleMessageId = selectedMessageId;
                await LoadSelectedOcrSampleAsync(selectedMessageId.Value);
            }
            else
            {
                _selectedOcrSampleMessageId = null;
                _selectedOcrSampleMessage = null;
            }

            if (showEmptyMessage && _ocrSampleMessages.Count == 0)
                inj_snackbar.Add("当前接口没有可用的历史消息样本，可重新执行一次数据补录后再预览 PDF", Severity.Warning);
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"加载 OCR 样本失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _ocrSamplesLoading = false;
        }
    }

    private async Task OnOcrSampleMessageChanged(long? messageId)
    {
        _selectedOcrSampleMessageId = messageId;
        _editOcrProfile.SampleMessageId = messageId;
        if (_selectedOcrSampleMessage?.Id != messageId)
            _selectedOcrSampleMessage = null;
        _ocrPreviewResult = null;
        _ocrPreviewElapsedMs = 0;
        _ocrPreviewHasMorePages = false;
        _ocrPreviewLoadError = null;
        _ocrPreviewFieldsTested = false;
        _ocrPreviewTestRuleSignature = null;
        _ocrPreviewTestSampleMessageId = null;
        _ocrPreviewTestError = null;

        if (messageId.HasValue)
        {
            try
            {
                await LoadSelectedOcrSampleAsync(messageId.Value);
            }
            catch (Exception ex)
            {
                inj_snackbar.Add($"加载 OCR 样本失败: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task LoadSelectedOcrSampleAsync(long messageId)
    {
        var message = await MessageQuerySvc.GetMessageByIdAsync(messageId);
        if (message == null)
            throw new InvalidOperationException("OCR 样本消息不存在");
        if (!IsOcrSampleForCurrentInterface(message))
            throw new InvalidOperationException("样本消息的事件代码与当前接口不一致");

        _selectedOcrSampleMessage = message;
        _selectedOcrSampleMessageId = message.Id;
        _editOcrProfile.SampleMessageId = message.Id;
        if (string.IsNullOrWhiteSpace(_editItem?.SampleJson))
            _editItem!.SampleJson = BuildSanitizedMessageTemplate(message.RawJson);
    }

    private async Task PreviewOcrSampleAsync()
        => await LoadOcrPreviewBatchAsync(true);

    private async Task LoadMoreOcrPreviewPagesAsync()
        => await LoadOcrPreviewBatchAsync(false);

    private async Task LoadOcrPreviewBatchAsync(bool reset)
    {
        if (!_selectedOcrSampleMessageId.HasValue || _selectedOcrSampleMessage == null)
            await LoadOcrSampleMessagesAsync(false);

        if (!_selectedOcrSampleMessageId.HasValue)
        {
            inj_snackbar.Add("没有可用于 PDF 预览的历史消息，请重新执行一次数据补录", Severity.Warning);
            return;
        }

        PrepareOcrExtractionRules();
        var errors = OcrProfileService.ValidateSourceProfile(_editOcrProfile, false);
        if (errors.Count > 0)
        {
            foreach (var error in errors)
                inj_snackbar.Add(error, Severity.Error);
            return;
        }

        _ocrPreviewing = true;
        if (reset)
            _ocrPreviewResult = null;
        _ocrPreviewLoadError = null;
        if (reset)
            _ocrPreviewElapsedMs = 0;
        try
        {
            var message = _selectedOcrSampleMessage?.Id == _selectedOcrSampleMessageId.Value
                ? _selectedOcrSampleMessage
                : await MessageQuerySvc.GetMessageByIdAsync(_selectedOcrSampleMessageId.Value);
            if (message == null)
                throw new InvalidOperationException("OCR 样本消息不存在");
            if (!IsOcrSampleForCurrentInterface(message))
                throw new InvalidOperationException("样本消息的事件代码与当前接口不一致");
            if (!MessageJsonHelper.TryParseToken(message.RawJson, out var token, out var parseError)
                || token is not JObject root)
            {
                throw new InvalidOperationException(parseError ?? "OCR 样本消息根节点必须是对象");
            }

            var mainContext = MessageJsonHelper.ResolveMainRecordContext(root, _editItem?.MainRecordArrayPath);
            var sourceValue = MessageJsonHelper.ReadString(root, _editOcrProfile.SourcePath, mainContext);
            if (string.IsNullOrWhiteSpace(sourceValue))
                throw new InvalidOperationException($"未从样本消息中提取到 PDF 来源：{_editOcrProfile.SourcePath}");

            _editOcrProfile.ExtractionRules = OcrProfileService.SerializeExtractionRules(_editOcrExtractionRules);
            var options = OcrProfileService.ToConversionOptions(_editOcrProfile);
            options.ExtractionRules = [];
            options.OutputJsonPath = null;
            options.OutputNameHint = null;
            options.KeepWorkFiles = false;
            options.IncludePreviewImages = true;
            options.IncludeLayoutRecognition = true;
            options.PageRangeStart = reset
                ? 1
                : (_ocrPreviewResult?.Pages.Max(page => page.PageNumber) ?? 0) + 1;
            options.PageRangeCount = 3;
            options.ProbeNextPage = true;

            var stopwatch = System.Diagnostics.Stopwatch.StartNew();
            var batchResult = await inj_ocrConversionService.ConvertAsync(
                new OcrSource
                {
                    Kind = _editOcrProfile.SourceKind,
                    Value = sourceValue
                },
                options,
                CancellationToken);
            stopwatch.Stop();
            _ocrPreviewElapsedMs += stopwatch.ElapsedMilliseconds;
            _ocrPreviewResult = reset
                ? batchResult
                : MergeOcrPreviewResults(_ocrPreviewResult!, batchResult);
            _ocrPreviewHasMorePages = batchResult.HasMorePages;
            _ocrPreviewFieldsTested = false;
            _ocrPreviewTestRuleSignature = null;
            _ocrPreviewTestSampleMessageId = null;
            _ocrPreviewTestError = null;
            _selectedOcrSampleMessage = message;
            _ocrFieldSelectorVisible = true;
            inj_snackbar.Add(
                reset
                    ? "已加载 PDF 前 3 页，可配置并测试当前页面字段"
                    : $"已加载到第 {_ocrPreviewResult.Pages.Max(page => page.PageNumber)} 页",
                Severity.Success);
        }
        catch (OperationCanceledException) when (CancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _ocrPreviewLoadError = $"PDF 页面加载失败：{ex.Message}";
            if (_ocrPreviewResult == null)
            {
                _ocrPreviewElapsedMs = 0;
                _ocrFieldSelectorVisible = false;
                inj_snackbar.Add($"PDF 样本预览失败: {ex.Message}", Severity.Error);
            }
            else
            {
                inj_snackbar.Add(_ocrPreviewLoadError, Severity.Error);
            }
        }
        finally
        {
            _ocrPreviewing = false;
        }
    }

    private static OcrDocumentResult MergeOcrPreviewResults(
        OcrDocumentResult current,
        OcrDocumentResult batch)
    {
        var pages = current.Pages
            .Concat(batch.Pages)
            .GroupBy(page => page.PageNumber)
            .Select(group => group.Last())
            .OrderBy(page => page.PageNumber)
            .ToList();
        var layoutPages = current.LayoutPages
            .Concat(batch.LayoutPages)
            .GroupBy(page => page.PageNumber)
            .Select(group => group.Last())
            .OrderBy(page => page.PageNumber)
            .ToList();

        return new OcrDocumentResult
        {
            SourceKind = current.SourceKind,
            Language = current.Language,
            Dpi = current.Dpi,
            PageSegMode = current.PageSegMode,
            StartedAt = current.StartedAt,
            FinishedAt = batch.FinishedAt,
            PageCount = pages.Count,
            Pages = pages,
            LayoutPages = layoutPages,
            TextItems = pages.SelectMany(page => page.TextItems).ToList(),
            FullText = string.Join(
                $"{Environment.NewLine}{Environment.NewLine}",
                pages.Select(page => page.Text).Where(text => !string.IsNullOrWhiteSpace(text))),
            HasMorePages = batch.HasMorePages,
            Metadata = new Dictionary<string, string>(current.Metadata, StringComparer.Ordinal)
        };
    }

    private async Task TestOcrPreviewFieldsAsync()
    {
        if (_ocrPreviewResult == null)
        {
            _ocrPreviewTestError = "当前没有可用的 PDF 预览结果";
            return;
        }
        PrepareOcrExtractionRules();
        var errors = OcrExtractionRuleHelper.Validate(_editOcrExtractionRules);
        if (errors.Count > 0)
        {
            _ocrPreviewTestError = string.Join("；", errors);
            return;
        }

        _ocrPreviewTesting = true;
        _ocrPreviewFieldsTested = false;
        _ocrPreviewTestError = null;
        _ocrPreviewResult.ExtractedFields.Clear();
        try
        {
            await OcrAiExtractionSvc.ExtractAsync(
                _ocrPreviewResult,
                _editOcrExtractionRules,
                CancellationToken);
            _ocrPreviewFieldsTested = true;
            _ocrPreviewTestRuleSignature = BuildOcrRuleValueSignature(_editOcrExtractionRules);
            _ocrPreviewTestSampleMessageId = _selectedOcrSampleMessageId ?? _editOcrProfile.SampleMessageId;
            RebuildOcrSampleJson();
            inj_snackbar.Add("OCR 字段测试完成", Severity.Success);
        }
        catch (OperationCanceledException) when (CancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _ocrPreviewResult.ExtractedFields.Clear();
            _ocrPreviewTestError = $"字段测试失败：{ex.Message}";
            inj_snackbar.Add(_ocrPreviewTestError, Severity.Error);
        }
        finally
        {
            _ocrPreviewTesting = false;
        }
    }

    private void RebuildOcrSampleJson()
    {
        if (_editItem == null)
            return;

        PrepareOcrExtractionRules();
        var ruleSignature = BuildOcrRuleValueSignature(_editOcrExtractionRules);
        var sampleMessageId = _selectedOcrSampleMessageId ?? _editOcrProfile.SampleMessageId;
        var existingValues = ReadOcrTemplateValues(_editItem.SampleJson, _editItem.MainRecordArrayPath);
        var existingPageCount = ReadOcrTemplatePageCount(_editItem.SampleJson, _editItem.MainRecordArrayPath);
        var canUsePreviewValues = _ocrPreviewFieldsTested
            && string.Equals(_ocrPreviewTestRuleSignature, ruleSignature, StringComparison.Ordinal)
            && sampleMessageId == _ocrPreviewTestSampleMessageId;
        var canKeepTemplateValues = string.Equals(_ocrTemplateRuleSignature, ruleSignature, StringComparison.Ordinal)
            && sampleMessageId == _ocrTemplateSampleMessageId;
        var templateSource = _selectedOcrSampleMessage?.RawJson ?? _editItem.SampleJson;
        var root = MessageJsonHelper.TryParseToken(templateSource ?? "{}", out var token, out _)
            && token is JObject obj
                ? obj
                : new JObject();

        var mainContext = MessageJsonHelper.ResolveMainRecordContext(root, _editItem.MainRecordArrayPath);
        var sourceToken = MessageJsonHelper.ResolveScopedToken(
            root,
            mainContext,
            _editOcrProfile.SourcePath,
            mainContext);
        sourceToken?.Replace(new JValue("[PDF 内容已省略]"));
        MessageJsonHelper.SanitizeLargeStringValues(root);

        var templateResult = new OcrDocumentResult
        {
            PageCount = canUsePreviewValues
                ? _ocrPreviewResult?.PageCount ?? 0
                : canKeepTemplateValues ? existingPageCount : 0
        };
        foreach (var rule in _editOcrExtractionRules)
        {
            var fieldCode = rule.FieldCode.Trim();
            if (canUsePreviewValues
                && _ocrPreviewResult?.ExtractedFields.TryGetValue(fieldCode, out var previewValue) == true)
            {
                templateResult.ExtractedFields[fieldCode] = previewValue;
            }
            else if (canKeepTemplateValues && existingValues.TryGetValue(fieldCode, out var existingValue))
            {
                templateResult.ExtractedFields[fieldCode] = existingValue;
            }
        }
        var ocrTemplate = OcrMessageJsonHelper.BuildPayload(
            templateResult,
            _editOcrExtractionRules,
            template: true);

        AttachOcrResult(root, mainContext, ocrTemplate);
        _editItem.SampleJson = root.ToString(Newtonsoft.Json.Formatting.Indented);
        _ocrTemplateRuleSignature = ruleSignature;
        _ocrTemplateSampleMessageId = sampleMessageId;
        ResetPathPickState();
    }

    private static Dictionary<string, string?> ReadOcrTemplateValues(
        string? sampleJson,
        string? mainRecordArrayPath)
    {
        var values = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        if (!MessageJsonHelper.TryParseToken(sampleJson ?? "{}", out var token, out _)
            || token is not JObject root)
        {
            return values;
        }

        var ocr = ResolveOcrTemplate(root, mainRecordArrayPath);
        if (ocr?["ExtractedFields"] is not JObject fields)
            return values;

        foreach (var property in fields.Properties())
            values[property.Name] = property.Value.Type == JTokenType.Null ? null : property.Value.ToString();
        return values;
    }

    private static int ReadOcrTemplatePageCount(string? sampleJson, string? mainRecordArrayPath)
    {
        if (!MessageJsonHelper.TryParseToken(sampleJson ?? "{}", out var token, out _)
            || token is not JObject root)
        {
            return 0;
        }

        return ResolveOcrTemplate(root, mainRecordArrayPath)?["PageCount"]?.Value<int?>() ?? 0;
    }

    private static JToken? ResolveOcrTemplate(JObject root, string? mainRecordArrayPath)
    {
        var mainContext = MessageJsonHelper.ResolveMainRecordContext(root, mainRecordArrayPath);
        return mainContext is JObject mainRecord && !ReferenceEquals(mainRecord, root)
            ? mainRecord["Ocr"]
            : root["Ocr"];
    }

    private static string BuildOcrRuleValueSignature(IReadOnlyList<OcrExtractionRule> rules)
        => System.Text.Json.JsonSerializer.Serialize(rules.Select(rule => new
        {
            FieldCode = rule.FieldCode.Trim(),
            SourceFieldName = rule.SourceFieldName?.Trim(),
            SectionHeading = rule.SectionHeading?.Trim(),
            Instruction = rule.Instruction?.Trim()
        }));

