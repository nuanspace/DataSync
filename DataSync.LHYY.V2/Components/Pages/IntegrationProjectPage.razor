@page "/projects"
@inherits BasePage

<PageTitle>项目管理 - LHYY V2</PageTitle>

<div class="integration-project-page">
    <section class="project-hero">
        <div class="project-hero-copy">
            <MudText Typo="Typo.h5" Class="project-hero-title">项目管理</MudText>

            <div class="project-hero-current">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary">当前默认</MudChip>
                <MudText Typo="Typo.body2" Class="project-hero-current-text">@GetCurrentProjectDisplayText()</MudText>
            </div>
        </div>

        <div class="project-hero-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddNew" Class="project-add-button">
                新增项目
            </MudButton>
        </div>
    </section>

    <MudGrid Class="project-summary-grid">
        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Elevation="0" Class="project-summary-card">
                <MudText Typo="Typo.caption" Class="project-summary-label">项目总数</MudText>
                <MudText Typo="Typo.h4" Class="project-summary-value">@GetSummaryCount(_items.Count)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Elevation="0" Class="project-summary-card">
                <MudText Typo="Typo.caption" Class="project-summary-label">启用项目</MudText>
                <MudText Typo="Typo.h4" Class="project-summary-value">@GetSummaryCount(EnabledProjectCount)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Elevation="0" Class="project-summary-card">
                <MudText Typo="Typo.caption" Class="project-summary-label">停用项目</MudText>
                <MudText Typo="Typo.h4" Class="project-summary-value">@GetSummaryCount(DisabledProjectCount)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <MudPaper Elevation="0" Class="project-summary-card project-summary-card-accent">
                <MudText Typo="Typo.caption" Class="project-summary-label">默认启动编码</MudText>
                <MudText Typo="Typo.h6" Class="project-summary-value project-summary-code">@CurrentIntegrationProjectCode</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (!_loading && CurrentDefaultProject == null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="project-warning">
            当前默认启动项目配置为 @CurrentIntegrationProjectCode，但项目列表中不存在，请检查默认项目配置。
        </MudAlert>
    }
    else if (!_loading && CurrentDefaultProject is { IsEnabled: false })
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="project-warning">
            当前默认项目 @CurrentDefaultProject.ProjectCode 已停用。请先启用该项目，或切换到其他启用项目。
        </MudAlert>
    }

    <section class="project-list-panel">
        <div class="project-list-heading">
            <MudText Typo="Typo.h6">项目清单</MudText>
        </div>

        @if (_loading)
        {
            <MudText Typo="Typo.body2" Class="project-list-empty">正在加载项目数据...</MudText>
        }
        else if (_items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">当前还没有接入项目，请先新增项目。</MudAlert>
        }
        else
        {
            <div class="project-list">
                @foreach (var item in _items)
                {
                    var isCurrent = IsCurrentProject(item);

                    <MudPaper Elevation="0" Class="@GetProjectCardClass(item)">
                        <div class="project-card-head">
                            <div class="project-card-title-block">
                                <MudText Typo="Typo.h6" Class="project-card-title">@item.ProjectName</MudText>
                                <MudText Typo="Typo.body2" Class="project-card-code">@item.ProjectCode</MudText>
                            </div>

                            <div class="project-card-state">
                                @if (isCurrent)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">当前默认项目</MudChip>
                                }

                                <MudChip T="string" Size="Size.Small" Color="@(item.IsEnabled ? Color.Success : Color.Default)">
                                    @(item.IsEnabled ? "启用中" : "已停用")
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">排序 @item.SortOrder</MudChip>
                            </div>
                        </div>

                        @if (HasProjectDescription(item))
                        {
                            <MudText Typo="Typo.body2" Class="project-card-desc">@GetProjectDescription(item)</MudText>
                        }

                        <div class="project-card-configs">
                            <div class="project-config-item">
                                <MudText Typo="Typo.caption" Class="project-config-label">LicenseCode</MudText>
                                <MudText Typo="Typo.body2" Class="project-config-value">@GetLicenseCodeText(item.ProjectCode)</MudText>
                            </div>
                            <div class="project-config-item">
                                <MudText Typo="Typo.caption" Class="project-config-label">HospitalId</MudText>
                                <MudText Typo="Typo.body2" Class="project-config-value">@GetHospitalIdText(item.ProjectCode)</MudText>
                            </div>
                            <div class="project-config-item">
                                <MudText Typo="Typo.caption" Class="project-config-label">ProjectId</MudText>
                                <MudText Typo="Typo.body2" Class="project-config-value">@GetProjectIdText(item.ProjectCode)</MudText>
                            </div>
                        </div>

                        <MudDivider Class="project-card-divider" />

                        <div class="project-card-foot">
                            <div class="project-card-actions">
                                @if (isCurrent)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">已在使用中</MudChip>
                                }
                                else if (item.IsEnabled)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Star" OnClick="@(() => SetDefaultProjectAsync(item))">
                                        设为默认
                                    </MudButton>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                        停用后不可设为默认
                                    </MudChip>
                                }

                                <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="@(() => OpenProjectDocuments(item))">
                                    项目文档
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => Edit(item))">
                                    编辑
                                </MudButton>

                                @if (CannotDelete(item))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                        默认项目不可删除
                                    </MudChip>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => Delete(item))">
                                        删除
                                    </MudButton>
                                }
                            </div>
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </section>
</div>

<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "新增接入项目" : "编辑接入项目")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editItem != null)
        {
            @if (IsEditingCurrentProject)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    当前默认项目不能直接停用；如需停用，请先切换默认项目。
                </MudAlert>
            }

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editItem.ProjectCode" Label="项目编码" Required="true" Disabled="!_isNew" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editItem.ProjectName" Label="项目名称" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_editItem.SortOrder" Label="排序" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch @bind-Value="_editItem.IsEnabled" Label="启用" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editItem.Description" Label="说明" Lines="3" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />

            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_editDefaultLicenseCode" Label="项目默认 LicenseCode" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_editDefaultHospitalId" Label="项目默认 HospitalId" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_editDefaultProjectId" Label="项目默认 ProjectId" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogVisible = false)">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">保存</MudButton>
    </DialogActions>
</MudDialog>

<ProjectDocumentDialog Visible="_documentDialogVisible"
                       VisibleChanged="OnDocumentDialogVisibleChanged"
                       IntegrationProjectCode="@_documentProjectCode"
                       IntegrationProjectName="@_documentProjectName"
                       AllowManage="true" />

@code {
    [Inject] private ConfigService ConfigSvc { get; set; } = default!;

    private List<EsbIntegrationProject> _items = [];
    private EsbIntegrationProject? _editItem;
    private readonly Dictionary<string, ProjectConfigSnapshot> _projectConfigs = new(StringComparer.OrdinalIgnoreCase);
    private bool _loading = true;
    private bool _dialogVisible;
    private bool _isNew;
    private bool _documentDialogVisible;
    private string? _documentProjectCode;
    private string? _documentProjectName;
    private string? _editDefaultLicenseCode;
    private string? _editDefaultHospitalId;
    private string? _editDefaultProjectId;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private EsbIntegrationProject? CurrentDefaultProject => _items.FirstOrDefault(item => IsCurrentProject(item));
    private int EnabledProjectCount => _items.Count(item => item.IsEnabled);
    private int DisabledProjectCount => _items.Count(item => !item.IsEnabled);
    private bool IsEditingCurrentProject =>
        _editItem != null &&
        string.Equals(_editItem.ProjectCode, CurrentIntegrationProjectCode, StringComparison.OrdinalIgnoreCase);

    private sealed class ProjectConfigSnapshot
    {
        public string? DefaultLicenseCode { get; set; }
        public string? DefaultHospitalId { get; set; }
        public string? DefaultProjectId { get; set; }
    }

    protected override async Task OnPageInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _items = await IntegrationProjectService.GetProjectsAsync();
            _projectConfigs.Clear();

            await using var db = await ContextFactory.CreateDbContextAsync();
            var configs = await db.EsbIntegrationProjectConfigs
                .AsNoTracking()
                .OrderBy(c => c.IntegrationProjectCode)
                .ThenBy(c => c.ConfigKey)
                .ToListAsync();

            foreach (var group in configs.GroupBy(c => c.IntegrationProjectCode, StringComparer.OrdinalIgnoreCase))
            {
                _projectConfigs[group.Key] = new ProjectConfigSnapshot
                {
                    DefaultLicenseCode = GetProjectConfigValue(group, "DefaultLicenseCode"),
                    DefaultHospitalId = GetProjectConfigValue(group, "DefaultHospitalId"),
                    DefaultProjectId = GetProjectConfigValue(group, "DefaultProjectId")
                };
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddNew()
    {
        _editItem = new EsbIntegrationProject
        {
            IsEnabled = true,
            SortOrder = _items.Count == 0 ? 1 : _items.Max(x => x.SortOrder) + 1
        };
        _editDefaultLicenseCode = null;
        _editDefaultHospitalId = null;
        _editDefaultProjectId = null;
        _isNew = true;
        _dialogVisible = true;
    }

    private void Edit(EsbIntegrationProject item)
    {
        _editItem = new EsbIntegrationProject
        {
            Id = item.Id,
            ProjectCode = item.ProjectCode,
            ProjectName = item.ProjectName,
            IsEnabled = item.IsEnabled,
            Description = item.Description,
            SortOrder = item.SortOrder,
            CreatedAt = item.CreatedAt,
            UpdatedAt = item.UpdatedAt
        };
        _editDefaultLicenseCode = GetLicenseCodeValue(item.ProjectCode);
        _editDefaultHospitalId = GetHospitalIdValue(item.ProjectCode);
        _editDefaultProjectId = GetProjectIdValue(item.ProjectCode);
        _isNew = false;
        _dialogVisible = true;
    }

    private async Task Save()
    {
        if (_editItem == null || string.IsNullOrWhiteSpace(_editItem.ProjectCode) || string.IsNullOrWhiteSpace(_editItem.ProjectName))
        {
            inj_snackbar.Add("项目编码和项目名称不能为空", Severity.Warning);
            return;
        }

        if (IsEditingCurrentProject && !_editItem.IsEnabled)
        {
            inj_snackbar.Add("当前默认项目不能停用，请先切换默认项目", Severity.Warning);
            return;
        }

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var projectCode = _editItem.ProjectCode.Trim().ToUpperInvariant();

            if (_isNew)
            {
                _editItem.ProjectCode = projectCode;
                _editItem.ProjectName = _editItem.ProjectName.Trim();
                _editItem.CreatedAt = DateTime.Now;
                _editItem.UpdatedAt = DateTime.Now;
                db.EsbIntegrationProjects.Add(_editItem);
            }
            else
            {
                var existing = await db.EsbIntegrationProjects.FindAsync(_editItem.Id);
                if (existing != null)
                {
                    projectCode = existing.ProjectCode;
                    existing.ProjectName = _editItem.ProjectName.Trim();
                    existing.IsEnabled = _editItem.IsEnabled;
                    existing.SortOrder = _editItem.SortOrder;
                    existing.Description = _editItem.Description;
                    existing.UpdatedAt = DateTime.Now;
                }
            }

            await UpsertProjectConfigAsync(db, projectCode, "DefaultLicenseCode", _editDefaultLicenseCode, "string", "项目默认 Bio.Core LicenseCode");
            await UpsertProjectConfigAsync(db, projectCode, "DefaultHospitalId", _editDefaultHospitalId, "guid", "项目默认医院 ID");
            await UpsertProjectConfigAsync(db, projectCode, "DefaultProjectId", _editDefaultProjectId, "guid", "项目默认项目 ID");

            await db.SaveChangesAsync();
            IntegrationProjectService.ClearCache();
            ConfigSvc.ClearCache();
            _dialogVisible = false;
            inj_snackbar.Add("保存成功", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task SetDefaultProjectAsync(EsbIntegrationProject item)
    {
        if (!item.IsEnabled)
        {
            inj_snackbar.Add("停用项目不能设为默认，请先启用该项目", Severity.Warning);
            return;
        }

        await IntegrationProjectService.SetCurrentProjectCodeAsync(item.ProjectCode);
        ConfigSvc.ClearCache();
        inj_snackbar.Add($"已切换默认项目为 {item.ProjectCode}", Severity.Success);
        inj_navigationManager.NavigateTo("/projects", forceLoad: true);
    }

    private async Task Delete(EsbIntegrationProject item)
    {
        var confirmed = await inj_dialogService.ShowMessageBox(
            "确认删除",
            $"确定要删除接入项目 {item.ProjectCode} - {item.ProjectName} 吗？",
            yesText: "删除",
            cancelText: "取消");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var entity = await db.EsbIntegrationProjects.FindAsync(item.Id);
            if (entity == null)
            {
                return;
            }

            var configs = await db.EsbIntegrationProjectConfigs
                .Where(c => c.IntegrationProjectCode == entity.ProjectCode)
                .ToListAsync();
            db.EsbIntegrationProjectConfigs.RemoveRange(configs);
            db.EsbIntegrationProjects.Remove(entity);
            await db.SaveChangesAsync();
            IntegrationProjectService.ClearCache();
            ConfigSvc.ClearCache();
            inj_snackbar.Add("删除成功", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private bool CannotDelete(EsbIntegrationProject item)
    {
        return string.Equals(item.ProjectCode, CurrentIntegrationProjectCode, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsCurrentProject(EsbIntegrationProject item)
    {
        return string.Equals(item.ProjectCode, CurrentIntegrationProjectCode, StringComparison.OrdinalIgnoreCase);
    }

    private void OpenProjectDocuments(EsbIntegrationProject item)
    {
        _documentProjectCode = item.ProjectCode;
        _documentProjectName = item.ProjectName;
        _documentDialogVisible = true;
    }

    private Task OnDocumentDialogVisibleChanged(bool visible)
    {
        _documentDialogVisible = visible;
        return Task.CompletedTask;
    }

    private static string? GetProjectConfigValue(IEnumerable<EsbIntegrationProjectConfig> configs, string key)
    {
        return configs
            .Where(c => string.Equals(c.ConfigKey, key, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.UpdatedAt)
            .ThenByDescending(c => c.Id)
            .Select(c => c.ConfigValue)
            .FirstOrDefault();
    }

    private string GetLicenseCodeText(string projectCode) => FormatProjectConfigValue(GetLicenseCodeValue(projectCode));

    private string GetHospitalIdText(string projectCode) => FormatProjectConfigValue(GetHospitalIdValue(projectCode));

    private string GetProjectIdText(string projectCode) => FormatProjectConfigValue(GetProjectIdValue(projectCode));

    private string? GetLicenseCodeValue(string projectCode)
        => _projectConfigs.TryGetValue(projectCode, out var snapshot) ? snapshot.DefaultLicenseCode : null;

    private string? GetHospitalIdValue(string projectCode)
        => _projectConfigs.TryGetValue(projectCode, out var snapshot) ? snapshot.DefaultHospitalId : null;

    private string? GetProjectIdValue(string projectCode)
        => _projectConfigs.TryGetValue(projectCode, out var snapshot) ? snapshot.DefaultProjectId : null;

    private static string FormatProjectConfigValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "跟随全局" : value;

    private string GetCurrentProjectDisplayText()
    {
        var projectName = CurrentIntegrationProjectName ?? CurrentIntegrationProjectCode;
        return $"{projectName} ({CurrentIntegrationProjectCode})";
    }

    private string GetProjectDescription(EsbIntegrationProject item)
    {
        return item.Description?.Trim() ?? string.Empty;
    }

    private bool HasProjectDescription(EsbIntegrationProject item)
    {
        return !string.IsNullOrWhiteSpace(item.Description);
    }

    private string GetProjectCardClass(EsbIntegrationProject item)
    {
        var classes = new List<string> { "project-card" };

        if (IsCurrentProject(item))
        {
            classes.Add("project-card-current");
        }

        if (!item.IsEnabled)
        {
            classes.Add("project-card-disabled");
        }

        return string.Join(" ", classes);
    }

    private string GetSummaryCount(int value)
    {
        return _loading ? "--" : value.ToString();
    }

    private static async Task UpsertProjectConfigAsync(
        DataSyncDbContext db,
        string integrationProjectCode,
        string configKey,
        string? configValue,
        string configType,
        string description)
    {
        var normalizedValue = string.IsNullOrWhiteSpace(configValue) ? null : configValue.Trim();
        var existing = await db.EsbIntegrationProjectConfigs
            .FirstOrDefaultAsync(c =>
                c.IntegrationProjectCode == integrationProjectCode &&
                c.ConfigKey == configKey);

        if (string.IsNullOrWhiteSpace(normalizedValue))
        {
            if (existing != null)
            {
                db.EsbIntegrationProjectConfigs.Remove(existing);
            }

            return;
        }

        if (existing == null)
        {
            db.EsbIntegrationProjectConfigs.Add(new EsbIntegrationProjectConfig
            {
                IntegrationProjectCode = integrationProjectCode,
                ConfigKey = configKey,
                ConfigValue = normalizedValue,
                ConfigType = configType,
                Description = description,
                CreatedAt = DateTime.Now,
                UpdatedAt = DateTime.Now
            });
            return;
        }

        existing.ConfigValue = normalizedValue;
        existing.ConfigType = configType;
        existing.Description = description;
        existing.UpdatedAt = DateTime.Now;
    }
}
