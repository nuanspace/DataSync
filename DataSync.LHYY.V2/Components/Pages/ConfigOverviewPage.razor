    private void AppendExcelQuestionRows(
        System.Text.StringBuilder sb,
        EventTypeTabData tab,
        string formName,
        IEnumerable<FormTreeChildNode> children,
        CardNode? subCardAncestor,
        string cardPath,
        bool includeInterfaceSource)
    {
        foreach (var child in children)
        {
            if (child.Card != null)
            {
                var card = child.Card;
                var isSubCard = card.CardType is "multiple" or "table";
                var currentSubCard = isSubCard ? card : subCardAncestor;
                var nextCardPath = string.IsNullOrWhiteSpace(cardPath) ? card.Name : $"{cardPath} > {card.Name}";
                AppendExcelQuestionRows(sb, tab, formName, FormBrowserHelper.GetOrderedChildren(card), currentSubCard, nextCardPath, includeInterfaceSource);
                continue;
            }

            if (child.Question == null)
                continue;

            var target = subCardAncestor != null ? MappingTarget.SubCard : MappingTarget.Question;
            var mappings = GetMappingsForFieldByEventType(target, child.Question.Id, tab, subCardAncestor?.CardId);
            if (includeInterfaceSource)
            {
                AppendExcelRow(
                    sb,
                    mappings.Count > 0 ? "Configured" : "Cell",
                    formName,
                    string.IsNullOrWhiteSpace(cardPath) ? "-" : cardPath,
                    child.Question.Title ?? "",
                    child.Question.DataType ?? "",
                    mappings.Count > 0 ? "★ 已配置" : "未配置",
                    BuildExportMappingsText(mappings, true));
            }
            else
            {
                AppendExcelRow(
                    sb,
                    mappings.Count > 0 ? "Configured" : "Cell",
                    formName,
                    string.IsNullOrWhiteSpace(cardPath) ? "-" : cardPath,
                    child.Question.Title ?? "",
                    child.Question.DataType ?? "",
                    mappings.Count > 0 ? "★ 已配置" : "未配置");
            }
        }
    }

