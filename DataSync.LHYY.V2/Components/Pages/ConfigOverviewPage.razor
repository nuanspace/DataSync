    private string BuildExportMappingsHtml(List<EsbFieldMapping> mappings, bool includeInterfaceSource)
    {
        if (mappings.Count == 0)
            return "<span class=\"muted\">未配置</span>";

        return string.Join("<br>", mappings.Select(m => BuildExportMappingHtml(m, includeInterfaceSource)));
    }

    private string BuildExportMappingHtml(EsbFieldMapping mapping, bool includeInterfaceSource)
    {
        var interfaceClass = IsInterfaceEnabled(mapping.TranCode) ? "tag" : "tag disabled";
        var parts = new List<string>();

        if (includeInterfaceSource)
            parts.Add($"<span class=\"{interfaceClass}\">{Html(GetInterfaceLabel(mapping.TranCode))}</span>");

        parts.Add($"<span class=\"source\">{Html(GetMappingSourceText(mapping))}</span>");

        if (includeInterfaceSource && !IsInterfaceEnabled(mapping.TranCode))
            parts.Add("<span class=\"tag\">接口已禁用</span>");

        if (!string.IsNullOrWhiteSpace(mapping.DictCode))
        {
            parts.Add($"<span class=\"tag\">字典: {Html(mapping.DictCode)}</span>");
            var dictMatchModeText = GetDictMatchModeDisplayText(mapping.DictMatchMode);
            if (!string.IsNullOrWhiteSpace(dictMatchModeText))
                parts.Add($"<span class=\"tag\">{dictMatchModeText}</span>");
        }

        if (!string.IsNullOrWhiteSpace(mapping.DefaultValue))
            parts.Add($"<span class=\"tag\">默认: {Html(mapping.DefaultValue)}</span>");
        if (!string.IsNullOrWhiteSpace(mapping.ValueExpression))
            parts.Add($"<span class=\"tag\">表达式: {Html(mapping.ValueExpression)}</span>");
        if (GetMappingFilterCount(mapping) > 0)
            parts.Add($"<span class=\"tag\">过滤: {GetMappingFilterCount(mapping)}</span>");
        if (!mapping.IsEnabled)
            parts.Add("<span class=\"tag\">映射已禁用</span>");

        return string.Join(" ", parts);
    }

    private string BuildExportMappingsText(List<EsbFieldMapping> mappings, bool includeInterfaceSource)
    {
        if (mappings.Count == 0)
            return "未配置";

        return string.Join("\n", mappings.Select(m => BuildExportMappingText(m, includeInterfaceSource)));
    }

    private string BuildExportMappingText(EsbFieldMapping mapping, bool includeInterfaceSource)
    {
        var parts = new List<string>();

        if (includeInterfaceSource)
            parts.Add(GetInterfaceLabel(mapping.TranCode));

        parts.Add(GetMappingSourceText(mapping));

        if (includeInterfaceSource && !IsInterfaceEnabled(mapping.TranCode))
            parts.Add("接口已禁用");
        if (!string.IsNullOrWhiteSpace(mapping.DictCode))
        {
            parts.Add($"字典: {mapping.DictCode}");
            var dictMatchModeText = GetDictMatchModeDisplayText(mapping.DictMatchMode);
            if (!string.IsNullOrWhiteSpace(dictMatchModeText))
                parts.Add(dictMatchModeText);
        }
        if (!string.IsNullOrWhiteSpace(mapping.DefaultValue))
            parts.Add($"默认: {mapping.DefaultValue}");
        if (!string.IsNullOrWhiteSpace(mapping.ValueExpression))
            parts.Add($"表达式: {mapping.ValueExpression}");
        if (GetMappingFilterCount(mapping) > 0)
            parts.Add($"过滤: {GetMappingFilterCount(mapping)}");
        if (!mapping.IsEnabled)
            parts.Add("映射已禁用");

        return string.Join("；", parts);
    }

    private static string Html(string? value) => System.Net.WebUtility.HtmlEncode(value ?? "");

    private static string GetDictMatchModeDisplayText(string? dictMatchMode) =>
        EsbFieldMapping.NormalizeDictMatchMode(dictMatchMode) switch
        {
            EsbFieldMapping.DictMatchModeContainsExcludeNegation => "排除否定",
            EsbFieldMapping.DictMatchModePriorityFirst => "按排序优先命中",
            _ => ""
        };

    private static string Xml(string? value) => System.Security.SecurityElement.Escape(value ?? "") ?? "";

    private static string BuildSafeFilePart(string? value)
    {
        var result = string.IsNullOrWhiteSpace(value) ? "DEFAULT" : value.Trim();
        foreach (var invalidChar in System.IO.Path.GetInvalidFileNameChars())
        {
            result = result.Replace(invalidChar, '_');
        }
        return result;
    }

    private static string BuildExcelSheetName(string? value, HashSet<string> usedSheetNames)
    {
        var name = string.IsNullOrWhiteSpace(value) ? "Sheet" : value.Trim();
        foreach (var invalidChar in new[] { ':', '\\', '/', '?', '*', '[', ']', '\'' })
        {
            name = name.Replace(invalidChar, '_');
        }

        if (name.Length > 31)
            name = name[..31];
        if (string.IsNullOrWhiteSpace(name))
            name = "Sheet";

        var baseName = name;
        var index = 2;
        while (!usedSheetNames.Add(name))
        {
            var suffix = $"_{index++}";
            var maxBaseLength = Math.Max(1, 31 - suffix.Length);
            name = (baseName.Length > maxBaseLength ? baseName[..maxBaseLength] : baseName) + suffix;
        }

        return name;
    }

