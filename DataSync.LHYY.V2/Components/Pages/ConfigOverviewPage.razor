    /// <summary>
    /// 渲染单条映射条目（标签+SourcePath+操作按钮），Patient/Event/问卷 Tab 复用
    /// </summary>
    private RenderFragment RenderMappingItem(EsbFieldMapping m) => __builder =>
    {
        <div class="mapping-item @(m.IsEnabled ? "" : "disabled-mapping")">
            <span class="mapping-tag @(IsInterfaceEnabled(m.TranCode) ? "" : "disabled-interface")">
                @GetInterfaceLabel(m.TranCode)
            </span>
            <span class="mapping-source">@GetMappingSourceText(m)</span>
            @if (!string.IsNullOrEmpty(m.DictCode))
            {
                <span class="mapping-tag">字典: @m.DictCode</span>
                @if (!string.IsNullOrWhiteSpace(GetDictMatchModeDisplayText(m.DictMatchMode)))
                {
                    <span class="mapping-tag">@GetDictMatchModeDisplayText(m.DictMatchMode)</span>
                }
            }
            @if (!string.IsNullOrEmpty(m.DefaultValue))
            {
                <span class="mapping-tag">默认: @m.DefaultValue</span>
            }
            @if (!string.IsNullOrEmpty(m.ValueExpression))
            {
                <span class="mapping-tag">表达式: @m.ValueExpression</span>
            }
            @if (GetMappingFilterCount(m) > 0)
            {
                <span class="mapping-tag">过滤: @GetMappingFilterCount(m)</span>
            }
            @if (!m.IsEnabled)
            {
                <span class="mapping-tag">已禁用</span>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           OnClick="@(() => OpenEditMapping(m))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                           Color="Color.Error" OnClick="@(() => DeleteMapping(m))" />
        </div>
    };

