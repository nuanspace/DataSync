    #region 统计与搜索

    /// <summary>
    /// 事件类型 Tab 内统计全部已映射问题数
    /// </summary>
    private (int Total, int Mapped) CountAllMappedForEventType(EventTypeTabData tab)
    {
        int total = 0, mapped = 0;
        foreach (var form in tab.FormNodes)
        {
            var (fm, ft) = CountFormMappedForEventType(form, tab);
            mapped += fm;
            total += ft;
        }
        return (total, mapped);
    }

    private (int Mapped, int Total) CountFormMappedForEventType(FormNode form, EventTypeTabData tab)
    {
        int total = 0, mapped = 0;
        foreach (var card in GetAllCardsFlat(form.Cards))
        {
            foreach (var q in card.Questions)
            {
                total++;
                var isSubCard = FindSubCardAncestor(card, form.Cards) != null;
                var target = isSubCard ? MappingTarget.SubCard : MappingTarget.Question;
                var cardId = isSubCard ? FindSubCardAncestor(card, form.Cards)?.CardId : null;
                if (GetMappingsForFieldByEventType(target, q.Id, tab, cardId).Count > 0) mapped++;
            }
        }
        foreach (var q in form.OrphanQuestions)
        {
            total++;
            if (GetMappingsForFieldByEventType(MappingTarget.Question, q.Id, tab).Count > 0) mapped++;
        }
        return (mapped, total);
    }

    private (int Mapped, int Total) CountCardMappedForEventType(CardNode card, CardNode? subCardAncestor, EventTypeTabData tab)
    {
        var isSubCard = card.CardType is "multiple" or "table";
        var currentSubCard = isSubCard ? card : subCardAncestor;
        int total = 0, mapped = 0;

        foreach (var q in card.Questions)
        {
            total++;
            var target = currentSubCard != null ? MappingTarget.SubCard : MappingTarget.Question;
            var cardId = currentSubCard?.CardId;
            if (GetMappingsForFieldByEventType(target, q.Id, tab, cardId).Count > 0) mapped++;
        }
        foreach (var sub in card.SubCards)
        {
            var (sm, st) = CountCardMappedForEventType(sub, currentSubCard, tab);
            mapped += sm;
            total += st;
        }
        return (mapped, total);
    }

    /// <summary>
    /// 在卡片树中查找某节点的 SubCard 祖先
    /// </summary>
    private static CardNode? FindSubCardAncestor(CardNode target, List<CardNode> roots)
    {
        foreach (var root in roots)
        {
            var result = FindSubCardAncestorRecursive(target, root, null);
            if (result != null) return result;
        }
        return null;
    }

    private static CardNode? FindSubCardAncestorRecursive(CardNode target, CardNode current, CardNode? subCardAncestor)
    {
        var isSubCard = current.CardType is "multiple" or "table";
        var currentSubCard = isSubCard ? current : subCardAncestor;

        if (current.CardId == target.CardId)
            return currentSubCard;

        foreach (var sub in current.SubCards)
        {
            var result = FindSubCardAncestorRecursive(target, sub, currentSubCard);
            if (result != null) return result;
        }
        return null;
    }

    private static IEnumerable<CardNode> GetAllCardsFlat(List<CardNode> cards)
    {
        foreach (var card in cards)
        {
            yield return card;
            foreach (var sub in GetAllCardsFlat(card.SubCards))
                yield return sub;
        }
    }

    /// <summary>
    /// Tab 内搜索
    /// </summary>
    private void ApplyFilterForTab(EventTypeTabData tab)
    {
        if (string.IsNullOrEmpty(tab.SearchText))
        {
            foreach (var f in tab.FormNodes)
            {
                f.IsExpanded = true;
                SetCardExpanded(f.Cards, false);
            }
            return;
        }

        var search = tab.SearchText.ToLower();
        foreach (var f in tab.FormNodes)
        {
            var formHasMatch = false;
            foreach (var card in GetAllCardsFlat(f.Cards))
            {
                var cardHasMatch = card.Questions.Any(q => MatchesSearch(q, search));
                card.IsExpanded = cardHasMatch;
                if (cardHasMatch) formHasMatch = true;
            }
            if (f.OrphanQuestions.Any(q => MatchesSearch(q, search)))
                formHasMatch = true;
            f.IsExpanded = formHasMatch;
        }
    }

    private static bool MatchesSearch(QuestionInfo q, string search)
    {
        return (q.Title?.ToLower().Contains(search) == true) ||
               q.Id.Contains(search) ||
               (q.DataType?.ToLower().Contains(search) == true);
    }

    private static void SetCardExpanded(List<CardNode> cards, bool expanded)
    {
        foreach (var card in cards)
        {
            card.IsExpanded = expanded;
            SetCardExpanded(card.SubCards, expanded);
        }
    }

