    private string FormatTargetField(EsbFieldMapping item)
    {
        if (item.MappingTarget is MappingTarget.Patient or MappingTarget.Event)
            return item.TargetField;

        // 在所有事件类型 Tab 的 FormNodes 中搜索
        var allFormNodes = _eventTypeTabs.SelectMany(t => t.FormNodes);
        var q = allFormNodes
            .SelectMany(f => f.OrphanQuestions.Concat(GetAllCardsFlat(f.Cards).SelectMany(c => c.Questions)))
            .FirstOrDefault(q => q.Id == item.TargetField);
        return q?.Title ?? item.TargetField ?? "";
    }

    private string? GetTranCodeProjectCode(string? tranCode)
    {
        if (string.IsNullOrWhiteSpace(tranCode))
        {
            return CurrentIntegrationProjectCode;
        }

        return _interfaceDict.TryGetValue(tranCode, out var config)
            ? config.IntegrationProjectCode
            : CurrentIntegrationProjectCode;
    }

