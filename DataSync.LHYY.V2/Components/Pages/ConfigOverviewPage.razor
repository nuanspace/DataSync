@page "/config/overview"
@inherits BasePage
@inject BioCoreIntegrationService BioCoreService
@inject ConfigService ConfigSvc

<PageTitle>配置总览 - LHYY V2</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">配置总览</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
               Disabled="@(_loading || _exporting)" OnClick="ExportOverviewAsync">
        导出HTML
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.TableView"
               Disabled="@(_loading || _exporting)" OnClick="ExportOverviewExcelAsync">
        导出Excel
    </MudButton>
</MudStack>

@* 概要信息 *@
<MudPaper Class="pa-3 mb-4">
    <MudStack Row="true" Spacing="4">
        <MudText><b>当前项目 LicenseCode:</b> @(_defaultLicenseCode ?? "未配置")</MudText>
        <MudText><b>已注册接口:</b> @_interfaces.Count 个</MudText>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

        @* ========== Patient 模块（共享） ========== *@
        <MudTabPanel Text="Patient（患者）" Icon="@Icons.Material.Filled.Person">
            <MudText Class="mb-2 mud-text-secondary">
                @PatientFields.Count 个字段，@GetMappedCount(MappingTarget.Patient, PatientFields.Select(f => f.Name)) 个已映射
            </MudText>
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>字段名</th>
                        <th>中文名</th>
                        <th>映射来源</th>
                        <th style="width:60px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (name, label) in PatientFields)
                    {
                        var mappings = GetMappingsForField(MappingTarget.Patient, name);
                        <tr class="@(mappings.Count > 0 ? "configured-field-row" : null)">
                            <td class="mapping-source">@name</td>
                            <td>@label</td>
                            <td>
                                @if (mappings.Count == 0)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                                               Color="Color.Primary" Variant="Variant.Text"
                                               OnClick="@(() => OpenAddMapping(MappingTarget.Patient, name))">
                                        添加映射
                                    </MudButton>
                                }
                                else
                                {
                                    @foreach (var m in mappings)
                                    {
                                        @RenderMappingItem(m)
                                    }
                                }
                            </td>
                            <td>
                                @if (mappings.Count > 0)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenAddMapping(MappingTarget.Patient, name))" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudTabPanel>

        @* ========== 按事件类型动态生成 Tab ========== *@
        @if (_eventTypeTabs.Count == 0)
        {
            <MudTabPanel Text="事件类型" Icon="@Icons.Material.Filled.Event">
                <MudAlert Severity="Severity.Info" Dense="true">产品库暂无有效事件类型</MudAlert>
            </MudTabPanel>
        }
        else
        {
            @foreach (var tab in _eventTypeTabs)
            {
                <MudTabPanel Text="@GetEventTypeTabText(tab)" Icon="@Icons.Material.Filled.Event">
                    <div class="event-type-section">
                        @if (tab.Interfaces.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">该事件类型暂无已注册接口，仅展示产品库表单。</MudAlert>
                        }
                        @* Event 字段映射 *@
                        <MudText Typo="Typo.subtitle1" Class="mb-2">
                            <b>Event 字段映射</b>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2" Style="display:inline;">
                                @EventFields.Count 个字段，@GetMappedCountForEventType(tab) 个已映射
                            </MudText>
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="mb-4">
                            <thead>
                                <tr>
                                    <th>字段名</th>
                                    <th>中文名</th>
                                    <th>映射来源</th>
                                    <th style="width:60px">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (name, label) in EventFields)
                                {
                                    var mappings = GetMappingsForFieldByEventType(MappingTarget.Event, name, tab);
                                    <tr class="@(mappings.Count > 0 ? "configured-field-row" : null)">
                                        <td class="mapping-source">@name</td>
                                        <td>@label</td>
                                        <td>
                                            @if (mappings.Count == 0)
                                            {
                                                if (tab.Interfaces.Count == 0)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">暂无接口</MudText>
                                                }
                                                else
                                                {
                                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                               Color="Color.Primary" Variant="Variant.Text"
                                                               OnClick="@(() => OpenAddMappingForEventType(MappingTarget.Event, name, tab))">
                                                        添加映射
                                                    </MudButton>
                                                }
                                            }
                                            else
                                            {
                                                @foreach (var m in mappings)
                                                {
                                                    @RenderMappingItem(m)
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (mappings.Count > 0)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                                               Color="Color.Primary"
                                                               OnClick="@(() => OpenAddMappingForEventType(MappingTarget.Event, name, tab))" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>

                        @* 表单映射 *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.subtitle1"><b>表单映射</b></MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.FactCheck"
                                       Disabled="@(tab.Interfaces.Count == 0 || tab.FormNodes.Count == 0)"
                                       OnClick="@(() => CheckAndClearMissingFormQuestions(tab))">
                                检查题目映射
                            </MudButton>
                        </MudStack>
                        @if (string.IsNullOrEmpty(tab.EffectiveLicenseCode))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">未配置 LicenseCode，无法加载问卷</MudAlert>
                        }
                        else if (tab.FormSetId == null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">未找到事件类型 "@tab.EventTypeName" 对应的 FormSet</MudAlert>
                        }
                        else if (tab.FormNodes.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">该 FormSet 下无表单问题</MudAlert>
                        }
                        else
                        {
                            var (totalQ, totalMapped) = CountAllMappedForEventType(tab);
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="3">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    共 @totalQ 个问题，@totalMapped 个已映射
                                </MudText>
                                <MudSpacer />
                                <MudTextField @bind-Value="tab.SearchText" Label="搜索问题" Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.Search"
                                              OnKeyUp="@(() => ApplyFilterForTab(tab))"
                                              Clearable="true" Style="max-width:300px;" Margin="Margin.Dense" />
                            </MudStack>
                            <MudGrid Spacing="2" Style="height:calc(100vh - 360px);min-height:500px;">
                                @* 左侧 Form 列表 *@
                                <MudItem xs="2" Style="height:100%;">
                                    <MudPaper Outlined="true" Style="height:100%;overflow-y:auto;">
                                        <MudList T="string" @bind-SelectedValue="tab.SelectedFormId" Color="Color.Primary" Dense="true">
                                            @foreach (var form in tab.FormNodes)
                                            {
                                                var (fMapped, fTotal) = CountFormMappedForEventType(form, tab);
                                                <MudListItem Value="@form.Id" Icon="@Icons.Material.Filled.Description">
                                                    <div style="display:flex;justify-content:space-between;align-items:center;width:100%;">
                                                        <MudText Typo="Typo.body2">@form.Name</MudText>
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                                 Color="@(fMapped == fTotal && fTotal > 0 ? Color.Success : Color.Default)">
                                                            @fMapped/@fTotal
                                                        </MudChip>
                                                    </div>
                                                </MudListItem>
                                            }
                                        </MudList>
                                    </MudPaper>
                                </MudItem>
                                @* 右侧 Card > Question 树 *@
                                <MudItem xs="10" Style="height:100%;">
                                    <MudPaper Outlined="true" Class="pa-2" Style="height:100%;overflow-y:auto;">
                                        @{
                                            var activeForm = tab.FormNodes.FirstOrDefault(f => f.Id == tab.SelectedFormId) ?? tab.FormNodes.FirstOrDefault();
                                        }
                                        @if (activeForm != null)
                                        {
                                            <MudTreeView T="string" Dense="true" Hover="true" ExpandOnClick="true">
                                                @foreach (var child in FormBrowserHelper.GetOrderedChildren(activeForm))
                                                {
                                                    if (child.Card != null)
                                                    {
                                                        @RenderCardWithMapping(child.Card, null, tab)
                                                    }
                                                    else if (child.Question != null)
                                                    {
                                                        @RenderQuestionWithMapping(child.Question, null, tab)
                                                    }
                                                }
                                            </MudTreeView>
                                        }
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        }
                    </div>
                </MudTabPanel>
            }
        }

    </MudTabs>
}

@* ========== 映射编辑对话框 ========== *@
<MappingEditDialog EditItem="_editItem"
                   @bind-Visible="_dialogVisible"
                   Title="@(_isEditMode ? "编辑映射" : "添加映射")"
                   JsonText="@_editSampleJson"
                   MainRecordArrayPath="@GetDialogMainRecordArrayPath()"
                   JsonTreeLayout="JsonTreeLayout.SidePanel"
                   DialogMaxWidth="MaxWidth.ExtraLarge"
                   MappingTargetEditable="false"
                   UseTargetFieldSelector="false"
                   LicenseCode="@_defaultLicenseCode"
                   TargetFieldFormatter="FormatTargetField"
                   ShowTranCode="true"
                   TranCodeReadOnly="_isEditMode"
                   TranCodeDisplayText="@GetInterfaceLabel(_editItem.TranCode)"
                   TranCodeOptions="@(_dialogInterfaceScope ?? _interfaces)"
                   TranCodeChanged="OnDialogTranCodeChanged"
                   ShowFilterRules="true"
                   FilterRules="_editFilterRules"
                   FilterRulesChanged="v => _editFilterRules = v"
                   OnSave="SaveMapping" />

@* ========== Card 级映射对话框 ========== *@
<CardMappingDialog @bind-Visible="_cardDialogVisible"
                   Card="_cardDialogCard"
                   Tab="_cardDialogTab"
                   AllMappings="_allMappings"
                   InterfaceDict="_interfaceDict"
                   OnSaved="OnCardMappingSaved" />

@code {
    // 患者字段定义（与数据库 patient 表业务字段一致）
    private static readonly List<(string Name, string Label)> PatientFields =
        PatientFieldCatalog.Definitions.Select(f => (f.Name, f.Label)).ToList();

    private static readonly List<(string Name, string Label)> EventFields =
    [
        ("event_start_time", "事件开始时间"),
        ("event_end_time", "事件结束时间"),
    ];

    // 页面状态
    private bool _loading = true;
    private bool _exporting;
    private string? _defaultLicenseCode;
    private List<EsbInterfaceConfig> _interfaces = [];
    private List<EsbFieldMapping> _allMappings = [];
    private List<EventTypeTabData> _eventTypeTabs = [];

    // 按字段分组的映射缓存
    private Dictionary<(MappingTarget, string, Guid?), List<EsbFieldMapping>> _mappingsByField = new();
    private Dictionary<int, int> _mappingFilterCounts = [];
    // 按 TranCode 快速查找接口
    private Dictionary<string, EsbInterfaceConfig> _interfaceDict = new();

    // 对话框
    private bool _dialogVisible;
    private bool _isEditMode;
    private EsbFieldMapping _editItem = new();
    private List<EsbFilterRule> _editFilterRules = [];
    private List<EsbInterfaceConfig>? _dialogInterfaceScope;
    // 对话框中的 JSON 树选取
    private string? _editSampleJson;

    // Card 级映射对话框
    private bool _cardDialogVisible;
    private CardNode? _cardDialogCard;
    private EventTypeTabData? _cardDialogTab;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadAllDataAsync();
    }

    private async Task LoadAllDataAsync()
    {
        _loading = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();

            // 当前项目配置
            _defaultLicenseCode = await ConfigSvc.GetDefaultLicenseCodeAsync(CurrentIntegrationProjectCode);
            var defaultProjectId = await ConfigSvc.GetDefaultProjectIdAsync(CurrentIntegrationProjectCode);

            // 接口列表
            _interfaces = await ApplyCurrentProjectScope(db.EsbInterfaceConfigs, false)
                .OrderBy(c => c.SortOrder)
                .ThenBy(c => c.TranCode)
                .ToListAsync();

            // 所有映射
            _allMappings = (await ApplyCurrentProjectScope(db.EsbFieldMappings, false)
                .OrderBy(m => m.SortOrder)
                .ToListAsync())
                .Where(m => !EsbFieldMapping.IsSubCardFilterMapping(m))
                .ToList();

            var mappingIds = _allMappings.Select(m => m.Id).ToList();
            _mappingFilterCounts = mappingIds.Count == 0
                ? []
                : await db.EsbFilterRules
                    .Where(r => r.MappingId != null && mappingIds.Contains(r.MappingId.Value))
                    .GroupBy(r => r.MappingId!.Value)
                    .ToDictionaryAsync(g => g.Key, g => g.Count());

            // 建立映射字典
            _mappingsByField = _allMappings
                .GroupBy(m => (m.MappingTarget, m.TargetField, m.CardId))
                .ToDictionary(g => g.Key, g => g.ToList());

            _interfaceDict = _interfaces.ToDictionary(i => i.TranCode);

            // 从当前接入项目对应的产品项目构建 Tab，接口配置只用于显示映射关系
            _eventTypeTabs = [];
            var formNodesByFormSet = new Dictionary<Guid, List<FormNode>>();
            var interfacesByEventType = _interfaces
                .Where(i => !string.IsNullOrWhiteSpace(i.EventTypeName))
                .GroupBy(i => i.EventTypeName!.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderBy(i => i.SortOrder).ThenBy(i => i.TranCode).ToList(),
                    StringComparer.OrdinalIgnoreCase);
            var productEventTypes = (await LoadCurrentProjectEventTypesAsync(defaultProjectId))
                .Where(e => IsVisibleProductEventType(e.Name))
                .ToList();

            foreach (var eventType in productEventTypes)
            {
                var matchingInterfaces = interfacesByEventType.TryGetValue(eventType.Name, out var items)
                    ? items
                    : [];
                var effectiveLicenseCode = matchingInterfaces
                    .Select(i => i.LicenseCode)
                    .FirstOrDefault(code => !string.IsNullOrWhiteSpace(code))
                    ?? _defaultLicenseCode;

                var tab = new EventTypeTabData
                {
                    EventTypeName = eventType.Name,
                    DisplayName = BuildProductEventTypeTabText(eventType),
                    Interfaces = matchingInterfaces,
                    TranCodes = new HashSet<string>(matchingInterfaces.Select(i => i.TranCode), StringComparer.OrdinalIgnoreCase),
                    EffectiveLicenseCode = effectiveLicenseCode,
                    FormSetId = eventType.FormSetId,
                };

                tab.FormNodes = await LoadFormNodesByFormSetAsync(eventType.FormSetId, formNodesByFormSet);
                tab.SelectedFormId = tab.FormNodes.FirstOrDefault()?.Id;

                _eventTypeTabs.Add(tab);
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"加载失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<List<FormNode>> LoadFormNodesByFormSetAsync(Guid formSetId, Dictionary<Guid, List<FormNode>> cache)
    {
        if (cache.TryGetValue(formSetId, out var nodes))
            return CloneFormNodes(nodes);

        var questionDict = await BioCoreService.GetFormQuestionDictByFormSetAsync(formSetId);
        var questions = questionDict.Values
            .Select(FormBrowserHelper.BuildQuestionInfo)
            .ToList();
        var cards = await BioCoreService.GetAllCardListByFormSetAsync(formSetId);
        var formInfo = await BioCoreService.GetFormListByFormSetAsync(formSetId);
        nodes = FormBrowserHelper.BuildTree(questions, cards, formInfo);
        cache[formSetId] = nodes;
        return CloneFormNodes(nodes);
    }

    private async Task<List<ProductEventTypeInfo>> LoadCurrentProjectEventTypesAsync(string? defaultProjectId)
    {
        var result = new List<ProductEventTypeInfo>();
        var seen = new HashSet<(string Name, Guid FormSetId)>();

        if (Guid.TryParse(defaultProjectId, out var projectId))
        {
            AddUniqueEventTypes(result, seen, await BioCoreService.GetEventTypesByProjectAsync(projectId));
        }

        var licenseCodes = _interfaces
            .Select(i => i.LicenseCode)
            .Append(_defaultLicenseCode)
            .Where(code => !string.IsNullOrWhiteSpace(code))
            .Select(code => code!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var licenseCode in licenseCodes)
        {
            AddUniqueEventTypes(result, seen, await BioCoreService.GetProductEventTypesByLicenseAsync(licenseCode));
        }

        return result
            .OrderBy(e => e.ProjectName)
            .ThenBy(e => e.Group)
            .ThenBy(e => e.Name)
            .ThenBy(e => e.FormSetName)
            .ToList();
    }

    private static void AddUniqueEventTypes(
        List<ProductEventTypeInfo> result,
        HashSet<(string Name, Guid FormSetId)> seen,
        IEnumerable<ProductEventTypeInfo> items)
    {
        foreach (var item in items)
        {
            if (seen.Add((item.Name, item.FormSetId)))
                result.Add(item);
        }
    }

    private static List<FormNode> CloneFormNodes(List<FormNode> nodes) =>
        nodes.Select(CloneFormNode).ToList();

    private static FormNode CloneFormNode(FormNode source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        SortIndex = source.SortIndex,
        IsExpanded = source.IsExpanded,
        QuestionCount = source.QuestionCount,
        Cards = source.Cards.Select(CloneCardNode).ToList(),
        OrphanQuestions = source.OrphanQuestions.ToList(),
    };

    private static CardNode CloneCardNode(CardNode source) => new()
    {
        CardId = source.CardId,
        Name = source.Name,
        CardType = source.CardType,
        PreUid = source.PreUid,
        IsExpanded = source.IsExpanded,
        SubCards = source.SubCards.Select(CloneCardNode).ToList(),
        Questions = source.Questions.ToList(),
    };

    private static string BuildProductEventTypeTabText(ProductEventTypeInfo eventType) => eventType.Name;

    private static string GetEventTypeTabText(EventTypeTabData tab) =>
        string.IsNullOrWhiteSpace(tab.DisplayName) ? tab.EventTypeName : tab.DisplayName;

    private static bool IsVisibleProductEventType(string eventTypeName) =>
        eventTypeName is "住院" or "手术";

    #region 导出

    private async Task ExportOverviewAsync()
    {
        await DownloadOverviewAsync("html", "text/html;charset=utf-8", BuildOverviewExportHtml);
    }

    private async Task ExportOverviewExcelAsync()
    {
        await DownloadOverviewAsync("xls", "application/vnd.ms-excel;charset=utf-8", BuildOverviewExcelXml);
    }

    private async Task DownloadOverviewAsync(string extension, string contentType, Func<bool, string> contentFactory)
    {
        if (_loading || _exporting)
            return;

        var includeMappingSource = await ConfirmIncludeMappingSourceAsync();
        _exporting = true;
        try
        {
            var content = contentFactory(includeMappingSource);
            var fileName = $"配置总览_{BuildSafeFilePart(CurrentIntegrationProjectCode)}_{DateTime.Now:yyyyMMddHHmmss}.{extension}";
            await inj_jsRuntime.InvokeVoidAsync("dataSync.downloadFile", fileName, "\uFEFF" + content, contentType);
            inj_snackbar.Add("导出成功", Severity.Success);
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"导出失败: {ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task<bool> ConfirmIncludeMappingSourceAsync()
    {
        var confirmed = await inj_dialogService.ShowMessageBox(
            "导出选项",
            "是否导出映射来源？包含时会显示来源路径和使用的接口。",
            yesText: "包含映射来源",
            cancelText: "不包含映射来源");

        return confirmed == true;
    }

    private string BuildOverviewExportHtml(bool includeInterfaceSource)
    {
        var sb = new System.Text.StringBuilder();
        var patientMappedCount = GetMappedCount(MappingTarget.Patient, PatientFields.Select(f => f.Name));

        sb.AppendLine("<!DOCTYPE html>");
        sb.AppendLine("<html lang=\"zh-CN\">");
        sb.AppendLine("<head>");
        sb.AppendLine("<meta charset=\"utf-8\">");
        sb.AppendLine("<title>配置总览</title>");
        sb.AppendLine("<style>");
        sb.AppendLine("body{font-family:\"Microsoft YaHei\",Arial,sans-serif;color:#102033;margin:24px;background:#f7fafc;}");
        sb.AppendLine("h1{font-size:24px;margin:0 0 12px;}h2{font-size:18px;margin:28px 0 10px;}h3{font-size:15px;margin:16px 0 8px;}");
        sb.AppendLine(".summary{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:16px;color:#425466;}.summary span{background:#fff;border:1px solid #dce5ec;border-radius:6px;padding:8px 10px;}");
        sb.AppendLine("table{width:100%;border-collapse:collapse;background:#fff;margin-bottom:16px;}th,td{border:1px solid #dce5ec;padding:7px 8px;text-align:left;vertical-align:top;font-size:13px;}th{background:#edf3f8;}");
        sb.AppendLine(".configured{background:#fff8d8;box-shadow:inset 4px 0 0 #c47a1f;}.status{font-weight:700;color:#9a5b00;}.muted{color:#789;}.source{font-family:Consolas,\"Courier New\",monospace;}");
        sb.AppendLine(".tag{display:inline-block;background:#eef3f7;border-radius:4px;padding:1px 6px;margin:0 4px 4px 0;color:#425466;}.disabled{text-decoration:line-through;color:#8a97a3;}");
        sb.AppendLine("</style>");
        sb.AppendLine("</head>");
        sb.AppendLine("<body>");
        sb.AppendLine("<h1>配置总览</h1>");
        sb.AppendLine("<div class=\"summary\">");
        sb.Append("<span>当前项目：").Append(Html(CurrentIntegrationProjectCode)).AppendLine("</span>");
        sb.Append("<span>LicenseCode：").Append(Html(_defaultLicenseCode ?? "未配置")).AppendLine("</span>");
        sb.Append("<span>已注册接口：").Append(_interfaces.Count).AppendLine(" 个</span>");
        sb.Append("<span>导出时间：").Append(Html(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"))).AppendLine("</span>");
        sb.AppendLine("</div>");

        sb.Append("<h2>Patient（患者）</h2>");
        sb.Append("<p>").Append(PatientFields.Count).Append(" 个字段，").Append(patientMappedCount).AppendLine(" 个已配置</p>");
        AppendFieldExportTable(sb, PatientFields, field => GetMappingsForField(MappingTarget.Patient, field), includeInterfaceSource);

        foreach (var tab in _eventTypeTabs)
        {
            sb.Append("<h2>").Append(Html(GetEventTypeTabText(tab))).AppendLine("</h2>");
            sb.Append("<p>接口：").Append(Html(string.Join("，", tab.Interfaces.Select(i => GetInterfaceLabel(i.TranCode)))));
            sb.Append("；LicenseCode：").Append(Html(tab.EffectiveLicenseCode ?? "未配置")).AppendLine("</p>");

            sb.Append("<h3>Event 字段映射</h3>");
            sb.Append("<p>").Append(EventFields.Count).Append(" 个字段，").Append(GetMappedCountForEventType(tab)).AppendLine(" 个已配置</p>");
            AppendFieldExportTable(sb, EventFields, field => GetMappingsForFieldByEventType(MappingTarget.Event, field, tab), includeInterfaceSource);

            sb.AppendLine("<h3>表单映射</h3>");
            if (string.IsNullOrWhiteSpace(tab.EffectiveLicenseCode))
            {
                sb.AppendLine("<p class=\"muted\">未配置 LicenseCode，无法加载问卷。</p>");
            }
            else if (tab.FormSetId == null)
            {
                sb.Append("<p class=\"muted\">未找到事件类型 ").Append(Html(tab.EventTypeName)).AppendLine(" 对应的 FormSet。</p>");
            }
            else if (tab.FormNodes.Count == 0)
            {
                sb.AppendLine("<p class=\"muted\">该 FormSet 下无表单问题。</p>");
            }
            else
            {
                var (totalQ, totalMapped) = CountAllMappedForEventType(tab);
                sb.Append("<p>共 ").Append(totalQ).Append(" 个问题，").Append(totalMapped).AppendLine(" 个已配置</p>");
                AppendQuestionExportTable(sb, tab, includeInterfaceSource);
            }
        }

        sb.AppendLine("</body>");
        sb.AppendLine("</html>");
        return sb.ToString();
    }

