    private void OpenAddMapping(MappingTarget target, string targetField, Guid? cardId = null)
    {
        _isEditMode = false;
        _dialogInterfaceScope = null;
        _editFilterRules = [];
        _editSampleJson = null;
        _editItem = new EsbFieldMapping
        {
            MappingTarget = target,
            TargetField = targetField,
            CardId = cardId,
            IsEnabled = true,
        };
        _dialogVisible = true;
    }

    /// <summary>
    /// 事件类型 Tab 内添加映射，限定接口范围
    /// </summary>
    private void OpenAddMappingForEventType(MappingTarget target, string targetField, EventTypeTabData tab, Guid? cardId = null)
    {
        if (tab.Interfaces.Count == 0)
        {
            inj_snackbar.Add("该事件类型暂无已注册接口，不能添加映射", Severity.Warning);
            return;
        }

        _isEditMode = false;
        _dialogInterfaceScope = tab.Interfaces;
        _editFilterRules = [];
        _editSampleJson = null;
        _editItem = new EsbFieldMapping
        {
            MappingTarget = target,
            TargetField = targetField,
            CardId = cardId,
            IsEnabled = true,
        };
        _dialogVisible = true;
    }

    private async Task OpenEditMapping(EsbFieldMapping mapping)
    {
        _isEditMode = true;
        _dialogInterfaceScope = null;
        _editSampleJson = _interfaceDict.TryGetValue(mapping.TranCode, out var ic) ? ic.SampleJson : null;

        // 加载映射级过滤规则
        await using var db2 = await ContextFactory.CreateDbContextAsync();
        _editFilterRules = await db2.EsbFilterRules
            .Where(r => r.MappingId == mapping.Id)
            .OrderBy(r => r.RuleGroup)
            .ThenBy(r => r.SortOrder)
            .ToListAsync();

        _editItem = new EsbFieldMapping
        {
            Id = mapping.Id,
            TranCode = mapping.TranCode,
            MappingTarget = mapping.MappingTarget,
            TargetField = mapping.TargetField,
            CardId = mapping.CardId,
            SourcePath = mapping.SourcePath,
            ArrayPath = mapping.ArrayPath,
            DictCode = mapping.DictCode,
            DictMatchMode = EsbFieldMapping.NormalizeDictMatchMode(mapping.DictMatchMode),
            DefaultValue = mapping.DefaultValue,
            ValueExpression = mapping.ValueExpression,
            IsRequired = mapping.IsRequired,
            IsEnabled = mapping.IsEnabled,
            SortOrder = mapping.SortOrder,
            Description = mapping.Description,
            IntegrationProjectCode = mapping.IntegrationProjectCode,
        };
        _dialogVisible = true;
    }

    private async Task DeleteMapping(EsbFieldMapping mapping)
    {
        var confirmed = await inj_dialogService.ShowMessageBox(
            "确认删除",
            $"确定要删除 {GetInterfaceLabel(mapping.TranCode)} → {mapping.TargetField} 的映射吗？",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true) return;

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var entity = await db.EsbFieldMappings.FindAsync(mapping.Id);
            if (entity != null)
            {
                var rules = await db.EsbFilterRules
                    .Where(r => r.MappingId == mapping.Id)
                    .ToListAsync();
                db.EsbFilterRules.RemoveRange(rules);
                db.EsbFieldMappings.Remove(entity);
                await db.SaveChangesAsync();
                inj_snackbar.Add("删除成功", Severity.Success);
                await LoadAllDataAsync();
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveMapping()
    {
        if (string.IsNullOrWhiteSpace(_editItem.TranCode))
        {
            inj_snackbar.Add("请选择接口", Severity.Warning);
            return;
        }
        if (!HasValueSource(_editItem))
        {
            inj_snackbar.Add("源路径和默认值不能同时为空", Severity.Warning);
            return;
        }

        if (_editItem.MappingTarget != MappingTarget.SubCard)
        {
            if (MessageJsonHelper.TryNormalizeMainRecordRelativeSourcePath(_editItem.SourcePath, GetDialogMainRecordArrayPath(), out var normalizedSourcePath))
            {
                _editItem.SourcePath = normalizedSourcePath;
            }

            foreach (var rule in _editFilterRules)
            {
                if (MessageJsonHelper.TryNormalizeMainRecordRelativeSourcePath(rule.SourcePath, GetDialogMainRecordArrayPath(), out var normalizedRulePath))
                {
                    rule.SourcePath = normalizedRulePath;
                }
            }
        }

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            if (_isEditMode)
            {
                var entity = await db.EsbFieldMappings.FindAsync(_editItem.Id);
                if (entity != null)
                {
                    entity.SourcePath = _editItem.SourcePath;
                    entity.ArrayPath = _editItem.ArrayPath;
                    entity.DictCode = _editItem.DictCode;
                    entity.DictMatchMode = EsbFieldMapping.NormalizeDictMatchMode(_editItem.DictMatchMode);
                    entity.DefaultValue = _editItem.DefaultValue;
                    entity.ValueExpression = _editItem.ValueExpression;
                    entity.IsEnabled = _editItem.IsEnabled;
                    entity.IsRequired = _editItem.IsRequired;
                    entity.SortOrder = _editItem.SortOrder;
                    entity.Description = _editItem.Description;
                    entity.IntegrationProjectCode = _editItem.IntegrationProjectCode;
                    await db.SaveChangesAsync();
                }
            }
            else
            {
                _editItem.IntegrationProjectCode = GetTranCodeProjectCode(_editItem.TranCode);
                db.EsbFieldMappings.Add(_editItem);
                await db.SaveChangesAsync();
            }

            // 同步映射级过滤规则
            var oldRules = await db.EsbFilterRules
                .Where(r => r.MappingId == _editItem.Id)
                .ToListAsync();
            db.EsbFilterRules.RemoveRange(oldRules);
            foreach (var rule in _editFilterRules)
            {
                rule.Id = 0;
                rule.TranCode = _editItem.TranCode;
                rule.MappingId = _editItem.Id;
                rule.IntegrationProjectCode = _editItem.IntegrationProjectCode;
                rule.RuleGroup = Math.Max(1, rule.RuleGroup);
                db.EsbFilterRules.Add(rule);
            }
            await db.SaveChangesAsync();
            _dialogVisible = false;
            inj_snackbar.Add("保存成功", Severity.Success);
            await LoadAllDataAsync();
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
    }

