@page "/config/filters"
@inherits BasePage

<PageTitle>过滤规则 - LHYY V2</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">过滤规则</MudText>

<MudGrid>
    <MudItem xs="12" sm="3">
        <MudSelect T="string" Label="接口代码" Value="_selectedTranCode" ValueChanged="OnTranCodeChanged" Clearable="true">
            @foreach (var tc in _tranCodes)
            {
                <MudSelectItem Value="@tc.TranCode">@tc.TranCode - @tc.TranName</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudSelect T="string" Label="挂载层级" Value="_selectedScope" ValueChanged="OnScopeChanged" Clearable="true">
            <MudSelectItem T="string" Value="@("interface")">接口级</MudSelectItem>
            <MudSelectItem T="string" Value="@("mapping")">映射级</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" Class="d-flex align-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddNew" Disabled="@string.IsNullOrEmpty(_selectedTranCode)">
            新增规则
        </MudButton>
    </MudItem>
</MudGrid>

<MudTable Items="_items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="_loading" Class="mt-4">
    <HeaderContent>
        <MudTh>源路径</MudTh>
        <MudTh>组号</MudTh>
        <MudTh>运算符</MudTh>
        <MudTh>比较值</MudTh>
        <MudTh>作用范围</MudTh>
        <MudTh>挂载</MudTh>
        <MudTh>启用</MudTh>
        <MudTh>排序</MudTh>
        <MudTh>说明</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><MudText Typo="Typo.body2" Style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:monospace;font-size:12px;" title="@context.SourcePath">@context.SourcePath</MudText></MudTd>
        <MudTd>@context.RuleGroup</MudTd>
        <MudTd>@context.Operator</MudTd>
        <MudTd><MudText Typo="Typo.body2" Style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@context.CompareValue">@context.CompareValue</MudText></MudTd>
        <MudTd>@GetScopeName(context)</MudTd>
        <MudTd>@GetMountLabel(context)</MudTd>
        <MudTd><MudIcon Icon="@(context.IsEnabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(context.IsEnabled ? Color.Success : Color.Default)" Size="Size.Small" /></MudTd>
        <MudTd>@context.SortOrder</MudTd>
        <MudTd><MudText Typo="Typo.body2" Style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@context.Description">@context.Description</MudText></MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@* 编辑对话框 *@
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "新增过滤规则" : "编辑过滤规则")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editItem != null)
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editItem.TranCode" Label="接口代码" Required="true" Disabled="!_isNew" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_editItem.MappingId" Label="关联映射 ID（空=接口级）" />
                </MudItem>
                <MudItem xs="12">
                    <div class="d-flex align-center gap-2">
                        <MudTextField @bind-Value="_editItem.SourcePath" Label="源路径（支持 [] 数组语法）" Required="true" Style="flex:1;" />
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary"
                                       OnClick="@(() => _showJsonPicker = !_showJsonPicker)" />
                    </div>
                </MudItem>
                @if (_showJsonPicker)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_pastedJson" Label="粘贴 JSON（用于路径选取）" Lines="4"
                                      Variant="Variant.Outlined" Placeholder="粘贴 JSON 数据..." />
                        @if (!string.IsNullOrWhiteSpace(_pastedJson))
                        {
                            <MudPaper Outlined="true" Class="pa-2 mt-1" Style="max-height:250px;overflow-y:auto;">
                                <JsonTreeViewer JsonText="@_pastedJson" UseArrayBrackets="true" PreferFirstArrayItemAsRoot="true" OnPathSelected="OnPathPicked" />
                            </MudPaper>
                        }
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_editItem.Operator" Label="运算符" Required="true">
                        @foreach (var op in _operators)
                        {
                            <MudSelectItem Value="@op.Key">@op.Key — @op.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editItem.CompareValue" Label="比较值" HelperText="多值用逗号分隔(in/not_in)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int" @bind-Value="_editItem.RuleGroup" Label="组号" Min="1" />
                </MudItem>

                @if (_editItem.SourcePath.Contains("[]"))
                {
                    <MudItem xs="12" sm="6">
                        <MudSelect T="FilterScope" @bind-Value="_editItem.FilterScope" Label="作用范围">
                            <MudSelectItem Value="FilterScope.MessageCheck">消息判断（任一满足即通过）</MudSelectItem>
                            <MudSelectItem Value="FilterScope.RowFilter">行过滤（只保留满足的行）</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12" sm="4">
                    <MudCheckBox @bind-Value="_editItem.IsEnabled" Label="启用" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="_editItem.SortOrder" Label="排序" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editItem.Description" Label="说明" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogVisible = false)">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">保存</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<EsbFilterRule> _items = [];
    private List<EsbInterfaceConfig> _tranCodes = [];
    private EsbFilterRule? _editItem;
    private string? _selectedTranCode;
    private string? _selectedScope;
    private bool _loading;
    private bool _dialogVisible;
    private bool _isNew;
    private bool _showJsonPicker;
    private string? _pastedJson;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private static readonly Dictionary<string, string> _operators = new()
    {
        ["eq"] = "等于",
        ["neq"] = "不等于",
        ["contains"] = "包含",
        ["not_contains"] = "不包含",
        ["starts_with"] = "以…开头",
        ["ends_with"] = "以…结尾",
        ["in"] = "在列表中",
        ["not_in"] = "不在列表中",
        ["gt"] = "大于",
        ["lt"] = "小于",
        ["gte"] = "大于等于",
        ["lte"] = "小于等于",
        ["is_empty"] = "为空",
        ["is_not_empty"] = "不为空",
        ["regex"] = "正则匹配",
    };

    protected override async Task OnPageInitializedAsync()
    {
        await LoadTranCodesAsync();
    }

    private async Task LoadTranCodesAsync()
    {
        await using var db = await ContextFactory.CreateDbContextAsync();
        var scopedInterfaces = await ApplyCurrentProjectScope(db.EsbInterfaceConfigs)
            .OrderByDescending(c => c.IntegrationProjectCode == CurrentIntegrationProjectCode)
            .ThenBy(c => c.TranCode)
            .ToListAsync();
        _tranCodes = SelectEffectiveProjectItems(scopedInterfaces, item => item.TranCode, item => item.IntegrationProjectCode)
            .OrderBy(c => c.TranCode)
            .ToList();
    }

    private async Task OnTranCodeChanged(string value)
    {
        _selectedTranCode = value;
        await LoadDataAsync();
    }

    private async Task OnScopeChanged(string value)
    {
        _selectedScope = value;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var query = ApplyCurrentProjectScope(db.EsbFilterRules);

            if (!string.IsNullOrEmpty(_selectedTranCode))
                query = query.Where(r => r.TranCode == _selectedTranCode);

            if (_selectedScope == "interface")
                query = query.Where(r => r.MappingId == null);
            else if (_selectedScope == "mapping")
                query = query.Where(r => r.MappingId != null);

            var scopedRules = await query
                .OrderByDescending(r => r.IntegrationProjectCode == CurrentIntegrationProjectCode)
                .ThenBy(r => r.TranCode)
                .ThenBy(r => r.MappingId)
                .ThenBy(r => r.RuleGroup)
                .ThenBy(r => r.SortOrder)
                .ToListAsync();

            _items = scopedRules
                .GroupBy(r => new { r.TranCode, r.MappingId })
                .SelectMany(group =>
                {
                    var currentProjectRules = group
                        .Where(r => string.Equals(r.IntegrationProjectCode, CurrentIntegrationProjectCode, StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    return currentProjectRules.Count > 0
                        ? currentProjectRules
                        : group.Where(r => r.IntegrationProjectCode == null);
                })
                .OrderBy(r => r.TranCode)
                .ThenBy(r => r.MappingId)
                .ThenBy(r => r.RuleGroup)
                .ThenBy(r => r.SortOrder)
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void AddNew()
    {
        _editItem = new EsbFilterRule
        {
            TranCode = _selectedTranCode ?? "",
            RuleGroup = 1,
            IsEnabled = true,
            IntegrationProjectCode = GetTranCodeProjectCode(_selectedTranCode),
        };
        _showJsonPicker = false;
        _pastedJson = null;
        _isNew = true;
        _dialogVisible = true;
    }

    private void Edit(EsbFilterRule item)
    {
        _editItem = new EsbFilterRule
        {
            Id = item.Id,
            TranCode = item.TranCode,
            SourcePath = item.SourcePath,
            RuleGroup = item.RuleGroup,
            Operator = item.Operator,
            CompareValue = item.CompareValue,
            MappingId = item.MappingId,
            FilterScope = item.FilterScope,
            IsEnabled = item.IsEnabled,
            SortOrder = item.SortOrder,
            Description = item.Description,
            IntegrationProjectCode = item.IntegrationProjectCode,
        };
        _showJsonPicker = false;
        _pastedJson = null;
        _isNew = false;
        _dialogVisible = true;
    }

    private void OnPathPicked(string path)
    {
        if (_editItem != null)
        {
            _editItem.SourcePath = path;
            _showJsonPicker = false;
            StateHasChanged();
        }
    }

    private async Task Save()
    {
        if (_editItem == null || string.IsNullOrWhiteSpace(_editItem.TranCode)
            || string.IsNullOrWhiteSpace(_editItem.SourcePath))
        {
            inj_snackbar.Add("接口代码和源路径不能为空", Severity.Warning);
            return;
        }

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            _editItem.RuleGroup = Math.Max(1, _editItem.RuleGroup);

            if (_isNew)
            {
                _editItem.IntegrationProjectCode = GetTranCodeProjectCode(_editItem.TranCode);
                db.EsbFilterRules.Add(_editItem);
            }
            else
            {
                var existing = await db.EsbFilterRules.FindAsync(_editItem.Id);
                if (existing != null)
                {
                    existing.SourcePath = _editItem.SourcePath;
                    existing.RuleGroup = Math.Max(1, _editItem.RuleGroup);
                    existing.Operator = _editItem.Operator;
                    existing.CompareValue = _editItem.CompareValue;
                    existing.MappingId = _editItem.MappingId;
                    existing.FilterScope = _editItem.FilterScope;
                    existing.IsEnabled = _editItem.IsEnabled;
                    existing.SortOrder = _editItem.SortOrder;
                    existing.Description = _editItem.Description;
                    existing.IntegrationProjectCode = _editItem.IntegrationProjectCode;
                }
            }

            await db.SaveChangesAsync();
            _dialogVisible = false;
            inj_snackbar.Add("保存成功", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
    }

    private async Task Delete(EsbFilterRule item)
    {
        var confirmed = await inj_dialogService.ShowMessageBox("确认删除",
            $"确定要删除此过滤规则吗？\n{item.SourcePath} {item.Operator} {item.CompareValue}",
            yesText: "删除", cancelText: "取消");

        if (confirmed != true) return;

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var entity = await db.EsbFilterRules.FindAsync(item.Id);
            if (entity != null)
            {
                db.EsbFilterRules.Remove(entity);
                await db.SaveChangesAsync();
                inj_snackbar.Add("删除成功", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private static string GetScopeName(EsbFilterRule rule)
    {
        if (!rule.SourcePath.Contains("[]")) return "-";
        return rule.FilterScope == FilterScope.RowFilter ? "行过滤" : "消息判断";
    }

    private static string GetMountLabel(EsbFilterRule rule)
    {
        return rule.MappingId.HasValue ? $"映射:{rule.MappingId}" : "接口级";
    }

    private string? GetTranCodeProjectCode(string? tranCode)
    {
        if (string.IsNullOrWhiteSpace(tranCode))
        {
            return CurrentIntegrationProjectCode;
        }

        return _selectedTranCode == tranCode && !string.IsNullOrWhiteSpace(_editItem?.IntegrationProjectCode)
            ? _editItem!.IntegrationProjectCode
            : _tranCodes.FirstOrDefault(c => c.TranCode == tranCode)?.IntegrationProjectCode ?? CurrentIntegrationProjectCode;
    }
}
