@page "/config/dicts"
@inherits BasePage

<PageTitle>数据字典 - LHYY V2</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">数据字典</MudText>

<MudGrid>
    <MudItem xs="12" sm="3">
        <MudSelect T="string" Label="字典范围" Value="_selectedScope" ValueChanged="OnScopeChanged">
            <MudSelectItem Value="@ProjectScopeKey">项目级</MudSelectItem>
            <MudSelectItem Value="@GlobalScopeKey">全局级</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudSelect T="string" Label="字典代码" Value="_selectedDictCode" ValueChanged="OnDictCodeChanged" Clearable="true">
            @foreach (var dc in _dictCodes)
            {
                <MudSelectItem Value="@dc">@dc</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudTextField @bind-Value="_newDictCode" Label="新建字典代码" />
    </MudItem>
    <MudItem xs="12" sm="3" Class="d-flex align-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddNew" Disabled="@(string.IsNullOrEmpty(_selectedDictCode) && string.IsNullOrEmpty(_newDictCode))">
            新增条目
        </MudButton>
    </MudItem>
</MudGrid>

<MudTable Items="_items" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="_loading" Class="mt-4">
    <HeaderContent>
        <MudTh>字典代码</MudTh>
        <MudTh>范围</MudTh>
        <MudTh>源值</MudTh>
        <MudTh>目标值</MudTh>
        <MudTh>排序</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.DictCode</MudTd>
        <MudTd>@GetScopeDisplayName(context.IntegrationProjectCode)</MudTd>
        <MudTd>@context.SourceValue</MudTd>
        <MudTd>@context.TargetValue</MudTd>
        <MudTd>@context.SortOrder</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                           Disabled="@(!CanMove(context, -1))" OnClick="@(() => Move(context, -1))" />
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                           Disabled="@(!CanMove(context, 1))" OnClick="@(() => Move(context, 1))" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Edit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions" Class="dict-entry-dialog"
           Style="width:min(1120px, calc(100vw - 64px));max-width:min(1120px, calc(100vw - 64px));">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "新增字典条目" : "编辑字典条目")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_editItem != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editItem.DictCode" Label="字典代码" Required="true" Disabled="!_isNew" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Value="@GetScopeDisplayName(_editItem.IntegrationProjectCode)" Label="范围" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editItem.TargetValue" Label="目标值" Required="true" Lines="3" />
                </MudItem>
                <MudItem xs="12">
                    <div class="dict-condition-list">
                        @for (var conditionIndex = 0; conditionIndex < _editConditions.Count; conditionIndex++)
                        {
                            var condIndex = conditionIndex;
                            var condition = _editConditions[condIndex];
                            @if (condIndex > 0)
                            {
                                <div class="dict-condition-divider">或</div>
                            }
                            <div class="dict-condition">
                                <div class="dict-keyword-list">
                                    @for (var keywordIndex = 0; keywordIndex < condition.Keywords.Count; keywordIndex++)
                                    {
                                        var keyIndex = keywordIndex;
                                        @if (keyIndex == 0)
                                        {
                                            <div class="dict-keyword-row dict-keyword-row-main">
                                                <MudSelect T="string" Value="condition.MatchMode" ValueChanged="v => condition.MatchMode = v"
                                                           Margin="Margin.Dense" Variant="Variant.Outlined">
                                                    <MudSelectItem Value="@DictExpressionHelper.MatchModeAll">全部包含</MudSelectItem>
                                                    <MudSelectItem Value="@DictExpressionHelper.MatchModeAny">任一包含</MudSelectItem>
                                                </MudSelect>
                                                <MudTextField T="string" Value="@condition.Keywords[keyIndex]" ValueChanged="@((string? v) => condition.Keywords[keyIndex] = v)"
                                                              Placeholder="关键词" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                               Color="Color.Error" Disabled="@(condition.Keywords.Count <= 1)"
                                                               OnClick="@(() => RemoveEditKeyword(condition, keyIndex))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small"
                                                               Color="Color.Error" Disabled="@(_editConditions.Count <= 1)"
                                                               OnClick="@(() => RemoveEditCondition(condIndex))" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="dict-keyword-row dict-keyword-row-sub">
                                                <span class="dict-keyword-operator">@GetKeywordJoinText(condition.MatchMode)</span>
                                                <MudTextField T="string" Value="@condition.Keywords[keyIndex]" ValueChanged="@((string? v) => condition.Keywords[keyIndex] = v)"
                                                              Placeholder="关键词" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                               Color="Color.Error" OnClick="@(() => RemoveEditKeyword(condition, keyIndex))" />
                                            </div>
                                        }
                                    }
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => AddEditKeyword(condition))">
                                        新增关键词
                                    </MudButton>
                                </div>
                            </div>
                        }
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddEditCondition">
                            新增条件
                        </MudButton>
                    </div>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dialogVisible = false)">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">保存</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string ProjectScopeKey = "project";
    private const string GlobalScopeKey = "global";

    private List<EsbDict> _items = [];
    private List<string> _dictCodes = [];
    private EsbDict? _editItem;
    private string _selectedScope = ProjectScopeKey;
    private string? _selectedDictCode;
    private string? _newDictCode;
    private bool _loading;
    private bool _dialogVisible;
    private bool _isNew;
    private List<DictConditionEditItem> _editConditions = [new()];
    private List<int> _editOriginalIds = [];
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };

    private sealed class DictConditionEditItem
    {
        public int? Id { get; set; }
        public int SortOrder { get; set; }
        public string MatchMode { get; set; } = DictExpressionHelper.MatchModeAll;
        public List<string?> Keywords { get; set; } = [null];
    }

    protected override async Task OnPageInitializedAsync()
    {
        await LoadDictCodesAsync();
        await LoadDataAsync();
    }

    private async Task OnScopeChanged(string value)
    {
        _selectedScope = value;
        _selectedDictCode = null;
        await LoadDictCodesAsync();
        await LoadDataAsync();
    }

    private async Task LoadDictCodesAsync()
    {
        await using var db = await ContextFactory.CreateDbContextAsync();
        _dictCodes = await GetScopeQuery(db.EsbDicts)
            .Select(d => d.DictCode)
            .Distinct()
            .OrderBy(c => c)
            .ToListAsync();
    }

    private async Task OnDictCodeChanged(string value)
    {
        _selectedDictCode = value;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var query = GetScopeQuery(db.EsbDicts);

            if (!string.IsNullOrEmpty(_selectedDictCode))
                query = query.Where(d => d.DictCode == _selectedDictCode);

            _items = await query
                .OrderBy(d => d.DictCode)
                .ThenBy(d => d.SortOrder)
                .ThenBy(d => d.SourceValue)
                .ToListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private IQueryable<EsbDict> GetScopeQuery(IQueryable<EsbDict> query)
    {
        return _selectedScope == GlobalScopeKey
            ? query.Where(d => d.IntegrationProjectCode == null)
            : query.Where(d => d.IntegrationProjectCode == CurrentIntegrationProjectCode);
    }

    private void AddNew()
    {
        var dictCode = !string.IsNullOrWhiteSpace(_newDictCode) ? _newDictCode.Trim() : _selectedDictCode ?? "";
        _editItem = new EsbDict
        {
            DictCode = dictCode,
            IntegrationProjectCode = GetEditingScopeCode()
        };
        _editConditions = [new DictConditionEditItem()];
        _editOriginalIds = [];
        _isNew = true;
        _dialogVisible = true;
    }

    private void Edit(EsbDict item)
    {
        _editItem = new EsbDict
        {
            Id = item.Id,
            DictCode = item.DictCode,
            IntegrationProjectCode = item.IntegrationProjectCode,
            SourceValue = item.SourceValue,
            TargetValue = item.TargetValue,
            SortOrder = item.SortOrder,
        };
        var groupItems = _items
            .Where(d => d.DictCode == item.DictCode
                && IsSameScope(d.IntegrationProjectCode, item.IntegrationProjectCode)
                && string.Equals(d.TargetValue, item.TargetValue, StringComparison.OrdinalIgnoreCase))
            .OrderBy(d => d.SortOrder)
            .ThenBy(d => d.Id)
            .ToList();

        _editConditions = groupItems.Count == 0
            ? [BuildEditCondition(item)]
            : groupItems.Select(BuildEditCondition).ToList();
        _editOriginalIds = _editConditions.Where(c => c.Id.HasValue).Select(c => c.Id!.Value).ToList();
        _isNew = false;
        _dialogVisible = true;
    }

    private static DictConditionEditItem BuildEditCondition(EsbDict item)
    {
        var (matchMode, _) = DictExpressionHelper.ParseSourceValue(item.SourceValue);
        return new DictConditionEditItem
        {
            Id = item.Id,
            SortOrder = item.SortOrder,
            MatchMode = matchMode,
            Keywords = DictExpressionHelper.ParseSourceValueKeywords(item.SourceValue)
        };
    }

    private async Task Save()
    {
        var conditions = BuildEditConditionsForSave();
        if (_editItem == null || string.IsNullOrWhiteSpace(_editItem.DictCode) || string.IsNullOrWhiteSpace(_editItem.TargetValue) || conditions.Count == 0)
        {
            inj_snackbar.Add("字典代码和源值不能为空", Severity.Warning);
            return;
        }

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();

            if (_isNew)
            {
                _editItem.IntegrationProjectCode = GetEditingScopeCode();
                var nextSortOrder = await GetNextSortOrderAsync(db, _editItem.DictCode, _editItem.IntegrationProjectCode);
                foreach (var condition in conditions)
                {
                    db.EsbDicts.Add(new EsbDict
                    {
                        DictCode = _editItem.DictCode,
                        IntegrationProjectCode = _editItem.IntegrationProjectCode,
                        SourceValue = condition.SourceValue,
                        TargetValue = _editItem.TargetValue.Trim(),
                        SortOrder = nextSortOrder
                    });
                    nextSortOrder += 10;
                }
            }
            else
            {
                var existingItems = await db.EsbDicts
                    .Where(d => _editOriginalIds.Contains(d.Id))
                    .OrderBy(d => d.SortOrder)
                    .ThenBy(d => d.Id)
                    .ToListAsync();
                var existingMap = existingItems.ToDictionary(d => d.Id);
                var baseSortOrder = existingItems.Count == 0
                    ? await GetNextSortOrderAsync(db, _editItem.DictCode, _editItem.IntegrationProjectCode)
                    : existingItems.Min(d => d.SortOrder);
                var usedIds = new HashSet<int>();

                for (var i = 0; i < conditions.Count; i++)
                {
                    var condition = conditions[i];
                    if (condition.Id.HasValue && existingMap.TryGetValue(condition.Id.Value, out var existing))
                    {
                        existing.SourceValue = condition.SourceValue;
                        existing.TargetValue = _editItem.TargetValue.Trim();
                        existing.SortOrder = baseSortOrder + i;
                        usedIds.Add(existing.Id);
                    }
                    else
                    {
                        db.EsbDicts.Add(new EsbDict
                        {
                            DictCode = _editItem.DictCode,
                            IntegrationProjectCode = _editItem.IntegrationProjectCode,
                            SourceValue = condition.SourceValue,
                            TargetValue = _editItem.TargetValue.Trim(),
                            SortOrder = baseSortOrder + i
                        });
                    }
                }

                var removedItems = existingItems.Where(d => !usedIds.Contains(d.Id)).ToList();
                db.EsbDicts.RemoveRange(removedItems);
            }

            await db.SaveChangesAsync();
            inj_dictService.ClearCache(_editItem.DictCode, CurrentIntegrationProjectCode);
            _dialogVisible = false;
            _newDictCode = null;
            inj_snackbar.Add("保存成功", Severity.Success);
            await LoadDictCodesAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败: {ex.Message}", Severity.Error);
        }
    }

    private List<DictConditionSaveItem> BuildEditConditionsForSave()
    {
        var result = new List<DictConditionSaveItem>();
        foreach (var condition in _editConditions)
        {
            var sourceValue = DictExpressionHelper.BuildSourceValue(condition.Keywords, condition.MatchMode);
            if (!string.IsNullOrWhiteSpace(sourceValue))
            {
                result.Add(new DictConditionSaveItem(condition.Id, sourceValue));
            }
        }

        return result
            .GroupBy(c => c.SourceValue, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
    }

    private void AddEditCondition()
    {
        _editConditions.Add(new DictConditionEditItem());
    }

    private void RemoveEditCondition(int index)
    {
        if (_editConditions.Count <= 1 || index < 0 || index >= _editConditions.Count)
        {
            return;
        }

        _editConditions.RemoveAt(index);
    }

    private static void AddEditKeyword(DictConditionEditItem condition)
    {
        condition.Keywords.Add(null);
    }

    private static void RemoveEditKeyword(DictConditionEditItem condition, int index)
    {
        if (condition.Keywords.Count <= 1 || index < 0 || index >= condition.Keywords.Count)
        {
            return;
        }

        condition.Keywords.RemoveAt(index);
    }

    private static string GetKeywordJoinText(string? matchMode) =>
        DictExpressionHelper.NormalizeMatchMode(matchMode) == DictExpressionHelper.MatchModeAny ? "或" : "且";

    private readonly record struct DictConditionSaveItem(int? Id, string SourceValue);

    private async Task<int> GetNextSortOrderAsync(DataSyncDbContext db, string dictCode, string? integrationProjectCode)
    {
        var query = db.EsbDicts.Where(d => d.DictCode == dictCode);
        query = integrationProjectCode == null
            ? query.Where(d => d.IntegrationProjectCode == null)
            : query.Where(d => d.IntegrationProjectCode == integrationProjectCode);

        var maxSort = await query
            .Select(d => (int?)d.SortOrder)
            .MaxAsync() ?? 0;

        return maxSort + 10;
    }

    private bool CanMove(EsbDict item, int direction)
    {
        var sameDictItems = _items
            .Where(d => d.DictCode == item.DictCode && IsSameScope(d.IntegrationProjectCode, item.IntegrationProjectCode))
            .OrderBy(d => d.SortOrder)
            .ThenBy(d => d.Id)
            .ToList();

        var index = sameDictItems.FindIndex(d => d.Id == item.Id);
        var targetIndex = index + direction;
        return index >= 0 && targetIndex >= 0 && targetIndex < sameDictItems.Count;
    }

    private async Task Move(EsbDict item, int direction)
    {
        await using var db = await ContextFactory.CreateDbContextAsync();
        var query = db.EsbDicts.Where(d => d.DictCode == item.DictCode);
        query = item.IntegrationProjectCode == null
            ? query.Where(d => d.IntegrationProjectCode == null)
            : query.Where(d => d.IntegrationProjectCode == item.IntegrationProjectCode);

        var items = await query
            .OrderBy(d => d.SortOrder)
            .ThenBy(d => d.Id)
            .ToListAsync();

        var index = items.FindIndex(d => d.Id == item.Id);
        var targetIndex = index + direction;
        if (index < 0 || targetIndex < 0 || targetIndex >= items.Count)
        {
            return;
        }

        var moving = items[index];
        items.RemoveAt(index);
        items.Insert(targetIndex, moving);

        for (var i = 0; i < items.Count; i++)
        {
            items[i].SortOrder = (i + 1) * 10;
        }

        await db.SaveChangesAsync();
        inj_dictService.ClearCache(item.DictCode, CurrentIntegrationProjectCode);
        await LoadDataAsync();
    }

    private async Task Delete(EsbDict item)
    {
        var confirmed = await inj_dialogService.ShowMessageBox(
            "确认删除",
            $"确定要删除 {item.DictCode}: {item.SourceValue} -> {item.TargetValue} 吗？",
            yesText: "删除",
            cancelText: "取消");

        if (confirmed != true) return;

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            var entity = await db.EsbDicts.FindAsync(item.Id);
            if (entity != null)
            {
                db.EsbDicts.Remove(entity);
                await db.SaveChangesAsync();
                inj_dictService.ClearCache(item.DictCode, CurrentIntegrationProjectCode);
                inj_snackbar.Add("删除成功", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"删除失败: {ex.Message}", Severity.Error);
        }
    }

    private string? GetEditingScopeCode() => _selectedScope == GlobalScopeKey ? null : CurrentIntegrationProjectCode;

    private static bool IsSameScope(string? left, string? right) =>
        string.Equals(left ?? "", right ?? "", StringComparison.OrdinalIgnoreCase);

    private string GetScopeDisplayName(string? integrationProjectCode)
    {
        return string.IsNullOrWhiteSpace(integrationProjectCode)
            ? "全局级"
            : $"项目级（{integrationProjectCode}）";
    }
}
