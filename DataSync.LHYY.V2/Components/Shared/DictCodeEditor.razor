@inherits BasePage

<div class="dict-code-editor-shell">
    <MudAutocomplete T="string" Value="Value" ValueChanged="OnValueChanged"
                     Label="@Label" Margin="@Margin" Variant="@Variant"
                     SearchFunc="SearchDictCodes" Clearable="true"
                     CoerceText="false" CoerceValue="false" Strict="true" MaxItems="50"
                     HelperText="@HelperText" />
    <div class="dict-code-editor-actions">
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@DictActionIcon"
                   OnClick="OpenCreateDialog">
            @DictActionText
        </MudButton>
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public EventCallback<string> SuggestedDictMatchModeChanged { get; set; }
    [Parameter] public IEnumerable<string>? SuggestedSourceValues { get; set; }
    [Parameter] public string Label { get; set; } = "字典代码";
    [Parameter] public string HelperText { get; set; } = "搜索并选择当前项目或全局字典代码；如无可选项，可直接新建。";
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;

    private List<string> _dictCodes = [];
    private bool SelectedDictExists =>
        !string.IsNullOrWhiteSpace(Value)
        && _dictCodes.Contains(Value.Trim(), StringComparer.OrdinalIgnoreCase);

    private string DictActionText => SelectedDictExists ? "编辑字典" : "新建字典";

    private string DictActionIcon => SelectedDictExists
        ? Icons.Material.Filled.Edit
        : Icons.Material.Filled.AddCircleOutline;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadDictCodesAsync();
    }

    private async Task LoadDictCodesAsync()
    {
        await using var db = await ContextFactory.CreateDbContextAsync();
        _dictCodes = await db.EsbDicts
            .Where(d => d.IntegrationProjectCode == CurrentIntegrationProjectCode || d.IntegrationProjectCode == null)
            .Select(d => d.DictCode)
            .Distinct()
            .OrderBy(c => c)
            .ToListAsync();
    }

    private Task<IEnumerable<string>> SearchDictCodes(string? search, CancellationToken ct)
    {
        var items = _dictCodes.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            items = items.Where(code => code.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(items);
    }

    private Task OnValueChanged(string? value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["InitialDictCode"] = Value?.Trim(),
            ["SuggestedSourceValues"] = SuggestedSourceValues?.ToList(),
            ["EditExisting"] = SelectedDictExists
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await inj_dialogService.ShowAsync<DictCreateDialog>(DictActionText, parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        if (result.Data is DictCreateDialogResult createResult)
        {
            await LoadDictCodesAsync();
            await OnValueChanged(createResult.DictCode);
            if (!string.IsNullOrWhiteSpace(createResult.RecommendedMatchMode) && SuggestedDictMatchModeChanged.HasDelegate)
            {
                await SuggestedDictMatchModeChanged.InvokeAsync(createResult.RecommendedMatchMode);
            }
        }
        else if (result.Data is string dictCode)
        {
            await LoadDictCodesAsync();
            await OnValueChanged(dictCode);
        }
    }
}
