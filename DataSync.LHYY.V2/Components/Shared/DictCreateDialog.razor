@inherits BasePage

<MudDialog>
    <TitleContent>
        <div class="dict-create-title">
            <div>
                <MudText Typo="Typo.caption" Class="dict-create-kicker">字典配置</MudText>
                <MudText Typo="Typo.h6" Class="dict-create-heading">@DialogHeading</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Cancel" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="dict-create-body">
            <div class="dict-create-fields">
                <MudTextField T="string" Value="_newDictCode" ValueChanged="v => _newDictCode = v"
                              Label="DictCode（字典代码）" Required="true" Margin="Margin.Dense"
                              Variant="Variant.Outlined" Disabled="@_editExisting" />
                <MudSelect T="string" Value="_createScope" ValueChanged="v => _createScope = v"
                           Label="保存范围" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="@_editExisting">
                    <MudSelectItem Value="@ProjectScopeKey">项目级（@CurrentIntegrationProjectCode）</MudSelectItem>
                    <MudSelectItem Value="@GlobalScopeKey">全局级</MudSelectItem>
                </MudSelect>
            </div>

            <div class="dict-create-entry-header">
                <MudText Typo="Typo.subtitle2">字典条目</MudText>
                <div class="dict-create-entry-actions">
                    @if (!_editExisting)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.UploadFile"
                                   OnClick="ToggleJsonImport">
                            JSON 导入
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               OnClick="OpenTemplateDialog">
                        套用模板
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddEntry">
                        新增一行
                    </MudButton>
                </div>
            </div>

            @if (_jsonImportVisible && !_editExisting)
            {
                <div class="dict-json-import-panel">
                    <MudTextField T="string" @bind-Value="_jsonImportText"
                                  Label="粘贴简单 JSON"
                                  Placeholder="{&quot;高血压&quot;:&quot;58917EAD-6B01-45E9-8731-ACFAD2371F8B&quot;}"
                                  HelperText="key 为目标选项，value 为条件关键词；导入后仍需点击保存。"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="5" />
                    <div class="dict-json-import-actions">
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelJsonImport">取消</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="ImportJsonEntries">
                            导入条目
                        </MudButton>
                    </div>
                </div>
            }

            <div class="dict-create-table-wrap">
                <MudSimpleTable Hover="true" Class="dict-create-table">
                    <thead>
                        <tr>
                            <th class="dict-create-index-cell">序号</th>
                            <th>目标选项</th>
                            <th>命中条件</th>
                            <th class="dict-create-action-cell">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _entries.Count; i++)
                        {
                            var idx = i;
                            var entry = _entries[i];
                            <tr>
                                <td class="dict-create-index-cell">@(i + 1)</td>
                                <td>
                                    <MudTextField T="string" Value="entry.TargetValue" ValueChanged="v => entry.TargetValue = v"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                                                  AutoGrow="true" MaxLines="6" Placeholder="选项值" Class="dict-create-cell-input" />
                                </td>
                                <td>
                                    <div class="dict-create-condition-list">
                                        @for (var conditionIndex = 0; conditionIndex < entry.Conditions.Count; conditionIndex++)
                                        {
                                            var condIndex = conditionIndex;
                                            var condition = entry.Conditions[condIndex];
                                            @if (condIndex > 0)
                                            {
                                                <div class="dict-create-condition-divider">或</div>
                                            }
                                            <div class="dict-create-condition">
                                                <div class="dict-create-keyword-list">
                                                    @for (var keywordIndex = 0; keywordIndex < condition.Keywords.Count; keywordIndex++)
                                                    {
                                                        var keyIndex = keywordIndex;
                                                        @if (keyIndex == 0)
                                                        {
                                                            <div class="dict-create-keyword-row dict-create-keyword-row-main">
                                                                <MudSelect T="string" Value="condition.MatchMode" ValueChanged="v => condition.MatchMode = v"
                                                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                                                    <MudSelectItem Value="@DictExpressionHelper.MatchModeAll">全部包含</MudSelectItem>
                                                                    <MudSelectItem Value="@DictExpressionHelper.MatchModeAny">任一包含</MudSelectItem>
                                                                </MudSelect>
                                                                <MudTextField T="string" Value="@condition.Keywords[keyIndex]" ValueChanged="@((string? v) => condition.Keywords[keyIndex] = v)"
                                                                              Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="关键词" Class="dict-create-cell-input" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                                               Color="Color.Error" Disabled="@(condition.Keywords.Count <= 1)"
                                                                               OnClick="@(() => RemoveKeyword(condition, keyIndex))" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small"
                                                                               Color="Color.Error" Disabled="@(entry.Conditions.Count <= 1)"
                                                                               OnClick="@(() => RemoveCondition(entry, condIndex))" />
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="dict-create-keyword-row dict-create-keyword-row-sub">
                                                                <span class="dict-create-keyword-operator">@GetKeywordJoinText(condition.MatchMode)</span>
                                                                <MudTextField T="string" Value="@condition.Keywords[keyIndex]" ValueChanged="@((string? v) => condition.Keywords[keyIndex] = v)"
                                                                              Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="关键词" Class="dict-create-cell-input" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                                               Color="Color.Error" OnClick="@(() => RemoveKeyword(condition, keyIndex))" />
                                                            </div>
                                                        }
                                                    }
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                                               OnClick="@(() => AddKeyword(condition))">
                                                        新增关键词
                                                    </MudButton>
                                                </div>
                                            </div>
                                        }
                                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="@(() => AddCondition(entry))">
                                            新增条件
                                        </MudButton>
                                    </div>
                                </td>
                                <td class="dict-create-action-cell">
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small"
                                                   Disabled="@(idx == 0)" OnClick="@(() => MoveEntry(idx, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small"
                                                   Disabled="@(idx >= _entries.Count - 1)" OnClick="@(() => MoveEntry(idx, 1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                   Color="Color.Error" Disabled="@(_entries.Count <= 1)"
                                                   OnClick="@(() => RemoveEntry(idx))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="dict-create-hint">
            一个目标值可以配置多组条件；每组条件会保存为一条字典匹配规则。
        </MudText>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDictAsync">@SaveButtonText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string ProjectScopeKey = "project";
    private const string GlobalScopeKey = "global";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? InitialDictCode { get; set; }
    [Parameter] public IEnumerable<string>? SuggestedSourceValues { get; set; }
    [Parameter] public bool EditExisting { get; set; }

    private string? _newDictCode;
    private string _createScope = ProjectScopeKey;
    private List<DictEntryItem> _entries = [];
    private bool _editExisting;
    private string? _recommendedMatchMode;
    private bool _jsonImportVisible;
    private string? _jsonImportText;

    private string DialogHeading => _editExisting ? "编辑字典" : "新建字典";

    private string SaveButtonText => _editExisting ? "保存修改并选中" : "保存并选中";

    private sealed class DictEntryItem
    {
        public string? SourceValue { get; set; }
        public List<DictConditionItem> Conditions { get; set; } = [new()];
        public string? TargetValue { get; set; }
    }

    private sealed class DictConditionItem
    {
        public string MatchMode { get; set; } = DictExpressionHelper.MatchModeAll;
        public List<string?> Keywords { get; set; } = [null];
    }

    protected override async Task OnPageInitializedAsync()
    {
        _newDictCode = InitialDictCode?.Trim();
        if (EditExisting && !string.IsNullOrWhiteSpace(_newDictCode) && await LoadExistingDictAsync(_newDictCode))
        {
            return;
        }

        var suggestedEntries = SuggestedSourceValues?
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(v => new DictEntryItem
            {
                Conditions = [new DictConditionItem { Keywords = [v] }],
                TargetValue = v
            })
            .ToList();

        _entries = suggestedEntries is { Count: > 0 }
            ? suggestedEntries
            : [new DictEntryItem()];
    }

    private async Task<bool> LoadExistingDictAsync(string dictCode)
    {
        await using var db = await ContextFactory.CreateDbContextAsync();

        var projectItems = await db.EsbDicts
            .Where(d => d.DictCode == dictCode && d.IntegrationProjectCode == CurrentIntegrationProjectCode)
            .OrderBy(d => d.SortOrder)
            .ThenBy(d => d.Id)
            .ToListAsync();

        if (projectItems.Count > 0)
        {
            _createScope = ProjectScopeKey;
            _entries = BuildEntriesFromExistingItems(projectItems);
            _editExisting = true;
            return true;
        }

        var globalItems = await db.EsbDicts
            .Where(d => d.DictCode == dictCode && d.IntegrationProjectCode == null)
            .OrderBy(d => d.SortOrder)
            .ThenBy(d => d.Id)
            .ToListAsync();

        if (globalItems.Count == 0)
        {
            return false;
        }

        _createScope = GlobalScopeKey;
        _entries = BuildEntriesFromExistingItems(globalItems);
        _editExisting = true;
        return true;
    }

    private static List<DictEntryItem> BuildEntriesFromExistingItems(IEnumerable<EsbDict> items)
    {
        var entries = items
            .GroupBy(d => d.TargetValue, StringComparer.OrdinalIgnoreCase)
            .Select(group => new DictEntryItem
            {
                TargetValue = group.First().TargetValue,
                Conditions = group.Select(BuildConditionFromExistingItem).ToList()
            })
            .ToList();

        return entries.Count == 0 ? [new DictEntryItem()] : entries;
    }

    private static DictConditionItem BuildConditionFromExistingItem(EsbDict item)
    {
        var (matchMode, _) = DictExpressionHelper.ParseSourceValue(item.SourceValue);
        return new DictConditionItem
        {
            MatchMode = matchMode,
            Keywords = DictExpressionHelper.ParseSourceValueKeywords(item.SourceValue)
        };
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task OpenTemplateDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await inj_dialogService.ShowAsync<DictTemplateSelectDialog>("套用字典模板", new DialogParameters(), options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: DictTemplateApplyResult template })
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_newDictCode) && !string.IsNullOrWhiteSpace(template.DefaultDictCode))
        {
            _newDictCode = template.DefaultDictCode.Trim();
        }

        _recommendedMatchMode = EsbFieldMapping.NormalizeDictMatchMode(template.DefaultMatchMode);
        var templateEntries = BuildEntriesFromTemplate(template.Items);
        ApplyTemplateEntries(templateEntries, template.ApplyMode);
        inj_snackbar.Add($"已套用模板“{template.TemplateName}”。", Severity.Success);
    }

    private void AddEntry()
    {
        _entries.Add(new DictEntryItem());
    }

    private void ToggleJsonImport()
    {
        _jsonImportVisible = !_jsonImportVisible;
    }

    private void CancelJsonImport()
    {
        _jsonImportVisible = false;
        _jsonImportText = null;
    }

    private void ImportJsonEntries()
    {
        if (string.IsNullOrWhiteSpace(_jsonImportText))
        {
            inj_snackbar.Add("请先粘贴 JSON。", Severity.Warning);
            return;
        }

        JToken token;
        try
        {
            token = JToken.Parse(_jsonImportText, new JsonLoadSettings
            {
                DuplicatePropertyNameHandling = DuplicatePropertyNameHandling.Error
            });
        }
        catch (Newtonsoft.Json.JsonException)
        {
            inj_snackbar.Add("JSON 格式错误或存在重复 key。", Severity.Warning);
            return;
        }

        if (token is not JObject jsonObject || !jsonObject.HasValues)
        {
            inj_snackbar.Add("只支持包含条目的简单 JSON 对象。", Severity.Warning);
            return;
        }

        var importedEntries = new List<DictEntryItem>();
        var importedKeywords = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var property in jsonObject.Properties())
        {
            var targetValue = property.Name.Trim();
            if (targetValue.Length == 0 || property.Value.Type != JTokenType.String)
            {
                inj_snackbar.Add("JSON 的 key 和 value 都必须是非空字符串。", Severity.Warning);
                return;
            }

            var keyword = property.Value.Value<string>()?.Trim();
            if (string.IsNullOrEmpty(keyword))
            {
                inj_snackbar.Add("JSON 的 key 和 value 都必须是非空字符串。", Severity.Warning);
                return;
            }

            if (!importedKeywords.Add(keyword))
            {
                inj_snackbar.Add($"条件关键词重复：{keyword}", Severity.Warning);
                return;
            }

            importedEntries.Add(new DictEntryItem
            {
                TargetValue = targetValue,
                Conditions =
                [
                    new DictConditionItem
                    {
                        MatchMode = DictExpressionHelper.MatchModeAll,
                        Keywords = [keyword]
                    }
                ]
            });
        }

        _entries = importedEntries;
        _jsonImportVisible = false;
        _jsonImportText = null;
        inj_snackbar.Add($"已导入 {_entries.Count} 条字典条目，请确认后保存。", Severity.Success);
    }

    private static void AddCondition(DictEntryItem entry)
    {
        entry.Conditions.Add(new DictConditionItem());
    }

    private static void RemoveCondition(DictEntryItem entry, int index)
    {
        if (entry.Conditions.Count <= 1 || index < 0 || index >= entry.Conditions.Count)
        {
            return;
        }

        entry.Conditions.RemoveAt(index);
    }

    private static void AddKeyword(DictConditionItem condition)
    {
        condition.Keywords.Add(null);
    }

    private static void RemoveKeyword(DictConditionItem condition, int index)
    {
        if (condition.Keywords.Count <= 1 || index < 0 || index >= condition.Keywords.Count)
        {
            return;
        }

        condition.Keywords.RemoveAt(index);
    }

    private static string GetKeywordJoinText(string? matchMode) =>
        DictExpressionHelper.NormalizeMatchMode(matchMode) == DictExpressionHelper.MatchModeAny ? "或" : "且";

    private void MoveEntry(int index, int direction)
    {
        var targetIndex = index + direction;
        if (index < 0 || index >= _entries.Count || targetIndex < 0 || targetIndex >= _entries.Count)
        {
            return;
        }

        var item = _entries[index];
        _entries.RemoveAt(index);
        _entries.Insert(targetIndex, item);
    }

    private void RemoveEntry(int index)
    {
        if (_entries.Count <= 1 || index < 0 || index >= _entries.Count)
        {
            return;
        }

        _entries.RemoveAt(index);
    }

    private void ApplyTemplateEntries(List<DictEntryItem> templateEntries, string applyMode)
    {
        if (templateEntries.Count == 0)
        {
            return;
        }

        if (applyMode == DictTemplateApplyModes.Replace || IsOnlyEmptyEntry())
        {
            _entries = templateEntries;
            return;
        }

        if (applyMode == DictTemplateApplyModes.MergeOverwrite)
        {
            RemoveTemplateConflicts(templateEntries);
        }

        AppendMissingTemplateEntries(templateEntries);
        if (_entries.Count == 0)
        {
            _entries = [new DictEntryItem()];
        }
    }

    private bool IsOnlyEmptyEntry() =>
        _entries.Count == 1
        && string.IsNullOrWhiteSpace(_entries[0].TargetValue)
        && _entries[0].Conditions.All(c => string.IsNullOrWhiteSpace(DictExpressionHelper.BuildSourceValue(c.Keywords, c.MatchMode)));

    private void RemoveTemplateConflicts(List<DictEntryItem> templateEntries)
    {
        var templateSourceValues = FlattenEntries(templateEntries)
            .Select(e => e.SourceValue)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var entry in _entries)
        {
            entry.Conditions = entry.Conditions
                .Where(c =>
                {
                    var sourceValue = DictExpressionHelper.BuildSourceValue(c.Keywords, c.MatchMode);
                    return string.IsNullOrWhiteSpace(sourceValue) || !templateSourceValues.Contains(sourceValue);
                })
                .ToList();
        }

        _entries = _entries
            .Where(e => !string.IsNullOrWhiteSpace(e.TargetValue) && e.Conditions.Count > 0)
            .ToList();
    }

    private void AppendMissingTemplateEntries(List<DictEntryItem> templateEntries)
    {
        var existingSourceValues = FlattenEntries(_entries)
            .Select(e => e.SourceValue)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var templateEntry in templateEntries)
        {
            foreach (var condition in templateEntry.Conditions)
            {
                var sourceValue = DictExpressionHelper.BuildSourceValue(condition.Keywords, condition.MatchMode);
                if (string.IsNullOrWhiteSpace(sourceValue) || existingSourceValues.Contains(sourceValue))
                {
                    continue;
                }

                var targetEntry = _entries.FirstOrDefault(e => string.Equals(e.TargetValue, templateEntry.TargetValue, StringComparison.OrdinalIgnoreCase));
                if (targetEntry == null)
                {
                    targetEntry = new DictEntryItem { TargetValue = templateEntry.TargetValue };
                    targetEntry.Conditions.Clear();
                    _entries.Add(targetEntry);
                }

                targetEntry.Conditions.Add(CloneCondition(condition));
                existingSourceValues.Add(sourceValue);
            }
        }
    }

    private static List<DictEntryItem> BuildEntriesFromTemplate(IEnumerable<DictTemplateItemDto> items)
    {
        return items
            .Where(i => !string.IsNullOrWhiteSpace(i.SourceValue) && !string.IsNullOrWhiteSpace(i.TargetValue))
            .GroupBy(i => i.TargetValue.Trim(), StringComparer.OrdinalIgnoreCase)
            .Select(group => new DictEntryItem
            {
                TargetValue = group.First().TargetValue.Trim(),
                Conditions = group.Select(i => BuildConditionFromSourceValue(i.SourceValue)).ToList()
            })
            .Where(e => e.Conditions.Count > 0)
            .ToList();
    }

    private static DictConditionItem BuildConditionFromSourceValue(string sourceValue)
    {
        var (matchMode, _) = DictExpressionHelper.ParseSourceValue(sourceValue);
        return new DictConditionItem
        {
            MatchMode = matchMode,
            Keywords = DictExpressionHelper.ParseSourceValueKeywords(sourceValue)
        };
    }

    private static DictConditionItem CloneCondition(DictConditionItem condition) =>
        new()
        {
            MatchMode = condition.MatchMode,
            Keywords = condition.Keywords.ToList()
        };

    private static List<DictEntryItem> FlattenEntries(IEnumerable<DictEntryItem> entries)
    {
        var result = new List<DictEntryItem>();
        foreach (var entry in entries)
        {
            foreach (var condition in entry.Conditions)
            {
                var sourceValue = DictExpressionHelper.BuildSourceValue(condition.Keywords, condition.MatchMode);
                if (string.IsNullOrWhiteSpace(sourceValue))
                {
                    continue;
                }

                result.Add(new DictEntryItem
                {
                    SourceValue = sourceValue,
                    TargetValue = entry.TargetValue
                });
            }
        }

        return result;
    }

    private async Task SaveDictAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDictCode))
        {
            inj_snackbar.Add("请输入 DictCode。", Severity.Warning);
            return;
        }

        var dictCode = _newDictCode.Trim();
        var integrationProjectCode = _createScope == GlobalScopeKey ? null : CurrentIntegrationProjectCode;
        var entries = BuildEntriesForSave();

        if (entries.Count == 0)
        {
            inj_snackbar.Add("至少需要填写 1 条完整的字典条目。", Severity.Warning);
            return;
        }

        await using var db = await ContextFactory.CreateDbContextAsync();
        var existingItems = await db.EsbDicts
            .Where(d => d.DictCode == dictCode && d.IntegrationProjectCode == integrationProjectCode)
            .ToListAsync();

        if (_editExisting)
        {
            db.EsbDicts.RemoveRange(existingItems);

            var sortOrder = 0;
            foreach (var entry in entries)
            {
                sortOrder += 10;
                db.EsbDicts.Add(new EsbDict
                {
                    DictCode = dictCode,
                    IntegrationProjectCode = integrationProjectCode,
                    SourceValue = entry.SourceValue ?? "",
                    TargetValue = entry.TargetValue ?? "",
                    SortOrder = sortOrder
                });
            }

            await db.SaveChangesAsync();
            inj_dictService.ClearCache(dictCode, CurrentIntegrationProjectCode);
            inj_snackbar.Add($"字典“{dictCode}”已保存，共 {entries.Count} 条", Severity.Success);
            MudDialog.Close(new DictCreateDialogResult
            {
                DictCode = dictCode,
                RecommendedMatchMode = _recommendedMatchMode
            });
            return;
        }

        var existingMap = existingItems.ToDictionary(d => d.SourceValue, d => d, StringComparer.OrdinalIgnoreCase);
        var conflictEntries = entries
            .Where(e => existingMap.ContainsKey(e.SourceValue!))
            .ToList();

        if (conflictEntries.Count > 0)
        {
            var conflictList = string.Join("、", conflictEntries.Select(e => e.SourceValue));
            var result = await inj_dialogService.ShowMessageBox(
                "存在冲突条目",
                $"以下 SourceValue 在字典“{dictCode}”中已存在：{conflictList}",
                yesText: "覆盖已存在的",
                cancelText: "跳过已存在的");

            if (result == true)
            {
                foreach (var entry in conflictEntries)
                {
                    if (entry.SourceValue != null && existingMap.TryGetValue(entry.SourceValue, out var item))
                    {
                        item.TargetValue = entry.TargetValue ?? "";
                    }
                }
            }

            entries = entries
                .Where(e => e.SourceValue != null && !existingMap.ContainsKey(e.SourceValue))
                .ToList();
        }

        var maxSort = existingItems.Count == 0 ? 0 : existingItems.Max(d => d.SortOrder);
        foreach (var entry in entries)
        {
            maxSort++;
            db.EsbDicts.Add(new EsbDict
            {
                DictCode = dictCode,
                IntegrationProjectCode = integrationProjectCode,
                SourceValue = entry.SourceValue ?? "",
                TargetValue = entry.TargetValue ?? "",
                SortOrder = maxSort
            });
        }

        await db.SaveChangesAsync();
        inj_dictService.ClearCache(dictCode, CurrentIntegrationProjectCode);

        var message = $"字典“{dictCode}”已保存";
        if (entries.Count > 0)
        {
            message += $"，新增 {entries.Count} 条";
        }

        if (conflictEntries.Count > 0)
        {
            message += $"，冲突 {conflictEntries.Count} 条";
        }

        inj_snackbar.Add(message, Severity.Success);
        MudDialog.Close(new DictCreateDialogResult
        {
            DictCode = dictCode,
            RecommendedMatchMode = _recommendedMatchMode
        });
    }

    private List<DictEntryItem> BuildEntriesForSave()
    {
        var entries = new List<DictEntryItem>();
        foreach (var entry in _entries)
        {
            if (string.IsNullOrWhiteSpace(entry.TargetValue))
            {
                continue;
            }

            foreach (var condition in entry.Conditions)
            {
                var sourceValue = DictExpressionHelper.BuildSourceValue(condition.Keywords, condition.MatchMode);
                if (string.IsNullOrWhiteSpace(sourceValue))
                {
                    continue;
                }

                entries.Add(new DictEntryItem
                {
                    SourceValue = sourceValue,
                    TargetValue = entry.TargetValue.Trim()
                });
            }
        }

        return entries
            .GroupBy(e => e.SourceValue, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList();
    }
}
