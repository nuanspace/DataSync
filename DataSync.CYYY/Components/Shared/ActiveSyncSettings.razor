@inherits BasePage

<section class="active-sync-settings">
    <div class="active-sync-heading">
        <div>
            <div class="active-sync-tag">在院增量</div>
            <MudText Typo="Typo.h6">Active 病历同步</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                公共查询与推送配置直接继承当前同步任务，这里只维护在院增量参数。
            </MudText>
        </div>
        <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Success" Label="启用在院增量" />
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-3" />
    }
    else
    {
        <MudTabs Elevation="0"
                 Rounded="false"
                 KeepPanelsAlive="true"
                 Class="active-sync-subtabs"
                 PanelClass="active-sync-subtab-panel">
            <MudTabPanel Text="同步设置" Icon="@Icons.Material.Filled.Tune">
        <div class="active-task-grid @(_enabled ? string.Empty : "is-disabled")">
            <MudTextField @bind-Value="_activeRecordsUrl"
                          Label="Active 病历接口地址"
                          Placeholder="http://localhost:50146/api/active-medical-records"
                          Variant="Variant.Outlined"
                          Disabled="@(!_enabled)"
                          Required="@_enabled" />
            <MudTextField @bind-Value="_integrationProjectCode"
                          Label="项目编码"
                          Variant="Variant.Outlined"
                          Disabled="@(!_enabled)" />
            <MudSelect T="string"
                       @bind-Value="_patientIdSource"
                       Label="患者ID取值字段"
                       HelperText="从 Active 病历接口返回值中取值，用于填充同步任务的患者ID字段"
                       Variant="Variant.Outlined"
                       Disabled="@(!_enabled)">
                @foreach (var option in ActiveIdentitySources)
                {
                    <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string"
                       @bind-Value="_visitSnSource"
                       Label="就诊标识取值字段"
                       HelperText="从 Active 病历接口返回值中取值，用于填充同步任务的就诊号字段"
                       Variant="Variant.Outlined"
                       Disabled="@(!_enabled)">
                @foreach (var option in ActiveIdentitySources)
                {
                    <MudSelectItem Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField @bind-Value="_caseBatchSize"
                             Label="每轮病例数"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="500"
                             Disabled="@(!_enabled)" />
            <MudNumericField @bind-Value="_concurrency"
                             Label="并发数"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="20"
                             Disabled="@(!_enabled)" />
            <MudNumericField @bind-Value="_pollingIntervalSeconds"
                             Label="病例轮询间隔(秒)"
                             Variant="Variant.Outlined"
                             Min="60"
                             Disabled="@(!_enabled)" />
            <MudNumericField @bind-Value="_emptyBackoffBaseSeconds"
                             Label="空结果退避(秒)"
                             Variant="Variant.Outlined"
                             Min="60"
                             Disabled="@(!_enabled)" />
            <MudNumericField @bind-Value="_emptyBackoffMaxSeconds"
                             Label="最大退避(秒)"
                             Variant="Variant.Outlined"
                             Min="60"
                             Disabled="@(!_enabled)" />
        </div>

        <div class="active-interface-heading">
            <div>
                <MudText Typo="Typo.subtitle1">增量接口</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    数据库、SQL、查询字段和推送路由均继承上方接口配置。
                </MudText>
            </div>
            <span>@_drafts.Count 个接口</span>
        </div>

        @if (_drafts.Count == 0)
        {
            <div class="active-empty">当前任务没有可用于在院增量同步的接口。</div>
        }
        else
        {
            <div class="active-interface-list @(_enabled ? string.Empty : "is-disabled")">
                @foreach (var draft in _drafts.OrderBy(item => item.Interface.SortOrder).ThenBy(item => item.Interface.ServerCode))
                {
                    <div class="active-interface-row" @key="draft.Key">
                        <div class="active-interface-identity">
                            <MudSwitch T="bool" @bind-Value="draft.Enabled" Color="Color.Success" Disabled="@(!_enabled)" />
                            <div>
                                <strong>@GetInterfaceName(draft.Interface)</strong>
                                <span>@GetSourceTypeText(draft.Interface) · @draft.Interface.ServerCode · 查询字段 @draft.Interface.QueryField</span>
                            </div>
                        </div>
                        <MudTextField @bind-Value="draft.RecordKeyFields"
                                      Label="增量唯一键字段"
                                      HelperText="多个字段用逗号分隔；留空时自动计算整行 SHA-256"
                                      Variant="Variant.Outlined"
                                      Disabled="@(!_enabled || !draft.Enabled)" />
                        <MudNumericField @bind-Value="draft.PollingIntervalSeconds"
                                         Label="接口轮询(秒)"
                                         Variant="Variant.Outlined"
                                         Min="60"
                                         Disabled="@(!_enabled || !draft.Enabled)" />
                    </div>
                }
            </div>
        }
            </MudTabPanel>

            <MudTabPanel Text="Active 病例" Icon="@Icons.Material.Filled.Assessment">
        @if (_lastRunAt.HasValue || _receiptCount > 0)
        {
            <div class="active-runtime-line">
                <span>最近执行 <strong>@FormatDateTime(_lastRunAt)</strong></span>
                <span>当前 Active <strong>@_caseCount</strong></span>
                <span>已推送记录 <strong>@_receiptCount</strong></span>
                <span class="@(_errorCount > 0 ? "has-error" : string.Empty)">异常 <strong>@_errorCount</strong></span>
            </div>
        }

        <div class="active-log-heading">
            <div>
                <MudText Typo="Typo.subtitle1">Active 病例同步明细</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    一行对应一个 Active 病例和一个接口，同时展示原始字段、任务映射与同步状态。
                </MudText>
            </div>
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(_activeTaskId <= 0 || _refreshingLogs)"
                       OnClick="RefreshRuntimeAsync">
                刷新 Active 列表
            </MudButton>
        </div>

        @if (!string.IsNullOrWhiteSpace(_activeListError))
        {
            <div class="active-list-error">
                <strong>Active 列表刷新失败</strong>
                <span>@_activeListError</span>
                @if (_activeListLastSuccessAt.HasValue)
                {
                    <small>当前保留 @_activeListLastSuccessAt.Value.ToString("yyyy-MM-dd HH:mm:ss") 的列表。</small>
                }
            </div>
        }

        @if (_activeTaskId <= 0)
        {
            <div class="active-log-empty">保存同步任务后可查看 Active 病例。</div>
        }
        else if (_runtimeItems.Count == 0)
        {
            <div class="active-log-empty">当前没有 Active 病例，或 Active 列表尚未成功加载。</div>
        }
        else
        {
            <div class="active-list-toolbar">
                <MudTextField T="string"
                              @bind-Value="_runtimeSearch"
                              Immediate="true"
                              Clearable="true"
                              Placeholder="搜索病案号、住院号、住院次数"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudSelect T="int?"
                           @bind-Value="_runtimeSourceFilter"
                           Label="接口"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">
                    @foreach (var source in GetRuntimeSources())
                    {
                        <MudSelectItem T="int?" Value="@((int?)source.Id)">@source.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="active-result-filters" aria-label="同步状态筛选">
                @foreach (var filter in RuntimeFilters)
                {
                    <button type="button"
                            class="@GetRuntimeFilterClass(filter.Value)"
                            @onclick="@(() => _runtimeFilter = filter.Value)">
                        <span>@filter.Label</span>
                        <strong>@GetRuntimeCount(filter.Value)</strong>
                    </button>
                }
            </div>

            var filteredItems = GetFilteredRuntimeItems();
            @if (filteredItems.Count == 0)
            {
                <div class="active-log-empty">当前筛选条件下没有 Active 病例。</div>
            }
            else
            {
                <div class="active-flat-table-wrap">
                    <table class="active-flat-table">
                        <thead>
                            <tr>
                                <th>状态</th>
                                <th>Active ID</th>
                                <th>mrn</th>
                                <th>inpatientNo</th>
                                <th>visitNo</th>
                                <th>入院时间</th>
                                <th>内部标识</th>
                                <th>任务字段映射</th>
                                <th>接口</th>
                                <th>最近查询</th>
                                <th>最近推送</th>
                                <th>累计推送</th>
                                <th>执行时间</th>
                                <th>下次执行</th>
                                <th>错误</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in filteredItems)
                            {
                                <tr @key="item.RowKey">
                                    <td><span class="@GetRuntimeStatusClass(item)">@GetRuntimeStatusText(item)</span></td>
                                    <td>@FormatActiveId(item.ActiveId)</td>
                                    <td>@FormatActiveValue(item.Mrn)</td>
                                    <td>@FormatActiveValue(item.InpatientNo)</td>
                                    <td>@FormatActiveValue(item.VisitNo)</td>
                                    <td>@FormatDateTime(item.AdmissionTime)</td>
                                    <td class="active-internal-ids">
                                        <span title="@item.PatientId">patientId：@FormatGuid(item.PatientId)</span>
                                        <span title="@item.EventId">eventId：@FormatGuid(item.EventId)</span>
                                    </td>
                                    <td class="active-mapping-cell">
                                        <span>@item.PatientField ← @item.PatientSource</span>
                                        <strong>@FormatActiveValue(item.MappedPatientId)</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.VisitField))
                                        {
                                            <span>@item.VisitField ← @item.VisitSource</span>
                                            <strong>@FormatActiveValue(item.MappedVisitSn)</strong>
                                        }
                                    </td>
                                    <td class="active-interface-cell">
                                        <strong>@item.SourceName</strong>
                                        <span>@item.ServerCode</span>
                                    </td>
                                    <td>@item.LastResultCount 条</td>
                                    <td>@item.LastPushedCount 条</td>
                                    <td>@item.PushedCount 条</td>
                                    <td>@FormatDateTime(item.LastQueryAt)</td>
                                    <td>@FormatDateTime(item.NextQueryTime)</td>
                                    <td class="active-error-cell" title="@item.DisplayError">@FormatActiveValue(item.DisplayError)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
            </MudTabPanel>
        </MudTabs>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public SyncTask TaskConfig { get; set; } = new();

    [Parameter, EditorRequired]
    public IReadOnlyList<SyncTaskInterface> Interfaces { get; set; } = [];

    private readonly List<ActiveInterfaceDraft> _drafts = [];
    private readonly Dictionary<int, ActiveSyncSource> _existingSources = [];
    private bool _loading = true;
    private bool _enabled;
    private int _activeTaskId;
    private string _activeTaskCode = "";
    private string _activeRecordsUrl = "";
    private string? _integrationProjectCode;
    private string _patientIdSource = "Mrn";
    private string _visitSnSource = "InpatientNo";
    private int _caseBatchSize = 50;
    private int _concurrency = 3;
    private int _pollingIntervalSeconds = 300;
    private int _emptyBackoffBaseSeconds = 1800;
    private int _emptyBackoffMaxSeconds = 7200;
    private DateTime? _lastRunAt;
    private int _caseCount;
    private int _receiptCount;
    private int _errorCount;
    private List<ActiveRuntimeItem> _runtimeItems = [];
    private bool _refreshingLogs;
    private string _runtimeFilter = RuntimeAllFilter;
    private string _runtimeSearch = "";
    private int? _runtimeSourceFilter;
    private string? _activeListError;
    private DateTime? _activeListLastSuccessAt;

    protected override async Task OnPageInitializedAsync()
    {
        if (TaskConfig.Id > 0)
            await LoadAsync(TaskConfig.Id);

        SyncDrafts(Interfaces);
        _loading = false;
    }

    protected override void OnParametersSet()
    {
        if (!_loading)
            SyncDrafts(Interfaces);
    }

    public async Task SaveAsync(
        int taskId,
        string taskName,
        string taskCode,
        string pushType,
        string pushTarget,
        IReadOnlyList<SyncTaskInterface> interfaces)
    {
        if (taskId <= 0)
            throw new InvalidOperationException("同步任务尚未保存，无法保存 Active 增量配置");

        SyncDrafts(interfaces);
        Normalize();
        if (_enabled && string.IsNullOrWhiteSpace(_activeRecordsUrl))
            throw new InvalidOperationException("启用在院增量后必须填写 Active 病历接口地址");

        if (_enabled && _drafts.All(item => !item.Enabled))
            throw new InvalidOperationException("启用在院增量后至少需要启用一个接口");

        await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
        var activeTask = await db.ActiveSyncTasks
            .Include(item => item.Sources)
            .FirstOrDefaultAsync(item => item.SyncTaskId == taskId, CancellationToken);

        if (activeTask == null)
        {
            activeTask = new ActiveSyncTask
            {
                SyncTaskId = taskId,
                Code = await BuildAvailableCodeAsync(db, taskCode, taskId)
            };
            db.ActiveSyncTasks.Add(activeTask);
        }

        activeTask.Name = $"{taskName} 在院增量";
        activeTask.Enabled = _enabled;
        activeTask.ActiveRecordsUrl = _activeRecordsUrl;
        activeTask.IntegrationProjectCode = _integrationProjectCode;
        activeTask.PatientIdSource = _patientIdSource;
        activeTask.VisitSnSource = _visitSnSource;
        activeTask.PushType = pushType;
        activeTask.PushTarget = pushTarget;
        activeTask.CaseBatchSize = _caseBatchSize;
        activeTask.Concurrency = _concurrency;
        activeTask.PollingIntervalSeconds = _pollingIntervalSeconds;
        activeTask.EmptyBackoffBaseSeconds = _emptyBackoffBaseSeconds;
        activeTask.EmptyBackoffMaxSeconds = _emptyBackoffMaxSeconds;

        var sourcesByInterfaceId = activeTask.Sources
            .Where(item => item.SyncTaskInterfaceId.HasValue)
            .GroupBy(item => item.SyncTaskInterfaceId!.Value)
            .ToDictionary(group => group.Key, group => group.First());

        foreach (var draft in _drafts)
        {
            var iface = draft.Interface;
            if (iface.Id <= 0)
                throw new InvalidOperationException($"接口 {GetInterfaceName(iface)} 尚未保存，无法建立增量配置");

            if (!sourcesByInterfaceId.TryGetValue(iface.Id, out var source))
            {
                source = new ActiveSyncSource { SyncTaskInterfaceId = iface.Id };
                activeTask.Sources.Add(source);
            }

            source.DataType = "Source";
            source.ServerCode = iface.ServerCode;
            source.DisplayName = GetInterfaceName(iface);
            source.DatabaseResourceId = iface.DatabaseResourceId;
            source.QuerySql = iface.QuerySql ?? "";
            source.InpatientNoParameter = "InpatientNo";
            source.AdmissionTimeParameter = null;
            source.SourceRecordKeyFields = draft.RecordKeyFields;
            source.PollingIntervalSeconds = draft.PollingIntervalSeconds;
            source.SortOrder = iface.SortOrder;
            source.Enabled = draft.Enabled;
        }

        var currentInterfaceIds = _drafts
            .Select(item => item.Interface.Id)
            .Where(id => id > 0)
            .ToHashSet();
        foreach (var obsoleteSource in activeTask.Sources.Where(item =>
                     item.SyncTaskInterfaceId.HasValue && !currentInterfaceIds.Contains(item.SyncTaskInterfaceId.Value)))
        {
            obsoleteSource.Enabled = false;
        }

        await db.SaveChangesAsync(CancellationToken);
        _activeTaskId = activeTask.Id;
        _activeTaskCode = activeTask.Code;
    }

    private async Task LoadAsync(int taskId)
    {
        await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
        var activeTask = await db.ActiveSyncTasks
            .AsNoTracking()
            .Include(item => item.Sources)
            .OrderBy(item => item.Id)
            .FirstOrDefaultAsync(item => item.SyncTaskId == taskId, CancellationToken);
        if (activeTask == null)
            return;

        _activeTaskId = activeTask.Id;
        _activeTaskCode = activeTask.Code;
        _enabled = activeTask.Enabled;
        _activeRecordsUrl = activeTask.ActiveRecordsUrl;
        _integrationProjectCode = activeTask.IntegrationProjectCode;
        _patientIdSource = activeTask.PatientIdSource;
        _visitSnSource = activeTask.VisitSnSource;
        _caseBatchSize = activeTask.CaseBatchSize;
        _concurrency = activeTask.Concurrency;
        _pollingIntervalSeconds = activeTask.PollingIntervalSeconds;
        _emptyBackoffBaseSeconds = activeTask.EmptyBackoffBaseSeconds;
        _emptyBackoffMaxSeconds = activeTask.EmptyBackoffMaxSeconds;
        foreach (var source in activeTask.Sources.Where(item => item.SyncTaskInterfaceId.HasValue))
            _existingSources.TryAdd(source.SyncTaskInterfaceId!.Value, source);

        await LoadRuntimeAsync(activeTask.Id);
    }

    private async Task RefreshRuntimeAsync()
    {
        if (_activeTaskId <= 0)
            return;

        _refreshingLogs = true;
        try
        {
            await LoadRuntimeAsync(_activeTaskId);
        }
        finally
        {
            _refreshingLogs = false;
        }
    }

    private async Task LoadRuntimeAsync(int activeTaskId)
    {
        List<ActiveMedicalRecordInfo> activeCases;
        try
        {
            activeCases = await inj_activeSyncService.GetCurrentActiveCasesAsync(activeTaskId, CancellationToken);
            _activeListError = null;
            _activeListLastSuccessAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            _activeListError = ex.Message;
            return;
        }

        await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
        var sources = await db.ActiveSyncSources
            .AsNoTracking()
            .Where(item => item.TaskId == activeTaskId && item.Enabled)
            .OrderBy(item => item.SortOrder)
            .ThenBy(item => item.DisplayName)
            .ToListAsync(CancellationToken);
        var inpatientNos = activeCases
            .Select(item => item.InpatientNo)
            .Where(item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var states = inpatientNos.Count == 0
            ? new List<ActiveSyncCaseSourceState>()
            : await db.ActiveSyncCaseSourceStates
                .AsNoTracking()
                .Where(item => item.TaskId == activeTaskId && inpatientNos.Contains(item.InpatientNo))
                .ToListAsync(CancellationToken);
        var receiptCounts = inpatientNos.Count == 0
            ? new List<ActiveReceiptCount>()
            : await db.ActiveSyncRecordReceipts
                .AsNoTracking()
                .Where(item => item.TaskId == activeTaskId && inpatientNos.Contains(item.InpatientNo))
                .GroupBy(item => new { item.SourceId, item.InpatientNo })
                .Select(group => new ActiveReceiptCount
                {
                    SourceId = group.Key.SourceId,
                    InpatientNo = group.Key.InpatientNo,
                    Count = group.Count()
                })
                .ToListAsync(CancellationToken);
        var latestLogs = inpatientNos.Count == 0
            ? new List<ActiveLatestRun>()
            : await db.ActiveSyncRunLogs
                .AsNoTracking()
                .Where(item => item.TaskId == activeTaskId &&
                    item.SourceId.HasValue &&
                    item.InpatientNo != null &&
                    inpatientNos.Contains(item.InpatientNo))
                .GroupBy(item => new { SourceId = item.SourceId!.Value, InpatientNo = item.InpatientNo! })
                .Select(group => group
                    .OrderByDescending(item => item.CreatedAt)
                    .Select(item => new ActiveLatestRun
                    {
                        SourceId = item.SourceId!.Value,
                        InpatientNo = item.InpatientNo!,
                        QueryCount = item.QueryCount,
                        PushedCount = item.PushedCount
                    })
                    .First())
                .ToListAsync(CancellationToken);
        _lastRunAt = await db.ActiveSyncRunLogs
            .AsNoTracking()
            .Where(item => item.TaskId == activeTaskId)
            .OrderByDescending(item => item.CreatedAt)
            .Select(item => (DateTime?)item.CreatedAt)
            .FirstOrDefaultAsync(CancellationToken);

        var stateMap = states.ToDictionary(
            item => BuildSourceCaseKey(item.SourceId, item.InpatientNo),
            StringComparer.OrdinalIgnoreCase);
        var receiptMap = receiptCounts.ToDictionary(
            item => BuildSourceCaseKey(item.SourceId, item.InpatientNo),
            item => item.Count,
            StringComparer.OrdinalIgnoreCase);
        var latestLogMap = latestLogs.ToDictionary(
            item => BuildSourceCaseKey(item.SourceId, item.InpatientNo),
            StringComparer.OrdinalIgnoreCase);
        var runtimeItems = new List<ActiveRuntimeItem>();
        foreach (var activeCase in activeCases)
        {
            var mappedPatientId = ActiveSyncService.ResolveActiveCaseValue(activeCase, _patientIdSource);
            var mappedVisitSn = ActiveSyncService.ResolveActiveCaseValue(activeCase, _visitSnSource);
            var mappingError = BuildMappingError(activeCase, mappedPatientId, mappedVisitSn);
            foreach (var source in sources)
            {
                var key = BuildSourceCaseKey(source.Id, activeCase.InpatientNo);
                stateMap.TryGetValue(key, out var state);
                receiptMap.TryGetValue(key, out var pushedCount);
                latestLogMap.TryGetValue(key, out var latestLog);
                runtimeItems.Add(new ActiveRuntimeItem
                {
                    RowKey = $"{activeCase.Cursor}:{source.Id}",
                    ActiveId = activeCase.Cursor,
                    Mrn = activeCase.Mrn,
                    InpatientNo = activeCase.InpatientNo,
                    VisitNo = activeCase.VisitNo,
                    AdmissionTime = activeCase.AdmissionTime,
                    PatientId = activeCase.PatientId,
                    EventId = activeCase.EventId,
                    PatientField = TaskConfig.PatientIdField,
                    PatientSource = _patientIdSource,
                    MappedPatientId = mappedPatientId,
                    VisitField = TaskConfig.VisitSnField,
                    VisitSource = _visitSnSource,
                    MappedVisitSn = mappedVisitSn,
                    SourceId = source.Id,
                    SourceName = string.IsNullOrWhiteSpace(source.DisplayName) ? source.ServerCode : source.DisplayName,
                    ServerCode = source.ServerCode,
                    LastQueryAt = state?.LastQueryAt,
                    NextQueryTime = state?.NextQueryTime,
                    LastResultCount = latestLog?.QueryCount ?? state?.LastResultCount ?? 0,
                    LastPushedCount = latestLog?.PushedCount ?? 0,
                    PushedCount = pushedCount,
                    LastError = state?.LastError,
                    MappingError = mappingError
                });
            }
        }

        _runtimeItems = runtimeItems;
        _caseCount = activeCases.Count;
        _receiptCount = await db.ActiveSyncRecordReceipts
            .CountAsync(item => item.TaskId == activeTaskId, CancellationToken);
        _errorCount = _runtimeItems.Count(item =>
            GetRuntimeStatus(item) is RuntimeMissingStatus or RuntimeErrorStatus);
    }

    private void SyncDrafts(IReadOnlyList<SyncTaskInterface> interfaces)
    {
        var eligible = interfaces.ToList();
        var existingDrafts = _drafts.ToDictionary(item => item.Key, StringComparer.OrdinalIgnoreCase);
        var result = new List<ActiveInterfaceDraft>();

        foreach (var iface in eligible)
        {
            var key = GetInterfaceKey(iface);
            if (existingDrafts.TryGetValue(key, out var draft))
            {
                draft.Interface = iface;
                result.Add(draft);
                continue;
            }

            _existingSources.TryGetValue(iface.Id, out var source);
            result.Add(new ActiveInterfaceDraft
            {
                Key = key,
                Interface = iface,
                Enabled = source?.Enabled ?? iface.Enabled,
                RecordKeyFields = source?.SourceRecordKeyFields ?? "",
                PollingIntervalSeconds = Math.Max(60, source?.PollingIntervalSeconds ?? 1800)
            });
        }

        _drafts.Clear();
        _drafts.AddRange(result);
    }

    private void Normalize()
    {
        _activeRecordsUrl = _activeRecordsUrl.Trim();
        _integrationProjectCode = string.IsNullOrWhiteSpace(_integrationProjectCode)
            ? null
            : _integrationProjectCode.Trim();
        _patientIdSource = NormalizeIdentitySource(_patientIdSource, "Mrn");
        _visitSnSource = NormalizeIdentitySource(_visitSnSource, "InpatientNo");
        _caseBatchSize = Math.Clamp(_caseBatchSize, 1, 500);
        _concurrency = Math.Clamp(_concurrency, 1, 20);
        _pollingIntervalSeconds = Math.Max(60, _pollingIntervalSeconds);
        _emptyBackoffBaseSeconds = Math.Max(60, _emptyBackoffBaseSeconds);
        _emptyBackoffMaxSeconds = Math.Max(_emptyBackoffBaseSeconds, _emptyBackoffMaxSeconds);
        foreach (var draft in _drafts)
        {
            draft.RecordKeyFields = draft.RecordKeyFields.Trim();
            draft.PollingIntervalSeconds = Math.Max(60, draft.PollingIntervalSeconds);
        }
    }

    private static async Task<string> BuildAvailableCodeAsync(SyncDbContext db, string taskCode, int taskId)
    {
        var preferred = $"{taskCode}_active";
        var exists = await db.ActiveSyncTasks.AnyAsync(item => item.Code == preferred);
        return exists ? $"{preferred}_{taskId}" : preferred;
    }

    private static string GetInterfaceKey(SyncTaskInterface iface)
        => iface.Id > 0 ? $"id:{iface.Id}" : $"key:{iface.InterfaceKey}";

    private static string GetInterfaceName(SyncTaskInterface iface)
        => string.IsNullOrWhiteSpace(iface.DisplayName) ? iface.ServerCode : iface.DisplayName;

    private static string NormalizeIdentitySource(string? value, string fallback)
        => ActiveIdentitySources.Any(option => string.Equals(option.Value, value, StringComparison.OrdinalIgnoreCase))
            ? value!.Trim()
            : fallback;

    private static string GetSourceTypeText(SyncTaskInterface iface)
    {
        if (IngestionService.IsDatabaseSourceType(iface.SourceType))
            return "数据库";
        return "API 平台";
    }

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm:ss") : "-";

    private static string FormatActiveId(long value) => value > 0 ? value.ToString() : "-";

    private static string FormatActiveValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "缺失" : value;

    private static string FormatGuid(Guid? value)
    {
        if (!value.HasValue)
            return "缺失";

        var text = value.Value.ToString();
        return $"{text[..8]}…";
    }

    private int GetRuntimeCount(string status)
        => status == RuntimeAllFilter
            ? _runtimeItems.Count
            : _runtimeItems.Count(item => GetRuntimeStatus(item) == status);

    private string GetRuntimeFilterClass(string status)
        => status == _runtimeFilter ? "active-result-filter is-active" : "active-result-filter";

    private List<ActiveRuntimeItem> GetFilteredRuntimeItems()
        => _runtimeItems
            .Where(item => _runtimeFilter == RuntimeAllFilter || GetRuntimeStatus(item) == _runtimeFilter)
            .Where(item => !_runtimeSourceFilter.HasValue || item.SourceId == _runtimeSourceFilter.Value)
            .Where(item => MatchesRuntimeSearch(item, _runtimeSearch))
            .OrderBy(item => GetRuntimeStatusOrder(GetRuntimeStatus(item)))
            .ThenBy(item => item.InpatientNo)
            .ThenBy(item => item.SourceName)
            .ToList();

    private List<ActiveRuntimeSourceOption> GetRuntimeSources()
        => _runtimeItems
            .GroupBy(item => new { item.SourceId, item.SourceName })
            .Select(group => new ActiveRuntimeSourceOption
            {
                Id = group.Key.SourceId,
                Name = group.Key.SourceName
            })
            .OrderBy(item => item.Name)
            .ToList();

    private static bool MatchesRuntimeSearch(ActiveRuntimeItem item, string? search)
    {
        if (string.IsNullOrWhiteSpace(search))
            return true;

        var value = search.Trim();
        return item.Mrn.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            item.InpatientNo.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (item.VisitNo?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private static string GetRuntimeStatus(ActiveRuntimeItem item)
    {
        if (!string.IsNullOrWhiteSpace(item.MappingError))
            return RuntimeMissingStatus;
        if (!string.IsNullOrWhiteSpace(item.LastError))
            return RuntimeErrorStatus;
        if (!item.LastQueryAt.HasValue)
            return item.NextQueryTime.HasValue ? RuntimePendingStatus : RuntimeUnstartedStatus;
        if (item.LastPushedCount > 0)
            return RuntimeSyncedStatus;
        return RuntimeEmptyStatus;
    }

    private static int GetRuntimeStatusOrder(string status)
        => status switch
        {
            RuntimeMissingStatus => 0,
            RuntimeErrorStatus => 1,
            RuntimePendingStatus => 2,
            RuntimeUnstartedStatus => 3,
            RuntimeEmptyStatus => 4,
            _ => 5
        };

    private static string GetRuntimeStatusText(ActiveRuntimeItem item)
        => GetRuntimeStatus(item) switch
        {
            RuntimeMissingStatus => "字段缺失",
            RuntimeErrorStatus => "同步失败",
            RuntimeSyncedStatus => "同步成功",
            RuntimeEmptyStatus => item.LastResultCount == 0 ? "无数据" : "无新增数据",
            RuntimePendingStatus => "等待执行",
            _ => "未开始"
        };

    private static string GetRuntimeStatusClass(ActiveRuntimeItem item)
        => $"active-result-status is-{GetRuntimeStatus(item)}";

    private string? BuildMappingError(
        ActiveMedicalRecordInfo activeCase,
        string patientId,
        string visitSn)
    {
        if (string.IsNullOrWhiteSpace(activeCase.InpatientNo))
            return "Active 字段 [InpatientNo] 为空，无法建立同步状态";
        if (string.IsNullOrWhiteSpace(patientId))
            return $"Active 字段 [{_patientIdSource}] 为空，无法填充 [{TaskConfig.PatientIdField}]";
        if (!string.IsNullOrWhiteSpace(TaskConfig.VisitSnField) && string.IsNullOrWhiteSpace(visitSn))
            return $"Active 字段 [{_visitSnSource}] 为空，无法填充 [{TaskConfig.VisitSnField}]";

        return null;
    }

    private static string BuildSourceCaseKey(int sourceId, string? inpatientNo)
        => $"{sourceId}:{inpatientNo?.Trim()}";

