    private const string RuntimeAllFilter = "all";
    private const string RuntimeMissingStatus = "missing";
    private const string RuntimeSyncedStatus = "synced";
    private const string RuntimePendingStatus = "pending";
    private const string RuntimeUnstartedStatus = "unstarted";
    private const string RuntimeEmptyStatus = "empty";
    private const string RuntimeErrorStatus = "error";

    private static readonly (string Value, string Label)[] RuntimeFilters =
    [
        (RuntimeAllFilter, "全部"),
        (RuntimeMissingStatus, "字段缺失"),
        (RuntimeSyncedStatus, "同步成功"),
        (RuntimePendingStatus, "等待执行"),
        (RuntimeUnstartedStatus, "未开始"),
        (RuntimeEmptyStatus, "无新增"),
        (RuntimeErrorStatus, "同步失败")
