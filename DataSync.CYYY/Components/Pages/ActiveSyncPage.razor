    private bool ValidateTask()
    {
        if (string.IsNullOrWhiteSpace(_editingTask.Name) ||
            string.IsNullOrWhiteSpace(_editingTask.Code) ||
            string.IsNullOrWhiteSpace(_editingTask.ActiveRecordsUrl) ||
            !_editingTask.SyncTaskId.HasValue)
        {
            inj_snackbar.Add("任务名称、编码、Active 接口地址和关联同步任务不能为空", Severity.Warning);
            return false;
        }

        var syncTask = GetSyncTask(_editingTask.SyncTaskId);
        if (syncTask == null)
        {
            inj_snackbar.Add("关联同步任务不存在或未启用", Severity.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(syncTask.PushTarget))
        {
            inj_snackbar.Add("关联同步任务未配置推送目标", Severity.Warning);
            return false;
        }

        return true;
    }

    private bool ValidateSource()
    {
        if (_editingTask.Id <= 0)
        {
            inj_snackbar.Add("请先保存任务，再配置子数据源", Severity.Warning);
            return false;
        }

        if (!_editingSource.SyncTaskInterfaceId.HasValue ||
            string.IsNullOrWhiteSpace(_editingSource.SourceRecordKeyFields))
        {
            inj_snackbar.Add("同步任务接口和唯一键字段不能为空", Severity.Warning);
            return false;
        }

        var iface = GetSyncTaskInterface(_editingSource.SyncTaskInterfaceId);
        if (iface == null)
        {
            inj_snackbar.Add("同步任务接口不存在", Severity.Warning);
            return false;
        }

        if (!IngestionService.IsDatabaseSourceType(iface.SourceType))
        {
            inj_snackbar.Add("Active 补采当前只支持数据库接口", Severity.Warning);
            return false;
        }

        return true;
    }

    private void NormalizeTask()
    {
        _editingTask.Name = _editingTask.Name.Trim();
        _editingTask.Code = _editingTask.Code.Trim();
        _editingTask.ActiveRecordsUrl = _editingTask.ActiveRecordsUrl.Trim();
        var syncTask = GetSyncTask(_editingTask.SyncTaskId);
        if (syncTask != null)
        {
            _editingTask.PushType = syncTask.PushType;
            _editingTask.PushTarget = syncTask.PushTarget;
        }
        else
        {
            _editingTask.PushTarget = _editingTask.PushTarget.Trim();
        }
        _editingTask.CaseBatchSize = Math.Clamp(_editingTask.CaseBatchSize, 1, 500);
        _editingTask.Concurrency = Math.Clamp(_editingTask.Concurrency, 1, 20);
        _editingTask.PollingIntervalSeconds = Math.Max(60, _editingTask.PollingIntervalSeconds);
        _editingTask.EmptyBackoffBaseSeconds = Math.Max(60, _editingTask.EmptyBackoffBaseSeconds);
        _editingTask.EmptyBackoffMaxSeconds = Math.Max(_editingTask.EmptyBackoffBaseSeconds, _editingTask.EmptyBackoffMaxSeconds);
    }

    private void NormalizeSource()
    {
        _editingSource.DisplayName = _editingSource.DisplayName.Trim();
        _editingSource.ServerCode = _editingSource.ServerCode.Trim();
        _editingSource.DataType = string.IsNullOrWhiteSpace(_editingSource.DataType)
            ? "Source"
            : _editingSource.DataType.Trim();
        _editingSource.InpatientNoParameter = string.IsNullOrWhiteSpace(_editingSource.InpatientNoParameter)
            ? "InpatientNo"
            : _editingSource.InpatientNoParameter.Trim();
        _editingSource.AdmissionTimeParameter = string.IsNullOrWhiteSpace(_editingSource.AdmissionTimeParameter)
            ? null
            : _editingSource.AdmissionTimeParameter.Trim().TrimStart('@', ':');
        _editingSource.SourceRecordKeyFields = _editingSource.SourceRecordKeyFields.Trim();
        _editingSource.PollingIntervalSeconds = Math.Max(60, _editingSource.PollingIntervalSeconds);
    }

    private SyncTask? GetSyncTask(int? id)
        => id.HasValue ? _syncTasks.FirstOrDefault(t => t.Id == id.Value) : null;

    private SyncTaskInterface? GetSyncTaskInterface(int? id)
        => id.HasValue
            ? _syncTasks.SelectMany(t => t.Interfaces).FirstOrDefault(i => i.Id == id.Value)
            : null;

    private IEnumerable<SyncTaskInterface> GetAvailableInterfaces()
    {
        var selectedTask = GetSyncTask(_editingTask.SyncTaskId);
        if (selectedTask == null)
            return [];

        var selectedIds = _editingSources
            .Where(s => s.SyncTaskInterfaceId.HasValue && s.Id != _editingSource.Id)
            .Select(s => s.SyncTaskInterfaceId!.Value)
            .ToHashSet();

        return selectedTask.Interfaces
            .Where(i => i.Enabled &&
                IngestionService.IsDatabaseSourceType(i.SourceType) &&
                !selectedIds.Contains(i.Id))
            .OrderBy(i => i.SortOrder)
            .ThenBy(i => i.ServerCode);
    }

    private string GetInterfaceLabel(SyncTaskInterface iface)
        => string.IsNullOrWhiteSpace(iface.DisplayName)
            ? iface.ServerCode
            : $"{iface.DisplayName}（{iface.ServerCode}）";

    private string GetSourceInterfaceLabel(ActiveSyncSource source)
        => source.SyncTaskInterface == null
            ? source.ServerCode
            : GetInterfaceLabel(source.SyncTaskInterface);

    private string GetSourceDatabaseName(ActiveSyncSource source)
        => source.SyncTaskInterface?.DatabaseResource?.Name
            ?? source.DatabaseResource?.Name
            ?? "继承接口连接";

    private void ApplySelectedInterfaceDefaults()
    {
        var iface = GetSyncTaskInterface(_editingSource.SyncTaskInterfaceId);
        if (iface != null)
            ApplyInterfaceDefaults(_editingSource, iface);
    }

    private static void ApplyInterfaceDefaults(ActiveSyncSource source, SyncTaskInterface iface)
    {
        source.SyncTaskInterfaceId = iface.Id;
        source.SyncTaskInterface = iface;
        source.DataType = "Source";
        source.ServerCode = iface.ServerCode;
        source.DisplayName = string.IsNullOrWhiteSpace(iface.DisplayName) ? iface.ServerCode : iface.DisplayName;
        source.DatabaseResourceId = iface.DatabaseResourceId;
        source.DatabaseResource = iface.DatabaseResource;
        source.QuerySql = iface.QuerySql ?? "";
    }

    private string GetTaskRowClass(ActiveSyncTask task)
        => _editingTask.Id == task.Id ? "task-row is-selected" : "task-row";

    private string GetSourceRowClass(ActiveSyncSource source)
        => _editingSource.Id == source.Id && source.Id > 0 ? "source-row is-selected" : "source-row";

    private string GetPaneButtonClass(string pane)
        => _activePane == pane ? "pane-tab is-active" : "pane-tab";

    private string GetRunPaneSummary()
    {
        if (!CanEditSources)
            return "保存任务后查看";

        return LastRunAt.HasValue ? $"最近 {FormatDateTime(LastRunAt)}" : "暂无运行记录";
    }

    private static string FormatSeconds(int seconds)
    {
        if (seconds >= 3600 && seconds % 3600 == 0)
            return $"{seconds / 3600} 小时";

        if (seconds >= 60 && seconds % 60 == 0)
            return $"{seconds / 60} 分钟";

        return $"{seconds} 秒";
    }

    private static string FormatDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("MM-dd HH:mm:ss") : "-";

    private static string GetLogLevelClass(string? level)
    {
        if (string.Equals(level, "Error", StringComparison.OrdinalIgnoreCase))
            return "log-level is-error";

        if (string.Equals(level, "Warning", StringComparison.OrdinalIgnoreCase))
            return "log-level is-warning";

        return "log-level is-info";
    }

    private static ActiveSyncTask CloneTask(ActiveSyncTask source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Code = source.Code,
        Enabled = source.Enabled,
        SyncTaskId = source.SyncTaskId,
        SyncTask = source.SyncTask,
        ActiveRecordsUrl = source.ActiveRecordsUrl,
        IntegrationProjectCode = source.IntegrationProjectCode,
        PushType = source.PushType,
        PushTarget = source.PushTarget,
        CaseBatchSize = source.CaseBatchSize,
        Concurrency = source.Concurrency,
        PollingIntervalSeconds = source.PollingIntervalSeconds,
        EmptyBackoffBaseSeconds = source.EmptyBackoffBaseSeconds,
        EmptyBackoffMaxSeconds = source.EmptyBackoffMaxSeconds,
        Remark = source.Remark
    };

    private static ActiveSyncSource CloneSource(ActiveSyncSource source) => new()
    {
        Id = source.Id,
        TaskId = source.TaskId,
        SyncTaskInterfaceId = source.SyncTaskInterfaceId,
        SyncTaskInterface = source.SyncTaskInterface,
        DataType = source.DataType,
        ServerCode = source.ServerCode,
        DisplayName = source.DisplayName,
        DatabaseResourceId = source.DatabaseResourceId,
        QuerySql = source.QuerySql,
        InpatientNoParameter = source.InpatientNoParameter,
        AdmissionTimeParameter = source.AdmissionTimeParameter,
        SourceRecordKeyFields = source.SourceRecordKeyFields,
        PollingIntervalSeconds = source.PollingIntervalSeconds,
        SortOrder = source.SortOrder,
        Enabled = source.Enabled
    };

    private static void CopyTaskFields(ActiveSyncTask source, ActiveSyncTask target)
    {
        target.Name = source.Name;
        target.Code = source.Code;
        target.Enabled = source.Enabled;
        target.SyncTaskId = source.SyncTaskId;
        target.ActiveRecordsUrl = source.ActiveRecordsUrl;
        target.IntegrationProjectCode = source.IntegrationProjectCode;
        target.PushType = source.PushType;
        target.PushTarget = source.PushTarget;
        target.CaseBatchSize = source.CaseBatchSize;
        target.Concurrency = source.Concurrency;
        target.PollingIntervalSeconds = source.PollingIntervalSeconds;
        target.EmptyBackoffBaseSeconds = source.EmptyBackoffBaseSeconds;
        target.EmptyBackoffMaxSeconds = source.EmptyBackoffMaxSeconds;
        target.Remark = source.Remark;
    }

    private static void CopySourceFields(ActiveSyncSource source, ActiveSyncSource target)
    {
        target.DataType = source.DataType;
        target.SyncTaskInterfaceId = source.SyncTaskInterfaceId;
        target.ServerCode = source.ServerCode;
        target.DisplayName = source.DisplayName;
        target.DatabaseResourceId = source.DatabaseResourceId;
        target.QuerySql = source.QuerySql;
        target.InpatientNoParameter = source.InpatientNoParameter;
        target.AdmissionTimeParameter = source.AdmissionTimeParameter;
        target.SourceRecordKeyFields = source.SourceRecordKeyFields;
        target.PollingIntervalSeconds = source.PollingIntervalSeconds;
        target.SortOrder = source.SortOrder;
        target.Enabled = source.Enabled;
    }

