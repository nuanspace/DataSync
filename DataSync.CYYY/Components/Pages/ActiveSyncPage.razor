    private void OnSyncTaskChanged(int? syncTaskId)
    {
        _editingTask.SyncTaskId = syncTaskId;
        var syncTask = GetSyncTask(syncTaskId);
        if (syncTask != null)
        {
            if (string.IsNullOrWhiteSpace(_editingTask.Name))
                _editingTask.Name = $"{syncTask.Name} Active 补采";

            if (string.IsNullOrWhiteSpace(_editingTask.Code))
                _editingTask.Code = $"{syncTask.Code}_active";

            _editingTask.PushType = syncTask.PushType;
            _editingTask.PushTarget = syncTask.PushTarget;
        }

        _selectedInterfaceIdToAdd = GetAvailableInterfaces().FirstOrDefault()?.Id;
    }

    private async Task SaveSource()
    {
        ApplySelectedInterfaceDefaults();
        NormalizeSource();
        if (!ValidateSource())
            return;

        _savingSource = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            ActiveSyncSource entity;
            if (_editingSource.Id == 0)
            {
                entity = new ActiveSyncSource { TaskId = _editingTask.Id };
                db.ActiveSyncSources.Add(entity);
            }
            else
            {
                entity = await db.ActiveSyncSources.FindAsync([_editingSource.Id], CancellationToken)
                    ?? throw new InvalidOperationException("子数据源不存在");
            }

            CopySourceFields(_editingSource, entity);
            entity.TaskId = _editingTask.Id;
            await db.SaveChangesAsync(CancellationToken);
            inj_snackbar.Add("子数据源已保存", Severity.Success);
            await EditTask(_editingTask.Id);
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存子数据源失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _savingSource = false;
        }
    }

    private async Task ToggleSource(ActiveSyncSource source, bool enabled)
