        if (!CanEditSources)
            return;

        _editingSource = NewSource(_editingTask.Id);
        var iface = GetSyncTaskInterface(_selectedInterfaceIdToAdd);
        if (iface != null)
            ApplyInterfaceDefaults(_editingSource, iface);
        _activePane = SourcePane;
    }

    private void CreateSourceFromSelectedInterface()
    {
        var iface = GetSyncTaskInterface(_selectedInterfaceIdToAdd);
        if (iface == null)
        {
            inj_snackbar.Add("请选择要补采的同步任务接口", Severity.Warning);
            return;
        }

        _editingSource = NewSource(_editingTask.Id);
        ApplyInterfaceDefaults(_editingSource, iface);
        _activePane = SourcePane;
