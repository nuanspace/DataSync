@page "/ingestion/create"
@page "/ingestion/edit/{Id:int}"
@inherits BasePage
@rendermode InteractiveServer

<PageTitle>@(_isEdit ? $"编辑采集源 - {_source.Name}" : "新增采集源")</PageTitle>

<div class="ingestion-edit-toolbar">
    <MudText Typo="Typo.h5">@(_isEdit ? $"编辑采集源 - {_source.Name}" : "新增采集源")</MudText>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => inj_navigationManager.NavigateTo("/ingestion"))">
        返回列表
    </MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
}
else
{
    <div class="ingestion-edit-layout">
        <div class="ingestion-edit-column ingestion-edit-column--left">
            <MudPaper Class="pa-4 ingestion-edit-panel" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">基本信息</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_source.Name" Label="名称" Required="true" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_source.ServerCode" Label="ServerCode" Required="true"
                                      ReadOnly="@(!IsDatabaseSource)" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect T="string" @bind-Value="_source.SourceType" Label="来源类型" Variant="Variant.Outlined">
                            <MudSelectItem Value="@(IngestionService.SourceTypeApi)">API 平台</MudSelectItem>
                            <MudSelectItem Value="@(IngestionService.SourceTypeDatabase)">数据库</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Value="@_localTableName" Label="本地表名（自动生成）" ReadOnly="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_source.Enabled" Label="启用采集源" Color="Color.Success" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-4 ingestion-edit-panel" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">采集窗口</MudText>
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_source.TimeField" Label="时间字段" Required="true"
                                      Variant="Variant.Outlined" HelperText="增量查询的时间字段名" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField @bind-Value="_source.PollingIntervalSeconds" Label="轮询间隔(秒)"
                                         Variant="Variant.Outlined" Min="10" />
                    </MudItem>
                    @if (IsDatabaseSource)
                    {
                        <MudItem xs="12">
                            <MudNumericField @bind-Value="_source.LookbackMinutes" Label="回看分钟"
                                             Variant="Variant.Outlined" Min="0" />
                        </MudItem>
                    }
                    <MudItem xs="12" sm="8">
                        <MudNumericField @bind-Value="_startDisplayValue" Label="开始偏移"
                                         Variant="Variant.Outlined" Min="1"
                                         HelperText="开始时间 = 当前时间 - 该值" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect @bind-Value="_startUnit" Label="单位" Variant="Variant.Outlined">
                            <MudSelectItem Value="@UnitMinutes">分钟</MudSelectItem>
                            <MudSelectItem Value="@UnitHours">小时</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <MudNumericField @bind-Value="_endDisplayValue" Label="结束偏移"
                                         Variant="Variant.Outlined" Min="0"
                                         HelperText="结束时间 = 当前时间 - 该值，0 表示当前时间" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect @bind-Value="_endUnit" Label="单位" Variant="Variant.Outlined">
                            <MudSelectItem Value="@UnitMinutes">分钟</MudSelectItem>
                            <MudSelectItem Value="@UnitHours">小时</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (_isEdit)
            {
                <MudPaper Class="pa-4 ingestion-edit-panel" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">采集检查点</MudText>
                    <div class="checkpoint-summary">
                        <div class="checkpoint-row">
                            <span>检查点键</span>
                            <strong>@IngestionCheckpointKey</strong>
                        </div>
                        <div class="checkpoint-row">
                            <span>上次采集到</span>
                            <strong>@FormatCheckpointTime(_ingestionCheckpoint?.LastSuccessTime)</strong>
                        </div>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               Disabled="@(_resettingCheckpoint || _ingestionCheckpoint is null)"
                               OnClick="ResetIngestionCheckpoint"
                               Class="mt-3">
                        @(_resettingCheckpoint ? "重置中..." : "重置检查点")
                    </MudButton>
                </MudPaper>
            }
        </div>

        <div class="ingestion-edit-column ingestion-edit-column--right">
            @if (IsDatabaseSource)
            {
                <MudPaper Class="pa-4 ingestion-edit-panel" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">数据库查询</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int?" @bind-Value="_source.DatabaseResourceId" Label="数据库资源" Variant="Variant.Outlined">
                                @foreach (var resource in _databaseResources)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)resource.Id)">@GetDatabaseResourceOption(resource)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Value="@SelectedDatabaseTypeText"
                                          Label="数据库类型"
                                          ReadOnly="true"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_source.QuerySql"
                                          Label="SQL 查询模板"
                                          Variant="Variant.Outlined"
                                          Lines="8"
                                          HelperText="@SqlTemplateHelperText" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-4 ingestion-edit-panel" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">API 接口</MudText>
                    <MudSelect T="int?" Value="_source.ApiInterfaceId" ValueChanged="OnApiInterfaceChanged"
                               Label="API 接口" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem T="int?" Value="@((int?)null)">请选择</MudSelectItem>
                        @foreach (var apiInterface in _apiInterfaces)
                        {
                            <MudSelectItem T="int?" Value="@((int?)apiInterface.Id)">@FormatApiInterface(apiInterface)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.subtitle2" Class="mt-3">按对象补录映射</MudText>
                    @for (var i = 0; i < _queryMappings.Count; i++)
                    {
                        var index = i;
                        <MudGrid Class="mt-1">
                            <MudItem xs="12" sm="5"><MudTextField @bind-Value="_queryMappings[index].TargetField" Label="API 请求字段" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" sm="5">
                                <MudSelect T="string" @bind-Value="_queryMappings[index].SourceField" Label="补录输入" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("PatientId")">患者 ID</MudSelectItem>
                                    <MudSelectItem Value="@("VisitId")">就诊号</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="2"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => _queryMappings.RemoveAt(index))" /></MudItem>
                        </MudGrid>
                    }
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _queryMappings.Add(new()))">添加映射</MudButton>
                </MudPaper>
            }

            <MudPaper Class="pa-4 ingestion-edit-panel" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">主键字段</MudText>
                <div class="pk-section">
                    <div class="pk-input-row">
                        <MudTextField @bind-Value="_pkInput" Label="主键字段 *" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" OnKeyUp="OnPkKeyUp"
                                      HelperText="输入字段名后按回车添加，支持联合主键" Class="pk-input" />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddPrimaryKey" Class="ml-2 pk-add-btn">添加</MudButton>
                    </div>
                    @if (_primaryKeys.Count > 0)
                    {
                        <div class="pk-chips">
                            @foreach (var pk in _primaryKeys)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                         OnClose="@(() => _primaryKeys.Remove(pk))">@pk</MudChip>
                            }
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-error)">
                            请至少配置一个主键字段
                        </MudText>
                    }
                </div>
            </MudPaper>

            @if (IsConditionArraySource)
            {
                <MudPaper Class="pa-4 ingestion-edit-panel" Elevation="1">
                    <div class="section-header">
                        <MudText Typo="Typo.h6">额外查询条件</MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddCondition">
                            添加条件
                        </MudButton>
                    </div>

                    @if (_conditions.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2" Style="color: var(--mud-palette-text-secondary)">
                            暂无额外条件，采集时仅按时间范围查询
                        </MudText>
                    }
                    else
                    {
                        @for (var i = 0; i < _conditions.Count; i++)
                        {
                            var index = i;
                            <MudGrid Class="mt-2" Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="_conditions[index].Column" Label="字段名"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudSelect @bind-Value="_conditions[index].Type" Label="操作类型"
                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                        @foreach (var op in SelectedOperators)
                                        {
                                            <MudSelectItem Value="@op.Value">@op.Value（@op.DisplayName）</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="_conditions[index].Value" Label="值"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Disabled="@IsValueDisabled(_conditions[index].Type)" />
                                </MudItem>
                                <MudItem xs="12" sm="1" Class="d-flex align-center">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => _conditions.RemoveAt(index))" />
                                </MudItem>
                            </MudGrid>
                        }
                    }
                </MudPaper>
            }
        </div>
    </div>

    <div class="ingestion-edit-actions mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Save" Disabled="_saving">
            @(_saving ? "保存中..." : "保存")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Class="ml-2"
                   OnClick="@(() => inj_navigationManager.NavigateTo("/ingestion"))">
            取消
        </MudButton>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private IngestionSource _source = new();
    private bool _isEdit;
    private bool _loading = true;
    private bool _saving;
    private bool _resettingCheckpoint;
    private string _checkpointServerCode = "";
    private SyncCheckpoint? _ingestionCheckpoint;
    private List<DatabaseResource> _databaseResources = [];
    private List<ApiInterface> _apiInterfaces = [];
    private List<InterfaceQueryMapping> _queryMappings = [];
    private List<ConditionItem> _conditions = [];
    private List<string> _primaryKeys = [];
    private string _pkInput = "";

    private const string UnitMinutes = "minutes";
    private const string UnitHours = "hours";

    // 单位切换相关（偏移量数值始终按分钟存库，单位单独保存）
    private int _startDisplayValue = 2;
    private string _startUnit = UnitHours;
    private int _endDisplayValue;
    private string _endUnit = UnitHours;

    private bool IsDatabaseSource =>
        IngestionService.IsDatabaseSourceType(_source.SourceType);

    private ApiInterface? SelectedApiInterface =>
        _source.ApiInterfaceId.HasValue ? _apiInterfaces.FirstOrDefault(i => i.Id == _source.ApiInterfaceId.Value) : null;

    private ApiQueryConfig? SelectedApiQueryConfig => SelectedApiInterface?.Platform?.GetQueryConfig();

    private bool IsConditionArraySource =>
        !IsDatabaseSource && string.Equals(SelectedApiQueryConfig?.ParameterMode, ApiParameterModes.ConditionArray, StringComparison.OrdinalIgnoreCase);

    private List<ApiOperatorConfig> SelectedOperators =>
        SelectedApiQueryConfig?.ConditionArray?.Operators ?? [];

    private bool IsSqlServerDatabase =>
        IsDatabaseSource && IngestionService.IsSqlServerDatabaseType(SelectedDatabaseResource?.DatabaseType ?? _source.DatabaseType);

    private bool IsOracleDatabase =>
        IsDatabaseSource && IngestionService.IsOracleDatabaseType(SelectedDatabaseResource?.DatabaseType ?? _source.DatabaseType);

    private bool IsDorisDatabase =>
        IsDatabaseSource && IngestionService.IsDorisDatabaseType(SelectedDatabaseResource?.DatabaseType ?? _source.DatabaseType);

    private bool IsMySqlDatabase =>
        IsDatabaseSource && IngestionService.IsMySqlDatabaseType(SelectedDatabaseResource?.DatabaseType ?? _source.DatabaseType);

    private DatabaseResource? SelectedDatabaseResource =>
        _databaseResources.FirstOrDefault(r => r.Id == _source.DatabaseResourceId);

    private string SelectedDatabaseTypeText => SelectedDatabaseResource?.DatabaseType ?? "未选择";

    private string DatabaseHostLabel => IsOracleDatabase
        ? "Oracle 主机"
        : IsDorisDatabase
            ? "Doris FE 主机"
            : IsMySqlDatabase
                ? "MySQL 主机"
                : "SQL Server 主机";

    private string DatabaseNameLabel => IsOracleDatabase ? "服务名" : IsDorisDatabase ? "Catalog/数据库" : "数据库";

    private string DatabaseHostHelperText => IsOracleDatabase
        ? "可填写主机或 host:port，端口默认 1521"
        : IsDorisDatabase
            ? "填写 FE 查询地址，可包含端口，默认 9030"
            : IsMySqlDatabase
                ? "可填写 host:port，端口默认 3306"
                : "可包含端口或实例名";

    private string SqlTemplateHelperText => IsOracleDatabase
        ? "时间参数可写 :from/:to，也兼容 @from/@to"
        : IsDorisDatabase || IsMySqlDatabase
            ? "时间参数使用 @from 和 @to；仅允许 SELECT 或 WITH 查询"
            : "时间参数使用 @from 和 @to";

    private static string GetDatabaseResourceOption(DatabaseResource resource) =>
        $"{resource.Name}（{resource.DatabaseType} {resource.Host}/{resource.DatabaseName}）";

    /// <summary>
    /// 条件编辑用临时模型
    /// </summary>
    private class ConditionItem
    {
        public string Column { get; set; } = "";
        public string Type { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private bool IsValueDisabled(string type) =>
        SelectedOperators.FirstOrDefault(item => string.Equals(item.Value, type, StringComparison.OrdinalIgnoreCase)) is { RequiresValue: false };

    private void AddCondition() => _conditions.Add(new ConditionItem
    {
        Type = SelectedOperators.FirstOrDefault()?.Value ?? ""
    });

    private void AddPrimaryKey()
    {
        var pk = _pkInput?.Trim();
        if (!string.IsNullOrWhiteSpace(pk) && !_primaryKeys.Contains(pk, StringComparer.OrdinalIgnoreCase))
            _primaryKeys.Add(pk);
        _pkInput = "";
    }

    private void OnPkKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddPrimaryKey();
    }

    private string _localTableName => string.IsNullOrWhiteSpace(_source.ServerCode)
        ? "" : IngestionService.GetLocalTableName(_source.ServerCode);

    private string IngestionCheckpointKey => string.IsNullOrWhiteSpace(_checkpointServerCode)
        ? ""
        : $"INGEST_{_checkpointServerCode}";

    protected override async Task OnPageInitializedAsync()
    {
        _isEdit = Id > 0;

        await using (var resourceDb = await ContextFactory.CreateDbContextAsync(CancellationToken))
        {
            _databaseResources = await resourceDb.DatabaseResources
                .AsNoTracking()
                .OrderBy(r => r.Name)
                .ToListAsync(CancellationToken);
            _apiInterfaces = await resourceDb.ApiInterfaces
                .AsNoTracking()
                .Include(i => i.Platform)
                .OrderBy(i => i.Platform!.Name)
                .ThenBy(i => i.Name)
                .ToListAsync(CancellationToken);
        }

        if (_isEdit)
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            var source = await db.IngestionSources.FindAsync([Id], CancellationToken);

            if (source is null)
            {
                inj_snackbar.Add("采集源不存在", Severity.Error);
                inj_navigationManager.NavigateTo("/ingestion");
                return;
            }

            _source = source;
            _checkpointServerCode = source.ServerCode;
            _source.SourceType = IngestionService.NormalizeSourceType(_source.SourceType);
            _source.DatabaseType = IngestionService.NormalizeDatabaseType(_source.DatabaseType, source.SourceType);
            if (_source.LookbackMinutes < 0)
                _source.LookbackMinutes = 0;
            await LoadIngestionCheckpointAsync();
        }
        else
        {
            _source = new IngestionSource
            {
                SourceType = IngestionService.SourceTypeApi,
                DatabaseType = IngestionService.DatabaseTypeSqlServer,
                LookbackMinutes = 5
            };
        }

        // 加载主键配置
        _primaryKeys = _source.PrimaryKeyArray.ToList();

        // 初始化偏移量显示值，优先使用数据库保存的单位
        InitOffsetDisplay(_source.StartOffsetMinutes, _source.StartOffsetUnit, out _startDisplayValue, out _startUnit);
        InitOffsetDisplay(_source.EndOffsetMinutes, _source.EndOffsetUnit, out _endDisplayValue, out _endUnit);

        // 反序列化已有条件
        if (!string.IsNullOrWhiteSpace(_source.Conditions))
        {
            var parsed = JsonSerializer.Deserialize<List<ConditionItem>>(_source.Conditions,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (parsed != null)
                _conditions = parsed;
        }

        if (!string.IsNullOrWhiteSpace(_source.QueryMappings))
        {
            try { _queryMappings = JsonSerializer.Deserialize<List<InterfaceQueryMapping>>(_source.QueryMappings) ?? []; }
            catch (JsonException) { _queryMappings = []; }
        }

        _loading = false;
    }

    private async Task LoadIngestionCheckpointAsync()
    {
        if (string.IsNullOrWhiteSpace(IngestionCheckpointKey))
            return;

        await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
        _ingestionCheckpoint = await db.SyncCheckpoints
            .AsNoTracking()
            .FirstOrDefaultAsync(c => c.TaskCode == IngestionCheckpointKey, CancellationToken);
    }

    private async Task ResetIngestionCheckpoint()
    {
        if (string.IsNullOrWhiteSpace(IngestionCheckpointKey))
            return;

        var confirmed = await inj_dialogService.ShowMessageBox(
            "重置采集检查点",
            $"确定要重置采集源「{_source.Name}」的检查点吗？下次采集将按开始偏移和结束偏移重新计算查询区间。",
            yesText: "重置",
            cancelText: "取消");
        if (confirmed != true)
            return;

        _resettingCheckpoint = true;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            var checkpoint = await db.SyncCheckpoints.FindAsync([IngestionCheckpointKey], CancellationToken);
            if (checkpoint != null)
            {
                db.SyncCheckpoints.Remove(checkpoint);
                await db.SaveChangesAsync(CancellationToken);
            }

            _ingestionCheckpoint = null;
            inj_snackbar.Add("采集检查点已重置", Severity.Success);
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"重置失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _resettingCheckpoint = false;
        }
    }

    private void OnApiInterfaceChanged(int? apiInterfaceId)
    {
        _source.ApiInterfaceId = apiInterfaceId;
        var apiInterface = SelectedApiInterface;
        if (apiInterface == null)
            return;
        _source.SourceType = IngestionService.SourceTypeApi;
        _source.ServerCode = apiInterface.Code;
        _source.QueryPath = apiInterface.RelativePath;
        if (!IsConditionArraySource)
            _conditions = [];
    }

    private static string FormatApiInterface(ApiInterface apiInterface) =>
        $"{apiInterface.Platform?.Name} / {apiInterface.Name}（{apiInterface.Code}）";

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_source.Name) ||
            string.IsNullOrWhiteSpace(_source.ServerCode) ||
            string.IsNullOrWhiteSpace(_source.TimeField))
        {
            inj_snackbar.Add("请填写所有必填字段", Severity.Warning);
            return;
        }

        _source.SourceType = IngestionService.NormalizeSourceType(_source.SourceType);
        _source.DatabaseType = IngestionService.NormalizeDatabaseType(_source.DatabaseType, _source.SourceType);

        if (IsDatabaseSource &&
            (!_source.DatabaseResourceId.HasValue ||
             string.IsNullOrWhiteSpace(_source.QuerySql)))
        {
            inj_snackbar.Add("数据库采集源必须选择数据库资源并填写 SQL 查询模板", Severity.Warning);
            return;
        }

        if (!IsDatabaseSource && !_source.ApiInterfaceId.HasValue)
        {
            inj_snackbar.Add("API 采集源必须选择接口目录", Severity.Warning);
            return;
        }

        if (_primaryKeys.Count == 0)
        {
            inj_snackbar.Add("请至少配置一个主键字段", Severity.Warning);
            return;
        }
        _source.PrimaryKeys = string.Join(",", _primaryKeys);

        _startUnit = NormalizeUnit(_startUnit, _startDisplayValue);
        _endUnit = NormalizeUnit(_endUnit, _endDisplayValue);

        // 将显示值换算回分钟
        _source.StartOffsetMinutes = _startUnit == UnitHours ? _startDisplayValue * 60 : _startDisplayValue;
        _source.EndOffsetMinutes = _endUnit == UnitHours ? _endDisplayValue * 60 : _endDisplayValue;
        _source.StartOffsetUnit = _startUnit;
        _source.EndOffsetUnit = _endUnit;

        if (_source.StartOffsetMinutes <= _source.EndOffsetMinutes)
        {
            inj_snackbar.Add("开始偏移必须大于结束偏移", Severity.Warning);
            return;
        }

        var queryMappings = _queryMappings.Select(item => new InterfaceQueryMapping
        {
            TargetField = (item.TargetField ?? "").Trim(),
            SourceField = (item.SourceField ?? "").Trim()
        }).ToList();
        if (!IsDatabaseSource && queryMappings.Any(item =>
                string.IsNullOrWhiteSpace(item.TargetField) || string.IsNullOrWhiteSpace(item.SourceField)))
        {
            inj_snackbar.Add("按对象补录映射的字段名不能为空", Severity.Warning);
            return;
        }
        if (!IsDatabaseSource && queryMappings
                .GroupBy(item => item.TargetField, StringComparer.OrdinalIgnoreCase)
                .Any(group => group.Count() > 1))
        {
            inj_snackbar.Add("API 请求字段不能重复", Severity.Warning);
            return;
        }
        if (IsConditionArraySource && _conditions.Any(condition =>
                string.IsNullOrWhiteSpace(condition.Column) ||
                !SelectedOperators.Any(item => string.Equals(item.Value, condition.Type, StringComparison.OrdinalIgnoreCase)) ||
                !IsValueDisabled(condition.Type) && string.IsNullOrWhiteSpace(condition.Value?.ToString())))
        {
            inj_snackbar.Add("请完整填写额外查询条件，操作符必须来自当前平台", Severity.Warning);
            return;
        }

        _saving = true;

        if (IsDatabaseSource)
        {
            var resource = SelectedDatabaseResource;
            if (resource == null)
            {
                inj_snackbar.Add("请选择有效的数据库资源", Severity.Warning);
                return;
            }

            _source.DatabaseType = IngestionService.NormalizeDatabaseType(resource.DatabaseType);
            _source.Conditions = null;
            _source.ConnectionStringName = null;
            _source.SqlServerHost = null;
            _source.SqlServerDatabase = null;
            _source.SqlServerUsername = null;
            _source.SqlServerPassword = null;
            _source.LookbackMinutes = Math.Max(0, _source.LookbackMinutes);
            _source.SqlServerTrustCertificate = resource.TrustCertificate;
            _source.QueryPath = null;
            _source.ApiInterfaceId = null;
            _source.QueryMappings = null;
        }
        else
        {
            _source.DatabaseResourceId = null;
            _source.DatabaseType = IngestionService.DatabaseTypeSqlServer;
            _source.ConnectionStringName = null;
            _source.SqlServerHost = null;
            _source.SqlServerDatabase = null;
            _source.SqlServerUsername = null;
            _source.SqlServerPassword = null;
            _source.SqlServerTrustCertificate = true;
            _source.QuerySql = null;
            _source.LookbackMinutes = Math.Max(0, _source.LookbackMinutes);

            var apiInterface = SelectedApiInterface!;
            _source.ServerCode = apiInterface.Code;
            _source.QueryPath = apiInterface.RelativePath;
            _source.QueryMappings = queryMappings.Count == 0 ? null : JsonSerializer.Serialize(queryMappings);

            var validConditions = IsConditionArraySource
                ? _conditions.Where(c => !string.IsNullOrWhiteSpace(c.Column) &&
                    SelectedOperators.Any(item => string.Equals(item.Value, c.Type, StringComparison.OrdinalIgnoreCase))).ToList()
                : [];
            _source.Conditions = validConditions.Count > 0
                ? JsonSerializer.Serialize(validConditions.Select(c => new
                {
                    column = c.Column,
                    type = c.Type,
                    value = IsValueDisabled(c.Type) ? "" : c.Value
                }))
                : null;
        }

        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);

            // ServerCode 唯一性校验
            var codeExists = await db.IngestionSources
                .AnyAsync(s => s.ServerCode == _source.ServerCode && s.Id != _source.Id, CancellationToken);
            if (codeExists)
            {
                inj_snackbar.Add($"ServerCode「{_source.ServerCode}」已存在", Severity.Warning);
                return;
            }

            if (_isEdit)
            {
                var entity = await db.IngestionSources.FindAsync([Id], CancellationToken);
                if (entity is null) return;

                entity.Name = _source.Name;
                entity.ServerCode = _source.ServerCode;
                entity.ApiInterfaceId = _source.ApiInterfaceId;
                entity.SourceType = _source.SourceType;
                entity.DatabaseResourceId = _source.DatabaseResourceId;
                entity.DatabaseType = _source.DatabaseType;
                entity.ConnectionStringName = _source.ConnectionStringName;
                entity.SqlServerHost = _source.SqlServerHost;
                entity.SqlServerDatabase = _source.SqlServerDatabase;
                entity.SqlServerUsername = _source.SqlServerUsername;
                entity.SqlServerPassword = _source.SqlServerPassword;
                entity.SqlServerTrustCertificate = _source.SqlServerTrustCertificate;
                entity.QuerySql = _source.QuerySql;
                entity.QueryPath = _source.QueryPath;
                entity.QueryMappings = _source.QueryMappings;
                entity.TimeField = _source.TimeField;
                entity.LookbackMinutes = _source.LookbackMinutes;
                entity.PollingIntervalSeconds = _source.PollingIntervalSeconds;
                entity.StartOffsetMinutes = _source.StartOffsetMinutes;
                entity.EndOffsetMinutes = _source.EndOffsetMinutes;
                entity.StartOffsetUnit = _source.StartOffsetUnit;
                entity.EndOffsetUnit = _source.EndOffsetUnit;
                entity.Enabled = _source.Enabled;
                entity.PrimaryKeys = _source.PrimaryKeys;
                entity.Conditions = _source.Conditions;
            }
            else
            {
                db.IngestionSources.Add(_source);
            }

            await db.SaveChangesAsync(CancellationToken);
            inj_snackbar.Add(_isEdit ? "采集源更新成功" : "采集源创建成功", Severity.Success);
            inj_navigationManager.NavigateTo("/ingestion");
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// 根据分钟数和已保存单位初始化显示值。
    /// </summary>
    private static void InitOffsetDisplay(int minutes, string? savedUnit, out int displayValue, out string unit)
    {
        unit = NormalizeUnit(savedUnit, minutes);
        if (unit == UnitHours && minutes % 60 == 0)
        {
            displayValue = minutes / 60;
            return;
        }

        displayValue = minutes;
        unit = UnitMinutes;
    }

    private static string NormalizeUnit(string? unit, int minutes)
        => unit is UnitHours or UnitMinutes ? unit : GuessUnit(minutes);

    private static string GuessUnit(int minutes)
        => minutes % 60 == 0 ? UnitHours : UnitMinutes;

    private static string FormatCheckpointTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm:ss") : "尚未生成";

}
