    private List<string> GetInterfaceIssues(SyncTaskInterface iface)
    {
        if (!iface.Enabled)
            return [];

        var issues = new List<string>();
        if (string.IsNullOrWhiteSpace(iface.ServerCode))
        {
            issues.Add("先选择目标接口");
            return issues;
        }

        if (!IsDatabaseInterface(iface))
        {
            if (!iface.ApiInterfaceId.HasValue || _apiInterfaces.All(i => i.Id != iface.ApiInterfaceId.Value))
                issues.Add("先选择有效的 API 接口");
            if (!IsChildInterface(iface))
            {
                var queryMappings = GetQueryMappings(iface);
                if (queryMappings.Count == 0)
                    issues.Add("先添加手动查询映射");
                else if (queryMappings.GroupBy(mapping => mapping.TargetField, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1))
                    issues.Add("API 请求字段不能重复");

                if (iface.ContinuousPollingEnabled)
                {
                    if (iface.ContinuousPollingIntervalSeconds < 1)
                        issues.Add("持续轮询间隔必须大于 0");
                    if (string.IsNullOrWhiteSpace(_task.VisitSnField))
                        issues.Add("任务必须配置统一就诊号字段");
                    if (string.IsNullOrWhiteSpace(iface.QueryStartTimeSourceServerCode) ||
                        _ingestionSources.All(source => !string.Equals(
                            source.ServerCode, iface.QueryStartTimeSourceServerCode, StringComparison.OrdinalIgnoreCase)))
                        issues.Add("先选择有效的入院时间来源接口");
                    if (string.IsNullOrWhiteSpace(iface.QueryStartTimeSourceField))
                        issues.Add("先填写入院时间来源字段");
                    if (string.IsNullOrWhiteSpace(iface.QueryEndTimeSourceServerCode) ||
                        _ingestionSources.All(source => !string.Equals(
                            source.ServerCode, iface.QueryEndTimeSourceServerCode, StringComparison.OrdinalIgnoreCase)))
                        issues.Add("先选择有效的出院时间来源接口");
                    if (string.IsNullOrWhiteSpace(iface.QueryEndTimeSourceField))
                        issues.Add("先填写出院时间来源字段");
                }

                if (iface.PatientContinuousSyncEnabled &&
                    string.IsNullOrWhiteSpace(iface.ContinuousRecordKeyFields) &&
                    !iface.ContinuousUseRowHash)
                    issues.Add("配置记录唯一键或启用不可变整行哈希");
                if (iface.PatientContinuousSyncEnabled && IsConditionArrayInterface(iface))
                    issues.Add("患者持续同步当前仅支持直接参数 API");
                var continuousQueryConfig = iface.PatientContinuousSyncEnabled
                    ? GetApiInterface(iface)?.Platform?.GetQueryConfig()
                    : null;
                if (iface.PatientContinuousSyncEnabled && iface.ContinuousUseTimeRange &&
                    continuousQueryConfig != null &&
                    (string.IsNullOrWhiteSpace(continuousQueryConfig.StartTimeField) ||
                     string.IsNullOrWhiteSpace(continuousQueryConfig.EndTimeField)))
                    issues.Add("API 平台必须配置开始、结束时间请求字段");
            }
        }
        else if (!IsChildInterface(iface) && string.IsNullOrWhiteSpace(iface.QueryField))
            issues.Add("先填写目标接口查询字段");

        if (IsDatabaseInterface(iface))
        {
            if (iface.DatabaseResourceId.HasValue && GetDatabaseResource(iface.DatabaseResourceId) == null)
            {
                issues.Add("选择的数据库资源不存在");
            }
            else if (!iface.DatabaseResourceId.HasValue && !HasTriggerDatabaseConnection(iface))
            {
                issues.Add("先选择数据库资源或配置患者来源数据库资源");
            }

            if (string.IsNullOrWhiteSpace(iface.QuerySql))
                issues.Add("先填写 SQL 查询模板");
        }

        if (iface.AccessWindowEnabled)
        {
            try
            {
                InterfaceAccessWindow.Validate(iface);
            }
            catch (InvalidOperationException ex)
            {
                issues.Add(ex.Message);
            }
        }

        var relatedRoot = IsChildInterface(iface) ? GetParentInterface(iface) : iface;
        if (relatedRoot != null)
        {
            var unit = _interfaces.Where(item => item.Enabled &&
                (ReferenceEquals(item, relatedRoot) ||
                 string.Equals(item.ParentInterfaceKey, relatedRoot.InterfaceKey, StringComparison.OrdinalIgnoreCase)));
            if (unit.Any(item => item.AccessWindowEnabled != relatedRoot.AccessWindowEnabled ||
                    relatedRoot.AccessWindowEnabled &&
                    (!string.Equals(item.AccessWindowStart, relatedRoot.AccessWindowStart, StringComparison.Ordinal) ||
                     !string.Equals(item.AccessWindowEnd, relatedRoot.AccessWindowEnd, StringComparison.Ordinal))))
            {
                issues.Add("组合根接口和子接口的访问时段必须一致");
            }
        }

        if (IsChildInterface(iface))
        {
            var parent = GetParentInterface(iface);
            if (parent == null)
                issues.Add("先选择有效父接口");
            else if (!parent.Enabled)
                issues.Add("父接口已停用");

            var mappings = GetLinkMappings(iface);
            if (mappings.Count == 0)
            {
                issues.Add("先添加关联字段");
            }
            else if (mappings.GroupBy(mapping => mapping.ChildField, StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
            {
                issues.Add("当前接口关联字段不能重复");
            }

            if (string.IsNullOrWhiteSpace(iface.MountField))
                issues.Add("先填写挂载字段名");

            if (!string.IsNullOrWhiteSpace(iface.MountField))
            {
                var duplicateMount = _interfaces.Any(i =>
                    !ReferenceEquals(i, iface) &&
                    i.Enabled &&
                    i.ParentInterfaceKey == iface.ParentInterfaceKey &&
                    string.Equals(i.MountField, iface.MountField, StringComparison.OrdinalIgnoreCase));
                if (duplicateMount)
                    issues.Add("同一父接口下挂载字段名不能重复");
            }

            var siblings = _interfaces
                .Where(i => i.Enabled && i.ParentInterfaceKey == iface.ParentInterfaceKey)
                .ToList();
            if (siblings.Count > 1)
            {
                if (string.IsNullOrWhiteSpace(iface.RouteField))
                    issues.Add("存在多个候选子接口时必须配置分流字段");
                if (string.IsNullOrWhiteSpace(iface.RouteValue))
                    issues.Add("存在多个候选子接口时必须配置分流值");
            }

            return issues;
        }

        var missingPushParams = GetMissingPushParamNames(iface);
        if (missingPushParams.Count > 0)
            issues.Add($"补齐路由参数：{string.Join("、", missingPushParams)}");

        return issues;
    }

