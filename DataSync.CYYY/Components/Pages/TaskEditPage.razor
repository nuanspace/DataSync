    private async Task SaveConfig()
    {
        if (_editingConfigInterface == null) return;

        if (IsChildInterface(_editingConfigInterface))
        {
            var hasIncompleteMapping = _editingLinkMappings.Any(mapping =>
                string.IsNullOrWhiteSpace(mapping.ParentField) != string.IsNullOrWhiteSpace(mapping.ChildField));
            if (hasIncompleteMapping)
            {
                inj_snackbar.Add("关联字段必须同时填写父接口字段和当前接口字段", Severity.Warning);
                return;
            }

            SetLinkMappings(_editingConfigInterface, _editingLinkMappings);
            _editingConfigInterface.PushParams = null;
            _editingConfigInterface.OutputFields = null;
            _editingConfigInterface.RouteOperator = string.IsNullOrWhiteSpace(_editingConfigInterface.RouteOperator)
                ? "eq"
                : _editingConfigInterface.RouteOperator;
        }
        else
        {
            if (!IsDatabaseInterface(_editingConfigInterface))
            {
                var hasIncompleteMapping = _editingQueryMappings.Any(mapping =>
                    string.IsNullOrWhiteSpace(mapping.TargetField) != string.IsNullOrWhiteSpace(mapping.SourceField));
                if (hasIncompleteMapping)
                {
                    inj_snackbar.Add("查询映射必须同时填写 API 请求字段和触发记录字段", Severity.Warning);
                    return;
                }
                var validMappings = _editingQueryMappings
                    .Where(mapping => !string.IsNullOrWhiteSpace(mapping.TargetField) && !string.IsNullOrWhiteSpace(mapping.SourceField))
                    .ToList();
                if (validMappings.GroupBy(mapping => mapping.TargetField, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1))
                {
                    inj_snackbar.Add("API 请求字段不能重复", Severity.Warning);
                    return;
                }
                SetQueryMappings(_editingConfigInterface, validMappings);
            }

            // 保存路由参数
            var validParams = _editingParams
                .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                .ToDictionary(kv => kv.Key, kv => kv.Value.Trim());
            _editingConfigInterface.PushParams = validParams.Count > 0
                ? JsonSerializer.Serialize(validParams)
                : null;

            var outputFields = _editingOutputFieldsText
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            _editingConfigInterface.OutputFields = outputFields.Count > 0
                ? string.Join(",", outputFields)
                : null;
        }

        // 保存过滤条件
        var validFilters = IsConditionArrayInterface(_editingConfigInterface)
            ? _editingFilters.Where(c => !string.IsNullOrWhiteSpace(c.Column) && !string.IsNullOrWhiteSpace(c.Type)).ToList()
            : [];
        var allowedOperators = GetEditingOperators().Select(item => item.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (validFilters.Any(condition => !allowedOperators.Contains(condition.Type)))
        {
            inj_snackbar.Add("过滤条件包含当前平台未配置的操作符", Severity.Warning);
            return;
        }
        if (validFilters.Any(condition =>
                OperatorRequiresValue(condition.Type) && string.IsNullOrWhiteSpace(condition.Value?.ToString())))
        {
            inj_snackbar.Add("请填写过滤条件值", Severity.Warning);
            return;
        }
        foreach (var condition in validFilters.Where(condition => !OperatorRequiresValue(condition.Type)))
            condition.Value = "";
        _editingConfigInterface.FilterConditions = validFilters.Count > 0
            ? JsonSerializer.Serialize(validFilters)
            : null;

        if (_editingNewInterface)
        {
            _interfaces.Add(_editingConfigInterface);
            _pendingNewInterface = _editingConfigInterface;
            _editingNewInterface = false;
            await RefreshInterfaceWorkspaceAsync();
        }

        _showConfigDialog = false;
    }

