    private static string GetDropZoneIdentifier(int sortOrder) => $"group-{sortOrder}";

    private static int GetSortOrderFromDropZone(string? zoneIdentifier, int fallbackSortOrder)
    {
        if (string.IsNullOrWhiteSpace(zoneIdentifier))
            return fallbackSortOrder;

        const string prefix = "group-";
        if (zoneIdentifier.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) &&
            int.TryParse(zoneIdentifier[prefix.Length..], out var sortOrder) &&
            sortOrder > 0)
        {
            return sortOrder;
        }

        return fallbackSortOrder;
    }

    private int GetInsertIndexForDrop(int targetSortOrder, int indexInZone)
    {
        var targetItems = _interfaces
            .Where(i => i.SortOrder == targetSortOrder)
            .ToList();

        if (targetItems.Count == 0)
        {
            var lastLowerOrEqualIndex = _interfaces.FindLastIndex(i => i.SortOrder <= targetSortOrder);
            return lastLowerOrEqualIndex >= 0 ? lastLowerOrEqualIndex + 1 : 0;
        }

        var safeIndex = Math.Clamp(indexInZone, 0, targetItems.Count);
        if (safeIndex >= targetItems.Count)
        {
            var lastItem = targetItems[^1];
            return _interfaces.IndexOf(lastItem) + 1;
        }

        var anchorItem = targetItems[safeIndex];
        return _interfaces.IndexOf(anchorItem);
    }

    private int GetInsertIndexForManualGroupChange(int targetSortOrder)
    {
        var targetItems = _interfaces
            .Where(i => i.SortOrder == targetSortOrder)
            .ToList();

        if (targetItems.Count == 0)
        {
            var lastLowerIndex = _interfaces.FindLastIndex(i => i.SortOrder < targetSortOrder);
            return lastLowerIndex >= 0 ? lastLowerIndex + 1 : 0;
        }

        var lastItem = targetItems[^1];
        return _interfaces.IndexOf(lastItem) + 1;
    }

