    private InterfaceWorkspaceSummary GetInterfaceWorkspaceSummary()
    {
        var readyCount = 0;
        var missingServerCount = 0;
        var missingQueryCount = 0;
        var missingPushParamCount = 0;

        foreach (var iface in _interfaces.Where(i => i.Enabled))
        {
            if (string.IsNullOrWhiteSpace(iface.ServerCode))
            {
                missingServerCount++;
                continue;
            }

            if (string.IsNullOrWhiteSpace(iface.QueryField))
                missingQueryCount++;

            if (GetMissingPushParamCount(iface) > 0)
                missingPushParamCount++;

            if (GetInterfaceIssues(iface).Count == 0)
                readyCount++;
        }

        return new InterfaceWorkspaceSummary
        {
            ReadyCount = readyCount,
            MissingServerCount = missingServerCount,
            MissingQueryCount = missingQueryCount,
            MissingPushParamCount = missingPushParamCount
        };
    }

