    private static Dictionary<string, string> ParsePushParams(string? pushParams)
    {
        if (string.IsNullOrWhiteSpace(pushParams)) return [];
        try
        {
            return JsonSerializer.Deserialize<Dictionary<string, string>>(pushParams) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static bool TryValidatePushParams(string? pushParams, out string? errorMessage)
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(pushParams))
            return true;

        try
        {
            var parsed = JsonSerializer.Deserialize<Dictionary<string, string>>(pushParams);
            if (parsed == null)
            {
                errorMessage = "必须是 JSON 对象";
                return false;
            }

            return true;
        }
        catch (JsonException ex)
        {
            errorMessage = ex.Message;
            return false;
        }
    }

    private static int GetPushParamCount(SyncTaskInterface iface) => ParsePushParams(iface.PushParams).Count;

    private List<string> GetMissingPushParamNames(SyncTaskInterface iface)
    {
        if (IsChildInterface(iface))
            return [];

        var placeholders = ExtractPlaceholders();
        if (placeholders.Count == 0)
            return [];

        var existingParams = ParsePushParams(iface.PushParams);
        return placeholders
            .Where(name => !existingParams.TryGetValue(name, out var value) || string.IsNullOrWhiteSpace(value))
            .ToList();
    }

    private int GetMissingPushParamCount(SyncTaskInterface iface) => GetMissingPushParamNames(iface).Count;

    private string GetPushParamCompletionText(SyncTaskInterface iface)
    {
        if (IsChildInterface(iface))
            return "子接口不单独推送";

        var total = ExtractPlaceholders().Count;
        if (total == 0)
            return "无需补充";

        var completed = total - GetMissingPushParamCount(iface);
        return $"{completed}/{total} 已补齐";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!string.IsNullOrWhiteSpace(_pendingSortOrderFocusKey))
        {
            var interfaceKey = _pendingSortOrderFocusKey;
            _pendingSortOrderFocusKey = null;
            await inj_jsRuntime.InvokeVoidAsync("taskEdit.focusInterfaceCard", interfaceKey);

            return;
        }

        if (_pendingNewInterface is null)
            return;

        await inj_jsRuntime.InvokeVoidAsync("taskEdit.focusNewInterfaceCard", ".interface-card--new");
        _pendingNewInterface = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReleaseSortOrderTransitionAsync(int transitionVersion)
    {
        await Task.Delay(280);
        if (transitionVersion != _sortOrderTransitionVersion)
            return;

        _sortOrderTransitioning = false;
        _movingSortOrderInterfaceKey = null;
        await InvokeAsync(StateHasChanged);
    }

    private List<string> GetEditingMissingParamNames() => _editingParams
        .Where(kv => string.IsNullOrWhiteSpace(kv.Value))
        .Select(kv => kv.Key)
        .ToList();

    private string GetEditingPushTargetPreview()
    {
        if (string.IsNullOrWhiteSpace(_task.PushTarget))
            return "未配置";

        if (_editingParams.Count == 0)
            return _task.PushTarget;

        var preview = _task.PushTarget;
        foreach (var item in _editingParams)
        {
            var value = string.IsNullOrWhiteSpace(item.Value)
                ? $"{{{item.Key}}}"
                : item.Value.Trim();
            preview = preview.Replace($"{{{item.Key}}}", value, StringComparison.Ordinal);
        }

        return preview;
    }

    private static int GetFilterConditionCount(SyncTaskInterface iface)
    {
        if (IsDatabaseInterface(iface))
            return 0;

        if (string.IsNullOrWhiteSpace(iface.FilterConditions)) return 0;
        try
        {
            return JsonSerializer.Deserialize<List<DataLakeCondition>>(iface.FilterConditions)?.Count ?? 0;
        }
        catch (JsonException)
        {
            return 0;
        }
    }

    private void CaptureOriginalTaskState()
    {
        _originalEnabled = _task.Enabled;
        _originalTriggerServerCode = _task.TriggerServerCode;
        _originalPushType = _task.PushType;
        _originalPushTarget = _task.PushTarget;
    }

    private bool ShouldConfirmEnableRisk()
    {
        if (!_task.Enabled)
            return false;

        if (!_isEdit)
            return true;

        if (!_originalEnabled)
            return true;

        return !string.Equals(_task.TriggerServerCode, _originalTriggerServerCode, StringComparison.Ordinal) ||
            !string.Equals(_task.PushType, _originalPushType, StringComparison.Ordinal) ||
            !string.Equals(_task.PushTarget, _originalPushTarget, StringComparison.Ordinal);
    }

    private void BackToTaskList() => inj_navigationManager.NavigateTo("/tasks");

    private async Task SaveConfig()
    {
        if (_editingConfigInterface == null) return;

        if (IsChildInterface(_editingConfigInterface))
        {
            var hasIncompleteMapping = _editingLinkMappings.Any(mapping =>
                string.IsNullOrWhiteSpace(mapping.ParentField) != string.IsNullOrWhiteSpace(mapping.ChildField));
            if (hasIncompleteMapping)
            {
                inj_snackbar.Add("关联字段必须同时填写父接口字段和当前接口字段", Severity.Warning);
                return;
            }

            SetLinkMappings(_editingConfigInterface, _editingLinkMappings);
            _editingConfigInterface.PushParams = null;
            _editingConfigInterface.OutputFields = null;
            _editingConfigInterface.RouteOperator = string.IsNullOrWhiteSpace(_editingConfigInterface.RouteOperator)
                ? "eq"
                : _editingConfigInterface.RouteOperator;
        }
        else
        {
            // 保存路由参数
            var validParams = _editingParams
                .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                .ToDictionary(kv => kv.Key, kv => kv.Value.Trim());
            _editingConfigInterface.PushParams = validParams.Count > 0
                ? JsonSerializer.Serialize(validParams)
                : null;

            var outputFields = _editingOutputFieldsText
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            _editingConfigInterface.OutputFields = outputFields.Count > 0
                ? string.Join(",", outputFields)
                : null;
        }

        // 保存过滤条件
        var validFilters = _editingFilters
            .Where(c => !string.IsNullOrWhiteSpace(c.Column) && !string.IsNullOrWhiteSpace(c.Type))
            .ToList();
        foreach (var c in validFilters.Where(c => c.Type is "isnull" or "isnotnull"))
            c.Value = "";
        _editingConfigInterface.FilterConditions = validFilters.Count > 0
            ? JsonSerializer.Serialize(validFilters)
            : null;

        if (_editingNewInterface)
        {
            _interfaces.Add(_editingConfigInterface);
            _pendingNewInterface = _editingConfigInterface;
            _editingNewInterface = false;
            await RefreshInterfaceWorkspaceAsync();
        }

        _showConfigDialog = false;
    }

    // --- 过滤条件管理 ---

    private async Task AddRule()
    {
        var defaultInterface = !string.IsNullOrWhiteSpace(_task.TriggerServerCode)
            ? _task.TriggerServerCode
            : _ingestionSources.FirstOrDefault()?.ServerCode ?? "";
        _conditionConfig.Rules.Add(new ConditionRule { Interface = defaultInterface });
        _ruleValuesText.Add("");
        await EnsureColumnsLoadedAsync(defaultInterface);
    }

    private void RemoveRule(int index)
    {
        _conditionConfig.Rules.RemoveAt(index);
        _ruleValuesText.RemoveAt(index);
    }

    private async Task OnRuleInterfaceChanged(int index, string serverCode)
    {
        _conditionConfig.Rules[index].Interface = serverCode;
        _conditionConfig.Rules[index].Field = "";
        await EnsureColumnsLoadedAsync(serverCode);
    }

    private List<string> GetColumnsForInterface(string? serverCode)
    {
        if (string.IsNullOrEmpty(serverCode)) return [];
        return _columnsCache.TryGetValue(serverCode, out var cols) ? cols : [];
    }

    private List<string> GetTriggerSourceColumns()
    {
        if (string.IsNullOrEmpty(_task.TriggerServerCode)) return [];
        return _columnsCache.TryGetValue(_task.TriggerServerCode, out var cols) ? cols : [];
    }

    private Task<IEnumerable<string>> SearchTriggerSourceColumns(string value, CancellationToken token = default)
    {
        var columns = GetTriggerSourceColumns();
        var result = string.IsNullOrWhiteSpace(value)
            ? columns
            : columns.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.FromResult(result.AsEnumerable());
    }

    private async Task EnsureColumnsLoadedAsync(string? serverCode)
    {
        if (string.IsNullOrEmpty(serverCode) || _columnsCache.ContainsKey(serverCode)) return;
        var tableName = IngestionService.GetLocalTableName(serverCode);
        _columnsCache[serverCode] = await inj_localQueryService
            .GetTableColumnsAsync(tableName, CancellationToken);
    }

    // --- 保存 ---

    private async Task Save()
    {
        EnsureInterfaceKeys();
        foreach (var iface in _interfaces)
            NormalizeInterfaceConfig(iface);
        NormalizeInterfaceOrder();

        var duplicateInterfaceKeys = _interfaces
            .Where(i => !string.IsNullOrWhiteSpace(i.InterfaceKey))
            .GroupBy(i => i.InterfaceKey)
            .Where(g => g.Count() > 1)
            .Select(g => GetInterfaceDisplayName(g.First()))
            .ToList();
        if (duplicateInterfaceKeys.Count > 0)
        {
            inj_snackbar.Add($"关联接口存在重复配置：{string.Join("、", duplicateInterfaceKeys.Take(3))}", Severity.Warning);
            return;
        }

        if (!_task.EnableTriggerRecordPush)
        {
            _task.TriggerPushTarget = null;
            _task.TriggerPushParams = null;
        }

        if (string.IsNullOrWhiteSpace(_task.Name) ||
            string.IsNullOrWhiteSpace(_task.Code) ||
            string.IsNullOrWhiteSpace(_task.TriggerServerCode) ||
            string.IsNullOrWhiteSpace(_task.PushType) ||
            string.IsNullOrWhiteSpace(_task.PushTarget))
        {
            inj_snackbar.Add("请填写所有必填字段", Severity.Warning);
            return;
        }

        if (_task.Enabled && _interfaces.All(i => !i.Enabled))
        {
            inj_snackbar.Add("任务已启用时，至少保留 1 个启用接口", Severity.Warning);
            return;
        }

        if (_task.EnableTriggerRecordPush)
        {
            if (string.IsNullOrWhiteSpace(_task.TriggerPushTarget))
            {
                inj_snackbar.Add("启用触发记录单独推送后，必须填写触发记录推送目标", Severity.Warning);
                return;
            }

            if (!TryValidatePushParams(_task.TriggerPushParams, out var triggerPushParamError))
            {
                inj_snackbar.Add($"触发记录路由参数 JSON 无法解析：{triggerPushParamError}", Severity.Warning);
                return;
            }

            var triggerPushParams = ParsePushParams(_task.TriggerPushParams);
            var missingTriggerPushParams = ExtractPlaceholders(_task.TriggerPushTarget)
                .Where(name => !triggerPushParams.TryGetValue(name, out var value) || string.IsNullOrWhiteSpace(value))
                .ToList();
            if (missingTriggerPushParams.Count > 0)
            {
                inj_snackbar.Add(
                    $"触发记录推送目标仍有未补齐占位符：{string.Join("、", missingTriggerPushParams.Select(name => $"{{{name}}}"))}",
                    Severity.Warning);
                return;
            }
        }

        var invalidInterfaces = _interfaces
            .Where(i => i.Enabled)
            .Select(i => new
            {
                Label = GetInterfaceDisplayName(i),
                Issues = GetInterfaceIssues(i)
            })
            .Where(x => x.Issues.Count > 0)
            .ToList();
        if (invalidInterfaces.Count > 0)
        {
            var detail = string.Join("；", invalidInterfaces
                .Take(3)
                .Select(x => $"{x.Label}：{string.Join("、", x.Issues)}"));
            if (invalidInterfaces.Count > 3)
                detail += $"；另有 {invalidInterfaces.Count - 3} 个接口也未配置完整";
            inj_snackbar.Add($"请先补齐启用接口配置：{detail}", Severity.Warning);
            return;
        }

        if (ShouldConfirmEnableRisk())
        {
            var conflicts = await inj_taskManagementService.GetEnabledConflictsAsync(_task, CancellationToken);
            if (conflicts.Count > 0)
            {
                var confirmed = await inj_dialogService.ShowMessageBox(
                    "重复同步风险提示",
                    TaskManagementService.BuildEnableConflictMessage(_task, conflicts),
                    yesText: "继续保存", cancelText: "取消");
                if (confirmed != true)
                    return;
            }
        }

        _saving = true;
        try
        {
            // 同步过滤条件文本到 rules 的 values
            for (var i = 0; i < _conditionConfig.Rules.Count; i++)
            {
                _conditionConfig.Rules[i].Values = _ruleValuesText[i]
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList();
            }
            var conditionsJson = _conditionConfig.Rules.Count > 0
                ? JsonSerializer.Serialize(_conditionConfig, new JsonSerializerOptions { WriteIndented = false })
                : null;

            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            var createdInterfaces = new List<(SyncTaskInterface PageItem, SyncTaskInterface EntityItem)>();

            // Code 唯一性校验
            var codeExists = await db.SyncTasks
                .AnyAsync(t => t.Code == _task.Code && t.Id != _task.Id, CancellationToken);
            if (codeExists)
            {
                inj_snackbar.Add($"编码「{_task.Code}」已存在，请使用其他编码", Severity.Warning);
                return;
            }

            if (_isEdit)
            {
                var entity = await db.SyncTasks
                    .Include(t => t.Interfaces)
                    .FirstAsync(t => t.Id == Id, CancellationToken);

                entity.Name = _task.Name;
                entity.Code = _task.Code;
                entity.TriggerServerCode = _task.TriggerServerCode;
                entity.PushType = _task.PushType;
                entity.PushTarget = _task.PushTarget;
                entity.EnableTriggerRecordPush = _task.EnableTriggerRecordPush;
                entity.TriggerPushTarget = _task.TriggerPushTarget;
                entity.TriggerPushParams = _task.TriggerPushParams;
                entity.PatientIdField = _task.PatientIdField;
                entity.VisitSnField = _task.VisitSnField;
                entity.PollingIntervalSeconds = _task.PollingIntervalSeconds;
                entity.PatientConcurrency = _task.PatientConcurrency;
                entity.ApiConcurrency = _task.ApiConcurrency;
                entity.Enabled = _task.Enabled;
                entity.TriggerConditions = conditionsJson;

                if (_removedInterfaceIds.Count > 0)
                {
                    var toRemove = entity.Interfaces
                        .Where(i => _removedInterfaceIds.Contains(i.Id)).ToList();
                    db.SyncTaskInterfaces.RemoveRange(toRemove);
                }

                foreach (var iface in _interfaces)
                {
                    var existing = iface.Id > 0
                        ? entity.Interfaces.FirstOrDefault(i => i.Id == iface.Id)
                        : entity.Interfaces.FirstOrDefault(i => i.InterfaceKey == iface.InterfaceKey);

                    if (existing != null)
                    {
                        ApplyInterfaceValues(existing, iface);
                        iface.Id = existing.Id;
                    }
                    else
                    {
                        var created = new SyncTaskInterface();
                        ApplyInterfaceValues(created, iface);
                        entity.Interfaces.Add(created);
                        createdInterfaces.Add((iface, created));
                    }
                }
            }
            else
            {
                _task.TriggerConditions = conditionsJson;
                _task.Interfaces = _interfaces;
                db.SyncTasks.Add(_task);
            }

            await db.SaveChangesAsync(CancellationToken);
            foreach (var (pageItem, entityItem) in createdInterfaces)
                pageItem.Id = entityItem.Id;

            inj_snackbar.Add(_isEdit ? "任务更新成功" : "任务创建成功", Severity.Success);
            _removedInterfaceIds.Clear();
            CaptureOriginalTaskState();

            if (!_isEdit)
            {
                _isEdit = true;
                Id = _task.Id;
                inj_navigationManager.NavigateTo($"/tasks/edit/{_task.Id}", replace: true);
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static void ApplyInterfaceValues(SyncTaskInterface target, SyncTaskInterface source)
    {
        target.ServerCode = source.ServerCode;
        target.DisplayName = source.DisplayName;
        target.SourceType = source.SourceType;
        target.DatabaseResourceId = source.DatabaseResourceId;
        target.DatabaseType = source.DatabaseType;
        target.ConnectionStringName = source.ConnectionStringName;
        target.SqlServerHost = source.SqlServerHost;
        target.SqlServerDatabase = source.SqlServerDatabase;
        target.SqlServerUsername = source.SqlServerUsername;
        target.SqlServerPassword = source.SqlServerPassword;
        target.SqlServerTrustCertificate = source.SqlServerTrustCertificate;
        target.QuerySql = source.QuerySql;
        target.QueryField = source.QueryField;
        target.QueryValueField = source.QueryValueField;
        target.IsRequired = source.IsRequired;
        target.SortOrder = source.SortOrder;
        target.Enabled = source.Enabled;
        target.InterfaceKey = source.InterfaceKey;
        target.ParentInterfaceKey = source.ParentInterfaceKey;
        target.ParentResultField = source.ParentResultField;
        target.LinkMappings = source.LinkMappings;
        target.MountField = source.MountField;
        target.RouteField = source.RouteField;
        target.RouteOperator = source.RouteOperator;
        target.RouteValue = source.RouteValue;
        target.OutputFields = source.OutputFields;
        target.PushParams = source.PushParams;
        target.InjectFields = source.InjectFields;
        target.FilterConditions = source.FilterConditions;
    }
}

