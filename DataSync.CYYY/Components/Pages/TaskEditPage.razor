    private List<string> ExtractPlaceholders(string? target = null)
    {
        var result = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var url = target ?? _task.PushTarget;
        if (string.IsNullOrEmpty(url)) return result;

        var start = -1;
        for (var i = 0; i < url.Length; i++)
        {
            if (url[i] == '{') start = i + 1;
            else if (url[i] == '}' && start >= 0)
            {
                var name = url[start..i];
                if (!string.IsNullOrWhiteSpace(name) && seen.Add(name))
                    result.Add(name);
                start = -1;
            }
        }
        return result;
    }

    private async Task OpenConfigDialog(SyncTaskInterface iface, bool isNew = false)
    {
        await EnsureColumnsLoadedAsync(_task.TriggerServerCode);
        _editingConfigInterface = iface;
        _editingNewInterface = isNew;
        _editingOutputFieldsText = iface.OutputFields ?? "";
        _editingLinkMappings = GetLinkMappings(iface)
            .Select(mapping => new InterfaceLinkMapping
            {
                ParentField = mapping.ParentField,
                ChildField = mapping.ChildField
            })
            .ToList();
        if (_editingLinkMappings.Count == 0)
            _editingLinkMappings.Add(new InterfaceLinkMapping());
        _editingQueryMappings = GetQueryMappings(iface)
            .Select(mapping => new InterfaceQueryMapping
            {
                TargetField = mapping.TargetField,
                SourceField = mapping.SourceField
            })
            .ToList();
        if (_editingQueryMappings.Count == 0)
            _editingQueryMappings.Add(new InterfaceQueryMapping());
        // 初始化路由参数
        Dictionary<string, string>? existingParams = null;
        if (!IsChildInterface(iface) && !string.IsNullOrEmpty(iface.PushParams))
        {
            try { existingParams = JsonSerializer.Deserialize<Dictionary<string, string>>(iface.PushParams); }
            catch (JsonException) { /* 忽略 */ }
        }
        var placeholders = IsChildInterface(iface) ? new List<string>() : ExtractPlaceholders();
        _editingParams = placeholders.Select(key =>
        {
            var value = "";
            existingParams?.TryGetValue(key, out value);
            return new KeyValuePair<string, string>(key, value ?? "");
        }).ToList();

        // 初始化过滤条件
        _editingFilters = [];
        if (!string.IsNullOrEmpty(iface.FilterConditions))
        {
            try
            {
                var existing = JsonSerializer.Deserialize<List<QueryCondition>>(iface.FilterConditions);
                if (existing != null)
                    _editingFilters = existing.Select(c => new QueryCondition
                    {
                        Column = c.Column, Type = c.Type, Value = c.Value
                    }).ToList();
            }
            catch (JsonException) { /* 忽略 */ }
        }

        _showConfigDialog = true;
    }

