    private async Task Save()
    {
        SyncAdditionalTriggerServerCodes();
        _task.AdmissionSourceServerCode = _task.AdmissionSourceServerCode?.Trim();
        _task.AdmissionTimeField = _task.AdmissionTimeField?.Trim();
        _task.DischargeSourceServerCode = _task.DischargeSourceServerCode?.Trim();
        _task.DischargeTimeField = _task.DischargeTimeField?.Trim();
        EnsureInterfaceKeys();
        foreach (var iface in _interfaces)
            NormalizeInterfaceConfig(iface);
        NormalizeInterfaceOrder();

        var duplicateInterfaceKeys = _interfaces
            .Where(i => !string.IsNullOrWhiteSpace(i.InterfaceKey))
            .GroupBy(i => i.InterfaceKey)
            .Where(g => g.Count() > 1)
            .Select(g => GetInterfaceDisplayName(g.First()))
            .ToList();
        if (duplicateInterfaceKeys.Count > 0)
        {
            inj_snackbar.Add($"关联接口存在重复配置：{string.Join("、", duplicateInterfaceKeys.Take(3))}", Severity.Warning);
            return;
        }

        if (!_task.EnableTriggerRecordPush)
        {
            _task.TriggerPushTarget = null;
            _task.TriggerPushParams = null;
        }

        if (string.IsNullOrWhiteSpace(_task.Name) ||
            string.IsNullOrWhiteSpace(_task.Code) ||
            string.IsNullOrWhiteSpace(_task.TriggerServerCode) ||
            string.IsNullOrWhiteSpace(_task.PushType) ||
            string.IsNullOrWhiteSpace(_task.PushTarget))
        {
            inj_snackbar.Add("请填写所有必填字段", Severity.Warning);
            return;
        }

        if (_task.Enabled && _interfaces.All(i => !i.Enabled))
        {
            inj_snackbar.Add("任务已启用时，至少保留 1 个启用接口", Severity.Warning);
            return;
        }

        if (_task.PatientContinuousSyncEnabled)
        {
            if (string.IsNullOrWhiteSpace(_task.VisitSnField) ||
                string.IsNullOrWhiteSpace(_task.AdmissionSourceServerCode) ||
                string.IsNullOrWhiteSpace(_task.AdmissionTimeField) ||
                string.IsNullOrWhiteSpace(_task.DischargeSourceServerCode) ||
                string.IsNullOrWhiteSpace(_task.DischargeTimeField) ||
                _task.PatientContinuousSyncIntervalSeconds < 60 ||
                _task.PatientContinuousSyncLookbackMinutes < 0)
            {
                inj_snackbar.Add("请完整配置患者持续同步的入院、出院来源、时间字段和有效执行周期", Severity.Warning);
                return;
            }

            if (_ingestionSources.All(source => !string.Equals(
                    source.ServerCode, _task.AdmissionSourceServerCode, StringComparison.OrdinalIgnoreCase)) ||
                _ingestionSources.All(source => !string.Equals(
                    source.ServerCode, _task.DischargeSourceServerCode, StringComparison.OrdinalIgnoreCase)))
            {
                inj_snackbar.Add("患者持续同步配置的入院或出院采集源不存在", Severity.Warning);
                return;
            }

            if (_interfaces.All(iface => !iface.Enabled || !iface.PatientContinuousSyncEnabled))
            {
                inj_snackbar.Add("启用患者持续同步后，至少选择一个持续同步 API 接口", Severity.Warning);
                return;
            }
        }

        if (_task.EnableTriggerRecordPush)
        {
            if (string.IsNullOrWhiteSpace(_task.TriggerPushTarget))
            {
                inj_snackbar.Add("启用触发记录单独推送后，必须填写触发记录推送目标", Severity.Warning);
                return;
            }

            if (!TryValidatePushParams(_task.TriggerPushParams, out var triggerPushParamError))
            {
                inj_snackbar.Add($"触发记录路由参数 JSON 无法解析：{triggerPushParamError}", Severity.Warning);
                return;
            }

            var triggerPushParams = ParsePushParams(_task.TriggerPushParams);
            var missingTriggerPushParams = ExtractPlaceholders(_task.TriggerPushTarget)
                .Where(name => !triggerPushParams.TryGetValue(name, out var value) || string.IsNullOrWhiteSpace(value))
                .ToList();
            if (missingTriggerPushParams.Count > 0)
            {
                inj_snackbar.Add(
                    $"触发记录推送目标仍有未补齐占位符：{string.Join("、", missingTriggerPushParams.Select(name => $"{{{name}}}"))}",
                    Severity.Warning);
                return;
            }
        }

        var invalidInterfaces = _interfaces
            .Where(i => i.Enabled)
            .Select(i => new
            {
                Label = GetInterfaceDisplayName(i),
                Issues = GetInterfaceIssues(i)
            })
            .Where(x => x.Issues.Count > 0)
            .ToList();
        if (invalidInterfaces.Count > 0)
        {
            var detail = string.Join("；", invalidInterfaces
                .Take(3)
                .Select(x => $"{x.Label}：{string.Join("、", x.Issues)}"));
            if (invalidInterfaces.Count > 3)
                detail += $"；另有 {invalidInterfaces.Count - 3} 个接口也未配置完整";
            inj_snackbar.Add($"请先补齐启用接口配置：{detail}", Severity.Warning);
            return;
        }

        if (ShouldConfirmEnableRisk())
        {
            var conflicts = await inj_taskManagementService.GetEnabledConflictsAsync(_task, CancellationToken);
            if (conflicts.Count > 0)
            {
                var confirmed = await inj_dialogService.ShowMessageBox(
                    "重复同步风险提示",
                    TaskManagementService.BuildEnableConflictMessage(_task, conflicts),
                    yesText: "继续保存", cancelText: "取消");
                if (confirmed != true)
                    return;
            }
        }

        _saving = true;
        try
        {
            // 同步过滤条件文本到 rules 的 values
            for (var i = 0; i < _conditionConfig.Rules.Count; i++)
            {
                _conditionConfig.Rules[i].Values = _ruleValuesText[i]
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList();
            }
            var conditionsJson = _conditionConfig.Rules.Count > 0
                ? JsonSerializer.Serialize(_conditionConfig, new JsonSerializerOptions { WriteIndented = false })
                : null;

            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            var createdInterfaces = new List<(SyncTaskInterface PageItem, SyncTaskInterface EntityItem)>();

            // Code 唯一性校验
            var codeExists = await db.SyncTasks
                .AnyAsync(t => t.Code == _task.Code && t.Id != _task.Id, CancellationToken);
            if (codeExists)
            {
                inj_snackbar.Add($"编码「{_task.Code}」已存在，请使用其他编码", Severity.Warning);
                return;
            }

            if (_isEdit)
            {
                var entity = await db.SyncTasks
                    .Include(t => t.Interfaces)
                    .FirstAsync(t => t.Id == Id, CancellationToken);

                entity.Name = _task.Name;
                entity.Code = _task.Code;
                entity.TriggerServerCode = _task.TriggerServerCode;
                entity.AdditionalTriggerServerCodes = _task.AdditionalTriggerServerCodes;
                entity.PushType = _task.PushType;
                entity.PushTarget = _task.PushTarget;
                entity.EnableTriggerRecordPush = _task.EnableTriggerRecordPush;
                entity.TriggerPushTarget = _task.TriggerPushTarget;
                entity.TriggerPushParams = _task.TriggerPushParams;
                entity.PatientIdField = _task.PatientIdField;
                entity.VisitSnField = _task.VisitSnField;
                entity.PollingIntervalSeconds = _task.PollingIntervalSeconds;
                entity.PatientContinuousSyncEnabled = _task.PatientContinuousSyncEnabled;
                entity.PatientContinuousSyncIntervalSeconds = _task.PatientContinuousSyncIntervalSeconds;
                entity.PatientContinuousSyncLookbackMinutes = _task.PatientContinuousSyncLookbackMinutes;
                entity.AdmissionSourceServerCode = _task.AdmissionSourceServerCode;
                entity.AdmissionTimeField = _task.AdmissionTimeField;
                entity.DischargeSourceServerCode = _task.DischargeSourceServerCode;
                entity.DischargeTimeField = _task.DischargeTimeField;
                entity.PatientConcurrency = _task.PatientConcurrency;
                entity.ApiConcurrency = _task.ApiConcurrency;
                entity.Enabled = _task.Enabled;
                entity.TriggerConditions = conditionsJson;

                if (_removedInterfaceIds.Count > 0)
                {
                    var toRemove = entity.Interfaces
                        .Where(i => _removedInterfaceIds.Contains(i.Id)).ToList();
                    db.SyncTaskInterfaces.RemoveRange(toRemove);
                }

                foreach (var iface in _interfaces)
                {
                    var existing = iface.Id > 0
                        ? entity.Interfaces.FirstOrDefault(i => i.Id == iface.Id)
                        : entity.Interfaces.FirstOrDefault(i => i.InterfaceKey == iface.InterfaceKey);

                    if (existing != null)
                    {
                        ApplyInterfaceValues(existing, iface);
                        iface.Id = existing.Id;
                    }
                    else
                    {
                        var created = new SyncTaskInterface();
                        ApplyInterfaceValues(created, iface);
                        entity.Interfaces.Add(created);
                        createdInterfaces.Add((iface, created));
                    }
                }

                if (_task.PatientContinuousSyncEnabled)
                {
                    var activeTasks = await db.ActiveSyncTasks
                        .Where(item => item.SyncTaskId == entity.Id && item.Enabled)
                        .ToListAsync(CancellationToken);
                    foreach (var activeTask in activeTasks)
                        activeTask.Enabled = false;
                }
            }
            else
            {
                _task.TriggerConditions = conditionsJson;
                _task.Interfaces = _interfaces;
                db.SyncTasks.Add(_task);
            }

            await db.SaveChangesAsync(CancellationToken);
            foreach (var (pageItem, entityItem) in createdInterfaces)
                pageItem.Id = entityItem.Id;

            if (_activeSyncSettings != null && !_task.PatientContinuousSyncEnabled)
            {
                await _activeSyncSettings.SaveAsync(
                    _task.Id,
                    _task.Name,
                    _task.Code,
                    _task.PushType,
                    _task.PushTarget,
                    _interfaces);
            }

            inj_snackbar.Add(_isEdit ? "任务更新成功" : "任务创建成功", Severity.Success);
            _removedInterfaceIds.Clear();
            CaptureOriginalTaskState();

            if (!_isEdit)
            {
                _isEdit = true;
                Id = _task.Id;
                inj_navigationManager.NavigateTo($"/tasks/edit/{_task.Id}", replace: true);
            }
        }
        catch (Exception ex)
        {
            inj_snackbar.Add($"保存失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static void ApplyInterfaceValues(SyncTaskInterface target, SyncTaskInterface source)
    {
        target.ServerCode = source.ServerCode;
        target.DisplayName = source.DisplayName;
        target.SourceType = source.SourceType;
        target.ApiInterfaceId = source.ApiInterfaceId;
        target.DatabaseResourceId = source.DatabaseResourceId;
        target.DatabaseType = source.DatabaseType;
        target.ConnectionStringName = source.ConnectionStringName;
        target.SqlServerHost = source.SqlServerHost;
        target.SqlServerDatabase = source.SqlServerDatabase;
        target.SqlServerUsername = source.SqlServerUsername;
        target.SqlServerPassword = source.SqlServerPassword;
        target.SqlServerTrustCertificate = source.SqlServerTrustCertificate;
        target.QuerySql = source.QuerySql;
        target.QueryPath = source.QueryPath;
        target.UseTodayTimeRange = source.UseTodayTimeRange;
        target.ContinuousPollingEnabled = source.ContinuousPollingEnabled;
        target.ContinuousPollingIntervalSeconds = source.ContinuousPollingIntervalSeconds;
        target.PatientContinuousSyncEnabled = source.PatientContinuousSyncEnabled;
        target.ContinuousUseTimeRange = source.ContinuousUseTimeRange;
        target.ContinuousRecordKeyFields = source.ContinuousRecordKeyFields;
        target.ContinuousUseRowHash = source.ContinuousUseRowHash;
        target.QueryStartTimeSourceServerCode = source.QueryStartTimeSourceServerCode;
        target.QueryStartTimeSourceField = source.QueryStartTimeSourceField;
        target.QueryEndTimeSourceServerCode = source.QueryEndTimeSourceServerCode;
        target.QueryEndTimeSourceField = source.QueryEndTimeSourceField;
        target.AccessWindowEnabled = source.AccessWindowEnabled;
        target.AccessWindowStart = source.AccessWindowStart;
        target.AccessWindowEnd = source.AccessWindowEnd;
        target.QueryField = source.QueryField;
        target.QueryValueField = source.QueryValueField;
        target.QueryMappings = source.QueryMappings;
        target.IsRequired = source.IsRequired;
        target.SortOrder = source.SortOrder;
        target.Enabled = source.Enabled;
        target.InterfaceKey = source.InterfaceKey;
        target.ParentInterfaceKey = source.ParentInterfaceKey;
        target.ParentResultField = source.ParentResultField;
        target.LinkMappings = source.LinkMappings;
        target.MountField = source.MountField;
        target.RouteField = source.RouteField;
        target.RouteOperator = source.RouteOperator;
        target.RouteValue = source.RouteValue;
        target.OutputFields = source.OutputFields;
        target.PushParams = source.PushParams;
        target.InjectFields = source.InjectFields;
        target.FilterConditions = source.FilterConditions;
    }
}

