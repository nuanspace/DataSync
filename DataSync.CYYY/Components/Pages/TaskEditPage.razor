    private static List<InterfaceQueryMapping> GetQueryMappings(SyncTaskInterface iface)
    {
        if (string.IsNullOrWhiteSpace(iface.QueryMappings))
            return [];
        try
        {
            return (JsonSerializer.Deserialize<List<InterfaceQueryMapping>>(iface.QueryMappings) ?? [])
                .Where(mapping => !string.IsNullOrWhiteSpace(mapping.TargetField) && !string.IsNullOrWhiteSpace(mapping.SourceField))
                .Select(mapping => new InterfaceQueryMapping
                {
                    TargetField = mapping.TargetField.Trim(),
                    SourceField = mapping.SourceField.Trim()
                })
                .ToList();
        }
        catch (JsonException) { return []; }
    }

    private static void SetQueryMappings(SyncTaskInterface iface, IEnumerable<InterfaceQueryMapping> mappings)
    {
        var valid = mappings
            .Where(mapping => !string.IsNullOrWhiteSpace(mapping.TargetField) && !string.IsNullOrWhiteSpace(mapping.SourceField))
            .Select(mapping => new InterfaceQueryMapping
            {
                TargetField = mapping.TargetField.Trim(),
                SourceField = mapping.SourceField.Trim()
            })
            .ToList();
        iface.QueryMappings = valid.Count == 0 ? null : JsonSerializer.Serialize(valid);
    }

    private void RemoveLinkMapping(int index)
    {
        if (_editingLinkMappings.Count <= 1 || index < 0 || index >= _editingLinkMappings.Count)
            return;

        _editingLinkMappings.RemoveAt(index);
    }

    private static List<InterfaceLinkMapping> GetLinkMappings(SyncTaskInterface iface)
    {
        if (!string.IsNullOrWhiteSpace(iface.LinkMappings))
        {
            try
            {
                var mappings = JsonSerializer.Deserialize<List<InterfaceLinkMapping>>(iface.LinkMappings);
                if (mappings != null)
                {
                    var validMappings = NormalizeLinkMappings(mappings);
                    if (validMappings.Count > 0)
                        return validMappings;
                }
            }
            catch (JsonException) { return []; }
        }

        return [];
    }

    private static List<InterfaceLinkMapping> NormalizeLinkMappings(IEnumerable<InterfaceLinkMapping> mappings) =>
        mappings
            .Where(mapping =>
                !string.IsNullOrWhiteSpace(mapping.ParentField) &&
                !string.IsNullOrWhiteSpace(mapping.ChildField))
            .Select(mapping => new InterfaceLinkMapping
            {
                ParentField = mapping.ParentField.Trim(),
                ChildField = mapping.ChildField.Trim()
            })
            .ToList();

    private static void SetLinkMappings(SyncTaskInterface iface, IEnumerable<InterfaceLinkMapping> mappings)
    {
        var validMappings = NormalizeLinkMappings(mappings);
        var first = validMappings.FirstOrDefault();
        iface.ParentResultField = first?.ParentField;
        iface.QueryField = first?.ChildField ?? "";
        iface.LinkMappings = validMappings.Count > 0 ? JsonSerializer.Serialize(validMappings) : null;
    }

