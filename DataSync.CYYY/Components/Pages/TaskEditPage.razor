    private List<string> ExtractPlaceholders(string? target = null)
    {
        var result = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var url = target ?? _task.PushTarget;
        if (string.IsNullOrEmpty(url)) return result;

        var start = -1;
        for (var i = 0; i < url.Length; i++)
        {
            if (url[i] == '{') start = i + 1;
            else if (url[i] == '}' && start >= 0)
            {
                var name = url[start..i];
                if (!string.IsNullOrWhiteSpace(name) && seen.Add(name))
                    result.Add(name);
                start = -1;
            }
        }
        return result;
    }

    private async Task OpenConfigDialog(SyncTaskInterface iface, bool isNew = false)
    {
        await EnsureColumnsLoadedAsync(_task.TriggerServerCode);
        _editingConfigInterface = iface;
        _editingNewInterface = isNew;
        _editingOutputFieldsText = iface.OutputFields ?? "";
        _editingLinkMappings = GetLinkMappings(iface)
            .Select(mapping => new InterfaceLinkMapping
            {
                ParentField = mapping.ParentField,
                ChildField = mapping.ChildField
            })
            .ToList();
        if (_editingLinkMappings.Count == 0)
            _editingLinkMappings.Add(new InterfaceLinkMapping());
        // 初始化路由参数
        Dictionary<string, string>? existingParams = null;
        if (!IsChildInterface(iface) && !string.IsNullOrEmpty(iface.PushParams))
        {
            try { existingParams = JsonSerializer.Deserialize<Dictionary<string, string>>(iface.PushParams); }
            catch (JsonException) { /* 忽略 */ }
        }
        var placeholders = IsChildInterface(iface) ? new List<string>() : ExtractPlaceholders();
        _editingParams = placeholders.Select(key =>
        {
            var value = "";
            existingParams?.TryGetValue(key, out value);
            return new KeyValuePair<string, string>(key, value ?? "");
        }).ToList();

        // 初始化过滤条件
        _editingFilters = [];
        if (!string.IsNullOrEmpty(iface.FilterConditions))
        {
            try
            {
                var existing = JsonSerializer.Deserialize<List<DataLakeCondition>>(iface.FilterConditions);
                if (existing != null)
                    _editingFilters = existing.Select(c => new DataLakeCondition
                    {
                        Column = c.Column, Type = c.Type, Value = c.Value
                    }).ToList();
            }
            catch (JsonException) { /* 忽略 */ }
        }

        _showConfigDialog = true;
    }

    private void AddLinkMapping() => _editingLinkMappings.Add(new InterfaceLinkMapping());

    private void RemoveLinkMapping(int index)
    {
        if (_editingLinkMappings.Count <= 1 || index < 0 || index >= _editingLinkMappings.Count)
            return;

        _editingLinkMappings.RemoveAt(index);
    }

    private static List<InterfaceLinkMapping> GetLinkMappings(SyncTaskInterface iface)
    {
        if (!string.IsNullOrWhiteSpace(iface.LinkMappings))
        {
            try
            {
                var mappings = JsonSerializer.Deserialize<List<InterfaceLinkMapping>>(iface.LinkMappings);
                if (mappings != null)
                {
                    var validMappings = NormalizeLinkMappings(mappings);
                    if (validMappings.Count > 0)
                        return validMappings;
                }
            }
            catch (JsonException) { /* 兼容旧字段 */ }
        }

        return string.IsNullOrWhiteSpace(iface.ParentResultField) || string.IsNullOrWhiteSpace(iface.QueryField)
            ? []
            :
            [
                new InterfaceLinkMapping
                {
                    ParentField = iface.ParentResultField,
                    ChildField = iface.QueryField
                }
            ];
    }

    private static List<InterfaceLinkMapping> NormalizeLinkMappings(IEnumerable<InterfaceLinkMapping> mappings) =>
        mappings
            .Where(mapping =>
                !string.IsNullOrWhiteSpace(mapping.ParentField) &&
                !string.IsNullOrWhiteSpace(mapping.ChildField))
            .Select(mapping => new InterfaceLinkMapping
            {
                ParentField = mapping.ParentField.Trim(),
                ChildField = mapping.ChildField.Trim()
            })
            .ToList();

    private static void SetLinkMappings(SyncTaskInterface iface, IEnumerable<InterfaceLinkMapping> mappings)
    {
        var validMappings = NormalizeLinkMappings(mappings);
        var first = validMappings.FirstOrDefault();
        iface.ParentResultField = first?.ParentField;
        iface.QueryField = first?.ChildField ?? "";
        iface.LinkMappings = validMappings.Count > 0 ? JsonSerializer.Serialize(validMappings) : null;
    }

