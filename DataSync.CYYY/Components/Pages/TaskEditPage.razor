    private static Dictionary<string, string> ParsePushParams(string? pushParams)
    {
        if (string.IsNullOrWhiteSpace(pushParams)) return [];
        try
        {
            return JsonSerializer.Deserialize<Dictionary<string, string>>(pushParams) ?? [];
        }
        catch (JsonException)
        {
            return [];
        }
    }

    private static bool TryValidatePushParams(string? pushParams, out string? errorMessage)
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(pushParams))
            return true;

        try
        {
            var parsed = JsonSerializer.Deserialize<Dictionary<string, string>>(pushParams);
            if (parsed == null)
            {
                errorMessage = "必须是 JSON 对象";
                return false;
            }

            return true;
        }
        catch (JsonException ex)
        {
            errorMessage = ex.Message;
            return false;
        }
    }

    private static int GetPushParamCount(SyncTaskInterface iface) => ParsePushParams(iface.PushParams).Count;

    private List<string> GetMissingPushParamNames(SyncTaskInterface iface)
    {
        if (IsChildInterface(iface))
            return [];

        var placeholders = ExtractPlaceholders();
        if (placeholders.Count == 0)
            return [];

        var existingParams = ParsePushParams(iface.PushParams);
        return placeholders
            .Where(name => !existingParams.TryGetValue(name, out var value) || string.IsNullOrWhiteSpace(value))
            .ToList();
    }

    private int GetMissingPushParamCount(SyncTaskInterface iface) => GetMissingPushParamNames(iface).Count;

    private string GetPushParamCompletionText(SyncTaskInterface iface)
    {
        if (IsChildInterface(iface))
            return "子接口不单独推送";

        var total = ExtractPlaceholders().Count;
        if (total == 0)
            return "无需补充";

        var completed = total - GetMissingPushParamCount(iface);
        return $"{completed}/{total} 已补齐";
    }

