    private async Task PreviewAndBootstrapContinuousPatientsAsync()
    {
        try
        {
            var count = await inj_patientContinuousRegistration.CountBootstrapCandidatesAsync(
                _task.Id,
                CancellationToken);
            if (count == 0)
            {
                inj_snackbar.Add("没有符合任务过滤条件且需要初始化的当前在院患者", Severity.Info);
                return;
            }

            var confirmed = await inj_dialogService.ShowMessageBox(
                "初始化当前在院患者",
                $"将根据任务过滤条件和本地入出院采集记录创建 {count} 个患者持续同步档案。此操作不会调用医院接口或立即推送数据，是否继续？",
                yesText: "确认初始化",
                cancelText: "取消");
