@page "/tasks/create"
@page "/tasks/edit/{Id:int}"
@inherits BasePage
@inject LocalQueryService inj_localQueryService
@inject TaskManagementService inj_taskManagementService
@inject PatientContinuousSyncRegistrationService inj_patientContinuousRegistration
@rendermode InteractiveServer

<PageTitle>@(_isEdit ? $"编辑任务 - {_task.Name}" : "新增任务")</PageTitle>

<div class="task-edit-page">
    <div class="task-edit-toolbar task-edit-toolbar--page">
        <div class="task-edit-heading">
            <div class="task-edit-eyebrow">同步任务编排</div>
            <MudText Typo="Typo.h4" Class="task-edit-title">@(_isEdit ? $"编辑任务 - {_task.Name}" : "新增任务")</MudText>
        </div>
        <div class="task-edit-toolbar-actions">
            <span class="task-state-pill @(_task.Enabled ? "is-enabled" : "is-disabled")">@(_task.Enabled ? "已启用" : "未启用")</span>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="BackToTaskList">
                返回列表
            </MudButton>
        </div>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
    }
    else
    {
        var placeholders = ExtractPlaceholders();
        var interfaceGroups = GetInterfaceGroups();
        var workspaceSummary = GetInterfaceWorkspaceSummary();

        <div class="task-edit-actions task-edit-actions--sticky">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Save" Disabled="_saving">
                @(_saving ? "保存中..." : "保存")
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="BackToTaskList">
                返回列表
            </MudButton>
        </div>

        <div class="task-overview-grid">
            <div class="task-overview-item">
                <span class="overview-label">触发来源</span>
                <strong class="overview-value">@GetTriggerSourceSummary()</strong>
            </div>
            <div class="task-overview-item">
                <span class="overview-label">接口状态</span>
                <strong class="overview-value">@GetEnabledInterfaceCount() / @_interfaces.Count</strong>
            </div>
            <div class="task-overview-item">
                <span class="overview-label">执行组</span>
                <strong class="overview-value">@GetExecutionGroupCount()</strong>
            </div>
            <div class="task-overview-item">
                <span class="overview-label">推送目标</span>
                <strong class="overview-value">@GetPushTypeSummary()</strong>
            </div>
        </div>

        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 KeepPanelsAlive="true"
                 Class="task-config-tabs"
                 PanelClass="task-config-tab-panel">
            <MudTabPanel Text="基础配置" Icon="@Icons.Material.Filled.Tune">
        <div class="task-panel-grid">
            <MudPaper Class="task-panel" Elevation="0">
                <div class="task-panel-header">
                    <div>
                        <div class="task-panel-tag">任务身份</div>
                        <MudText Typo="Typo.h6">基本信息</MudText>
                    </div>
                </div>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_task.Name" Label="名称" Required="true" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_task.Code" Label="编码" Required="true" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Value="_task.TriggerServerCode" ValueChanged="OnTriggerServerCodeChanged"
                                   Label="患者主来源接口" Required="true" Variant="Variant.Outlined"
                                   HelperText="提供患者ID、就诊号和主记录">
                            @foreach (var src in _ingestionSources)
                            {
                                <MudSelectItem Value="@src.ServerCode">@src.Name (@src.ServerCode)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField @bind-Value="_task.PatientIdField" Label="患者ID字段" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField @bind-Value="_task.VisitSnField" Label="就诊号字段" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect T="string" MultiSelection="true"
                                   SelectedValues="_additionalTriggerServerCodes"
                                   SelectedValuesChanged="OnAdditionalTriggerSourcesChanged"
                                   Label="附加触发采集源" Variant="Variant.Outlined"
                                   HelperText="这些采集源有新数据时，也会按就诊号触发当前任务"
                                   MultiSelectionTextFunc="@(selected => $"{selected.Count()} 个附加触发源")">
                            @foreach (var src in _ingestionSources.Where(src =>
                                !string.Equals(src.ServerCode, _task.TriggerServerCode, StringComparison.OrdinalIgnoreCase)))
                            {
                                <MudSelectItem Value="@src.ServerCode">@src.Name (@src.ServerCode)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch @bind-Value="_task.Enabled" Label="启用当前任务" Color="Color.Success" />
                    </MudItem>
                </MudGrid>
                <MudExpansionPanels Class="mt-4" Elevation="0">
                    <MudExpansionPanel Text="高级设置">
                        <MudGrid>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="_task.PollingIntervalSeconds" Label="轮询间隔(秒)"
                                                 Variant="Variant.Outlined" Min="10" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="_task.PatientConcurrency" Label="患者并发数"
                                                 Variant="Variant.Outlined" Min="1" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudNumericField @bind-Value="_task.ApiConcurrency" Label="接口并发数"
                                                 Variant="Variant.Outlined" Min="1" />
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>

            <MudPaper Class="task-panel" Elevation="0">
                <div class="task-panel-header">
                    <div>
                        <div class="task-panel-tag">推送策略</div>
                        <MudText Typo="Typo.h6">推送配置</MudText>
                    </div>
                    @if (placeholders.Count > 0)
                    {
                        <div class="task-inline-pills">
                            @foreach (var placeholder in placeholders)
                            {
                                <span class="meta-pill">@($"{{{placeholder}}}")</span>
                            }
                        </div>
                    }
                </div>
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudSelect @bind-Value="_task.PushType" Label="推送方式" Required="true" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Api")">Api</MudSelectItem>
                            <MudSelectItem Value="@("Database")">Database</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_task.PushTarget" Label="推送目标" Required="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch T="bool"
                                   @bind-Value="_task.EnableTriggerRecordPush"
                                   Label="启用触发记录单独推送"
                                   Color="Color.Primary" />
                    </MudItem>
                    @if (_task.EnableTriggerRecordPush)
                    {
                        <MudItem xs="12" sm="8">
                            <MudTextField @bind-Value="_task.TriggerPushTarget"
                                          Label="触发记录推送目标"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="_task.TriggerPushParams"
                                          Label="触发记录路由参数(JSON)"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </div>
            </MudTabPanel>

            <MudTabPanel Text="接口编排" Icon="@Icons.Material.Filled.AccountTree">
        <MudPaper Class="task-panel task-panel--workspace" Elevation="0">
            <div class="task-panel-header task-panel-header--split">
                <div>
                    <div class="task-panel-tag">核心配置</div>
                    <MudText Typo="Typo.h5">关联接口工作台</MudText>
                </div>
                <div class="task-panel-actions">
                    @if (_interfaces.Count > 0)
                    {
                        <div class="task-inline-pills task-inline-pills--wrap">
                            @foreach (var group in interfaceGroups)
                            {
                                <span class="stage-pill">执行组 @group.SortOrder · @group.Items.Count 项</span>
                            }
                        </div>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.UploadFile" OnClick="OpenApiImportDialog">
                        导入 API 接口
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddInterface">
                        添加接口
                    </MudButton>
                </div>
            </div>

            @if (_interfaces.Count > 0)
            {
                <div class="task-readiness-grid">
                    <div class="readiness-card readiness-card--ready">
                        <span class="readiness-label">可直接执行</span>
                        <strong class="readiness-value">@workspaceSummary.ReadyCount</strong>
                    </div>
                    <div class="readiness-card readiness-card--warning">
                        <span class="readiness-label">待选接口</span>
                        <strong class="readiness-value">@workspaceSummary.MissingServerCount</strong>
                    </div>
                    <div class="readiness-card readiness-card--warning">
                        <span class="readiness-label">待定查询</span>
                        <strong class="readiness-value">@workspaceSummary.MissingQueryCount</strong>
                    </div>
                    <div class="readiness-card readiness-card--info">
                        <span class="readiness-label">待补占位符</span>
                        <strong class="readiness-value">@workspaceSummary.MissingPushParamCount</strong>
                    </div>
                </div>
            }

            @if (_interfaces.Count == 0)
            {
                <div class="task-empty-state">
                    <MudText Typo="Typo.h6">还没有关联接口</MudText>
                </div>
            }
            else
            {
                <MudDropContainer @ref="_dropContainer" T="SyncTaskInterface" Items="_interfaces"
                                  ItemsSelector="IsItemInDropZone"
                                  ItemDropped="OnInterfaceDrop"
                                  Class="task-interface-dropzone">
                    <ChildContent>
                        @foreach (var group in interfaceGroups)
                        {
                            <div class="task-group-section">
                                <div class="task-group-header">
                                    <div>
                                        <div class="task-group-title">执行组 @group.SortOrder</div>
                                    </div>
                                    <div class="task-inline-pills task-inline-pills--wrap">
                                        <span class="meta-pill">接口 @group.Items.Count</span>
                                        <span class="meta-pill">必要 @group.Items.Count(i => i.IsRequired)</span>
                                        <span class="meta-pill">启用 @group.Items.Count(i => i.Enabled)</span>
                                    </div>
                                </div>
                                <MudDropZone T="SyncTaskInterface"
                                             Identifier="@GetDropZoneIdentifier(group.SortOrder)"
                                             AllowReorder="true"
                                             Class="task-interface-zone" />
                            </div>
                        }
                    </ChildContent>
                    <ItemRenderer>
                        @{
                            var missingPushParams = GetMissingPushParamNames(context);
                        }
                        <div @key="GetInterfaceRenderKey(context)"
                             class="interface-card @GetInterfaceCardClass(context) @(context.Enabled ? string.Empty : "interface-card--disabled") @(IsPendingNewInterface(context) ? "interface-card--new" : string.Empty) @(IsSortOrderAnimating(context) ? "interface-card--moving" : string.Empty)"
                             data-interface-key="@context.InterfaceKey"
                             tabindex="-1">
                            <div class="interface-card-rail">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small"
                                         Class="cursor-grab interface-drag-icon" />
                                <span class="interface-order-pill">#@GetInterfaceGroupPosition(context)</span>
                                <span class="stage-pill stage-pill--solid">组 @context.SortOrder</span>
                            </div>

                            <div class="interface-card-body">
                                <div class="interface-card-head">
                                    <div class="interface-card-title-block">
                                        <div class="interface-card-title-row">
                                            <div>
                                                <div class="interface-card-title">@GetInterfaceDisplayName(context)</div>
                                                <div class="interface-card-subtitle">@GetInterfaceCodeSummary(context)</div>
                                            </div>
                                            <span class="meta-pill">@GetInterfaceSourceTypeText(context)</span>
                                        </div>
                                        @if (IsChildInterface(context) || HasChildInterfaces(context))
                                        {
                                            <div class="interface-card-caption-row">
                                            @if (IsChildInterface(context))
                                            {
                                                <span class="interface-link-pill interface-link-pill--child">挂载分支</span>
                                            }
                                            else if (HasChildInterfaces(context))
                                            {
                                                <span class="interface-link-pill interface-link-pill--root">组合根接口</span>
                                            }
                                            </div>
                                        }
                                    </div>

                                    <div class="interface-card-switches">
                                        <MudCheckBox T="bool"
                                                     Value="context.IsRequired"
                                                     ValueChanged="@(v => OnInterfaceRequiredChanged(context, v))"
                                                     Dense="true"
                                                     Label="必要接口" />
                                        <MudCheckBox T="bool"
                                                     Value="context.Enabled"
                                                     ValueChanged="@(v => OnInterfaceEnabledChanged(context, v))"
                                                     Dense="true"
                                                     Label="启用" />
                                     </div>
                                 </div>

                                <div class="interface-card-status-row">
                                    <span class="interface-status-pill @GetInterfaceStatusClass(context)">@GetInterfaceStatusText(context)</span>
                                    <span class="meta-pill">@GetInterfaceRoleSummary(context)</span>
                                    @if (missingPushParams.Count > 0)
                                    {
                                        <span class="meta-pill meta-pill--warning">占位符待补 @missingPushParams.Count</span>
                                    }
                                </div>

                                @if (IsChildInterface(context))
                                {
                                    <div class="interface-linkage interface-linkage--child">
                                        <span class="interface-linkage-label">组合关系</span>
                                        <div class="interface-linkage-row">
                                            <span class="interface-linkage-item">@GetChildParentSummary(context)</span>
                                            <span class="interface-linkage-item">@GetChildSourceSummary(context)</span>
                                            <span class="interface-linkage-item">@GetChildMatchSummary(context)</span>
                                            <span class="interface-linkage-item">@GetChildMountSummary(context)</span>
                                            <span class="interface-linkage-item">@GetChildRouteSummary(context)</span>
                                        </div>
                                    </div>
                                }
                                else if (HasChildInterfaces(context))
                                {
                                    <div class="interface-linkage">
                                        <span class="interface-linkage-label">组合链路</span>
                                        <div class="interface-branch-list">
                                            @foreach (var child in GetChildInterfaces(context))
                                            {
                                                <span class="interface-branch-pill">@GetChildBranchPreview(child)</span>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="interface-card-grid">
                                    <div class="interface-summary-item">
                                        <span>查询字段</span>
                                        <strong>@GetInterfaceQueryFieldSummary(context)</strong>
                                    </div>
                                    <div class="interface-summary-item">
                                        <span>取值来源</span>
                                        <strong>@GetInterfaceValueSourceSummary(context)</strong>
                                    </div>
                                    <div class="interface-summary-item">
                                        <span>数据库资源</span>
                                        <strong>@GetInterfaceDatabaseSummary(context)</strong>
                                    </div>
                                    <MudNumericField T="int"
                                                     Value="context.SortOrder"
                                                     ValueChanged="@(v => OnInterfaceSortOrderChanged(context, v))"
                                                     Label="第几步执行"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Disabled="@IsChildInterface(context)"
                                                     Min="1" />
                                </div>

                                <div class="interface-card-footer">
                                    <span class="interface-mapping">查询映射：@GetQueryMappingPreview(context)</span>
                                    <div class="task-inline-pills task-inline-pills--wrap">
                                        <span class="meta-pill">注入字段 @GetInjectFieldCount(context)</span>
                                        <span class="meta-pill">路由参数 @GetPushParamCompletionText(context)</span>
                                        <span class="meta-pill">过滤条件 @GetFilterConditionCount(context)</span>
                                    </div>
                                </div>
                            </div>

                            <div class="interface-card-actions">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Settings"
                                           OnClick="@(() => OpenConfigDialog(context))">
                                    编辑配置
                                </MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => RemoveInterface(context))" />
                            </div>
                        </div>
                    </ItemRenderer>
                </MudDropContainer>

                <div class="task-interface-add">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddInterface">
                        添加接口
                    </MudButton>
                </div>
            }
        </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="触发筛选" Icon="@Icons.Material.Filled.FilterAlt">
        <MudPaper Class="task-panel" Elevation="0">
            <div class="task-panel-header task-panel-header--split">
                <div>
                    <div class="task-panel-tag">触发筛选</div>
                    <MudText Typo="Typo.h6">过滤条件</MudText>
                </div>
                <div class="task-inline-pills">
                    <span class="meta-pill">逻辑 @_conditionConfig.Logic</span>
                    <span class="meta-pill">规则 @_conditionConfig.Rules.Count</span>
                </div>
            </div>

            <div class="task-filter-toolbar">
                <div class="task-filter-controls">
                    <MudSelect T="string" @bind-Value="_conditionConfig.Logic" Label="条件逻辑" Variant="Variant.Outlined"
                               Style="max-width: 180px;">
                        <MudSelectItem Value="@("AND")">AND（全部满足）</MudSelectItem>
                        <MudSelectItem Value="@("OR")">OR（满足任一）</MudSelectItem>
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="_conditionConfig.ExcludeSynced" Label="排除已同步" Color="Color.Primary" />
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="AddRule">
                    添加规则
                </MudButton>
            </div>

            @for (var i = 0; i < _conditionConfig.Rules.Count; i++)
            {
                var index = i;
                var rule = _conditionConfig.Rules[index];
                <div class="task-rule-row">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="3">
                            <MudSelect T="string" Value="rule.Interface" Label="接口"
                                       ValueChanged="(v) => OnRuleInterfaceChanged(index, v)"
                                       Variant="Variant.Outlined" Dense="true">
                                @foreach (var src in _ingestionSources)
                                {
                                    <MudSelectItem Value="@src.ServerCode">@src.Name (@src.ServerCode)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudSelect T="string" @bind-Value="rule.Field" Label="字段"
                                       Variant="Variant.Outlined" Dense="true">
                                @foreach (var col in GetColumnsForInterface(rule.Interface))
                                {
                                    <MudSelectItem Value="@col">@col</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudSelect T="string" @bind-Value="rule.Mode" Label="模式"
                                       Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem Value="@("include")">接受</MudSelectItem>
                                <MudSelectItem Value="@("exclude")">排除</MudSelectItem>
                                <MudSelectItem Value="@("contains")">包含</MudSelectItem>
                                <MudSelectItem Value="@("not_null")">非空</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            @if (rule.Mode != "not_null")
                            {
                                <MudTextField @bind-Value="_ruleValuesText[index]" Label="值"
                                              Variant="Variant.Outlined" />
                            }
                            else
                            {
                                <MudTextField T="string" Label="值" Disabled="true" Variant="Variant.Outlined" />
                            }
                        </MudItem>
                        <MudItem xs="12" sm="1" Class="d-flex align-center justify-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => RemoveRule(index)" />
                        </MudItem>
                    </MudGrid>
                </div>
            }
        </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="患者持续同步" Icon="@Icons.Material.Filled.SyncAlt">
                <MudPaper Class="task-panel" Elevation="0">
                    <div class="task-panel-header">
                        <div>
                            <div class="task-panel-tag">患者增量</div>
                            <MudText Typo="Typo.h6">患者持续同步</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                入院、出院采集均可建档；按接口水位查询，并只推送本地未记录过的新唯一键。
                            </MudText>
                        </div>
                        <MudSwitch @bind-Value="_task.PatientContinuousSyncEnabled"
                                   Label="启用患者持续同步"
                                   Color="Color.Success" />
                    </div>

                    @if (_task.PatientContinuousSyncEnabled)
                    {
                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" @bind-Value="_task.AdmissionSourceServerCode"
                                           Label="入院采集源" Variant="Variant.Outlined">
                                    @foreach (var source in _ingestionSources)
                                    {
                                        <MudSelectItem Value="@source.ServerCode">@source.Name (@source.ServerCode)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_task.AdmissionTimeField"
                                              Label="入院时间字段" Variant="Variant.Outlined"
                                              HelperText="首次同步从该业务发生时间开始。" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" @bind-Value="_task.DischargeSourceServerCode"
                                           Label="出院采集源" Variant="Variant.Outlined">
                                    @foreach (var source in _ingestionSources)
                                    {
                                        <MudSelectItem Value="@source.ServerCode">@source.Name (@source.ServerCode)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_task.DischargeTimeField"
                                              Label="出院时间字段" Variant="Variant.Outlined"
                                              HelperText="采集到该业务发生时间后执行最终窗口并结束。" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_task.PatientContinuousSyncIntervalSeconds"
                                                 Label="同步间隔（秒）" Min="60" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="_task.PatientContinuousSyncLookbackMinutes"
                                                 Label="水位回看（分钟）" Min="0" Variant="Variant.Outlined"
                                                 HelperText="默认回看5分钟，用于覆盖时间边界和接口延迟。" />
                            </MudItem>
                        </MudGrid>

                        <div class="active-interface-heading mt-4">
                            <div>
                                <MudText Typo="Typo.subtitle1">持续同步接口</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    首期仅支持独立 API 接口；优先配置稳定业务主键。
                                </MudText>
                            </div>
                        </div>
                        @foreach (var iface in _interfaces.Where(item =>
                            item.Enabled && !IsDatabaseInterface(item) && !IsChildInterface(item)))
                        {
                            <MudPaper Class="pa-4 mt-3" Elevation="0" Outlined="true">
                                <MudGrid>
                                    <MudItem xs="12" sm="3">
                                        <MudSwitch @bind-Value="iface.PatientContinuousSyncEnabled"
                                                   Label="@GetInterfaceDisplayName(iface)"
                                                   Color="Color.Success" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudSwitch @bind-Value="iface.ContinuousUseTimeRange"
                                                   Label="请求携带时间窗口"
                                                   Disabled="@(!iface.PatientContinuousSyncEnabled)"
                                                   Color="Color.Primary" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="iface.ContinuousRecordKeyFields"
                                                      Label="记录唯一键字段"
                                                      Placeholder="recordId 或 patientId,reportId"
                                                      Disabled="@(!iface.PatientContinuousSyncEnabled)"
                                                      Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" sm="2">
                                        <MudSwitch @bind-Value="iface.ContinuousUseRowHash"
                                                   Label="不可变整行哈希"
                                                   Disabled="@(!iface.PatientContinuousSyncEnabled || !string.IsNullOrWhiteSpace(iface.ContinuousRecordKeyFields))"
                                                   Color="Color.Warning" />
                                    </MudItem>
                                    @if (iface.PatientContinuousSyncEnabled && !iface.ContinuousUseTimeRange)
                                    {
                                        <MudItem xs="12">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                每轮只传患者查询参数，不传开始、结束时间；完整返回结果仍按记录唯一键过滤新增。
                                            </MudText>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudPaper>
                        }

                        @if (_isEdit)
                        {
                            <MudText Class="mt-4" Typo="Typo.caption" Color="Color.Secondary">
                                请先保存以上配置，再初始化本地已有的当前在院患者。
                            </MudText>
                            <MudButton Class="mt-4" Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                       OnClick="PreviewAndBootstrapContinuousPatientsAsync">
                                初始化当前在院患者
                            </MudButton>
                        }
                    }

                    @if (!_task.PatientContinuousSyncEnabled && _isEdit)
                    {
                        <MudExpansionPanels Class="mt-4" Elevation="0">
                            <MudExpansionPanel Text="旧在院增量（兼容现有任务）">
                                <ActiveSyncSettings @ref="_activeSyncSettings"
                                                    TaskConfig="_task"
                                                    Interfaces="_interfaces" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="运行状态" Icon="@Icons.Material.Filled.MonitorHeart" Disabled="@(!_isEdit)">
                <div class="continuous-runtime-workspace">
                    @if (_isEdit)
                    {
                        <section class="continuous-runtime">
                            <div class="continuous-runtime-header">
                                <div>
                                    <div class="task-panel-tag">运行监控</div>
                                    <MudText Typo="Typo.h6">患者持续同步</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        查看待同步患者、执行节奏和该次住院的全部推送与失败日志。
                                    </MudText>
                                </div>
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           Disabled="_continuousRuntimeLoading"
                                           OnClick="LoadContinuousRuntimeAsync">
                                    刷新
                                </MudButton>
                            </div>

                            @if (_continuousRuntimeLoading)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
                            }
                            else if (!string.IsNullOrWhiteSpace(_continuousRuntimeError))
                            {
                                <MudAlert Severity="Severity.Error" Class="mt-3">@_continuousRuntimeError</MudAlert>
                            }
                            else
                            {
                                <div class="continuous-runtime-stats">
                                    <button type="button"
                                            class="@GetContinuousStatusClass(PatientContinuousSyncStatuses.WaitingData)"
                                            aria-pressed="@IsContinuousStatusSelected(PatientContinuousSyncStatuses.WaitingData)"
                                            @onclick="() => SelectContinuousStatusAsync(PatientContinuousSyncStatuses.WaitingData)">
                                        <span>等待数据</span>
                                        <strong>@_continuousWaitingDataCount</strong>
                                    </button>
                                    <button type="button"
                                            class="@GetContinuousStatusClass(PatientContinuousSyncStatuses.Active)"
                                            aria-pressed="@IsContinuousStatusSelected(PatientContinuousSyncStatuses.Active)"
                                            @onclick="() => SelectContinuousStatusAsync(PatientContinuousSyncStatuses.Active)">
                                        <span>同步中</span>
                                        <strong>@_continuousActiveCount</strong>
                                    </button>
                                    <button type="button"
                                            class="@GetContinuousStatusClass(PatientContinuousSyncStatuses.Closing)"
                                            aria-pressed="@IsContinuousStatusSelected(PatientContinuousSyncStatuses.Closing)"
                                            @onclick="() => SelectContinuousStatusAsync(PatientContinuousSyncStatuses.Closing)">
                                        <span>结束中</span>
                                        <strong>@_continuousClosingCount</strong>
                                    </button>
                                    <button type="button"
                                            class="@GetContinuousStatusClass(PatientContinuousSyncStatuses.Completed)"
                                            aria-pressed="@IsContinuousStatusSelected(PatientContinuousSyncStatuses.Completed)"
                                            @onclick="() => SelectContinuousStatusAsync(PatientContinuousSyncStatuses.Completed)">
                                        <span>已完成</span>
                                        <strong>@_continuousCompletedCount</strong>
                                    </button>
                                </div>

                                <MudGrid>
                                    <MudItem xs="12" lg="5" Class="continuous-patient-pane">
                                        <div class="continuous-patient-toolbar">
                                            <div class="continuous-patient-title">
                                                <MudText Typo="Typo.subtitle2">@GetContinuousPatientListTitle()（@_continuousSessions.Count）</MudText>
                                                @if (_continuousStatusFilter != ContinuousPendingFilter)
                                                {
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ShowPendingContinuousSessionsAsync">
                                                        返回待同步
                                                    </MudButton>
                                                }
                                            </div>
                                            <MudTextField @bind-Value="_continuousPatientSearch"
                                                          Placeholder="搜索患者ID或就诊号"
                                                          Adornment="Adornment.Start"
                                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                                          Immediate="true"
                                                          Margin="Margin.Dense" />
                                        </div>
                                        @if (_continuousSessions.Count == 0)
                                        {
                                            <div class="continuous-runtime-empty">@GetContinuousEmptySessionText()</div>
                                        }
                                        else
                                        {
                                            <MudTable T="PatientContinuousSyncSession"
                                                      Items="FilteredContinuousSessions"
                                                      Dense="true"
                                                      Hover="true">
                                                <HeaderContent>
                                                    <MudTh>患者ID</MudTh>
                                                    <MudTh>就诊号</MudTh>
                                                    <MudTh>状态</MudTh>
                                                    <MudTh>最近执行</MudTh>
                                                    <MudTh></MudTh>
                                                </HeaderContent>
                                                <RowTemplate>
                                                    <MudTd DataLabel="患者ID">@context.PatientId</MudTd>
                                                    <MudTd DataLabel="就诊号">@context.VisitSn</MudTd>
                                                    <MudTd DataLabel="状态">@GetContinuousSessionStatusText(context.Status)</MudTd>
                                                    <MudTd DataLabel="最近执行">@FormatContinuousDateTime(GetContinuousLastStartedAt(context.Id))</MudTd>
                                                    <MudTd>
                                                        <MudButton Size="Size.Small"
                                                                   Variant="@(context.Id == _selectedContinuousSession?.Id ? Variant.Filled : Variant.Text)"
                                                                   OnClick="() => SelectContinuousSessionAsync(context)">
                                                            查看日志
                                                        </MudButton>
                                                    </MudTd>
                                                </RowTemplate>
                                                <PagerContent>
                                                    <MudTablePager PageSizeOptions="@(new int[] { 10, 25, 50 })" />
                                                </PagerContent>
                                            </MudTable>
                                        }
                                    </MudItem>

                                    <MudItem xs="12" lg="7" Class="continuous-log-pane">
                                        @if (_selectedContinuousSession == null)
                                        {
                                            <div class="continuous-runtime-empty">请选择患者查看日志。</div>
                                        }
                                        else
                                        {
                                            <div class="continuous-selected-head">
                                                <div>
                                                    <MudText Typo="Typo.subtitle2">
                                                        @_selectedContinuousSession.PatientId / @_selectedContinuousSession.VisitSn
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        下次执行：@FormatContinuousDateTime(_selectedContinuousSession.NextRunAt)
                                                    </MudText>
                                                </div>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">
                                                    @GetContinuousSessionStatusText(_selectedContinuousSession.Status)
                                                </MudChip>
                                            </div>

                                            @if (_continuousRunLogs.Count == 0)
                                            {
                                                <div class="continuous-runtime-empty">
                                                    @GetContinuousEmptyLogText()
                                                </div>
                                            }
                                            else
                                            {
                                                <MudTable T="PatientContinuousSyncRunLog"
                                                          Items="_continuousRunLogs"
                                                          Dense="true"
                                                          Hover="true">
                                                    <HeaderContent>
                                                        <MudTh>时间</MudTh>
                                                        <MudTh>级别</MudTh>
                                                        <MudTh>接口</MudTh>
                                                        <MudTh>查询/推送/失败</MudTh>
                                                        <MudTh>时间窗口</MudTh>
                                                        <MudTh>消息</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate>
                                                        <MudTd DataLabel="时间">@context.CreatedAt.ToString("MM-dd HH:mm:ss")</MudTd>
                                                        <MudTd DataLabel="级别">
                                                            <MudChip T="string" Size="Size.Small" Color="@GetContinuousLogColor(context.Level)">
                                                                @GetContinuousLogLevelText(context.Level)
                                                            </MudChip>
                                                        </MudTd>
                                                        <MudTd DataLabel="接口">@GetContinuousInterfaceText(context)</MudTd>
                                                        <MudTd DataLabel="查询/推送/失败">
                                                            @context.QueryCount / @context.PushedCount / @context.FailedCount
                                                        </MudTd>
                                                        <MudTd DataLabel="时间窗口">@GetContinuousWindowText(context)</MudTd>
                                                        <MudTd DataLabel="消息">
                                                            <div class="continuous-runtime-message" title="@context.Message">@context.Message</div>
                                                        </MudTd>
                                                    </RowTemplate>
                                                    <PagerContent>
                                                        <MudTablePager PageSizeOptions="@(new int[] { 10, 25, 50, 100 })" />
                                                    </PagerContent>
                                                </MudTable>
                                            }
                                        }
                                    </MudItem>
                                </MudGrid>

                                <MudExpansionPanels Class="mt-4" Elevation="0">
                                    <MudExpansionPanel Text="任务批次汇总（最近 100 条）">
                                        @if (_continuousBatchLogs.Count == 0)
                                        {
                                            <div class="continuous-runtime-empty">还没有任务批次汇总。</div>
                                        }
                                        else
                                        {
                                            <MudTable T="PatientContinuousSyncRunLog" Items="_continuousBatchLogs" Dense="true" Hover="true">
                                                <HeaderContent>
                                                    <MudTh>时间</MudTh>
                                                    <MudTh>级别</MudTh>
                                                    <MudTh>查询/推送/失败</MudTh>
                                                    <MudTh>消息</MudTh>
                                                </HeaderContent>
                                                <RowTemplate>
                                                    <MudTd DataLabel="时间">@context.CreatedAt.ToString("MM-dd HH:mm:ss")</MudTd>
                                                    <MudTd DataLabel="级别">@GetContinuousLogLevelText(context.Level)</MudTd>
                                                    <MudTd DataLabel="查询/推送/失败">@context.QueryCount / @context.PushedCount / @context.FailedCount</MudTd>
                                                    <MudTd DataLabel="消息">@context.Message</MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        }
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }
                        </section>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>

        <MudDialog @bind-Visible="_showConfigDialog" Options="_configDialogOptions">
            <TitleContent>
                <div class="config-dialog-title">
                    <div class="task-panel-tag">接口配置</div>
                    <MudText Typo="Typo.h6">@GetConfigDialogTitle()</MudText>
                </div>
            </TitleContent>
            <DialogContent>
                @if (_editingConfigInterface != null)
                {
                    <div class="task-inline-pills task-inline-pills--wrap config-dialog-pills">
                        <span class="meta-pill">注入字段 @GetInjectFieldCount(_editingConfigInterface)</span>
                        <span class="meta-pill">路由参数 @GetPushParamCompletionText(_editingConfigInterface)</span>
                        <span class="meta-pill">过滤条件 @GetFilterConditionCount(_editingConfigInterface)</span>
                    </div>

                    @if (!IsChildInterface(_editingConfigInterface))
                    {
                        <div class="config-preview">
                            <span class="config-preview-title">推送目标预览</span>
                            <span class="config-preview-text">@GetEditingPushTargetPreview()</span>
                        </div>
                    }

                    <div class="config-section">
                        <div class="config-section-header">
                            <MudText Typo="Typo.subtitle1">查询来源</MudText>
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string"
                                           Value="_editingConfigInterface.SourceType"
                                           ValueChanged="@(v => OnInterfaceSourceTypeChanged(_editingConfigInterface, v))"
                                           Label="来源类型"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true">
                                    <MudSelectItem Value="@(IngestionService.SourceTypeApi)">API 平台</MudSelectItem>
                                    <MudSelectItem Value="@(IngestionService.SourceTypeDatabase)">数据库</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="8">
                                <MudTextField @bind-Value="_editingConfigInterface.DisplayName"
                                              Label="显示名称"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            @if (IsDatabaseInterface(_editingConfigInterface))
                            {
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_editingConfigInterface.ServerCode"
                                                  Label="接口编码"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12">
                                    <MudSelect T="int?"
                                               Value="_editingConfigInterface.ApiInterfaceId"
                                               ValueChanged="@(v => OnApiInterfaceChanged(_editingConfigInterface, v))"
                                               Label="API 接口"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Dense="true">
                                        <MudSelectItem T="int?" Value="@((int?)null)">请选择</MudSelectItem>
                                        @foreach (var apiInterface in _apiInterfaces)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)apiInterface.Id)">@FormatApiInterface(apiInterface)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            }
                            @if (IsDatabaseInterface(_editingConfigInterface))
                            {
                                <MudItem xs="12" sm="4">
                                    <MudTextField Value="@GetEffectiveDatabaseTypeText(_editingConfigInterface)"
                                                  Label="数据库类型"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  ReadOnly="true" />
                                </MudItem>
                                <MudItem xs="12" sm="8">
                                    <MudSelect T="int?"
                                               @bind-Value="_editingConfigInterface.DatabaseResourceId"
                                               Label="数据库资源"
                                               HelperText="@GetDatabaseResourceHelperText(_editingConfigInterface)"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Dense="true">
                                        <MudSelectItem T="int?" Value="@((int?)null)">继承患者来源数据库资源</MudSelectItem>
                                        @foreach (var resource in _databaseResources)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)resource.Id)">@GetDatabaseResourceOption(resource)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_editingConfigInterface.QuerySql"
                                                  Label="SQL 查询模板"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="6"
                                                  HelperText="@GetSqlTemplateHelperText(_editingConfigInterface)" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12">
                                    <MudSwitch @bind-Value="_editingConfigInterface.UseTodayTimeRange"
                                               Label="传入当天 00:00:00 至 23:59:59"
                                               Disabled="@_editingConfigInterface.ContinuousPollingEnabled"
                                               Color="Color.Primary" />
                                </MudItem>
                                @if (!IsChildInterface(_editingConfigInterface))
                                {
                                    <MudItem xs="12">
                                        <MudSwitch T="bool"
                                                   Value="_editingConfigInterface.ContinuousPollingEnabled"
                                                   ValueChanged="@(value => OnContinuousPollingChanged(_editingConfigInterface, value))"
                                                   Label="住院期间持续轮询"
                                                   Disabled="@_task.PatientContinuousSyncEnabled"
                                                   Color="Color.Primary" />
                                    </MudItem>
                                    @if (_editingConfigInterface.ContinuousPollingEnabled)
                                    {
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int"
                                                             @bind-Value="_editingConfigInterface.ContinuousPollingIntervalSeconds"
                                                             Label="轮询间隔（秒）"
                                                             Min="1"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string"
                                                       @bind-Value="_editingConfigInterface.QueryStartTimeSourceServerCode"
                                                       Label="入院时间来源接口"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Dense="true">
                                                @foreach (var source in _ingestionSources)
                                                {
                                                    <MudSelectItem Value="@source.ServerCode">@source.Name (@source.ServerCode)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudTextField @bind-Value="_editingConfigInterface.QueryStartTimeSourceField"
                                                          Label="入院时间来源字段"
                                                          Placeholder="ADMISSION_TIME"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="string"
                                                       @bind-Value="_editingConfigInterface.QueryEndTimeSourceServerCode"
                                                       Label="出院时间来源接口"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Dense="true">
                                                @foreach (var source in _ingestionSources)
                                                {
                                                    <MudSelectItem Value="@source.ServerCode">@source.Name (@source.ServerCode)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="_editingConfigInterface.QueryEndTimeSourceField"
                                                          Label="出院时间来源字段"
                                                          Placeholder="DISCHARGE_TIME"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                        </MudItem>
                                    }
                                }
                            }
                        </MudGrid>
                    </div>

                    <div class="config-section">
                        <div class="config-section-header">
                            <MudText Typo="Typo.subtitle1">访问时段</MudText>
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudSwitch @bind-Value="_editingConfigInterface.AccessWindowEnabled"
                                           Label="仅在指定时段访问"
                                           Color="Color.Primary" />
                            </MudItem>
                            @if (_editingConfigInterface.AccessWindowEnabled)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_editingConfigInterface.AccessWindowStart"
                                                  Label="开始时间"
                                                  Placeholder="22:00"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_editingConfigInterface.AccessWindowEnd"
                                                  Label="结束时间"
                                                  Placeholder="06:00"
                                                  HelperText="支持跨午夜，格式 HH:mm"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                        </MudGrid>
                    </div>

                    <div class="config-section">
                        <div class="config-section-header">
                            <MudText Typo="Typo.subtitle1">查询映射</MudText>
                        </div>
                        <MudGrid Spacing="2">
                            @if (IsChildInterface(_editingConfigInterface))
                            {
                                <MudItem xs="12">
                                    <div class="interface-inline-summary config-inline-summary">
                                        <span class="interface-inline-summary-label">关联映射</span>
                                        <strong class="interface-inline-summary-value">@GetQueryMappingPreview(_editingConfigInterface)</strong>
                                    </div>
                                </MudItem>
                            }
                            else if (IsDatabaseInterface(_editingConfigInterface))
                            {
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_editingConfigInterface.QueryField"
                                                  Label="@GetQueryFieldLabel(_editingConfigInterface)"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="string"
                                                     Value="_editingConfigInterface.QueryValueField"
                                                     ValueChanged="@(v => _editingConfigInterface.QueryValueField = v)"
                                                     Label="触发记录取值字段"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Dense="true"
                                                     Clearable="true"
                                                     CoerceValue="true"
                                                     SearchFunc="@SearchTriggerSourceColumns"
                                                     HelperText="@GetAutoQueryValueLabel(_editingConfigInterface)" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12">
                                    @for (var i = 0; i < _editingQueryMappings.Count; i++)
                                    {
                                        var index = i;
                                        <div class="link-mapping-row">
                                            <MudTextField @bind-Value="_editingQueryMappings[index].TargetField"
                                                          Label="API 请求字段"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense" />
                                            <MudAutocomplete T="string"
                                                             Value="_editingQueryMappings[index].SourceField"
                                                             ValueChanged="@(v => _editingQueryMappings[index].SourceField = v)"
                                                             Label="触发记录字段"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Dense="true"
                                                             CoerceValue="true"
                                                             SearchFunc="@SearchTriggerSourceColumns" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Disabled="@(_editingQueryMappings.Count <= 1)"
                                                           OnClick="@(() => RemoveQueryMapping(index))" />
                                        </div>
                                    }
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddQueryMapping">
                                        添加查询映射
                                    </MudButton>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>

                    <div class="config-section">
                        <div class="config-section-header">
                            <MudText Typo="Typo.subtitle1">组合关系</MudText>
                        </div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string"
                                           Value="@GetEditingParentSelectValue()"
                                           ValueChanged="OnEditingParentInterfaceChanged"
                                           Label="父接口"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true">
                                    <MudSelectItem Value="@string.Empty">无（独立/根接口）</MudSelectItem>
                                    @foreach (var candidate in GetParentCandidates(_editingConfigInterface))
                                    {
                                        <MudSelectItem Value="@candidate.InterfaceKey">@GetInterfaceDisplayName(candidate)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            @if (IsChildInterface(_editingConfigInterface))
                            {
                                <MudItem xs="12">
                                    <div class="link-mapping-list">
                                        @for (var i = 0; i < _editingLinkMappings.Count; i++)
                                        {
                                            var index = i;
                                            <div class="link-mapping-row">
                                                <MudTextField @bind-Value="_editingLinkMappings[index].ParentField"
                                                              Label="父接口字段"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" />
                                                <MudTextField @bind-Value="_editingLinkMappings[index].ChildField"
                                                              Label="当前接口字段"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               Disabled="@(_editingLinkMappings.Count <= 1)"
                                                               OnClick="@(() => RemoveLinkMapping(index))" />
                                            </div>
                                        }
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="AddLinkMapping">
                                            添加关联字段
                                        </MudButton>
                                    </div>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_editingConfigInterface.MountField"
                                                  Label="挂载到父记录"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                                @if (NeedsRouteConfig(_editingConfigInterface))
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_editingConfigInterface.RouteField"
                                                      Label="分流字段"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudSelect T="string" @bind-Value="_editingConfigInterface.RouteOperator"
                                                   Label="分流条件"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Dense="true">
                                            <MudSelectItem Value="@("eq")">eq（等于）</MudSelectItem>
                                            <MudSelectItem Value="@("in")">in（包含）</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="8">
                                        <MudTextField @bind-Value="_editingConfigInterface.RouteValue"
                                                      Label="分流值"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>
                                }
                            }
                            else
                            {
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_editingOutputFieldsText"
                                                  Label="父级输出字段"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                        </MudGrid>
                    </div>
                }

                <div class="config-section">
                    <div class="config-section-header">
                        <MudText Typo="Typo.subtitle1">注入字段</MudText>
                    </div>
                    <MudSelect T="string" MultiSelection="true"
                               SelectedValues="GetInjectFields(_editingConfigInterface!)"
                               SelectedValuesChanged="@(v => SetInjectFields(_editingConfigInterface!, v))"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Label="选择注入字段"
                               MultiSelectionTextFunc="@(selected => $"{selected.Count()} 个字段")">
                        @foreach (var col in GetTriggerSourceColumns())
                        {
                            <MudSelectItem Value="@col">@col</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @if (_editingConfigInterface != null && !IsChildInterface(_editingConfigInterface) && _editingParams.Count > 0)
                {
                    <div class="config-section">
                        <div class="config-section-header">
                            <MudText Typo="Typo.subtitle1">路由参数</MudText>
                        </div>
                        @for (var i = 0; i < _editingParams.Count; i++)
                        {
                            var index = i;
                            <div class="config-row">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="5">
                                        <MudTextField Value="_editingParams[index].Key" Label="占位符" ReadOnly="true"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="7">
                                        <MudTextField Value="_editingParams[index].Value" Label="值"
                                                      ValueChanged="@((string v) => UpdateParamValue(index, v))"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                            </div>
                        }
                    </div>
                }

                @if (_editingConfigInterface != null &&
                    IsConditionArrayInterface(_editingConfigInterface))
                {
                    <div class="config-section">
                        <div class="config-section-header">
                            <MudText Typo="Typo.subtitle1">过滤条件</MudText>
                        </div>
                        @for (var i = 0; i < _editingFilters.Count; i++)
                        {
                            var index = i;
                            var filter = _editingFilters[index];
                            <div class="config-row">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="filter.Column" Label="字段名"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudSelect T="string" @bind-Value="filter.Type" Label="条件类型"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                            @foreach (var operatorConfig in GetEditingOperators())
                                            {
                                                <MudSelectItem Value="@operatorConfig.Value">@operatorConfig.Value（@operatorConfig.DisplayName）</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField T="string" Value="@(filter.Value?.ToString() ?? "")" Label="值"
                                                      ValueChanged="@((string v) => { filter.Value = v; })"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Disabled="@(!OperatorRequiresValue(filter.Type))" />
                                    </MudItem>
                                    <MudItem xs="12" sm="1" Class="d-flex align-center justify-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="@(() => _editingFilters.RemoveAt(index))" />
                                    </MudItem>
                                </MudGrid>
                            </div>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _editingFilters.Add(new()))">
                            添加条件
                        </MudButton>
                    </div>
                }
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _showConfigDialog = false)">取消</MudButton>
                <MudButton Color="Color.Primary" OnClick="SaveConfig">确定</MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog @bind-Visible="_showApiImportDialog" Options="_configDialogOptions">
            <TitleContent>
                <MudText Typo="Typo.h6">导入单个 API 接口</MudText>
            </TitleContent>
            <DialogContent>
                <MudText Typo="Typo.body2" Class="mb-3">
                    JSON 必须包含 taskCode 和 interfaceKey。系统只新增或更新匹配的一个接口，其他接口不会改变。
                </MudText>
                <MudTextField @bind-Value="_apiImportJson"
                              Label="接口配置 JSON"
                              Variant="Variant.Outlined"
                              Lines="14"
                              Immediate="true" />
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Class="mt-3"
                           StartIcon="@Icons.Material.Filled.Preview" OnClick="PreviewApiImport">
                    生成变更预览
                </MudButton>
                @if (!string.IsNullOrWhiteSpace(_apiImportError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-3">@_apiImportError</MudAlert>
                }
                else if (_apiImportPreview.Count > 0)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-3">
                        <ul>
                            @foreach (var item in _apiImportPreview)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </MudAlert>
                }
                else if (_apiImportCandidate != null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">接口配置没有变化。</MudAlert>
                }
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="CloseApiImportDialog">取消</MudButton>
                <MudButton Color="Color.Primary"
                           Disabled="@(_apiImportCandidate == null || _apiImportPreview.Count == 0)"
                           OnClick="ApplyApiImport">
                    应用到当前任务
                </MudButton>
            </DialogActions>
        </MudDialog>

        <div class="task-edit-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="Save" Disabled="_saving">
                @(_saving ? "保存中..." : "保存")
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="BackToTaskList">
                返回列表
            </MudButton>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private SyncTask _task = new();
    private List<SyncTaskInterface> _interfaces = [];
    private List<int> _removedInterfaceIds = [];
    private bool _isEdit;
    private bool _loading = true;
    private bool _saving;
    private bool _continuousRuntimeLoading;
    private string? _continuousRuntimeError;
    private int _continuousWaitingDataCount;
    private int _continuousActiveCount;
    private int _continuousClosingCount;
    private int _continuousCompletedCount;
    private const string ContinuousPendingFilter = "Pending";
    private string _continuousStatusFilter = ContinuousPendingFilter;
    private string _continuousPatientSearch = "";
    private List<PatientContinuousSyncSession> _continuousSessions = [];
    private Dictionary<long, DateTime?> _continuousLastStartedAt = [];
    private PatientContinuousSyncSession? _selectedContinuousSession;
    private List<PatientContinuousSyncRunLog> _continuousRunLogs = [];
    private List<PatientContinuousSyncRunLog> _continuousBatchLogs = [];
    private ActiveSyncSettings? _activeSyncSettings;
    private bool _originalEnabled;
    private string _originalTriggerServerCode = "";
    private string _originalAdditionalTriggerServerCodes = "";
    private string _originalPushType = "";
    private string _originalPushTarget = "";
    private SyncTaskInterface? _pendingNewInterface;
    private string? _pendingSortOrderFocusKey;
    private string? _movingSortOrderInterfaceKey;
    private bool _sortOrderTransitioning;
    private int _sortOrderTransitionVersion;

    // 拖拽容器引用
    private MudDropContainer<SyncTaskInterface>? _dropContainer;

    // 下拉数据源
    private List<ApiInterface> _apiInterfaces = [];
    private List<IngestionSource> _ingestionSources = [];
    private List<DatabaseResource> _databaseResources = [];

    // 统一配置弹窗相关
    private SyncTaskInterface? _editingConfigInterface;
    private List<KeyValuePair<string, string>> _editingParams = [];
    private List<QueryCondition> _editingFilters = [];
    private List<InterfaceLinkMapping> _editingLinkMappings = [];
    private List<InterfaceQueryMapping> _editingQueryMappings = [];
    private string _editingOutputFieldsText = "";
    private bool _showConfigDialog;
    private bool _editingNewInterface;
    private readonly DialogOptions _configDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    // API 单接口增量导入
    private bool _showApiImportDialog;
    private string _apiImportJson = "";
    private string? _apiImportError;
    private List<string> _apiImportPreview = [];
    private SyncTaskInterface? _apiImportCandidate;
    private SyncTaskInterface? _apiImportExisting;
    private readonly JsonSerializerOptions _apiImportJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        UnmappedMemberHandling = System.Text.Json.Serialization.JsonUnmappedMemberHandling.Disallow
    };

    // 过滤条件相关
    private TriggerConditionConfig _conditionConfig = new();
    private List<string> _ruleValuesText = [];
    private readonly Dictionary<string, List<string>> _columnsCache = [];
    private HashSet<string> _additionalTriggerServerCodes = new(StringComparer.OrdinalIgnoreCase);

    private sealed class InterfaceGroupView
    {
        public int SortOrder { get; init; }
        public List<SyncTaskInterface> Items { get; init; } = [];
    }

    private sealed class InterfaceWorkspaceSummary
    {
        public int ReadyCount { get; init; }
        public int MissingServerCount { get; init; }
        public int MissingQueryCount { get; init; }
        public int MissingPushParamCount { get; init; }
    }

    protected override async Task OnPageInitializedAsync()
    {
        _isEdit = Id > 0;

        // 加载下拉数据源
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            _apiInterfaces = await db.ApiInterfaces
                .AsNoTracking()
                .Include(i => i.Platform)
                .OrderBy(i => i.Platform!.Name)
                .ThenBy(i => i.Name)
                .ToListAsync(CancellationToken);
            _ingestionSources = await db.IngestionSources
                .OrderBy(s => s.ServerCode).ToListAsync(CancellationToken);
            _databaseResources = await db.DatabaseResources
                .AsNoTracking()
                .OrderBy(r => r.Name)
                .ToListAsync(CancellationToken);
        }

        if (_isEdit)
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            var task = await db.SyncTasks
                .Include(t => t.Interfaces.OrderBy(i => i.SortOrder))
                .FirstOrDefaultAsync(t => t.Id == Id, CancellationToken);

            if (task is null)
            {
                inj_snackbar.Add("任务不存在", Severity.Error);
                inj_navigationManager.NavigateTo("/tasks");
                return;
            }

            _task = task;
            _interfaces = task.Interfaces.ToList();
            EnsureInterfaceKeys();
            NormalizeInterfaceOrder();

            // 解析现有过滤条件
            _conditionConfig = inj_localQueryService.ParseTriggerConditions(
                _task.TriggerConditions, _task.TriggerServerCode);
            _ruleValuesText = _conditionConfig.Rules
                .Select(r => string.Join(",", r.Values))
                .ToList();
            _additionalTriggerServerCodes = _task.AdditionalTriggerServerCodeArray
                .Where(code => !string.Equals(code, _task.TriggerServerCode, StringComparison.OrdinalIgnoreCase))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            SyncAdditionalTriggerServerCodes();
            CaptureOriginalTaskState();

            // 预加载已有规则的字段列表
            foreach (var rule in _conditionConfig.Rules)
                await EnsureColumnsLoadedAsync(rule.Interface);

            // 预加载触发源列（供"取值字段"下拉使用）
            await EnsureColumnsLoadedAsync(_task.TriggerServerCode);
            await LoadContinuousRuntimeAsync();
        }
        else
        {
            _task = new SyncTask();
            _interfaces = [];
            CaptureOriginalTaskState();
        }

        _loading = false;
    }

    private async Task LoadContinuousRuntimeAsync()
    {
        if (!_isEdit)
            return;

        _continuousRuntimeLoading = true;
        _continuousRuntimeError = null;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            var statusCounts = await db.PatientContinuousSyncSessions
                .AsNoTracking()
                .Where(item => item.TaskId == _task.Id)
                .GroupBy(item => item.Status)
                .Select(group => new { Status = group.Key, Count = group.Count() })
                .ToDictionaryAsync(item => item.Status, item => item.Count, CancellationToken);

            _continuousWaitingDataCount = statusCounts.GetValueOrDefault(PatientContinuousSyncStatuses.WaitingData);
            _continuousActiveCount = statusCounts.GetValueOrDefault(PatientContinuousSyncStatuses.Active);
            _continuousClosingCount = statusCounts.GetValueOrDefault(PatientContinuousSyncStatuses.Closing);
            _continuousCompletedCount = statusCounts.GetValueOrDefault(PatientContinuousSyncStatuses.Completed);

            var selectedStatuses = GetContinuousSelectedStatuses();
            var sessions = await db.PatientContinuousSyncSessions
                .AsNoTracking()
                .Where(item => item.TaskId == _task.Id && selectedStatuses.Contains(item.Status))
                .Select(item => new
                {
                    Session = item,
                    LastStartedAt = db.PatientContinuousSyncInterfaceStates
                        .Where(state => state.SessionId == item.Id)
                        .Max(state => state.LastStartedAt)
                })
                .OrderBy(item => item.LastStartedAt.HasValue)
                .ThenByDescending(item => item.LastStartedAt)
                .ThenBy(item => item.Session.PatientId)
                .ToListAsync(CancellationToken);
            _continuousSessions = sessions.Select(item => item.Session).ToList();
            _continuousLastStartedAt = sessions.ToDictionary(item => item.Session.Id, item => item.LastStartedAt);

            var selectedSessionId = _selectedContinuousSession?.Id;
            _selectedContinuousSession = _continuousSessions
                .FirstOrDefault(item => item.Id == selectedSessionId)
                ?? _continuousSessions.FirstOrDefault();
            _continuousRunLogs = _selectedContinuousSession == null
                ? []
                : await db.PatientContinuousSyncRunLogs
                    .AsNoTracking()
                    .Where(item => item.TaskId == _task.Id && item.SessionId == _selectedContinuousSession.Id)
                    .OrderByDescending(item => item.CreatedAt)
                    .ToListAsync(CancellationToken);
            _continuousBatchLogs = await db.PatientContinuousSyncRunLogs
                .AsNoTracking()
                .Where(item => item.TaskId == _task.Id && item.SessionId == null)
                .OrderByDescending(item => item.CreatedAt)
                .Take(100)
                .ToListAsync(CancellationToken);
        }
        catch (Exception ex)
        {
            _continuousRuntimeError = $"运行状态加载失败：{ex.Message}";
            _continuousSessions = [];
            _continuousLastStartedAt = [];
            _selectedContinuousSession = null;
            _continuousRunLogs = [];
            _continuousBatchLogs = [];
        }
        finally
        {
            _continuousRuntimeLoading = false;
        }
    }

    private IEnumerable<PatientContinuousSyncSession> FilteredContinuousSessions
        => string.IsNullOrWhiteSpace(_continuousPatientSearch)
            ? _continuousSessions
            : _continuousSessions.Where(item =>
                item.PatientId.Contains(_continuousPatientSearch, StringComparison.OrdinalIgnoreCase) ||
                item.VisitSn.Contains(_continuousPatientSearch, StringComparison.OrdinalIgnoreCase));

    private string[] GetContinuousSelectedStatuses()
        => _continuousStatusFilter == ContinuousPendingFilter
            ? [PatientContinuousSyncStatuses.Active, PatientContinuousSyncStatuses.Closing]
            : [_continuousStatusFilter];

    private bool IsContinuousStatusSelected(string status)
        => _continuousStatusFilter == status ||
           (_continuousStatusFilter == ContinuousPendingFilter &&
            (status == PatientContinuousSyncStatuses.Active || status == PatientContinuousSyncStatuses.Closing));

    private string GetContinuousStatusClass(string status)
        => IsContinuousStatusSelected(status)
            ? "continuous-runtime-stat is-selected"
            : "continuous-runtime-stat";

    private async Task SelectContinuousStatusAsync(string status)
    {
        _continuousStatusFilter = status;
        await LoadContinuousRuntimeAsync();
    }

    private async Task ShowPendingContinuousSessionsAsync()
    {
        _continuousStatusFilter = ContinuousPendingFilter;
        await LoadContinuousRuntimeAsync();
    }

    private string GetContinuousPatientListTitle()
        => _continuousStatusFilter == ContinuousPendingFilter
            ? "待同步患者"
            : $"{GetContinuousSessionStatusText(_continuousStatusFilter)}患者";

    private string GetContinuousEmptySessionText()
        => _continuousStatusFilter == ContinuousPendingFilter
            ? "当前没有同步中或结束中的患者。"
            : $"当前没有{GetContinuousSessionStatusText(_continuousStatusFilter)}患者。";

    private string GetContinuousEmptyLogText()
        => _selectedContinuousSession?.Status == PatientContinuousSyncStatuses.WaitingData
            ? "该患者仍在等待完整入院数据，尚未进入接口执行。"
            : "该患者还没有实际推送或失败明细；查询无新增数据时只计入任务批次汇总。";

    private async Task SelectContinuousSessionAsync(PatientContinuousSyncSession session)
    {
        _selectedContinuousSession = session;
        _continuousRuntimeLoading = true;
        _continuousRuntimeError = null;
        try
        {
            await using var db = await ContextFactory.CreateDbContextAsync(CancellationToken);
            _continuousRunLogs = await db.PatientContinuousSyncRunLogs
                .AsNoTracking()
                .Where(item => item.TaskId == _task.Id && item.SessionId == session.Id)
                .OrderByDescending(item => item.CreatedAt)
                .ToListAsync(CancellationToken);
        }
        catch (Exception ex)
        {
            _continuousRuntimeError = $"患者日志加载失败：{ex.Message}";
            _continuousRunLogs = [];
        }
        finally
        {
            _continuousRuntimeLoading = false;
        }
    }

    private static Color GetContinuousLogColor(string level)
        => level switch
        {
            "Error" => Color.Error,
            "Warning" => Color.Warning,
            _ => Color.Info
        };

    private static string GetContinuousLogLevelText(string level)
        => level switch
        {
            "Error" => "错误",
            "Warning" => "警告",
            _ => "信息"
        };

    private static string GetContinuousInterfaceText(PatientContinuousSyncRunLog log)
        => string.IsNullOrWhiteSpace(log.InterfaceName)
            ? string.IsNullOrWhiteSpace(log.ServerCode) ? "-" : log.ServerCode
            : string.IsNullOrWhiteSpace(log.ServerCode) ? log.InterfaceName : $"{log.InterfaceName}（{log.ServerCode}）";

    private static string GetContinuousWindowText(PatientContinuousSyncRunLog log)
    {
        if (!log.InterfaceId.HasValue)
            return "-";
        if (!log.WindowFrom.HasValue && !log.WindowTo.HasValue)
            return "无时间窗口";
        return $"{log.WindowFrom:MM-dd HH:mm:ss} ~ {log.WindowTo:MM-dd HH:mm:ss}";
    }

    private static string GetContinuousSessionStatusText(string status)
        => status switch
        {
            PatientContinuousSyncStatuses.Active => "同步中",
            PatientContinuousSyncStatuses.Closing => "结束中",
            PatientContinuousSyncStatuses.WaitingData => "等待数据",
            PatientContinuousSyncStatuses.Completed => "已完成",
            _ => status
        };

    private static string FormatContinuousDateTime(DateTime? value)
        => !value.HasValue || value.Value == DateTime.MaxValue
            ? "-"
            : value.Value.ToString("yyyy-MM-dd HH:mm:ss");

    private DateTime? GetContinuousLastStartedAt(long sessionId)
        => _continuousLastStartedAt.GetValueOrDefault(sessionId);

    // --- 接口管理 ---

    private async Task AddInterface()
    {
        var newInterface = new SyncTaskInterface
        {
            Enabled = true,
            SortOrder = GetRecommendedSortOrderForNewInterface(),
            InterfaceKey = CreateInterfaceKey(),
            SourceType = GetDefaultInterfaceSourceType(),
            DatabaseType = GetDefaultInterfaceDatabaseType(),
            RouteOperator = "eq"
        };
        if (!IsDatabaseInterface(newInterface) && _apiInterfaces.Count > 0)
            OnApiInterfaceChanged(newInterface, _apiInterfaces[0].Id);

        await OpenConfigDialog(newInterface, true);
    }

    private void OpenApiImportDialog()
    {
        _apiImportJson = "";
        ResetApiImportPreview();
        _showApiImportDialog = true;
    }

    private void CloseApiImportDialog()
    {
        _showApiImportDialog = false;
        ResetApiImportPreview();
    }

    private void PreviewApiImport()
    {
        ResetApiImportPreview();

        try
        {
            var import = JsonSerializer.Deserialize<ApiTaskInterfacePatchImport>(
                _apiImportJson,
                _apiImportJsonOptions) ?? throw new InvalidOperationException("JSON 内容不能为空");

            ValidateApiImportIdentity(import);
            var matches = _interfaces
                .Where(i => string.Equals(i.InterfaceKey, import.InterfaceKey.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (matches.Count > 1)
                throw new InvalidOperationException("当前任务存在重复的 interfaceKey，请先修正任务配置");

            _apiImportExisting = matches.FirstOrDefault();
            if (_apiImportExisting != null && IsDatabaseInterface(_apiImportExisting))
                throw new InvalidOperationException("相同 interfaceKey 已用于数据库接口，不能覆盖");
            if (_apiImportExisting != null &&
                (IsChildInterface(_apiImportExisting) || HasChildInterfaces(_apiImportExisting)))
            {
                throw new InvalidOperationException("本次单接口导入不处理父子组合关系，请在接口编排中修改");
            }

            var candidate = CreateApiImportCandidate(_apiImportExisting, import);
            ValidateApiImportCandidate(candidate);
            NormalizeInterfaceConfig(candidate);

            _apiImportCandidate = candidate;
            _apiImportPreview = BuildApiImportPreview(_apiImportExisting, candidate);
        }
        catch (JsonException ex)
        {
            _apiImportError = $"JSON 格式错误：{ex.Message}";
        }
        catch (Exception ex)
        {
            _apiImportError = ex.Message;
        }
    }

    private async Task ApplyApiImport()
    {
        if (_apiImportCandidate == null || _apiImportPreview.Count == 0)
            return;

        if (_apiImportExisting == null)
        {
            _interfaces.Add(_apiImportCandidate);
            _pendingNewInterface = _apiImportCandidate;
        }
        else
        {
            ApplyInterfaceValues(_apiImportExisting, _apiImportCandidate);
        }

        NormalizeInterfaceOrder();
        await RefreshInterfaceWorkspaceAsync();
        _showApiImportDialog = false;
        inj_snackbar.Add("接口配置已应用，请检查后点击保存生效", Severity.Success);
        ResetApiImportPreview();
    }

    private void ValidateApiImportIdentity(ApiTaskInterfacePatchImport import)
    {
        if (string.IsNullOrWhiteSpace(_task.Code))
            throw new InvalidOperationException("请先填写当前任务编码");
        if (string.IsNullOrWhiteSpace(import.TaskCode))
            throw new InvalidOperationException("taskCode 不能为空");
        if (!string.Equals(_task.Code.Trim(), import.TaskCode.Trim(), StringComparison.OrdinalIgnoreCase))
            throw new InvalidOperationException($"JSON 目标任务为 {import.TaskCode}，与当前任务 {_task.Code} 不一致");
        if (string.IsNullOrWhiteSpace(import.InterfaceKey))
            throw new InvalidOperationException("interfaceKey 不能为空");
        if (string.IsNullOrWhiteSpace(import.PlatformName))
            throw new InvalidOperationException("platformName 不能为空");

        var interfaceKey = import.InterfaceKey.Trim();
        if (interfaceKey.Length > 100 || interfaceKey.Any(c => !char.IsLetterOrDigit(c) && c is not '-' and not '_'))
            throw new InvalidOperationException("interfaceKey 只能包含字母、数字、短横线和下划线，且不能超过 100 个字符");
        if (import.SortOrder.HasValue && import.SortOrder.Value < 1)
            throw new InvalidOperationException("sortOrder 必须大于 0");
    }

    private SyncTaskInterface CreateApiImportCandidate(
        SyncTaskInterface? existing,
        ApiTaskInterfacePatchImport import)
    {
        var candidate = new SyncTaskInterface
        {
            Enabled = true,
            SortOrder = GetRecommendedSortOrderForNewInterface(),
            InterfaceKey = import.InterfaceKey.Trim(),
            SourceType = IngestionService.SourceTypeApi,
            DatabaseType = IngestionService.DatabaseTypeSqlServer,
            RouteOperator = "eq"
        };

        if (existing != null)
            ApplyInterfaceValues(candidate, existing);

        candidate.InterfaceKey = import.InterfaceKey.Trim();
        candidate.SourceType = IngestionService.SourceTypeApi;
        if (import.ServerCode != null)
            candidate.ServerCode = import.ServerCode.Trim();
        if (import.DisplayName != null)
            candidate.DisplayName = import.DisplayName.Trim();
        if (import.QueryPath != null)
            candidate.QueryPath = import.QueryPath.Trim();
        if (import.UseTodayTimeRange.HasValue)
            candidate.UseTodayTimeRange = import.UseTodayTimeRange.Value;
        if (import.ContinuousPollingEnabled.HasValue)
            candidate.ContinuousPollingEnabled = import.ContinuousPollingEnabled.Value;
        if (import.ContinuousPollingIntervalSeconds.HasValue)
            candidate.ContinuousPollingIntervalSeconds = import.ContinuousPollingIntervalSeconds.Value;
        if (import.PatientContinuousSyncEnabled.HasValue)
            candidate.PatientContinuousSyncEnabled = import.PatientContinuousSyncEnabled.Value;
        if (import.ContinuousUseTimeRange.HasValue)
            candidate.ContinuousUseTimeRange = import.ContinuousUseTimeRange.Value;
        if (import.ContinuousRecordKeyFields != null)
        {
            candidate.ContinuousRecordKeyFields = string.Join(",", import.ContinuousRecordKeyFields
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase));
        }
        if (import.ContinuousUseRowHash.HasValue)
            candidate.ContinuousUseRowHash = import.ContinuousUseRowHash.Value;
        if (import.QueryStartTimeSourceServerCode != null)
            candidate.QueryStartTimeSourceServerCode = import.QueryStartTimeSourceServerCode.Trim();
        if (import.QueryStartTimeSourceField != null)
            candidate.QueryStartTimeSourceField = import.QueryStartTimeSourceField.Trim();
        if (import.QueryEndTimeSourceServerCode != null)
            candidate.QueryEndTimeSourceServerCode = import.QueryEndTimeSourceServerCode.Trim();
        if (import.QueryEndTimeSourceField != null)
            candidate.QueryEndTimeSourceField = import.QueryEndTimeSourceField.Trim();
        if (import.AccessWindowEnabled.HasValue)
            candidate.AccessWindowEnabled = import.AccessWindowEnabled.Value;
        if (import.AccessWindowStart != null)
            candidate.AccessWindowStart = import.AccessWindowStart.Trim();
        if (import.AccessWindowEnd != null)
            candidate.AccessWindowEnd = import.AccessWindowEnd.Trim();
        if (import.IsRequired.HasValue)
            candidate.IsRequired = import.IsRequired.Value;
        if (import.SortOrder.HasValue)
            candidate.SortOrder = import.SortOrder.Value;
        if (import.Enabled.HasValue)
            candidate.Enabled = import.Enabled.Value;
        if (import.PushParams != null)
            candidate.PushParams = import.PushParams.Count == 0 ? null : JsonSerializer.Serialize(import.PushParams);
        if (import.InjectFields != null)
        {
            SetInjectFields(candidate, import.InjectFields
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase));
        }
        if (import.OutputFields != null)
        {
            candidate.OutputFields = string.Join(",", import.OutputFields
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase));
            if (string.IsNullOrWhiteSpace(candidate.OutputFields))
                candidate.OutputFields = null;
        }

        if (import.QueryMappings != null)
        {
            var mappings = import.QueryMappings.Select(item => new InterfaceQueryMapping
            {
                TargetField = (item.TargetField ?? "").Trim(),
                SourceField = (item.SourceField ?? "").Trim()
            }).ToList();
            if (mappings.Any(item => string.IsNullOrWhiteSpace(item.TargetField) || string.IsNullOrWhiteSpace(item.SourceField)))
                throw new InvalidOperationException("queryMappings 的字段名不能为空");
            if (mappings.GroupBy(item => item.TargetField, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1))
                throw new InvalidOperationException("queryMappings 存在重复的 targetField");
            candidate.QueryMappings = mappings.Count == 0 ? null : JsonSerializer.Serialize(mappings);
        }

        var apiInterfaces = _apiInterfaces.Where(item =>
            string.Equals(item.Platform?.Name, import.PlatformName.Trim(), StringComparison.OrdinalIgnoreCase) &&
            string.Equals(item.Code, candidate.ServerCode, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(item.RelativePath.Trim('/'), (candidate.QueryPath ?? "").Trim('/'), StringComparison.OrdinalIgnoreCase)).ToList();
        if (apiInterfaces.Count > 1)
            throw new InvalidOperationException("指定平台下存在多个同编码、同路径的 API 接口");
        candidate.ApiInterfaceId = apiInterfaces.FirstOrDefault()?.Id;

        return candidate;
    }

    private void ValidateApiImportCandidate(SyncTaskInterface candidate)
    {
        if (string.IsNullOrWhiteSpace(candidate.ServerCode))
            throw new InvalidOperationException("serverCode 不能为空；新增接口时必须提供该字段");
        if (string.IsNullOrWhiteSpace(candidate.DisplayName))
            throw new InvalidOperationException("displayName 不能为空；新增接口时必须提供该字段");
        if (!string.IsNullOrWhiteSpace(candidate.QueryPath) && Uri.TryCreate(candidate.QueryPath, UriKind.Absolute, out _))
            throw new InvalidOperationException("queryPath 只能填写查询端点前缀后的相对路径");
        if (!candidate.ApiInterfaceId.HasValue)
            throw new InvalidOperationException("请先在 API 平台配置中维护对应接口目录");
        if (GetQueryMappings(candidate).Count == 0)
            throw new InvalidOperationException("queryMappings 至少包含一组手动映射");
        if (candidate.ContinuousPollingEnabled)
        {
            if (candidate.ContinuousPollingIntervalSeconds < 1)
                throw new InvalidOperationException("continuousPollingIntervalSeconds 必须大于 0");
            if (string.IsNullOrWhiteSpace(candidate.QueryStartTimeSourceServerCode) ||
                string.IsNullOrWhiteSpace(candidate.QueryStartTimeSourceField) ||
                string.IsNullOrWhiteSpace(candidate.QueryEndTimeSourceServerCode) ||
                string.IsNullOrWhiteSpace(candidate.QueryEndTimeSourceField))
                throw new InvalidOperationException("持续轮询必须配置入院和出院时间来源字段");
        }
        if (candidate.PatientContinuousSyncEnabled &&
            string.IsNullOrWhiteSpace(candidate.ContinuousRecordKeyFields) &&
            !candidate.ContinuousUseRowHash)
            throw new InvalidOperationException("患者持续同步必须配置记录唯一键，或明确启用不可变整行哈希");
        if (candidate.PatientContinuousSyncEnabled)
        {
            var queryConfig = GetApiInterface(candidate)!.Platform!.GetQueryConfig();
            if (!string.Equals(
                    queryConfig.ParameterMode,
                    ApiParameterModes.DirectProperties,
                    StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("患者持续同步当前仅支持直接参数 API");
            if (candidate.ContinuousUseTimeRange &&
                (string.IsNullOrWhiteSpace(queryConfig.StartTimeField) ||
                 string.IsNullOrWhiteSpace(queryConfig.EndTimeField)))
                throw new InvalidOperationException("患者持续同步要求 API 平台配置开始、结束时间请求字段");
        }

        InterfaceAccessWindow.Validate(candidate);
    }

    private static List<string> BuildApiImportPreview(
        SyncTaskInterface? existing,
        SyncTaskInterface candidate)
    {
        var preview = new List<string>();
        if (existing == null)
        {
            preview.Add($"新增接口：{candidate.DisplayName}（{candidate.InterfaceKey}）");
            preview.Add($"接口编码：{candidate.ServerCode}");
            preview.Add($"查询路径：{candidate.QueryPath}");
            preview.Add($"执行顺序：{candidate.SortOrder}；必要：{FormatImportValue(candidate.IsRequired)}；启用：{FormatImportValue(candidate.Enabled)}");
            if (candidate.PatientContinuousSyncEnabled)
                preview.Add($"患者持续同步：启用；查询模式：{GetContinuousQueryModeText(candidate)}；记录唯一键：{FormatImportValue(candidate.ContinuousRecordKeyFields)}；不可变整行哈希：{FormatImportValue(candidate.ContinuousUseRowHash)}");
            return preview;
        }

        AddApiImportChange(preview, "接口编码", existing.ServerCode, candidate.ServerCode);
        AddApiImportChange(preview, "显示名称", existing.DisplayName, candidate.DisplayName);
        AddApiImportChange(preview, "查询路径", existing.QueryPath, candidate.QueryPath);
        AddApiImportChange(preview, "当天时间范围", existing.UseTodayTimeRange, candidate.UseTodayTimeRange);
        AddApiImportChange(preview, "持续轮询", existing.ContinuousPollingEnabled, candidate.ContinuousPollingEnabled);
        AddApiImportChange(preview, "持续轮询间隔", existing.ContinuousPollingIntervalSeconds, candidate.ContinuousPollingIntervalSeconds);
        AddApiImportChange(preview, "患者持续同步", existing.PatientContinuousSyncEnabled, candidate.PatientContinuousSyncEnabled);
        AddApiImportChange(preview, "持续同步查询模式", GetContinuousQueryModeText(existing), GetContinuousQueryModeText(candidate));
        AddApiImportChange(preview, "持续同步记录唯一键", existing.ContinuousRecordKeyFields, candidate.ContinuousRecordKeyFields);
        AddApiImportChange(preview, "不可变整行哈希", existing.ContinuousUseRowHash, candidate.ContinuousUseRowHash);
        AddApiImportChange(preview, "入院时间来源接口", existing.QueryStartTimeSourceServerCode, candidate.QueryStartTimeSourceServerCode);
        AddApiImportChange(preview, "入院时间来源字段", existing.QueryStartTimeSourceField, candidate.QueryStartTimeSourceField);
        AddApiImportChange(preview, "出院时间来源接口", existing.QueryEndTimeSourceServerCode, candidate.QueryEndTimeSourceServerCode);
        AddApiImportChange(preview, "出院时间来源字段", existing.QueryEndTimeSourceField, candidate.QueryEndTimeSourceField);
        AddApiImportChange(preview, "限制访问时段", existing.AccessWindowEnabled, candidate.AccessWindowEnabled);
        AddApiImportChange(preview, "访问开始时间", existing.AccessWindowStart, candidate.AccessWindowStart);
        AddApiImportChange(preview, "访问结束时间", existing.AccessWindowEnd, candidate.AccessWindowEnd);
        AddApiImportChange(preview, "必要接口", existing.IsRequired, candidate.IsRequired);
        AddApiImportChange(preview, "执行顺序", existing.SortOrder, candidate.SortOrder);
        AddApiImportChange(preview, "启用状态", existing.Enabled, candidate.Enabled);
        AddApiImportChange(preview, "路由参数", existing.PushParams, candidate.PushParams);
        AddApiImportChange(preview, "注入字段", existing.InjectFields, candidate.InjectFields);
        AddApiImportChange(preview, "输出字段", existing.OutputFields, candidate.OutputFields);
        AddApiImportChange(preview, "查询字段映射", existing.QueryMappings, candidate.QueryMappings);
        return preview;
    }

    private static void AddApiImportChange<T>(List<string> preview, string name, T before, T after)
    {
        if (EqualityComparer<T>.Default.Equals(before, after))
            return;

        preview.Add($"{name}：{FormatImportValue(before)} → {FormatImportValue(after)}");
    }

    private static string FormatImportValue<T>(T value) => value switch
    {
        null => "空",
        bool boolValue => boolValue ? "是" : "否",
        string stringValue when string.IsNullOrWhiteSpace(stringValue) => "空",
        _ => value.ToString() ?? "空"
    };

    private static string GetContinuousQueryModeText(SyncTaskInterface iface)
        => iface.ContinuousUseTimeRange ? "时间窗口增量" : "无时间窗口轮询";

    private void ResetApiImportPreview()
    {
        _apiImportError = null;
        _apiImportPreview = [];
        _apiImportCandidate = null;
        _apiImportExisting = null;
    }

    private void RemoveInterface(SyncTaskInterface item)
    {
        if (item.Id > 0)
            _removedInterfaceIds.Add(item.Id);

        foreach (var child in _interfaces.Where(i => i.ParentInterfaceKey == item.InterfaceKey))
            ClearParentBinding(child);

        _interfaces.Remove(item);
        _dropContainer?.Refresh();
    }

    private async Task OnInterfaceDrop(MudItemDropInfo<SyncTaskInterface> dropInfo)
    {
        if (dropInfo.Item == null) return;

        var targetSortOrder = GetSortOrderFromDropZone(dropInfo.DropzoneIdentifier, dropInfo.Item.SortOrder);
        var parent = GetParentInterface(dropInfo.Item);
        if (parent != null)
            targetSortOrder = parent.SortOrder;

        _interfaces.Remove(dropInfo.Item);
        dropInfo.Item.SortOrder = targetSortOrder;

        var insertIndex = GetInsertIndexForDrop(targetSortOrder, dropInfo.IndexInZone);
        _interfaces.Insert(insertIndex, dropInfo.Item);
        SyncChildSortOrders(dropInfo.Item.InterfaceKey, dropInfo.Item.SortOrder);
        await RefreshInterfaceWorkspaceAsync();
    }

    private void OnApiInterfaceChanged(SyncTaskInterface item, int? apiInterfaceId)
    {
        item.ApiInterfaceId = apiInterfaceId;
        var apiInterface = _apiInterfaces.FirstOrDefault(i => i.Id == apiInterfaceId);
        if (apiInterface == null)
            return;
        item.SourceType = IngestionService.SourceTypeApi;
        item.ServerCode = apiInterface.Code;
        item.DisplayName = apiInterface.Name;
        item.QueryPath = apiInterface.RelativePath;
        if (!IsConditionArrayInterface(item))
            item.FilterConditions = null;
    }

    private static string FormatApiInterface(ApiInterface apiInterface) =>
        $"{apiInterface.Platform?.Name} / {apiInterface.Name}（{apiInterface.Code}）";

    private static void OnContinuousPollingChanged(SyncTaskInterface item, bool enabled)
    {
        item.ContinuousPollingEnabled = enabled;
        if (enabled)
        {
            item.UseTodayTimeRange = false;
            item.ContinuousPollingIntervalSeconds = Math.Max(1, item.ContinuousPollingIntervalSeconds);
        }
    }

    private async Task OnInterfaceSourceTypeChanged(SyncTaskInterface item, string sourceType)
    {
        var normalized = NormalizeSourceType(sourceType);
        if (string.Equals(item.SourceType, normalized, StringComparison.Ordinal))
            return;

        item.SourceType = normalized;
        if (IsDatabaseInterface(item))
        {
            item.DisplayName = string.IsNullOrWhiteSpace(item.DisplayName) ? item.ServerCode : item.DisplayName;
            item.DatabaseType = GetDefaultInterfaceDatabaseType();
            item.ApiInterfaceId = null;
            item.QueryMappings = null;
            item.QueryPath = null;
            item.UseTodayTimeRange = false;
            item.ContinuousPollingEnabled = false;
            item.QueryStartTimeSourceServerCode = null;
            item.QueryStartTimeSourceField = null;
            item.QueryEndTimeSourceServerCode = null;
            item.QueryEndTimeSourceField = null;
        }
        else
        {
            ClearInterfaceDatabaseConnection(item);
            item.QuerySql = null;
            item.QueryField = "";
            item.QueryValueField = null;
            if (!item.ApiInterfaceId.HasValue && _apiInterfaces.Count > 0)
                OnApiInterfaceChanged(item, _apiInterfaces[0].Id);
        }

        await RefreshInterfaceWorkspaceAsync();
    }

    private async Task OnInterfaceEnabledChanged(SyncTaskInterface item, bool enabled)
    {
        item.Enabled = enabled;
        if (!enabled)
        {
            foreach (var child in _interfaces.Where(i => i.ParentInterfaceKey == item.InterfaceKey))
                child.Enabled = false;
        }
        await RefreshInterfaceWorkspaceAsync();
    }

    private async Task OnInterfaceRequiredChanged(SyncTaskInterface item, bool isRequired)
    {
        item.IsRequired = isRequired;
        await RefreshInterfaceWorkspaceAsync();
    }

    private async Task OnInterfaceSortOrderChanged(SyncTaskInterface item, int sortOrder)
    {
        var parent = GetParentInterface(item);
        if (parent != null)
        {
            item.SortOrder = parent.SortOrder;
            return;
        }

        var normalizedSortOrder = Math.Max(1, sortOrder);
        if (item.SortOrder == normalizedSortOrder)
            return;

        _sortOrderTransitioning = true;
        _movingSortOrderInterfaceKey = item.InterfaceKey;
        _sortOrderTransitionVersion++;
        var transitionVersion = _sortOrderTransitionVersion;
        _interfaces.Remove(item);
        item.SortOrder = normalizedSortOrder;
        var insertIndex = GetInsertIndexForManualGroupChange(normalizedSortOrder);
        _interfaces.Insert(insertIndex, item);
        SyncChildSortOrders(item.InterfaceKey, item.SortOrder);
        _pendingSortOrderFocusKey = item.InterfaceKey;
        await RefreshInterfaceWorkspaceAsync();
        _ = ReleaseSortOrderTransitionAsync(transitionVersion);
    }

    private async Task RefreshInterfaceWorkspaceAsync()
    {
        NormalizeInterfaceOrder();
        _dropContainer?.Refresh();
        await InvokeAsync(StateHasChanged);
    }

    private void NormalizeInterfaceOrder()
    {
        if (_interfaces.Count <= 1)
            return;

        var ordered = GetInterfaceDisplayOrder();
        if (_interfaces.SequenceEqual(ordered))
            return;

        _interfaces = ordered;
    }

    private List<SyncTaskInterface> GetInterfaceDisplayOrder()
    {
        var result = new List<SyncTaskInterface>();
        foreach (var group in _interfaces.GroupBy(i => i.SortOrder).OrderBy(g => g.Key))
        {
            var items = group.ToList();
            var topLevelItems = items.Where(i => !IsChildInterface(i)).ToList();

            foreach (var item in topLevelItems)
            {
                result.Add(item);
                result.AddRange(items.Where(i => i.ParentInterfaceKey == item.InterfaceKey));
            }

            result.AddRange(items.Where(i =>
                IsChildInterface(i) &&
                !topLevelItems.Any(parent => parent.InterfaceKey == i.ParentInterfaceKey)));
        }

        return result;
    }

    private static string CreateInterfaceKey() => Guid.NewGuid().ToString("N");

    private void EnsureInterfaceKeys()
    {
        foreach (var iface in _interfaces)
        {
            if (string.IsNullOrWhiteSpace(iface.InterfaceKey))
                iface.InterfaceKey = CreateInterfaceKey();

            if (string.IsNullOrWhiteSpace(iface.RouteOperator))
                iface.RouteOperator = "eq";

            var originalSourceType = iface.SourceType;
            if (string.IsNullOrWhiteSpace(iface.SourceType))
                iface.SourceType = IngestionService.SourceTypeApi;
            iface.SourceType = IngestionService.NormalizeSourceType(iface.SourceType);
            iface.DatabaseType = IngestionService.NormalizeDatabaseType(iface.DatabaseType, originalSourceType);
        }
    }

    private bool IsChildInterface(SyncTaskInterface iface) =>
        !string.IsNullOrWhiteSpace(iface.ParentInterfaceKey);

    private bool HasChildInterfaces(SyncTaskInterface iface) =>
        _interfaces.Any(i => i.ParentInterfaceKey == iface.InterfaceKey);

    private List<SyncTaskInterface> GetChildInterfaces(SyncTaskInterface iface) => _interfaces
        .Where(i => i.ParentInterfaceKey == iface.InterfaceKey)
        .OrderBy(i => i.DisplayName)
        .ThenBy(i => i.ServerCode)
        .ToList();

    private SyncTaskInterface? GetParentInterface(SyncTaskInterface iface)
    {
        if (string.IsNullOrWhiteSpace(iface.ParentInterfaceKey))
            return null;

        return _interfaces.FirstOrDefault(i => i.InterfaceKey == iface.ParentInterfaceKey);
    }

    private IEnumerable<SyncTaskInterface> GetParentCandidates(SyncTaskInterface current) =>
        _interfaces.Where(i =>
            !ReferenceEquals(i, current) &&
            !IsChildInterface(i) &&
            !string.Equals(i.InterfaceKey, current.InterfaceKey, StringComparison.Ordinal));

    private string GetEditingParentSelectValue() => _editingConfigInterface?.ParentInterfaceKey ?? "";

    private Task OnEditingParentInterfaceChanged(string parentInterfaceKey)
    {
        if (_editingConfigInterface == null)
            return Task.CompletedTask;

        ApplyParentBinding(_editingConfigInterface, parentInterfaceKey);
        return RefreshInterfaceWorkspaceAsync();
    }

    private void ApplyParentBinding(SyncTaskInterface iface, string? parentInterfaceKey)
    {
        var normalizedParentKey = string.IsNullOrWhiteSpace(parentInterfaceKey) ? null : parentInterfaceKey;
        iface.ParentInterfaceKey = normalizedParentKey;

        if (string.IsNullOrWhiteSpace(normalizedParentKey))
        {
            ClearParentBinding(iface);
            return;
        }

        var parent = _interfaces.FirstOrDefault(i => i.InterfaceKey == normalizedParentKey);
        iface.SortOrder = parent?.SortOrder ?? iface.SortOrder;
        iface.RouteOperator = string.IsNullOrWhiteSpace(iface.RouteOperator) ? "eq" : iface.RouteOperator;
        iface.OutputFields = null;
    }

    private void ClearParentBinding(SyncTaskInterface iface)
    {
        iface.ParentInterfaceKey = null;
        iface.ParentResultField = null;
        iface.LinkMappings = null;
        iface.MountField = null;
        iface.RouteField = null;
        iface.RouteOperator = "eq";
        iface.RouteValue = null;
    }

    private void SyncChildSortOrders(string interfaceKey, int sortOrder)
    {
        foreach (var child in _interfaces.Where(i => i.ParentInterfaceKey == interfaceKey))
            child.SortOrder = sortOrder;
    }

    private string GetInterfaceCardClass(SyncTaskInterface iface)
    {
        if (IsChildInterface(iface))
            return "interface-card--child";

        return HasChildInterfaces(iface)
            ? "interface-card--root"
            : "interface-card--standalone";
    }

    private bool NeedsRouteConfig(SyncTaskInterface iface)
    {
        if (!IsChildInterface(iface) || string.IsNullOrWhiteSpace(iface.ParentInterfaceKey))
            return false;

        return _interfaces.Count(i =>
            !ReferenceEquals(i, iface) &&
            string.Equals(i.ParentInterfaceKey, iface.ParentInterfaceKey, StringComparison.Ordinal)) > 0;
    }

    private void NormalizeInterfaceConfig(SyncTaskInterface iface)
    {
        var originalSourceType = iface.SourceType;
        iface.SourceType = NormalizeSourceType(iface.SourceType);
        if (iface.AccessWindowEnabled)
        {
            iface.AccessWindowStart = iface.AccessWindowStart?.Trim();
            iface.AccessWindowEnd = iface.AccessWindowEnd?.Trim();
        }
        else
        {
            iface.AccessWindowStart = null;
            iface.AccessWindowEnd = null;
        }
        if (!IsDatabaseInterface(iface))
        {
            iface.ContinuousRecordKeyFields = string.Join(",", iface.ContinuousRecordKeyArray
                .Distinct(StringComparer.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(iface.ContinuousRecordKeyFields))
                iface.ContinuousUseRowHash = false;
            iface.QueryStartTimeSourceServerCode = iface.QueryStartTimeSourceServerCode?.Trim();
            iface.QueryStartTimeSourceField = iface.QueryStartTimeSourceField?.Trim();
            iface.QueryEndTimeSourceServerCode = iface.QueryEndTimeSourceServerCode?.Trim();
            iface.QueryEndTimeSourceField = iface.QueryEndTimeSourceField?.Trim();
            if (iface.ContinuousPollingEnabled)
            {
                iface.UseTodayTimeRange = false;
                iface.ContinuousPollingIntervalSeconds = Math.Max(1, iface.ContinuousPollingIntervalSeconds);
            }
            ClearInterfaceDatabaseConnection(iface);
            iface.QuerySql = null;
            iface.QueryField = IsChildInterface(iface) ? iface.QueryField : "";
            iface.QueryValueField = null;
            var apiInterface = _apiInterfaces.FirstOrDefault(i => i.Id == iface.ApiInterfaceId);
            if (apiInterface != null)
            {
                iface.ServerCode = apiInterface.Code;
                iface.DisplayName = apiInterface.Name;
                iface.QueryPath = apiInterface.RelativePath;
            }
            if (!IsConditionArrayInterface(iface))
                iface.FilterConditions = null;
        }
        else
        {
            iface.ApiInterfaceId = null;
            iface.QueryMappings = null;
            iface.QueryPath = null;
            iface.UseTodayTimeRange = false;
            iface.ContinuousPollingEnabled = false;
            iface.PatientContinuousSyncEnabled = false;
            iface.ContinuousUseTimeRange = true;
            iface.ContinuousRecordKeyFields = "";
            iface.ContinuousUseRowHash = false;
            iface.QueryStartTimeSourceServerCode = null;
            iface.QueryStartTimeSourceField = null;
            iface.QueryEndTimeSourceServerCode = null;
            iface.QueryEndTimeSourceField = null;
            iface.ConnectionStringName = null;
            iface.FilterConditions = null;
            var resource = GetEffectiveDatabaseResource(iface);
            iface.DatabaseType = resource == null
                ? IngestionService.NormalizeDatabaseType(iface.DatabaseType, originalSourceType)
                : IngestionService.NormalizeDatabaseType(resource.DatabaseType);
            iface.SqlServerHost = null;
            iface.SqlServerDatabase = null;
            iface.SqlServerUsername = null;
            iface.SqlServerPassword = null;
            iface.SqlServerTrustCertificate = resource?.TrustCertificate ?? true;
        }

        if (IsChildInterface(iface))
        {
            iface.ContinuousPollingEnabled = false;
            iface.PatientContinuousSyncEnabled = false;
            iface.ContinuousUseTimeRange = true;
            iface.ContinuousRecordKeyFields = "";
            iface.ContinuousUseRowHash = false;
            iface.QueryStartTimeSourceServerCode = null;
            iface.QueryStartTimeSourceField = null;
            iface.QueryEndTimeSourceServerCode = null;
            iface.QueryEndTimeSourceField = null;
            iface.OutputFields = null;
            iface.PushParams = null;
            if (NeedsRouteConfig(iface))
            {
                iface.RouteOperator = string.IsNullOrWhiteSpace(iface.RouteOperator) ? "eq" : iface.RouteOperator;
            }
            else
            {
                iface.RouteField = null;
                iface.RouteOperator = "eq";
                iface.RouteValue = null;
            }
            var parent = GetParentInterface(iface);
            if (parent != null)
                iface.SortOrder = parent.SortOrder;
            return;
        }

        iface.ParentResultField = null;
        iface.LinkMappings = null;
        iface.MountField = null;
        iface.RouteField = null;
        iface.RouteOperator = "eq";
        iface.RouteValue = null;
    }

